# 28 - Snake (a game)
#
# Steer the snake with the arrow keys and eat the red apples. Each apple makes
# the snake longer; hitting a wall or yourself ends the game.
#
# The snake is an array of (column, row) pairs, head first. To move, the
# program adds a new head in the direction of travel and removes the tail -
# unless the snake has just eaten, which is how it grows.
#
# Try it: press Run, click the Canvas panel so it receives the keys, and play.
# Space starts a new game. frame_rate sets the speed.

import graphics

const cell = 20
const columns = 20
const rows = 15
canvas(columns * cell, rows * cell)
frame_rate(8)

var snake: (int, int)[] = []
var direction = (1, 0)
var apple = (0, 0)
var score = 0
var best = 0
var playing = false

func place_apple()
    apple = (random_int(0, columns - 1), random_int(0, rows - 1))
    while contains(snake, apple)
        apple = (random_int(0, columns - 1), random_int(0, rows - 1))

func new_game()
    snake = [(6, 7), (5, 7), (4, 7)]
    direction = (1, 0)
    score = 0
    playing = true
    place_apple()

# The snake may turn left or right, but not straight back into itself.
func steer(key: string)
    var (dx, dy) = direction
    if key == "left" and dx == 0
        direction = (-1, 0)
    else if key == "right" and dx == 0
        direction = (1, 0)
    else if key == "up" and dy == 0
        direction = (0, -1)
    else if key == "down" and dy == 0
        direction = (0, 1)

func move()
    var head = (first(snake[0]) + first(direction), second(snake[0]) + second(direction))
    var (x, y) = head
    if x < 0 or x >= columns or y < 0 or y >= rows or contains(snake, head)
        playing = false
        if score > best
            best = score
        return
    insert(snake, 0, head)
    if head == apple
        score = score + 1
        place_apple()
    else
        pop(snake)        # no apple: the tail moves on too

func draw()
    clear(rgb(20, 30, 20))
    circle(first(apple) * cell + cell / 2, second(apple) * cell + cell / 2, cell / 2 - 2, "red")
    for var i = 0, i < len(snake), i = i + 1
        var (x, y) = snake[i]
        var color = "green"
        if i == 0
            color = "lime"
        rect(x * cell + 1, y * cell + 1, cell - 2, cell - 2, color)
    text(6, 4, "score " + str(score) + "   best " + str(best), "white")
    if not playing
        rect(70, 95, 260, 85, "black")
        rect_outline(70, 95, 260, 85, "yellow")
        text_size(28)
        text(110, 110, "GAME OVER", "yellow")
        text_size(16)
        text(95, 150, "press space to play again", "white")

new_game()
while true
    var key = key_pressed()     # one key per step, so two quick turns are not lost
    if playing
        steer(key)
        move()
    else if key == "space"
        new_game()
    draw()
    frame()
