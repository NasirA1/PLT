# ژبه: ps
# ۰۴ - متنونه
#
# متنونه د یونیکوډ تورو نه بدلېدونکې لړۍ دي. + متنونه سره نښلوي،
# اوږدوالی توري شمېري، متن[ش] یو توری لولي، او «متن کړه» هر ارزښت په متن
# اړوي. «عدد کړه» متن په عدد اړوي.

متغیر لومړی_برخه = "د پروګرام"
متغیر دوهمه_برخه = "ژبې"
متغیر سرلیک = لومړی_برخه + " " + دوهمه_برخه

کرښه چاپ(سرلیک)
کرښه چاپ("اوږدوالی: "، اوږدوالی(سرلیک))
کرښه چاپ("لومړی توری: "، سرلیک[۰])
کرښه چاپ("وروستی توری: "، سرلیک[اوږدوالی(سرلیک) - ۱])

متغیر اوښتی = ""
لپاره متغیر ش = اوږدوالی(دوهمه_برخه) - ۱، ش >= ۰، ش = ش - ۱
    اوښتی = اوښتی + دوهمه_برخه[ش]
کرښه چاپ("سرچپه: "، اوښتی)

# عددونه او متنونه بېل ډولونه دي: په ښکاره یې واړوئ.
متغیر ځواب = "۴" + متن کړه(۲)
کرښه چاپ(ځواب، " + ۱ = "، عدد کړه(ځواب) + ۱)

# انګلیسي توري هم شمېرل کېږي: دا کلمه ۷ توري لري.
متغیر انګلیسي = "Thunder"
کرښه چاپ(انګلیسي، " "، اوږدوالی(انګلیسي)، " توري لري")

# ځانګړي ترکیبونه: \n نوې کرښه، \t ټب، \" قوس، \\ شاته کرښه
کرښه چاپ("الف\tب\n\"په قوسونو کې\" \\ پای")
