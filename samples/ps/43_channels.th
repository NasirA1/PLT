# ژبه: ps
# ۴۳ - جوړوونکي، کاروونکي او هغه نلۍ چې ترمنځ یې ده
#
# کانال یوه لیکه ده چې انتظار پکې جوړ شوی دی: ولېږه() هغه وخت انتظار باسي چې ډکه وي،
# واخله() هغه وخت چې تشه وي. نو دوه کاره د دوو ساده تکرارونو په بڼه لیکل کېږي - نه
# پوښتنه‌ګرځول، نه شریک شمېرګر، نه خپل قلف - او هیڅ یو له بل څخه مخته نشي تښتېدای.
راوړه "concurrency"

متغیر جوړ_شوي: متن[] = []
متغیر خوړل_شوي: متن[] = []

# یو کانال چې د دوو ځای لري: جوړوونکی تر دوو ارزښتونو مخته کېدای شي، نه ډېر.
متغیر چارې: کانال<متن> = کانال(۲)

دنده جوړول()
    تکرار ا په واټن(۱، ۷)
        متغیر ټوټه = "ټوټه " + متن کړه(ا)
        چارې.ولېږه(ټوټه)
        ورزیات کړه(جوړ_شوي، ټوټه + " (په انتظار: " + متن کړه(چارې.شمېر()) + ")")
    چارې.وتړه()           # نور څه نه راځي

دنده کارول()
    ترڅو چارې.بل_شته()
        ورزیات کړه(خوړل_شوي، چارې.واخله())

کرښه چاپ("۱. یو جوړوونکی، یو کاروونکی، د دوو کانال:")
متغیر ج = کار(جوړول)
متغیر ک = کار(کارول)
ج.انتظار_یې_وکړه()
ک.انتظار_یې_وکړه()
کرښه چاپ("  جوړ شول:  "، متن.یو ځای کړه(جوړ_شوي، "، "))
کرښه چاپ("  واخیستل شول: "، متن.یو ځای کړه(خوړل_شوي، "، "))

کرښه چاپ("۲. دوه کاروونکي کار سره ویشي (بل_شته ارزښت د خپل کار لپاره ساتي):")
متغیر شریک: کانال<عدد> = کانال(۴)
متغیر زما: عدد[] = []
متغیر ستا: عدد[] = []

دنده واخله_په(کڅوړه: عدد[]): دنده()
    متغیر چلول = دنده()
        ترڅو شریک.بل_شته()
            ورزیات کړه(کڅوړه، شریک.واخله())
    راګرځه چلول

متغیر کیڼ = کار(واخله_په(زما))
متغیر ښي = کار(واخله_په(ستا))
تکرار ن په واټن(۱، ۱۱)
    شریک.ولېږه(ن)
شریک.وتړه()
کیڼ.انتظار_یې_وکړه()
ښي.انتظار_یې_وکړه()
کرښه چاپ("  یوه واخیستل "، اوږدوالی(زما)، "، بل "، اوږدوالی(ستا)، "، ټول سره "،
        اوږدوالی(زما) + اوږدوالی(ستا)، " له ۱۰")

کرښه چاپ("۳. د ۰ ظرفیت کانال لاس په لاس دی - لېږونکی د کتنې انتظار باسي:")
متغیر لاس: کانال<متن> = کانال(۰)
متغیر پیغام = ""

دنده اخیستونکی()
    پیغام = لاس.واخله()

متغیر ا = کار(اخیستونکی)
لاس.ولېږه("دا یې واخله")
ا.انتظار_یې_وکړه()
کرښه چاپ("  اخیستونکي ترلاسه کړل: \""، پیغام، "\"")
کرښه چاپ("  څه پکې نه دي پاتې: "، لاس.شمېر()، " ارزښته")
