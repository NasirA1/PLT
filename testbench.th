# ژبه: ps

راوړه ګرافیک

جوړښت كوردينات
    افقي: عدد
    عمودي: عدد

متغیر ځاى = كوردينات(۱۰۰ ، ۱۰۰)
کرښه چاپ(ځاى)

ګرافیک.ټاټ(۵۰۰، ۴۰۰)

ترڅو رښتيا
    ګرافیک.ټاټ پاک کړه(”تور”)
    ګرافیک.دایره(ځاى.افقي، ځاى.عمودي، ۲۰، "زرغون")
    ګرافیک.مستطیل(۳۰۰، ۲۰۰، ۲۰، ۲۰، "سور")
    ګرافیک.چوکاټ()
    ځاى.افقي += ١

متغیر س = ١٢
جوړښت پكسل
    س: عدد
    ص: عدد
متغير پ = پكسل(١٢، ٢٣)
كرښه چاپ(پ)


