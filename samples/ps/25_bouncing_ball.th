# ژبه: ps
# ۲۵ - ټوپ وهونکې ګېنده (حرکت)
#
# حرکت یو تکرار دی چې په یو وخت کې یو انځور - یو چوکاټ - کاږي: ټاټ پاک
# کړه، هر شی چې اوس چېرته دی وکاږه، چوکاټ() وبوله، بیا شیان لږ وخوځوه.
# چوکاټ() انځور ښيي او انتظار کوي، نو حرکت په یوه ثانیه کې ۳۰ چوکاټه کېږي
# (د چوکاټ چټکتیا دا بدلوي).
#
# هڅه وکړئ: «چلول» کښېکښئ او د ټاټ پاڼه وګورئ؛ «درول» حرکت پای ته رسوي.
# ګام_س او ګام_ص بدل کړئ چې ګېنده چټکه شي، یا دوهمه ګېنده ورزیاته کړئ.

راوړه ګرافیک

ثابت پلنوالی = ۴۰۰
ثابت لوړوالی = ۳۰۰
ثابت وړانګه = ۱۸
ټاټ(پلنوالی، لوړوالی)

متغیر س = ۶۰
متغیر ص = ۵۰
متغیر ګام_س = ۴    # ګېنده په هر چوکاټ کې دومره خوځېږي
متغیر ګام_ص = ۳
متغیر ټوپونه = ۰

ترڅو رښتیا
    ټاټ پاک کړه(رنګ(۰، ۰، ۱۲۸))
    دایره(س + ۴، ص + ۴، وړانګه، "تور")         # سیوری
    دایره(س، ص، وړانګه، "نارنجي")
    دایره(س - ۶، ص - ۶، ۵، "ژېړ")              # ځلا
    لیکنه(۱۰، ۱۰، "ټوپونه: " + متن کړه(ټوپونه)، "سپین")
    چوکاټ()

    س = س + ګام_س
    ص = ص + ګام_ص
    # د دېوال سره ګېنده بېرته راګرځي: ګام یې نښه بدلوي.
    که س - وړانګه < ۰ یا س + وړانګه > پلنوالی
        ګام_س = -ګام_س
        ټوپونه = ټوپونه + ۱
    که ص - وړانګه < ۰ یا ص + وړانګه > لوړوالی
        ګام_ص = -ګام_ص
        ټوپونه = ټوپونه + ۱
