# ژبه: ps
# ۰۸ - د «تکرار» تکرارونه: شمېرل، او پر ټولګه ګرځېدل
#
# تندر دوه ډوله «تکرار» لري، او دا نمونه دواړه ښيي.
#
#   تکرار پیل، شرط، ګام        شمېري - د «ترڅو» تکرار لنډه بڼه
#   تکرار ارزښت په ټولګه       پخپله پر توکو ګرځي
#
# د تکرار متغیر یوازې د تکرار دننه شته. «ش += ۱» د «ش = ش + ۱» مانا لري؛ همدا ډول
# -= *= /= %= هم کار کوي، او د لړۍ په توکو او د جوړښت په برخو هم، او موخه یوازې یو
# ځل ارزول کېږي.
#
# هڅه وکړئ: «ډیبګ» وکاروئ او په لومړي تکرار کې ګام په ګام لاړ شئ، د VM په پاڼه کې د
# «ش» ځای وګورئ؛ بیا د «بایټ کوډ» پاڼه پرانیزئ او دواړه ډوله تکرارونه سره پرتله کړئ.

# --- شمېرل -----------------------------------------------------------------------------

# فیز باز: د مرکې یوه مشهوره پوښتنه.
تکرار متغیر ش = ۱، ش <= ۱۵، ش = ش + ۱
    که ش % ۱۵ == ۰
        کرښه چاپ("فیز باز")
    کنه که ش % ۳ == ۰
        کرښه چاپ("فیز")
    کنه که ش % ۵ == ۰
        کرښه چاپ("باز")
    کنه
        کرښه چاپ(ش)

# تکرار په تکرار کې: د ضرب کوچنی جدول.
تکرار متغیر قطار = ۱، قطار <= ۴، قطار = قطار + ۱
    متغیر کرښه = ""
    تکرار متغیر ستون = ۱، ستون <= ۴، ستون = ستون + ۱
        متغیر خونه = متن کړه(قطار * ستون)
        که اوږدوالی(خونه) < ۲
            خونه = " " + خونه
        کرښه = کرښه + خونه + " "
    کرښه چاپ(کرښه)

# کله چې ګام یو نه وي، شمېرل همغه بڼه ده چې په کار ده.
تکرار متغیر ش = ۱۰، ش > ۰، ش = ش - ۳
    چاپ(ش، " ")
کرښه چاپ()

# --- پر ټولګه ګرځېدل --------------------------------------------------------------------

# «تکرار ارزښت په ټولګه» پخپله توکي ګرځي - نه شمېرونکی، نه لړ شمېره. له شمېرلو لنډ او
# خوندي دی، ځکه چې هېڅ لړ شمېره نشته چې تېروتنه پکې وشي.
متغیر نمرې = [۷۱، ۸۴، ۶۶، ۹۰]
متغیر ټولټال = ۰
تکرار نمره په نمرې
    ټولټال += نمره
کرښه چاپ("ټولټال "، ټولټال، "، منځنۍ "، اعشاري کړه(ټولټال) / اوږدوالی(نمرې))

# د متن توري:
متغیر واولونه = ۰
تکرار توری په "programming language technology"
    که شامل دی("aeiou"، توری)
        واولونه += ۱
کرښه چاپ("واولونه: "، واولونه)

# د نقشې کیلۍ (که ارزښتونه هم غواړئ، توکي(نقشه) وکاروئ):
متغیر پلورنځی = {"قلمونه": ۱۲، "کتابونه": ۳}
تکرار توکی په پلورنځی
    کرښه چاپ(توکی، ": "، پلورنځی[توکی])

# څو نومونه یو ټاپل وېشي، چې شمېره ورکړه() او توکي() همدا راګرځوي:
تکرار (ځای، نمره) په شمېره ورکړه(نمرې)
    چاپ(ځای، "->"، نمره، " ")
کرښه چاپ()
تکرار (نوم، شمېر) په توکي(پلورنځی)
    کرښه چاپ(نوم، " "، شمېر، " وو")
    پلورنځی[نوم] += ۱
کرښه چاپ(پلورنځی)

# ودرېږه او دوام په دواړو ډوله تکرارونو کې کار کوي.
تکرار نمره په نمرې
    که نمره < ۷۰
        دوام
    که نمره > ۸۵
        ودرېږه
    کرښه چاپ("ښه نمره چې تر ټولو لوړه نه ده: "، نمره)

تکرار کلمه په ["تندر"، "برېښنا"، "باران"]
    چاپ(کلمه، " ")
کرښه چاپ()
