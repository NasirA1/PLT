// ژبه: ps
// lib/sockets.th - د شبکې له لارې خبرې: TCP او UDP ساکټونه (docs/ps/sockets.md)
//
// راوړه "lib/sockets" ولیکئ او ټولې لاندې دندې ستاسې دي. دوی په ++C کې لیکل شوې
// (lib/native/sockets/thunder_sockets.cpp) او له توکپانګې سره د بهرني کتابتون
// thunder_sockets په بڼه جوړېږي، چې د thunderc او thundervm تر څنګ کېني او د بسته
// شوي پروګرام تر څنګ پخپله کاپي کېږي.
//
// ساکټ یو عددي نښه ده، لکه د ټکټ شمېره. د -۱ پایله مانا «کار یې ونه کړ» او
// ساکټ_تېروتنه() وايي ولې؛ داسې نښه ورکول چې پرانیستې نه ده د پروګرام تېروتنه ده
// او پروګرام دروي، لکه د دننۍ دندې ناسمه بلنه.

راوړه بهرنی "thunder_sockets"

// --- TCP: اړیکه چې متن په ترتیب، دواړو لورو ته وړي ---------------------------------

// په دې کمپیوټر اړیکو ته انتظار کوي. کوربه "" مانا هره پته؛ پورټ ۰ سیسټم ته
// پرېږدي چې یو وټاکي (ساکټ_پورټ وپوښتئ). د اورېدونکي نښه راګرځوي، یا -۱.
بهرنی دنده اورېدونکی_جوړ_کړه(کوربه: متن، پورټ: عدد): عدد
// د اورېدونکي راتلونکي پېرېدونکي ته انتظار کوي او ورسره اړیکه راګرځوي، یا -۱.
بهرنی دنده اړیکه_ومنه(اورېدونکی: عدد): عدد
// له یوه سرور سره نښلي ("localhost"، "192.168.1.5"، "example.org"). که رد شي -۱.
بهرنی دنده ونښلېږه(کوربه: متن، پورټ: عدد): عدد

// متن لېږي (د UTF-8 بایټونو په بڼه)؛ د لېږل شویو بایټونو شمېر راګرځوي، یا -۱.
بهرنی دنده ساکټ_ولېږه(ساکټ: عدد، متن_یې: متن): عدد
// متن د کرښې له پایه سره لېږي: د ساده پروتوکولونو طبیعي واحد.
بهرنی دنده ساکټ_کرښه_ولېږه(ساکټ: عدد، متن_یې: متن): عدد
// تر تر_ټولو_ډېر_بایټونه پورې متن ته انتظار کوي. "" کله چې بل لوري تړلی وي
// (ساکټ_پرانیستی_دی بیا درواغ کېږي)، وخت پای ته ورسېږي، یا تېروتنه وشي.
بهرنی دنده ساکټ_واخله(ساکټ: عدد، تر_ټولو_ډېر_بایټونه: عدد): متن
// یوې کرښې ته انتظار کوي او پرته له خپل پای څخه یې راګرځوي.
بهرنی دنده ساکټ_کرښه_واخله(ساکټ: عدد): متن
// تر هغه رښتیا چې اړیکه لا څه راوړلای شي.
بهرنی دنده ساکټ_پرانیستی_دی(ساکټ: عدد): منطقي
// ساکټ تړي (اړیکه، اورېدونکی یا UDP). بل لوری یې پوهېږي.
بهرنی دنده ساکټ_وتړه(ساکټ: عدد)
// منل او اخیستل څومره انتظار کولای شي، په ملي ثانیو (-۱: تل، اصلي).
بهرنی دنده ساکټ_وخت_حد(ساکټ: عدد، ملي_ثانیې: عدد): منطقي
// پر دې کمپیوټر پورټ، لکه هغه چې اورېدونکی_جوړ_کړه(کوربه، ۰) ته ورکړل شو.
بهرنی دنده ساکټ_پورټ(ساکټ: عدد): عدد
// د اړیکې د بل لوري پته، لکه "ip:port".
بهرنی دنده ساکټ_مقابل_لوری(ساکټ: عدد): متن
// ولې وروستۍ بلنه چې -۱ یا "" یې راوګرځول داسې وشول.
بهرنی دنده ساکټ_تېروتنه(): متن

// --- UDP: یو یو پیغام (ډاټاګرام) بې اړیکې، هرې پتې ته -----------------------------

// د دې کمپیوټر پر یوه پورټ UDP ساکټ پرانیزي (۰: هر تش پورټ).
بهرنی دنده یو_ډي_پي_پرانیزه(پورټ: عدد): عدد
// یو ډاټاګرام کوربه:پورټ ته لېږي؛ لېږل شوي بایټونه راګرځوي، یا -۱.
بهرنی دنده یو_ډي_پي_ولېږه(ساکټ: عدد، کوربه: متن، پورټ: عدد، متن_یې: متن): عدد
// یوه ډاټاګرام ته انتظار کوي او متن یې راګرځوي ("" د وخت پای یا تېروتنې پر مهال).
بهرنی دنده یو_ډي_پي_واخله(ساکټ: عدد، تر_ټولو_ډېر_بایټونه: عدد): متن
// چا هغه ډاټاګرام لېږلی چې یو_ډي_پي_واخله وروستی راوګرځاوه، لکه "ip:port".
بهرنی دنده یو_ډي_پي_لېږونکی(): متن

// --- نومونه او پتې -------------------------------------------------------------------

// د یوه نوم IP پته ("example.org" -> "93.184.216.34")، یا "" که نامعلوم وي.
بهرنی دنده د_کوربه_پته(نوم: متن): متن
// د همدې کمپیوټر خپل نوم.
بهرنی دنده د_کوربه_نوم(): متن

// یوه بشپړه تبادله: ونښلېږه، یوه کرښه ولېږه، ځواب ولوله، اړیکه پرې کړه.
// "" که سرور ته نه رسېدل کېږي.
دنده غوښتنه(کوربه: متن، پورټ: عدد، کرښه: متن): متن
    متغیر ساکټ = ونښلېږه(کوربه، پورټ)
    که ساکټ < ۰
        راګرځه ""
    ساکټ_کرښه_ولېږه(ساکټ، کرښه)
    متغیر ځواب = ساکټ_کرښه_واخله(ساکټ)
    ساکټ_وتړه(ساکټ)
    راګرځه ځواب
