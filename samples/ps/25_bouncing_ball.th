// ژبه: ps
// ۲۵ - ټوپ وهونکې ګېنده (حرکت)
//
// حرکت یو تکرار دی چې په یو وخت کې یو انځور - یو چوکاټ - کاږي: کینوس پاک کړه،
// هر شی چې اوس چېرته دی وکاږه، چوکاټ() وبوله، بیا شیان لږ وخوځوه. چوکاټ()
// انځور ښيي او انتظار کوي، نو حرکت په یوه ثانیه کې ۳۰ چوکاټه کېږي.
//
// هڅه وکړئ: «چلول» کېکاږئ او د کینوس پاڼه وګورئ؛ «درول» حرکت پای ته رسوي.

راوړه ګرافیک

ثابت پلنوالی = ۴۰۰
ثابت لوړوالی = ۳۰۰
ثابت شعاع = ۱۸
کینوس(پلنوالی, لوړوالی)

متغیر x = ۶۰
متغیر y = ۵۰
متغیر dx = ۴    // ګېنده په هر چوکاټ کې دومره خوځېږي
متغیر dy = ۳
متغیر ټوپونه = ۰

ترڅو رښتیا
    کینوس پاک کړه("navy")
    دایره(x + ۴, y + ۴, شعاع, "تور")       // سیوری
    دایره(x, y, شعاع, "نارنجي")
    دایره(x - ۶, y - ۶, ۵, "ژېړ")
    لیکنه(۱۰, ۱۰, "ټوپونه: " + متن کړه(ټوپونه), "سپین")
    چوکاټ()

    x = x + dx
    y = y + dy
    // د دېوال سره ګېنده بېرته راګرځي: سرعت یې نښه بدلوي.
    که x - شعاع < ۰ || x + شعاع > پلنوالی
        dx = -dx
        ټوپونه = ټوپونه + ۱
    که y - شعاع < ۰ || y + شعاع > لوړوالی
        dy = -dy
        ټوپونه = ټوپونه + ۱
