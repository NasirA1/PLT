# ژبه: ps
# پرمختللی ۰۱ - د ډېټا جوړښتونو کتابتون
#
# راوړه "datastructures" کلاسیک جوړښتونه راوړي: ډېرۍ، لیکه، ځنځیر، د لټون دوه‌اړخیزه
# ونه او د لومړیتوب لیکه - ټول پخپله په تندر کې لیکل شوي (lib/thunder/ps). هر یو یو
# شی دی: په خپل جوړوونکي یې جوړ کړئ - ډېرۍ()، لیکه() - او د خپلو دندو له لارې یې
# وکاروئ. ټول عمومي دي - د توکو ډول په <زاویه قوسونو> کې هلته نومول کېږي چې متغیر
# اعلانېږي. کتابتون په docs/ps/datastructures.md کې تشریح شوی دی.

راوړه "datastructures"

# --- د متنونو ډېرۍ: وروستی دننه، لومړی بهر ------------------------------------------
متغیر کاسې: ډېرۍ<متن> = ډېرۍ()
کاسې.ورزیات_کړه("ومینځل شوه")
کاسې.ورزیات_کړه("وچه شوه")
کاسې.ورزیات_کړه("کېښودل شوه")
کرښه چاپ("د ډېرۍ سر: "، کاسې.وګوره())
ترڅو نه کاسې.تشه_ده()
    کرښه چاپ("واخله: "، کاسې.واخله())

# --- د پېرودونکو لیکه: لومړی دننه، لومړی بهر ----------------------------------------
متغیر انتظار: لیکه<متن> = لیکه()
انتظار.ورزیات_کړه("انا")
انتظار.ورزیات_کړه("بشیر")
انتظار.ورزیات_کړه("ثریا")
کرښه چاپ("خدمت: "، انتظار.واخله()، "؛ راتلونکی "، انتظار.وګوره()،
    " له "، انتظار.کچه())

# --- ځنځیر: د غوټیو کړۍ چې هېڅ یې پای ته رسوي ---------------------------------------
متغیر کړۍ: ځنځیر<عدد> = ځنځیر()
کړۍ.پای_ته_ورزیات_کړه(۲)
کړۍ.سر_ته_ورزیات_کړه(۱)
کړۍ.پای_ته_ورزیات_کړه(۳)
کرښه چاپ("د لړۍ په بڼه: "، کړۍ.لړۍ_کړه()، "، ۳ لري؟ "، کړۍ.لري(۳))
متغیر لیرې_شو = کړۍ.لیرې_کړه(۲)
کرښه چاپ("د ۲ له لیرې کولو ("، لیرې_شو، ") وروسته: "، کړۍ.لړۍ_کړه())

# --- د لټون دوه‌اړخیزه ونه خپل ارزښتونه په ترتیب ساتي -------------------------------
متغیر لټون_ونه: ونه<عدد> = ونه()
تکرار ن په [۵۰، ۳۰، ۸۰، ۱۰، ۴۰، ۷۰، ۹۰]
    لټون_ونه.ورزیات_کړه(ن)
کرښه چاپ("ترتیب شوې: "، لټون_ونه.په_ترتیب())
کرښه چاپ("کچه "، لټون_ونه.کچه()، "، لوړوالی "، لټون_ونه.لوړوالی()،
    "، کمینه "، لټون_ونه.کمینه()، "، اعظمه "، لټون_ونه.اعظمه())
متغیر ووت = لټون_ونه.لیرې_کړه(۵۰)
کرښه چاپ("ریښه لیرې شوه؟ "، ووت، "؛ پرته له هغې: "، لټون_ونه.په_ترتیب())

# --- د لومړیتوب لیکه همېش کمینه لومړی راکوي -----------------------------------------
متغیر د_کار_لیکه: لومړیتوب_لیکه<عدد> = لومړیتوب_لیکه()
تکرار لومړیتوب په [۷، ۲، ۹، ۱، ۵]
    د_کار_لیکه.ورزیات_کړه(لومړیتوب)
ترڅو نه د_کار_لیکه.تشه_ده()
    چاپ(د_کار_لیکه.واخله()، " ")
کرښه چاپ()

# --- ټولګه هر ارزښت یو ځل ساتي؛ ترتیب شوې ټولګه یې اڼلي هم ساتي ---------------------
متغیر لیدل_شوي: ټولګه<متن> = ټولګه()
تکرار رنګ په ["سور"، "شین"، "سور"، "زرغون"، "شین"]
    لیدل_شوي.ورزیات_کړه(رنګ)
کرښه چاپ("ځانګړي رنګونه: "، لیدل_شوي.ارزښتونه()، " (له ۵ څخه "، لیدل_شوي.کچه()، ")")
متغیر ساړه: ټولګه<متن> = ټولګه()
ساړه.ورزیات_کړه("شین")
ساړه.ورزیات_کړه("زرغون")
کرښه چاپ("یوازې تاوده: "، لیدل_شوي.توپیر(ساړه).ارزښتونه())

متغیر نمرې: ترتیب_شوې_ټولګه<عدد> = ترتیب_شوې_ټولګه()
تکرار نمره په [۷۰، ۴۰، ۹۰، ۷۰، ۴۰]
    نمرې.ورزیات_کړه(نمره)
کرښه چاپ("ځانګړې نمرې، اڼل شوې: "، نمرې.ارزښتونه()،
    "، له "، نمرې.کمینه()، " تر "، نمرې.اعظمه())

# --- دوسرې لیکه دواړه سرونه پرانیستي لري؛ دوه اړخیز ځنځیر دواړه لوري ګرځي -------------
متغیر لاره: دوسرې_لیکه<متن> = دوسرې_لیکه()
لاره.پای_ته_ورزیات_کړه("دویم")
لاره.سر_ته_ورزیات_کړه("لومړی")
لاره.پای_ته_ورزیات_کړه("درېیم")
کرښه چاپ("دوسرې لیکه: "، لاره.لړۍ_کړه()، "، له شا: "، لاره.له_پایه_واخله())

متغیر پېښلیک: دوه_اړخیز_ځنځیر<متن> = دوه_اړخیز_ځنځیر()
پېښلیک.پای_ته_ورزیات_کړه("یو")
پېښلیک.پای_ته_ورزیات_کړه("دوه")
پېښلیک.پای_ته_ورزیات_کړه("درې")
کرښه چاپ("مخ ته: "، پېښلیک.لړۍ_کړه()، "، شا ته: "، پېښلیک.سرچپه_لړۍ_کړه())

# --- ګراف: ښارونه، لارې، او تر ټولو لنډه لار د دوی تر منځ -----------------------------
متغیر لارې: ګراف<متن> = ګراف()
لارې.ونښلوه("کابل"، "غزني")
لارې.ونښلوه("غزني"، "کندهار")
لارې.ونښلوه("کابل"، "بامیان")
لارې.ونښلوه("بامیان"، "هرات")
لارې.ونښلوه("کندهار"، "هرات")
کرښه چاپ("له کابله، لومړی نږدې: "، لارې.پلن_لټون("کابل"))
کرښه چاپ("هرات ته لنډه لار: "، لارې.لنډه_لار("کابل"، "هرات"))

# --- مختاړې ونه د مختاړي پوښتنو ته د ویي په اوږدوالي ځواب ورکوي -----------------------
متغیر سیند = مختاړې_ونه()
تکرار ویی په ["کور"، "کورنۍ"، "کار"، "لار"]
    سیند.ورزیات_کړه(ویی)
کرښه چاپ("وییونه: "، سیند.وییونه()، "؛ په «کو» پیلېږي؟ "، سیند.مختاړی_لري("کو")،
    "؛ «کو» پخپله ویی دی؟ "، سیند.لري("کو"))
