# ژبه: ps
# ۴۱ - همکاري: څو کاره په یوه وخت کې
#
# کار ستاسې د پروګرام هغه برخه ده چې د نورو تر څنګ ځي. مجازي ماشین پخپله کارونه چلوي او
# پر یوه مزي یې وار په وار وړي، نو له یوه کاره چټک نه دي - خو دوه داسې برخې چې هره یوه
# یې باید *انتظار* وباسي، لکه دوه ساده کرښې لیکل کېږي، او همکاري همدې لپاره ده.
#
# ځکه چې ماشین پخپله هره وارۍ پرېکړه کوي، د تندر هغه پروګرام چې کارونه لري په هر ځل کې
# همغه شی چاپوي: یوه ننګونه ښودل کېږي، په ډیبګر کې ګام په ګام تېرېږي، او سمېږي.
#
# دا بېلګه هغه څلور شیان ښيي چې پوهېدل پرې اړین دي. ټول کتابتون - سیمافور، خنډ، ډله،
# دروازه، د لوست او لیک قلف او مهالګرونه - په docs/ps/concurrency.md کې دی، او پرمختللې
# بېلګې ۰۳-۰۸ هره یوه ښيي.
راوړه "concurrency"

# --- ۱. د یوه کار پیلول، او د پای انتظار یې ---------------------------------------
#
# د «کار» جوړول یې پیلول دي. راته_ودرېږه() انتظار باسي ترڅو پای ته ورسېږي.
متغیر یادښت: متن[] = []

دنده وشمېره(نوم: متن، تر: عدد)
    تکرار ا په واټن(۱، تر + ۱)
        ورزیات کړه(یادښت، نوم + متن کړه(ا))

کرښه چاپ("۱. دوه کاره د یو بل تر څنګ ځي:")
متغیر یو = کار(دنده() وشمېره("الف"، ۳))
متغیر دوه = کار(دنده() وشمېره("ب"، ۳))
یو.راته_ودرېږه()
دوه.راته_ودرېږه()
کرښه چاپ("  "، متن.یو ځای کړه(یادښت، " "))
کرښه چاپ("  د دې کار نوم "، کارونه.نوم(کارونه.اوسنی())، " دی؛ نور "، یو.نوم()، " او "،
        دوه.نوم()، " وو")

# --- ۲. کارونه هرڅه شریکوي، او دا پاملرنې ته اړتیا لري ----------------------------
#
# لاندې دواړه کاره یوه عام متغیر ته ورزیاتوي. «ټولټال += ۱» درې ګامه دي - ولوله، یو
# ورزیات کړه، بېرته یې وساته - او بل کار کولای شي په منځ کې خپله وارۍ ترلاسه کړي، نو یو
# بدلون ورکېږي.
متغیر ټولټال = ۰

دنده بې_قلفه_ورزیاته()
    متغیر پاتې = ۵۰۰
    ترڅو پاتې > ۰
        ټولټال += ۱
        پاتې -= ۱

کرښه چاپ("۲. دوه کاره یوه شمېرګر ته ورزیاتوي، بې قلفه:")
متغیر ج = کار(بې_قلفه_ورزیاته)
متغیر د = کار(بې_قلفه_ورزیاته)
ج.راته_ودرېږه()
د.راته_ودرېږه()
کرښه چاپ("  وشمېرل شول "، ټولټال، " له ۱۰۰۰؛ بدلونونه ورک شول: "، ټولټال < ۱۰۰۰)

# --- ۳. قلف هغه درې ګامه یو کوي ------------------------------------------------------
#
# یو قلف په یوه وخت کې یوازې یو کار نیولای شي؛ نور یې انتظار باسي. «سره» یې د بلاک په
# پای کې بېرته ورکوي، په هر ډول چې بلاک پای ته ورسېږي.
متغیر ساتونکې = قلف()

دنده په_قلف_ورزیاته()
    متغیر پاتې = ۵۰۰
    ترڅو پاتې > ۰
        ساتونکې.قلف_کړه() سره
            ټولټال += ۱
        پاتې -= ۱

کرښه چاپ("۳. همدا دوه کاره، د شمېرګر پر شا قلف سره:")
ټولټال = ۰
متغیر ه = کار(په_قلف_ورزیاته)
متغیر و = کار(په_قلف_ورزیاته)
ه.راته_ودرېږه()
و.راته_ودرېږه()
کرښه چاپ("  وشمېرل شول "، ټولټال، " له ۱۰۰۰؛ بدلونونه ورک شول: "، ټولټال < ۱۰۰۰)

# --- ۴. خبرې: کانال له یوه کاره بل ته ارزښتونه وړي ----------------------------------
#
# ولېږه() هغه وخت انتظار باسي چې کانال ډک وي، او واخله() هغه وخت چې تش وي، نو چټک
# جوړوونکی له ورو کاروونکي مخته نشي تښتېدای. وتړه() وايي چې نور څه نه راځي.
متغیر چارې: کانال<متن> = کانال(۲)
متغیر ترسره: متن[] = []

دنده کارګر()
    ترڅو چارې.بل_شته()
        ورزیات کړه(ترسره، کارونه.نوم(کارونه.اوسنی()) + " " + چارې.واخله() + " وکړ")

کرښه چاپ("۴. یو جوړوونکی، دوه کاروونکي، د دوو کانال:")
متغیر لومړی = کار(کارګر)
متغیر دوهم = کار(کارګر)
تکرار ن په واټن(۱، ۶)
    چارې.ولېږه("چار " + متن کړه(ن))
چارې.وتړه()
لومړی.راته_ودرېږه()
دوهم.راته_ودرېږه()
کرښه چاپ("  "، متن.یو ځای کړه(ترسره، "؛ "))

# --- ۵. د وخت انتظار ------------------------------------------------------------------
#
# هغه کار چې بیده شي خپله وارۍ پرېږدي؛ نور مخته ځي. کله چې ټول کارونه یوازې د وخت
# انتظار باسي، ماشین پخپله بیده کېږي، نو پروګرام هیڅ پروسېسر نه کاروي.
کرښه چاپ("۵. بیده کار نور نه دروي:")
متغیر ترتیب: متن[] = []
متغیر بیده_کېدونکی = دنده()
    کارونه.بیده شه(۱۰)
    ورزیات کړه(ترتیب، "بیده کار راویښ شو")
متغیر وروسته = کار(بیده_کېدونکی)
ورزیات کړه(ترتیب، "د پروګرام پاتې برخه مخته ولاړه")
وروسته.راته_ودرېږه()
کرښه چاپ("  "، متن.یو ځای کړه(ترتیب، "، او بیا "))

# پروګرام هغه وخت پای ته رسېږي چې ټول کارونه پای ته ورسېږي - نه کله چې دلته وروستۍ کرښه ورسېږي.
کرښه چاپ("هر کار پای ته ورسېد؛ پروګرام هم.")
