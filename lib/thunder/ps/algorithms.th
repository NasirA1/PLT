# ژبه: ps
# algorithms.th (lib/thunder/ps) - د ترتیب او لټون کلاسیک الګوریتمونه، پخپله په تندر کې
# لیکل شوي (docs/ps/algorithms.md)
#
# راوړه "algorithms" ولیکئ او ټولې لاندې دندې ستاسې دي. دلته هېڅ بهرنی نشته: دا ساده
# تندر دی، د لوستلو لپاره لیکل شوی - دا فایل پرانیزئ او وګورئ چې هغه الګوریتمونه چې هره
# ژبه یې لري رښتیا څنګه کار کوي. (د ورځنۍ کارونې لپاره تندر دننۍ دنده ترتیب کړه() لري؛
# دلته لیکل شوي دي چې داسې دنده دننه څه کوي.)
#
# هره دنده عمومي (generic) ده: پر هره ت[] کار کوي چې توکي یې د < سره پرتله کېږي -
# عددونه یا متنونه. ترتیب پر خپل ځای، په پورته کېدونکي ترتیب دی. لټونونه د ارزښت ځای
# (شاخص) راګرځوي، یا -۱ کله چې نه وي.

# ---------------------------------------------------------------- ترتیب

# حبابي ترتیب، O(n²): لړۍ بیا بیا جارو کړه او هغه ګاونډیان چې ترتیب یې ناسم وي بدل
# کړه. له هر جارو وروسته تر ټولو لوی ارزښت خپل وروستي ځای ته «راپورته» شوی وي؛ جارو
# چې هېڅ نه بدلوي مانا لړۍ ترتیب شوې ده.
دنده حبابي_ترتیب<ت>(ارزښتونه: ت[])
    متغیر ناترتیب = اوږدوالی(ارزښتونه)
    ترڅو ناترتیب > ۱
        متغیر بدل_شو = درواغ
        تکرار متغیر ش = ۱، ش < ناترتیب، ش = ش + ۱
            که ارزښتونه[ش - ۱] > ارزښتونه[ش]
                متغیر ساتلی = ارزښتونه[ش - ۱]
                ارزښتونه[ش - ۱] = ارزښتونه[ش]
                ارزښتونه[ش] = ساتلی
                بدل_شو = رښتیا
        که نه بدل_شو
            راګرځه
        ناترتیب = ناترتیب - ۱

# غوراوی ترتیب، O(n²): د ناترتیب پاتې برخې کمینه ومومه او مخ ته یې بدله کړه، بیا
# پاتې برخه همداسې. ساده دی، او هر ارزښت تر یوه ځله زیات نه خوځوي.
دنده غوراوی_ترتیب<ت>(ارزښتونه: ت[])
    تکرار متغیر پیل = ۰، پیل < اوږدوالی(ارزښتونه) - ۱، پیل = پیل + ۱
        متغیر کوچنی = پیل
        تکرار متغیر ش = پیل + ۱، ش < اوږدوالی(ارزښتونه)، ش = ش + ۱
            که ارزښتونه[ش] < ارزښتونه[کوچنی]
                کوچنی = ش
        که کوچنی != پیل
            متغیر ساتلی = ارزښتونه[پیل]
            ارزښتونه[پیل] = ارزښتونه[کوچنی]
            ارزښتونه[کوچنی] = ساتلی

# ننویستل ترتیب، O(n²) خو نږدې ترتیب شوې ننوتنه O(n): بل ارزښت واخله او له هر لوی
# ارزښته یې کیڼ لور ته وښویوه - لکه ډېری خلک چې د پتو پاڼې اڼي.
دنده ننویستل_ترتیب<ت>(ارزښتونه: ت[])
    تکرار متغیر ش = ۱، ش < اوږدوالی(ارزښتونه)، ش = ش + ۱
        متغیر ارزښت = ارزښتونه[ش]
        متغیر ځای = ش
        ترڅو ځای > ۰ او ارزښتونه[ځای - ۱] > ارزښت
            ارزښتونه[ځای] = ارزښتونه[ځای - ۱]
            ځای = ځای - ۱
        ارزښتونه[ځای] = ارزښت

# چټک ترتیب (quicksort)، په منځني ډول O(n log n): یو محور وټاکه، سیمه پر دوو برخو
# ووېشه - له محوره کوچني او له محوره لوی - بیا دواړې خواوې ترتیب کړه: ووېشه او وګټه.
دنده چټک_ترتیب<ت>(ارزښتونه: ت[])
    _چټک_ترتیب_سیمه(ارزښتونه، ۰، اوږدوالی(ارزښتونه) - ۱)

دنده _چټک_ترتیب_سیمه<ت>(ارزښتونه: ت[]، ښکته: عدد، پورته: عدد)
    که ښکته >= پورته
        راګرځه
    # وېش د منځني توکي پر شاوخوا (Hoare)، چې ترتیب شوې ننوتنه هم O(n log n) پاتې کېږي.
    متغیر محور = ارزښتونه[(ښکته + پورته) / ۲]
    متغیر ش = ښکته
    متغیر ص = پورته
    ترڅو ش <= ص
        ترڅو ارزښتونه[ش] < محور
            ش = ش + ۱
        ترڅو ارزښتونه[ص] > محور
            ص = ص - ۱
        که ش <= ص
            متغیر ساتلی = ارزښتونه[ش]
            ارزښتونه[ش] = ارزښتونه[ص]
            ارزښتونه[ص] = ساتلی
            ش = ش + ۱
            ص = ص - ۱
    _چټک_ترتیب_سیمه(ارزښتونه، ښکته، ص)
    _چټک_ترتیب_سیمه(ارزښتونه، ش، پورته)

# ګډولو ترتیب (merge sort)، همېش O(n log n): هره نیمایي ترتیب کړه، بیا دواړه ترتیب
# شوې نیمایي سره ګډې کړه - هر ځل د مخې کوچنی ارزښت اخلې. ډاډمن، د مرستندویه ځای په بیه.
دنده ګډولو_ترتیب<ت>(ارزښتونه: ت[])
    که اوږدوالی(ارزښتونه) < ۲
        راګرځه
    متغیر منځ = اوږدوالی(ارزښتونه) / ۲
    متغیر کیڼه = ټوټه(ارزښتونه، ۰، منځ)
    متغیر ښۍ = ټوټه(ارزښتونه، منځ، اوږدوالی(ارزښتونه))
    ګډولو_ترتیب(کیڼه)
    ګډولو_ترتیب(ښۍ)
    متغیر ش = ۰
    متغیر ص = ۰
    تکرار متغیر ځای = ۰، ځای < اوږدوالی(ارزښتونه)، ځای = ځای + ۱
        که ص >= اوږدوالی(ښۍ) یا (ش < اوږدوالی(کیڼه) او کیڼه[ش] <= ښۍ[ص])
            ارزښتونه[ځای] = کیڼه[ش]
            ش = ش + ۱
        کنه
            ارزښتونه[ځای] = ښۍ[ص]
            ص = ص + ۱

# ---------------------------------------------------------------- لټون

# پرله پسې لټون، O(n): هر ارزښت وګوره ترڅو همغه وي. پر هره لړۍ کار کوي.
دنده پرله_پسې_لټون<ت>(ارزښتونه: ت[]، غوښتل_شوی: ت): عدد
    تکرار متغیر ش = ۰، ش < اوږدوالی(ارزښتونه)، ش = ش + ۱
        که ارزښتونه[ش] == غوښتل_شوی
            راګرځه ش
    راګرځه -۱

# نیمایي (دوه‌اړخیز) لټون، O(log n): لړۍ باید ترتیب شوې وي. له منځني سره یې پرتله
# کړه، بیا یوازې هغه نیمایي ولټوه چې ارزښت لا پکې کېدای شي.
دنده نیمایي_لټون<ت>(ارزښتونه: ت[]، غوښتل_شوی: ت): عدد
    متغیر ښکته = ۰
    متغیر پورته = اوږدوالی(ارزښتونه) - ۱
    ترڅو ښکته <= پورته
        متغیر منځ = (ښکته + پورته) / ۲
        که ارزښتونه[منځ] == غوښتل_شوی
            راګرځه منځ
        که ارزښتونه[منځ] < غوښتل_شوی
            ښکته = منځ + ۱
        کنه
            پورته = منځ - ۱
    راګرځه -۱

# ---------------------------------------------------------------- مرستندویې

# رښتیا که لړۍ په پورته کېدونکي ترتیب وي (مساوي ګاونډیان روا دي).
دنده ترتیب_شوې_ده<ت>(ارزښتونه: ت[]): منطقي
    تکرار متغیر ش = ۱، ش < اوږدوالی(ارزښتونه)، ش = ش + ۱
        که ارزښتونه[ش - ۱] > ارزښتونه[ش]
            راګرځه درواغ
    راګرځه رښتیا

# د تر ټولو کوچني ارزښت ځای (د تشې لړۍ لپاره -۱).
دنده د_کمینې_ځای<ت>(ارزښتونه: ت[]): عدد
    که اوږدوالی(ارزښتونه) == ۰
        راګرځه -۱
    متغیر کوچنی = ۰
    تکرار متغیر ش = ۱، ش < اوږدوالی(ارزښتونه)، ش = ش + ۱
        که ارزښتونه[ش] < ارزښتونه[کوچنی]
            کوچنی = ش
    راګرځه کوچنی

# ارزښتونه په تصادفي ترتیب اڼي (Fisher-Yates): له پایه راروان شه، هر توکی له یوه
# تصادفي توکي سره چې په همغه ځای یا تر هغه مخکې وي بدلوه. تصادفي بنسټ() ترتیب تکرارېدونکی کوي.
دنده ګډوډه_کړه<ت>(ارزښتونه: ت[])
    تکرار متغیر ش = اوږدوالی(ارزښتونه) - ۱، ش > ۰، ش = ش - ۱
        متغیر ص = تصادفي عدد(۰، ش)
        متغیر ساتلی = ارزښتونه[ش]
        ارزښتونه[ش] = ارزښتونه[ص]
        ارزښتونه[ص] = ساتلی

# ---------------------------------------------------------------- متن

# د متن لټون، O(n*m): نمونه د متن په اوږدو وښویوه او توری په توري یې پرتله کړه - هغه
# څه چې دننۍ ځای یې() د متنونو لپاره کوي، دلته لیکل شوي. د لومړي پیدا کېدو ځای
# راګرځوي، یا -۱؛ تشه نمونه په ۰ کې موندل کېږي.
دنده د_متن_لټون(متن_: متن، نمونه: متن): عدد
    که اوږدوالی(نمونه) > اوږدوالی(متن_)
        راګرځه -۱
    تکرار متغیر پیل = ۰، پیل <= اوږدوالی(متن_) - اوږدوالی(نمونه)، پیل = پیل + ۱
        متغیر سمون = رښتیا
        تکرار متغیر ش = ۰، ش < اوږدوالی(نمونه)، ش = ش + ۱
            که د متن برخه(متن_، پیل + ش، پیل + ش + ۱) != د متن برخه(نمونه، ش، ش + ۱)
                سمون = درواغ
                ودرېږه
        که سمون
            راګرځه پیل
    راګرځه -۱

# هر هغه ځای چې نمونه پکې پیلېږي، یو پر بل پراته پیدا کېدل هم پکې دي
# (د_متن_ټول_ځایونه("aaaa"، "aa") = [۰، ۱، ۲]). تشه نمونه هېڅ نه مومي.
دنده د_متن_ټول_ځایونه(متن_: متن، نمونه: متن): عدد[]
    متغیر پایله: عدد[] = []
    که اوږدوالی(نمونه) == ۰ یا اوږدوالی(نمونه) > اوږدوالی(متن_)
        راګرځه پایله
    تکرار متغیر پیل = ۰، پیل <= اوږدوالی(متن_) - اوږدوالی(نمونه)، پیل = پیل + ۱
        که د متن برخه(متن_، پیل، پیل + اوږدوالی(نمونه)) == نمونه
            ورزیات کړه(پایله، پیل)
    راګرځه پایله

# رښتیا که متن سرچپه هم همغه لوستل کېږي ("level"، "۱۲۳۲۱"). توري او تشې حسابېږي.
دنده سرچپه_ورته_ده(متن_: متن): منطقي
    متغیر کیڼ = ۰
    متغیر ښی = اوږدوالی(متن_) - ۱
    ترڅو کیڼ < ښی
        که د متن برخه(متن_، کیڼ، کیڼ + ۱) != د متن برخه(متن_، ښی، ښی + ۱)
            راګرځه درواغ
        کیڼ = کیڼ + ۱
        ښی = ښی - ۱
    راګرځه رښتیا

# تر ټولو اوږد مختاړی چې ټول وییونه یې شریکوي ("" کله چې هېڅ نه شریکوي یا لړۍ تشه وي).
دنده تر_ټولو_اوږد_ګډ_مختاړی(وییونه: متن[]): متن
    که اوږدوالی(وییونه) == ۰
        راګرځه ""
    متغیر مختاړی = وییونه[۰]
    تکرار متغیر ش = ۱، ش < اوږدوالی(وییونه)، ش = ش + ۱
        متغیر ویی = وییونه[ش]
        متغیر شریک = ۰
        ترڅو شریک < اوږدوالی(مختاړی) او شریک < اوږدوالی(ویی)
            که د متن برخه(مختاړی، شریک، شریک + ۱) != د متن برخه(ویی، شریک، شریک + ۱)
                ودرېږه
            شریک = شریک + ۱
        مختاړی = د متن برخه(مختاړی، ۰، شریک)
        که اوږدوالی(مختاړی) == ۰
            راګرځه مختاړی
    راګرځه مختاړی

# د بدلون واټن (Levenshtein): څومره یو-توریز ننویستل، لیرې کول او بدلول یو متن بل ته
# اړوي. متحرک پروګرامول، کتار په کتار: کتار[ص] د الف د لومړیو ش تورو او د ب د لومړیو
# ص تورو تر منځ واټن دی.
دنده د_بدلون_واټن(الف_: متن، ب_: متن): عدد
    متغیر کتار: عدد[] = []
    تکرار متغیر ص = ۰، ص <= اوږدوالی(ب_)، ص = ص + ۱
        ورزیات کړه(کتار، ص)
    تکرار متغیر ش = ۱، ش <= اوږدوالی(الف_)، ش = ش + ۱
        متغیر مخکېنی_اریب = کتار[۰]
        کتار[۰] = ش
        تکرار متغیر ص = ۱، ص <= اوږدوالی(ب_)، ص = ص + ۱
            متغیر بیه = ۱
            که د متن برخه(الف_، ش - ۱، ش) == د متن برخه(ب_، ص - ۱، ص)
                بیه = ۰
            متغیر بدل_شوی = مخکېنی_اریب + بیه
            متغیر لیرې_شوی = کتار[ص] + ۱
            متغیر ننویستل_شوی = کتار[ص - ۱] + ۱
            مخکېنی_اریب = کتار[ص]
            کتار[ص] = کمینه(بدل_شوی، کمینه(لیرې_شوی، ننویستل_شوی))
    راګرځه کتار[اوږدوالی(ب_)]
