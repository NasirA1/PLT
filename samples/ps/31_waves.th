# ژبه: ps
# ۳۱ - جیب، تتمیم جیب او ظل (حرکت)
#
# د انځور کښلو دندې اعشاري شمېرې مني، نو یو ټکی کولای شي په
# جیب(زاویه) * ۸۰ کې کېني، پرته له دې چې مخکې بشپړ عدد شي. دا پروګرام درې
# مثلثاتي دندې کاږي او په هر چوکاټ کې یې یو ګام کیڼ خوا ته بیايي.
#
# زاویه په رادیانو ده: یوه بشپړه ګرځېدنه ۲ * پای ده، نیمه ګرځېدنه پای ده.
# جیب او تتمیم جیب تل له -۱ تر ۱ وي؛ ظل د څلورمې ګرځېدنې نیژدې بې‌پایه ته ځي،
# نو په لنډو ټوټو کښل کېږي او پرې کېږي.
#
# هڅه وکړه: «چلول» کښېکښه. «چټکتیا» بدله کړه چې څپې ژر وګرځي، یا «څپې» چې
# په ټاټ کې ډېرې څپې ځای شي.

راوړه ګرافیک

ثابت پلنوالی = ۴۸۰
ثابت لوړوالی = ۳۲۰
ثابت منځ = لوړوالی / ۲٫۰        # ۱۶۰٫۰ - اعشاري وېش، نه ۱۶۰
ثابت لوړه = ۱۱۰٫۰
ثابت څپې = ۲٫۰                  # څو بشپړې ګرځېدنې په ټاټ کې ځای شي
ثابت چټکتیا = ۰٫۰۸              # په هر چوکاټ کې څومره رادیان ښوېږي

ګرافیک.ټاټ(پلنوالی، لوړوالی)
ګرافیک.د لیکنې اندازه(۱۳)

# هغه زاویه، په رادیانو، چې د پکسلونو ستن س یې ښيي.
دنده زاویه_په(س: اعشاري، پړاو: اعشاري): اعشاري
    راګرځه س / پلنوالی * څپې * ۲٫۰ * ریاضي.پای() + پړاو

# یوه کږه، چې په هره څلورمه ستن کې له یو ټکي څخه د لیکې په بڼه کښل کېږي.
دنده وکاږه(پړاو: اعشاري، پیمانه: اعشاري، رنګ: متن، ډول: عدد)
    متغیر پخوانی_ص = ۰٫۰
    متغیر تشه = رښتیا
    تکرار متغیر س = ۰، س <= پلنوالی، س = س + ۴
        متغیر زاویه = زاویه_په(س، پړاو)
        متغیر ارزښت = ریاضي.جیب(زاویه)
        که ډول == ۱
            ارزښت = ریاضي.تتمیم جیب(زاویه)
        که ډول == ۲
            ارزښت = ریاضي.ظل(زاویه)
        متغیر ص = منځ - ارزښت * پیمانه
        # ظل د څلورمې ګرځېدنې نیژدې له ټاټه وځي: د څوکې پر ځای تشه پرېږده.
        که ریاضي.مطلق(ارزښت) > ۱٫۴
            تشه = رښتیا
        کنه
            که نه تشه
                ګرافیک.لیکه(س - ۴، پخوانی_ص، س، ص، رنګ)
            پخوانی_ص = ص
            تشه = درواغ

متغیر پړاو = ۰٫۰
ترڅو رښتیا
    ګرافیک.ټاټ پاک کړه("#101828")

    # محورونه او د -۱ / +۱ لارښود لیکې.
    ګرافیک.د لیکې پلنوالی(۱٫۰)
    ګرافیک.لیکه(۰، منځ، پلنوالی، منځ، "#55607a")
    ګرافیک.لیکه(۰، منځ - لوړه، پلنوالی، منځ - لوړه، "#2b344a")
    ګرافیک.لیکه(۰، منځ + لوړه، پلنوالی، منځ + لوړه، "#2b344a")

    ګرافیک.د لیکې پلنوالی(۲٫۵)
    وکاږه(پړاو، لوړه، "#4cc9f0"، ۰)        # جیب
    وکاږه(پړاو، لوړه، "#f7b801"، ۱)        # تتمیم جیب
    ګرافیک.د لیکې پلنوالی(۱٫۵)
    وکاږه(پړاو، لوړه، "#f55d3e"، ۲)        # ظل

    # یو ټکی چې د واحدې دایرې پر شاوخوا ګرځي، ښيي چې زاویه اوس چېرته ده.
    ثابت مس = ۶۰٫۰
    ثابت مص = ۶۰٫۰
    ثابت و = ۳۴٫۰
    ګرافیک.د دایرې څنډه(مس، مص، و، "#55607a")
    ګرافیک.لیکه(مس، مص، مس + ریاضي.تتمیم جیب(پړاو) * و، مص - ریاضي.جیب(پړاو) * و، "#f7b801")
    ګرافیک.دایره(مس + ریاضي.تتمیم جیب(پړاو) * و، مص - ریاضي.جیب(پړاو) * و، ۴٫۵، "#4cc9f0")

    ګرافیک.لیکنه(پلنوالی - ۱۵۰، ۱۰، "جیب"، "#4cc9f0")
    ګرافیک.لیکنه(پلنوالی - ۱۱۰، ۱۰، "تتمیم جیب"، "#f7b801")
    ګرافیک.لیکنه(پلنوالی - ۴۰، ۱۰، "ظل"، "#f55d3e")
    ګرافیک.لیکنه(۱۰، لوړوالی - ۲۲، "زاویه " + متن کړه(ریاضي.نیژدې کړه(پړاو / ریاضي.پای() * ۱۸۰٫۰) % ۳۶۰) + " درجې"، "#c9d1e4")
    ګرافیک.چوکاټ()

    پړاو = پړاو + چټکتیا
