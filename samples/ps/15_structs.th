# ژبه: ps
# ۱۵ - جوړښتونه
#
# «جوړښت» نوی ډول تعریفوي چې نوم لرونکې برخې لري. ارزښت یې د جوړښت د نوم
# په بللو جوړېږي، یا برخې په ترتیب ورکول کېږي یا په نوم.
#
# متن کړه() او کرښه چاپ جوړښت په یوه کرښه کې ښيي؛ کتنه() بشپړ بیان
# راګرځوي، او وښایه() یې چاپوي.

جوړښت ټکی
    س: عدد
    ص: عدد

جوړښت مستطیل
    کونج: ټکی
    پلنوالی: عدد
    لوړوالی: عدد
    نوم: متن

دنده مساحت(م: مستطیل): عدد
    راګرځه م.پلنوالی * م.لوړوالی

دنده دننه_دی(م: مستطیل، ټ: ټکی): منطقي
    راګرځه ټ.س >= م.کونج.س او ټ.س < م.کونج.س + م.پلنوالی او
        ټ.ص >= م.کونج.ص او ټ.ص < م.کونج.ص + م.لوړوالی

متغیر مبدا = ټکی(۰، ۰)                    # برخې په ترتیب
متغیر هدف = ټکی(ص: ۳، س: ۷)              # یا په نوم، په هر ترتیب
متغیر کوټه = مستطیل(کونج: مبدا، پلنوالی: ۱۰، لوړوالی: ۴، نوم: "پخلنځی")

کرښه چاپ("هدف = "، هدف)
کرښه چاپ("کوټه = "، کوټه)
کرښه چاپ("د "، کوټه.نوم، " مساحت = "، مساحت(کوټه))
کرښه چاپ("ایا هدف دننه دی؟ "، دننه_دی(کوټه، هدف))

کوټه.پلنوالی = ۵                          # برخې بدلېدای شي
کرښه چاپ("تر کوچني کېدو وروسته: دننه دی؟ "، دننه_دی(کوټه، هدف))

متغیر بې_نومه = مستطیل(پلنوالی: ۲، لوړوالی: ۲)
کرښه چاپ("بې نومه: "، بې_نومه)

متغیر بیان = کتنه(هدف)
کرښه چاپ("کتنه(هدف) "، اوږدوالی(بیان)، " توري لري")
وښایه(کوټه)
