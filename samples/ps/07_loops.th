// ژبه: ps
// ۰۷ - تکرار: ترڅو او لپاره
//
// «ترڅو» خپله برخه تر هغه تکراروي چې شرط رښتیا وي. «لپاره» د یو شمېرونکي
// سره تکرار دی: (پیل؛ شرط؛ ګام). «ودرېږه» تکرار ختموي او «دوام» راتلونکي
// ګام ته ځي.
//
// هڅه وکړئ: «ډیبګ» کېکاږئ او ګام په ګام لاړ شئ؛ د VM پاڼه کې د i بدلون وګورئ.

متغیر n = ۲۷
متغیر ګامونه = ۰
ترڅو n != ۱
    که n % ۲ == ۰
        n = n / ۲
    کنه
        n = ۳ * n + ۱
    ګامونه = ګامونه + ۱
کرښه چاپ("۲۷ په ", ګامونه, " ګامونو کې ۱ ته رسېږي")

// د ضرب کوچنی جدول
لپاره متغیر قطار = ۱; قطار <= ۴; قطار = قطار + ۱
    متغیر کرښه = ""
    لپاره متغیر ستون = ۱; ستون <= ۴; ستون = ستون + ۱
        که ستون == ۳ && قطار == ۳
            کرښه = کرښه + " * "
            دوام
        کرښه = کرښه + " " + متن کړه(قطار * ستون)
    کرښه چاپ(کرښه)
