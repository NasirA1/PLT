# ژبه: ps
# ۱۷ - بیټونه: شپاړس‌بنسټیز، دوه‌بنسټیز او بیټي عملګر
#
# بشپړ عدد د ۶۴ بیټونو یوه کرښه ده. په دوه‌بنسټیز (0b...) یا شپاړس‌بنسټیز (0x...،
# هر رقم څلور بیټه) لیکل هغه بیټونه ښيي، او بیټي عملګر یو په یو پرې کار کوي:
#     &  AND   ۱ چېرې چې دواړه ۱ لري        |  OR    ۱ چېرې چې یو یې ۱ لري
#     ^  XOR   ۱ چېرې چې توپیر لري            ~  NOT   هر بیټ اړول شوی
#     << >>    بیټونه کیڼ یا ښي ته ښويوي (<< په ۲ ضربوي، >> وېشي)
# د پرتلو نه لوړ لومړیتوب لري، نو  بیرغونه & نقاب != ۰  یعنې  (بیرغونه & نقاب) != ۰.
#
# هڅه وکړئ: د «بیټونه» پاڼه (د پردې شاته) پرانیزئ، ۱۲ او ۱۰ ولیکئ او هر عملګر
# وګورئ. بیا د «بایټ کوډ» پاڼه: هر عملګر یوه لارښوونه ده.

کرښه چاپ(0b1100، " "، 0x0C، " "، ۱۲)          # د دولسو درې لیکنې
کرښه چاپ(۱۲ & ۱۰، " "، ۱۲ | ۱۰، " "، ۱۲ ^ ۱۰)  # ۸ ۱۴ ۶
کرښه چاپ(~۰، " "، ~۱۲)                         # -۱ -۱۳: ~الف د -الف - ۱ دی

# ښويېدنې: هر ګام کیڼ ته دوه‌چنده کوي، هر ګام ښي ته نیمايي (نښه ساتي).
کرښه چاپ(۱ << ۴، " "، 0b1000 >> ۳، " "، -۱۶ >> ۲)

# بیرغونه: هرې ترتیبونې ته یو بیټ، ټول په یوه عدد کې.
ثابت پنډ = 0b001
ثابت کږ = 0b010
ثابت کرښه_لاندې = 0b100
متغیر بڼه = پنډ | کرښه_لاندې                   # دوه بیرغونه روښانه کړه
کرښه چاپ("پنډ؟ "، بڼه & پنډ != ۰، "  کږ؟ "، بڼه & کږ != ۰)
بڼه = بڼه & ~پنډ                               # یو بېرته مړ کړه
کرښه چاپ("پنډ؟ "، بڼه & پنډ != ۰، "  د بیټونو په بڼه: "، بڼه)

# نقابونه د عدد یوه برخه راباسي: د رنګ ټیټ بایټ، د بېلګې په توګه. بڼه کړه() د
# {x} او {b} ځای ناستو سره - او شپاړسیز کړه() او دوه ییز کړه() اړونې - بیټونه ښيي.
متغیر رنګ_یې = 0x336699
کرښه چاپ(متن.بڼه کړه("سور {} شین {} شین {}"، رنګ_یې >> ۱۶ & 0xFF، رنګ_یې >> ۸ & 0xFF، رنګ_یې & 0xFF))
کرښه چاپ(متن.بڼه کړه("بڼه {b} = {} = {x}"، بڼه، بڼه، بڼه))
کرښه چاپ(شپاړسیز کړه(۲۵۵)، " "، دوه ییز کړه(۵)، " "، عدد کړه("0x2a")، " "، عدد کړه(دوه ییز کړه(۴۲)))

# د یوه عدد د ۱ بیټونو شمېرل، په لاس.
دنده بیټونه_وشمېره(ن: عدد): عدد
    متغیر شمېر = ۰
    ترڅو ن != ۰
        شمېر = شمېر + (ن & ۱)
        ن = ن >> ۱
    راګرځه شمېر
کرښه چاپ("0b101101 "، بیټونه_وشمېره(0b101101)، " روښانه بیټونه لري؛ 0xFF "، بیټونه_وشمېره(0xFF))

# بایټونه: بایټ د عدد له اتو-بیټه ټوټو یوه ده، له ۰ تر ۲۵۵، او بایټ[] خامه ډېټا ده - د
# انځور، غږ یا د شبکې د بستې منځپانګه. بایټ پخپله عدد ته پراخېږي، نو بیټي عملګر پرې کار
# کوي؛ بایټ کړه(ن) د عدد ټیټ ۸ بیټونه ساتي.
متغیر بسته: بایټ[] = [0x48، 0x69، 0xFF، ۰]       # له ۰ تر ۲۵۵ بشپړ عددونه دلته بایټونه دي
کرښه چاپ(بسته، " "، اوږدوالی(بسته)، " بایټه، "، متن.بڼه کړه("{x}"، بسته[۲])، " "، بسته[۲] & 0x0F، " "، بایټ کړه(۳۰۰))
بسته[۳] = بایټ کړه(بسته[۰] + بسته[۱])            # مجموعه عدد دی: بایټ کړه یې بېرته کمه کوي
کرښه چاپ(بایټونه.متن کړه(ټوټه(بسته، ۰، ۲))، " "، بایټونه.له متنه("Hi")، " "، بایټونه.له متنه("ژ"))

# څو-بایټه عددونه په فایلونو کې په ثابت ترتیب ساتل کېږي: کوچنی-پای (ټیټ بایټ لومړی، لکه
# په WAV، BMP او ډېرو CPU-ګانو کې) یا لوی-پای (لکه په شبکه کې). عدد بایټونه کړه او
# بایټونه عدد کړه په دواړو ترتیبونو اړوي، له علامې سره یا پرته.
متغیر نمونه_چټکتیا = بایټونه.له عدده(۴۴۱۰۰، ۴، رښتیا)   # څلور بایټه، ټیټ لومړی: د WAV سرلیک برخه
کرښه چاپ(نمونه_چټکتیا، " -> "، بایټونه.عدد کړه(نمونه_چټکتیا، ۰، ۴، رښتیا، درواغ))
متغیر کچه = بایټونه.له عدده(-۲، ۲، رښتیا)            # ۱۶-بیټه علامه لرونکې نمونه، لکه په غږیزه ډېټا کې
کرښه چاپ(کچه، " علامه لرونکی "، بایټونه.عدد کړه(کچه، ۰، ۲، رښتیا، رښتیا)، " بې علامې "، بایټونه.عدد کړه(کچه، ۰، ۲، رښتیا، درواغ))
متغیر چک: بایټ = ۰
تکرار ب په بسته
    چک = بایټ کړه(چک ^ ب)                          # هر بایټ سره XOR کړه
کرښه چاپ("چک "، شپاړسیز کړه(چک))
