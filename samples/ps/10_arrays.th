// ژبه: ps
// ۱۰ - لړۍ
//
// لړۍ د یو ډول ارزښتونه ساتي، لکه عدد[] یا متن[]. هغه په [۱، ۲، ۳] یا
// لړۍ(ن، ارزښت) جوړېږي. اوږدوالی(لړ) یې د توکو شمېر دی، او لړ[ش] د ش ځای
// توکی لولي یا لیکي (شمېرنه له ۰ پیلېږي).
//
// لړۍ ماخذونه دي: که لړۍ بل متغیر ته ورکړئ یا دندې ته یې ولېږئ، همغه لړۍ
// شریکېږي، نه کاپي کېږي.

متغیر لومړني = [۲، ۳، ۵، ۷، ۱۱]
کرښه چاپ("لومړني عددونه: "، لومړني، " ("، اوږدوالی(لومړني)، " توکي)")
کرښه چاپ("لومړی: "، لومړني[۰]، "، وروستی: "، لومړني[اوږدوالی(لومړني) - ۱])

متغیر ټول = ۰
لپاره متغیر ش = ۰، ش < اوږدوالی(لومړني)، ش = ش + ۱
    ټول = ټول + لومړني[ش]
کرښه چاپ("مجموعه: "، ټول)

// لړۍ(ن، ارزښت) د ارزښت ن کاپيانې جوړوي.
متغیر مربعګانې = لړۍ(۶، ۰)
لپاره متغیر ش = ۰، ش < اوږدوالی(مربعګانې)، ش = ش + ۱
    مربعګانې[ش] = ش * ش
کرښه چاپ("مربعګانې: "، مربعګانې)

// لړۍ په ماخذ شریکېږي.
دنده ټول_دوه_چنده(ارزښتونه_یې: عدد[])
    لپاره متغیر ش = ۰، ش < اوږدوالی(ارزښتونه_یې)، ش = ش + ۱
        ارزښتونه_یې[ش] = ارزښتونه_یې[ش] * ۲
متغیر بل_نوم = مربعګانې
ټول_دوه_چنده(بل_نوم)
کرښه چاپ("له ټول_دوه_چنده وروسته: "، مربعګانې)

// تشه لړۍ د ډول ښودنې ته اړتیا لري، ترڅو جوړونکی د توکو ډول وپېژني.
متغیر نومونه: متن[] = []
کرښه چاپ("نومونه: "، نومونه، "، اوږدوالی "، اوږدوالی(نومونه))

متغیر کلمې = ["تندر"، "او"، "برېښنا"]
کرښه چاپ(کلمې)
