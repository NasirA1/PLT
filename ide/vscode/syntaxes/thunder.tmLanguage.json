{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Thunder",
  "scopeName": "source.thunder",
  "information_for_contributors": [
    "Generated by ide/vscode/tools/generate_assets.py from thunderc --language-info.",
    "Do not edit by hand: edit the language pack (src/core/language_*.cpp) and run the generator."
  ],
  "patterns": [
    {
      "include": "#language-directive"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#import"
    },
    {
      "include": "#type-annotation"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#call"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "language-directive": {
      "match": "\\A\\s*(//)\\s*(lang|ژبه)\\s*(:)\\s*(\\w+)\\s*$",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.thunder"
        },
        "2": {
          "name": "keyword.control.directive.thunder"
        },
        "3": {
          "name": "punctuation.separator.key-value.thunder"
        },
        "4": {
          "name": "constant.language.thunder"
        }
      }
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.thunder",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.thunder"
            }
          }
        },
        {
          "name": "comment.block.thunder",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.thunder"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.thunder"
            }
          }
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.thunder",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "name": "string.quoted.other.guillemet.thunder",
          "begin": "«",
          "end": "»|$",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "name": "string.quoted.other.curly.thunder",
          "begin": "[“„]",
          "end": "[”“]|$",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.thunder",
      "match": "\\\\."
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.thunder",
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])0[xX](?:[0-9a-fA-F]|[0123456789۰۱۲۳۴۵۶۷۸۹])+(?![[:word:]\\p{L}\\p{M}\\p{Nd}_])"
        },
        {
          "name": "constant.numeric.binary.thunder",
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])0[bB](?:[01]|[0123456789۰۱۲۳۴۵۶۷۸۹])+(?![[:word:]\\p{L}\\p{M}\\p{Nd}_])"
        },
        {
          "name": "constant.numeric.decimal.thunder",
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(?:[0-9]|[0123456789۰۱۲۳۴۵۶۷۸۹])+(?:[.٫](?:[0-9]|[0123456789۰۱۲۳۴۵۶۷۸۹])+)?(?![[:word:]\\p{L}\\p{M}\\p{Nd}_])"
        }
      ]
    },
    "declaration": {
      "patterns": [
        {
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(func|دنده)\\s+([[:word:]\\p{L}\\p{M}\\p{Nd}_]+)",
          "captures": {
            "1": {
              "name": "storage.type.function.thunder"
            },
            "2": {
              "name": "entity.name.function.thunder"
            }
          }
        },
        {
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(struct|جوړښت)\\s+([[:word:]\\p{L}\\p{M}\\p{Nd}_]+)",
          "captures": {
            "1": {
              "name": "storage.type.struct.thunder"
            },
            "2": {
              "name": "entity.name.type.struct.thunder"
            }
          }
        },
        {
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(const|متغیر|ثابت|var)\\s+([[:word:]\\p{L}\\p{M}\\p{Nd}_]+)",
          "captures": {
            "1": {
              "name": "storage.type.thunder"
            },
            "2": {
              "name": "variable.other.declaration.thunder"
            }
          }
        }
      ]
    },
    "import": {
      "patterns": [
        {
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(import|راوړه)\\s+(native|بهرنی)?",
          "captures": {
            "1": {
              "name": "keyword.control.import.thunder"
            },
            "2": {
              "name": "keyword.control.import.thunder"
            }
          }
        }
      ]
    },
    "type-annotation": {
      "match": "(:)\\s*(string|اعشاري|float|منطقي|bool|int|عدد|متن|[[:alpha:]\\p{L}][[:word:]\\p{L}\\p{M}\\p{Nd}_]*)",
      "captures": {
        "1": {
          "name": "punctuation.separator.type.thunder"
        },
        "2": {
          "name": "storage.type.thunder"
        }
      }
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.operator.word.thunder",
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(?:and|not|or|او|نه|یا)(?![[:word:]\\p{L}\\p{M}\\p{Nd}_])"
        },
        {
          "name": "constant.language.thunder",
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(?:false|درواغ|رښتیا|true|دروغ)(?![[:word:]\\p{L}\\p{M}\\p{Nd}_])"
        },
        {
          "name": "storage.type.thunder",
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(?:string|اعشاري|float|منطقي|bool|int|عدد|متن)(?![[:word:]\\p{L}\\p{M}\\p{Nd}_])"
        },
        {
          "name": "keyword.control.thunder",
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(?:continue|import|native|return|struct|راګرځه|راگرځه|ودریږه|ودرېږه|break|const|while|بهرنی|جوړښت|راوړه|لپاره|متغیر|else|func|pass|ترڅو|ثابت|دنده|دوام|for|var|تېر|کنه|if|in|په|که)(?![[:word:]\\p{L}\\p{M}\\p{Nd}_])"
        },
        {
          "name": "support.function.builtin.thunder",
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(?:له\\s+ځایه\\s+لرې\\s+کړه|from_char_code|واړه\\s+توري\\s+کړه|end_of_input|لوی\\s+توري\\s+کړه|وروستی\\s+واخله|seed_random|starts_with|تصادفي\\s+بنسټ|دوه\\s+ییز\\s+کړه|شمېره\\s+ورکړه|شپاړسیز\\s+کړه|random_int|اعشاري\\s+کړه|ترلاسه\\s+کړه|تصادفي\\s+عدد|د\\s+توري\\s+کوډ|د\\s+متن\\s+برخه|د\\s+ننوت\\s+پای|د\\s+کوډ\\s+توری|ورزیات\\s+کړه|یو\\s+ځای\\s+کړه|char_code|ends_with|enumerate|is_number|remove_at|substring|تتمیم\\s+جیب|ترتیب\\s+کړه|تکرار\\s+کړه|راټول\\s+کړه|سره\\s+نښلوه|سرچپه\\s+کړه|پایېږي\\s+په|پورته\\s+کړه|پیلېږي\\s+په|ځای\\s+بدلول|contains|index_of|to_float|to_lower|to_upper|ارزښتونه|اوږدوالی|توان\\s+کړه|جوړې\\s+کړه|شمېره\\s+ده|نږدې\\s+کړه|پر\\s+هر\\s+یو|ښکته\\s+کړه|کرښه\\s+چاپ|inspect|println|replace|reverse|بدل\\s+کړه|بڼه\\s+کړه|شامل\\s+دی|عدد\\s+کړه|لرې\\s+کړه|لوګارتم|متن\\s+کړه|پاک\\s+کړه|چاڼ\\s+کړه|concat|filter|format|insert|is_int|random|reduce|remove|repeat|second|to_int|values|تصادفي|عدد\\s+دی|مجموعه|ننباسه|ځای\\s+یې|array|first|floor|input|items|print|range|round|slice|split|اعظمه|لومړی|نمايي|ولوله|وښایه|کمینه|ceil|copy|dump|join|keys|push|sort|sqrt|swap|trim|توکي|دوهم|مطلق|واټن|وېشه|ټوټه|کاپي|کتنه|کیلۍ|abs|bin|cos|exp|get|has|hex|len|log|map|max|min|pop|pow|sin|str|sum|tan|zip|جذر|جیب|لري|لړۍ|پای|چاپ|pi|ظل)(?![[:word:]\\p{L}\\p{M}\\p{Nd}_])"
        },
        {
          "name": "support.function.module.thunder",
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(?:فایل\\s+ته\\s+ورزیات\\s+کړه|تڼۍ\\s+کښېکښل\\s+شوې\\s+ده|د\\s+موږک\\s+عمودي\\s+ځای|د\\s+چاپېریال\\s+ارزښت|د\\s+موږک\\s+افقي\\s+ځای|موږک\\s+کښېکښل\\s+شوی|circle_outline|د\\s+لیکنې\\s+اندازه|د\\s+لیکې\\s+پلنوالی|د\\s+چوکاټ\\s+چټکتیا|کښېکښل\\s+شوې\\s+تڼۍ|د\\s+مستطیل\\s+څنډه|د\\s+چلولو\\s+پایله|rect_outline|د\\s+دایرې\\s+څنډه|فایل\\s+ړنګ\\s+کړه|پای\\s+ته\\s+ورسوه|append_file|current_dir|file_exists|key_pressed|remove_file|د\\s+پوښۍ\\s+توکي|نېټه\\s+او\\s+وخت|ټاټ\\s+پاک\\s+کړه|frame_rate|line_width|mouse_down|run_output|write_file|اوسنۍ\\s+پوښۍ|عامل\\s+سیسټم|فایل\\s+ولوله|فایل\\s+ولیکه|date_time|read_file|text_size|ښکاره\\s+کړه|clock_ms|key_down|list_dir|platform|فایل\\s+شته|get_env|mouse_x|mouse_y|دلیلونه|canvas|circle|انتظار|مستطیل|clear|frame|pixel|sleep|دایره|لیکنه|وچلوه|چوکاټ|args|exit|line|rect|show|text|time|ساعت|لیکه|rgb|run|رنګ|وخت|ټاټ|ټکی)(?![[:word:]\\p{L}\\p{M}\\p{Nd}_])"
        }
      ]
    },
    "call": {
      "match": "([[:word:]\\p{L}\\p{M}\\p{Nd}_]+)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.thunder"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.thunder",
          "match": "[+\\-*/%]?=|=="
        },
        {
          "name": "keyword.operator.comparison.thunder",
          "match": "[<>]=?|!="
        },
        {
          "name": "keyword.operator.bitwise.thunder",
          "match": "<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.arithmetic.thunder",
          "match": "[-+*/%×÷٪]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.thunder",
          "match": "[,،]"
        },
        {
          "name": "punctuation.accessor.thunder",
          "match": "\\."
        },
        {
          "name": "meta.brace.round.thunder",
          "match": "[()]"
        },
        {
          "name": "meta.brace.square.thunder",
          "match": "[\\[\\]]"
        },
        {
          "name": "meta.brace.curly.thunder",
          "match": "[{}]"
        }
      ]
    }
  }
}
