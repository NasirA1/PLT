# ژبه: ps

راوړه ګرافیک

جوړښت كوردينات
    افقي: عدد
    عمودي: عدد

متغیر ځاى = كوردينات(۱۰۰ ، ۱۰۰)
کرښه چاپ(ځاى)

ټاټ(۵۰۰، ۴۰۰)

ترڅو رښتيا
    ټاټ پاک کړه(”تور”)
    دایره(ځاى.افقي، ځاى.عمودي، ۲۰، "زرغون")
    مستطیل(۳۰۰، ۲۰۰، ۲۰، ۲۰، "سور")
    چوکاټ()
    ځاى.افقي += ١

متغیر س = ١٢
جوړښت پكسل
    س: عدد
    ص: عدد
متغير پ = پكسل(١٢، ٢٣)
كرښه چاپ(پ)


