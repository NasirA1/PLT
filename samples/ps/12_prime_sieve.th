# ژبه: ps
# ۱۲ - د اراتوستنیز غلبیل
#
# تر یو حد پورې ټول لومړني عددونه د هر لومړني عدد د مضربونو په کرښه
# وهلو سره پیدا کوي. له لړۍ(ن، ارزښت) سره جوړه شوې منطقي[] لړۍ کاروي.

ثابت حد = ۵۰

متغیر لومړنی_دی = لړۍ(حد + ۱، رښتیا)
لومړنی_دی[۰] = درواغ
لومړنی_دی[۱] = درواغ

لپاره متغیر ل = ۲، ل * ل <= حد، ل = ل + ۱
    که لومړنی_دی[ل]
        لپاره متغیر مضرب = ل * ل، مضرب <= حد، مضرب = مضرب + ل
            لومړنی_دی[مضرب] = درواغ

متغیر شمېر = ۰
لپاره متغیر ن = ۲، ن <= حد، ن = ن + ۱
    که لومړنی_دی[ن]
        شمېر = شمېر + ۱
        چاپ(ن، " ")
کرښه چاپ()
کرښه چاپ(شمېر، " لومړني عددونه تر "، حد، " پورې")
