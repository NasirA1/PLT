دنده _ګراف_ژور_لټون_وګرځه<ت>(ګراف_: ګراف<ت>، څوکه: ت، لیدلي: ټولګه<ت>، پایله: ت[])
    که ټولګه_لري(لیدلي، څوکه)
        راګرځه
    ټولګې_ته_ورزیات_کړه(لیدلي، څوکه)
    ورزیات کړه(پایله، څوکه)
    لپاره ګاونډی په د_ګراف_ګاونډیان(ګراف_، څوکه)
        _ګراف_ژور_لټون_وګرځه(ګراف_، ګاونډی، لیدلي، پایله)

# تر ټولو لنډه لار (تر ټولو لږې غاړې) له یوې څوکې بلې ته، په پلن لټون موندل شوې؛
# تشه کله چې نه وي. دواړه سرونه پکې دي: [له، ...، ته].
دنده د_ګراف_لنډه_لار<ت>(ګراف_: ګراف<ت>، له_: ت، ته_: ت): ت[]
    متغیر لار: ت[] = []
    که نه لري(ګراف_.ګاونډیتوب، له_) یا نه لري(ګراف_.ګاونډیتوب، ته_)
        راګرځه لار
    متغیر له_کومه: {ت: ت} = {}
    متغیر لیدلي: ټولګه<ت> = نوې_ټولګه()
    متغیر مخکښه: لیکه<ت> = نوې_لیکه()
    ټولګې_ته_ورزیات_کړه(لیدلي، له_)
    لیکې_ته_ورزیات_کړه(مخکښه، له_)
    متغیر وموندل_شوه = له_ == ته_
    ترڅو نه لیکه_تشه_ده(مخکښه) او نه وموندل_شوه
        متغیر څوکه = له_لیکې_واخله(مخکښه)
        لپاره ګاونډی په د_ګراف_ګاونډیان(ګراف_، څوکه)
            که نه ټولګه_لري(لیدلي، ګاونډی)
                ټولګې_ته_ورزیات_کړه(لیدلي، ګاونډی)
                له_کومه[ګاونډی] = څوکه
                که ګاونډی == ته_
                    وموندل_شوه = رښتیا
                    ودرېږه
                لیکې_ته_ورزیات_کړه(مخکښه، ګاونډی)
    که نه وموندل_شوه
        راګرځه لار
    # د ډوډۍ د ذرو پر لاره بېرته کور ته، بیا پله سرچپه کړه.
    متغیر ګام = ته_
    ورزیات کړه(لار، ګام)
    ترڅو ګام != له_
        ګام = له_کومه[ګام]
        ورزیات کړه(لار، ګام)
    راګرځه سرچپه کړه(لار)

# رښتیا که د غاړو کومه لړۍ له یوې څوکې بلې ته رسېږي.
