// ژبه: ps
// ۲۱ - لړۍ، جوړې او دندې د ارزښت په توګه
//
// لړۍ د ورزیات کړه، وروستی واخله، ننباسه او له ځایه لرې کړه په مرسته غټېږي او
// کوچنۍ کېږي. ترتیب کړه، ټوټه او سرچپه کړه نوې لړۍ راګرځوي. جوړه د دوو
// ارزښتونو ټاپل دی؛ جوړې کړه او شمېره ورکړه د جوړو لړۍ جوړوي.
//
// دنده د ارزښت په توګه کارېدای شي: «پر هر یو» یې پر هر توکي کاروي، «چاڼ کړه»
// هغه توکي ساتي چې دنده یې مني، «راټول کړه» یې په یو ارزښت کې سره یو ځای کوي.

متغیر نمرې = [۷۲, ۹۵, ۵۸, ۸۸]
ورزیات کړه(نمرې, ۶۴)
ننباسه(نمرې, ۰, ۱۰۰)
کرښه چاپ(نمرې, " - ", اوږدوالی(نمرې), " نمرې")
کرښه چاپ("لرې شول ", وروستی واخله(نمرې), " او ", له ځایه لرې کړه(نمرې, ۰), "، پاتې ", نمرې)
کرښه چاپ("ترتیب شوې ", ترتیب کړه(نمرې), "، غوره دوه ", ټوټه(سرچپه کړه(ترتیب کړه(نمرې)), ۰, ۲))
کرښه چاپ("مجموعه ", مجموعه(نمرې), "، ۹۵ شته؟ ", شامل دی(نمرې, ۹۵), " په ", ځای یې(نمرې, ۹۵), " کې")

// جوړې
متغیر نومونه = ["Ada", "Grace", "Alan"]
متغیر کلونه = [۱۸۱۵, ۱۹۰۶, ۱۹۱۲]
متغیر خلک = جوړې کړه(نومونه, کلونه)
کرښه چاپ(خلک)
کرښه چاپ(لومړی(خلک[۲]), " په ", دوهم(خلک[۲]), " کې زېږېدلی؛ اړول شوی: ", ځای بدلول(خلک[۲]))

// دندې د ارزښت په توګه
دنده بریالی(نمره: عدد): منطقي
    راګرځه نمره >= ۶۰

دنده لوړول(نمره: عدد): عدد
    راګرځه نمره + ۵

دنده جمع(ټول: عدد, نمره: عدد): عدد
    راګرځه ټول + نمره

کرښه چاپ("بریالي: ", چاڼ کړه(نمرې, بریالی), "، لوړې شوې: ", پر هر یو(نمرې, لوړول), "، ټول: ", راټول کړه(نمرې, ۰, جمع))
متغیر ازموینه: دنده(عدد): منطقي = بریالی
کرښه چاپ("۵۹ بریالی دی؟ ", ازموینه(۵۹))
