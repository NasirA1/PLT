# ژبه: ps
# ۲۹ - انځور کښل (ګرافیک ماډیول)
#
# «راوړه ګرافیک» پروګرام ته د انځور کښلو لپاره یو ټاټ ورکوي. ځایونه په
# پکسلونو دي: س ښي لور ته لویېږي، ص کښته لور ته لویېږي، او (۰، ۰) پورته
# کیڼ کونج دی. رنګ د رنګونه ګڼنې یو غړی (رنګونه.سور، رنګونه.اسماني)، په قوسونو کې
# یو نوم ("خړ")، یو کوډ ("#ff8800") یا رنګ(...) دی. شکلونه په ترتیب کښل کېږي، نو
# وروستي شکلونه مخکیني پټوي.
#
# هڅه وکړئ: «چلول» کښېکښئ - انځور د ټاټ په پاڼه کې ښکاري. بیا لمر بل ځای
# ته یوسئ، رنګونه بدل کړئ، یا کور ته دوهمه کړکۍ ورکړئ.

راوړه ګرافیک

ګرافیک.ټاټ(۴۰۰، ۳۰۰)

# آسمان د افق خوا ته روښانه کېږي: ۲۲ پټې، هره یو څه بل ډول شین.
تکرار متغیر پټه = ۰، پټه < ۲۲، پټه = پټه + ۱
    ګرافیک.مستطیل(۰، پټه * ۱۰، ۴۰۰، ۱۰، ګرافیک.رنګ(۴۰ + پټه * ۶، ۱۱۰ + پټه * ۵، ۲۳۰))

# لمر او وړانګې یې (د س او ص د توپیرونو جوړې: زاویو ته اړتیا نشته).
متغیر وړانګې = [(۰، -۵۰)، (۳۵، -۳۵)، (۵۰، ۰)، (۳۵، ۳۵)، (۰، ۵۰)، (-۳۵، ۳۵)، (-۵۰، ۰)، (-۳۵، -۳۵)]
ګرافیک.د لیکې پلنوالی(۳)
تکرار متغیر ش = ۰، ش < اوږدوالی(وړانګې)، ش = ش + ۱
    متغیر (توپیر_س، توپیر_ص) = وړانګې[ش]
    ګرافیک.لیکه(۳۳۰، ۶۰، ۳۳۰ + توپیر_س، ۶۰ + توپیر_ص، ګرافیک.رنګونه.نارنجي)
ګرافیک.دایره(۳۳۰، ۶۰، ۲۸، ګرافیک.رنګونه.طلايي)

# ځمکه
ګرافیک.مستطیل(۰، ۲۲۰، ۴۰۰، ۸۰، ګرافیک.رنګ(۶۰، ۱۶۰، ۶۰))

# کور: دېوالونه، له لنډېدونکو لیکو جوړ چت، دروازه او کړکۍ.
ګرافیک.مستطیل(۶۰، ۱۵۰، ۱۲۰، ۸۰، ګرافیک.رنګونه.سپین)
ګرافیک.د لیکې پلنوالی(۱)
تکرار متغیر قطار = ۰، قطار < ۵۰، قطار = قطار + ۱
    ګرافیک.لیکه(۵۰ + قطار، ۱۵۰ - قطار، ۱۹۰ - قطار، ۱۵۰ - قطار، ګرافیک.رنګ(۱۲۸، ۰، ۰))
ګرافیک.مستطیل(۱۰۵، ۱۸۵، ۳۰، ۴۵، ګرافیک.رنګونه.نسواري)
ګرافیک.مستطیل(۱۴۰، ۱۶۵، ۲۸، ۲۴، ګرافیک.رنګونه.اسماني)
ګرافیک.د مستطیل څنډه(۱۴۰، ۱۶۵، ۲۸، ۲۴، ګرافیک.رنګونه.تور)
ګرافیک.لیکه(۱۵۴، ۱۶۵، ۱۵۴، ۱۸۹، ګرافیک.رنګونه.تور)

# ونه
ګرافیک.مستطیل(۲۶۲، ۱۶۵، ۱۶، ۶۰، ګرافیک.رنګونه.نسواري)
ګرافیک.دایره(۲۷۰، ۱۵۰، ۳۰، ګرافیک.رنګونه.زرغون)
ګرافیک.دایره(۲۵۵، ۱۶۵، ۲۰، ګرافیک.رنګونه.زرغون)
ګرافیک.دایره(۲۸۷، ۱۶۳، ۲۲، ګرافیک.رنګونه.زرغون)

ګرافیک.د لیکنې اندازه(۲۰)
ګرافیک.لیکنه(۱۲، ۱۲، "د تندر ګرافیک"، ګرافیک.رنګونه.سپین)
ګرافیک.د لیکنې اندازه(۱۴)
ګرافیک.لیکنه(۱۲، ۲۷۰، "(۰، ۰) پورته کیڼ کونج دی"، ګرافیک.رنګونه.سپین)
