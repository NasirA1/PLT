# ژبه: ps
# ۲۸ - ازموینه: د ازموینې فایل، ډلې یې او یو پېښه ګر
#
# ازموینې په خپل د ازموینې فایل کې اوسي: هغه فایل چې اعلانونه یې په @ازموینه نښه شوي. دا
# ازموینې او هغه څه لري چې ازموینو ته پکار دي - نه خپل امرونه او نه اصلي() - او هغه کوډ چې
# ازمویل کېږي له یوه «راوړه» راځي. (د پروګرام فایل د ازموینې ټولګی نشي کارولای: د ازموینې
# کوډ له اصلي کوډ څخه بېل پاتې کېږي.)
#
# د ازموینې فایل لکه هر پروګرام وچلوئ: ژباړونکی ازموینې پیدا کوي، د اعلان په ترتیب یې چلوي،
# د هرې هغې ازموینې لپاره چې ټولې تمې یې پوره شوې "✓ نوم" چاپوي، یا "✗ نوم: څه ناسم شول" د
# هرې هغې تمې لپاره چې پوره نه شوه، بیا ټولګه؛ که کومه ازموینه ناکامه وي د وتلو کوډ ۱ دی.
# پر امر کرښه ازموینې یا ډلې نوم کړئ (thundervm 28_testing.thc متنونه، یا
# thundervm 28_testing.thc "یوه شمېرنه/جمع کوي") او یوازې هغه چلېږي - د VS Code د ازموینو
# لړ یوه ازموینه یا یوه ډله همداسې چلوي. docs/ps/testing.md ټول چوکاټ لري.

راوړه "lib/scores"

# --- یوازې ازموینې: هغه دندې چې پارامټر نه لري ------------------------------------------
@ازموینه("د لړۍ تر ټولو لوی")
دنده د_لړۍ_تر_ټولو_لوی()
    تمه.برابر(نمرې.تر_ټولو_لوی([۳، ۹، ۲])، ۹)
    تمه.برابر(نمرې.تر_ټولو_لوی([-۵])، -۵)

@ازموینه                                # پرته له تشریح: «اعشاري په زغم پرتله کېږي»
دنده اعشاري_په_زغم_پرتله_کېږي()
    تمه.نږدې(۱٫۰ / ۳٫۰، ۰٫۳۳۳۳، ۰٫۰۰۱)
    تمه.دا_وي(متن.اوږدوالی("الف") == ۳، "ستاسې خپل پیغام")

# --- ټولګی یوه ډله ده: هره عامه دنده یې چې پارامټر نه لري یوه ازموینه ده ---------------
@ازموینه
ټولګی متنونه
    دنده پالیندرومونه()
        تمه.رښتیا_وي(نمرې.پالیندروم_دی("کاک"))
        تمه.درواغ_وي(نمرې.پالیندروم_دی("تندر"))

    دنده لړۍ_د_توکو_له_مخې_پرتله_کېږي()
        متغیر مربعګانې: عدد[] = []
        تکرار ش په [۱، ۲، ۳]
            ورزیات کړه(مربعګانې، ش * ش)
        تمه.برابر(مربعګانې، [۱، ۴، ۹])
        تمه.نابرابر(مربعګانې، [۱، ۲، ۳])

# --- جوړښت هم یوه ډله ده: هره ازموینه پر یوې نوې بېلګې چلېږي --------------------------------
# جوړوونکی هره ازموینه چمتو کوي، او د وتړه() دنده، که وي، له هغې وروسته پاکوي - نو هېڅ
# ازموینه هغه څه نه ویني چې بلې کړي وي.
@ازموینه("یوه شمېرنه")
جوړښت د_شمېرنې_ازموینې
    _شمېرنه: نمرې.شمېرنه

    د_شمېرنې_ازموینې()
        _شمېرنه = نمرې.شمېرنه()
        _شمېرنه.ورزیات_کړه(۵)

    دنده له_هغه_پیلېږي_چې_جوړوونکي_ورزیات_کړ()
        تمه.برابر(_شمېرنه.ټول_یې()، ۵)

    دنده جمع_کوي()
        _شمېرنه.ورزیات_کړه(۲)
        تمه.برابر(_شمېرنه.ټول_یې()، ۷)     # ۵ + ۲: دې ازموینې خپله شمېرنه لري

    دنده _دوه_ځله_ورزیات_کړه(اندازه: عدد)   # شخصي، له پارامټر سره: مرستندویه، نه ازموینه
        _شمېرنه.ورزیات_کړه(اندازه)
        _شمېرنه.ورزیات_کړه(اندازه)

    @ازموینه("دوه ځله ورزیاتوي")              # خپله تشریح
    دنده دوه_چنده_کوي()
        _دوه_ځله_ورزیات_کړه(۳)
        تمه.برابر(_شمېرنه.ټول_یې()، ۱۱)

# --- پېښه ګران: د یوه برسېر ځای نیوونکي ----------------------------------------------------------
# @پېښه ګر جوړښت د برسېر هرې دندې ته هره بلنه ثبتوي. هغه دنده چې جوړښت یې لیکي ځواب ورکوي؛
# هغه چې پرېږدي یې د اصلي ارزښت ځواب ورکوي (دلته ۰).
@پېښه ګر
جوړښت د_سهار_ساعت: نمرې.ساعت
    دنده ساعت_یې(): عدد
        راګرځه ۹

@پېښه ګر
جوړښت هر_ساعت: نمرې.ساعت

@ازموینه("د ورځې د وخت سره سم ستاینه کوي")
دنده د_وخت_سره_سم_ستاینه_کوي()
    متغیر ګړۍ = د_سهار_ساعت()
    تمه.برابر(نمرې.ستاینه(ګړۍ)، "سهار پخیر")
    ګړۍ.تمه_د_بللو("ساعت_یې"، ۱)          # ستاینې ساعت سم یو ځل وپوښته
    متغیر بله = هر_ساعت()
    تمه.برابر(نمرې.ستاینه(بله)، "سهار پخیر")   # ساعت_یې() ۰ ځواب ورکړ
    تمه.برابر(بله.بلنې()، ["ساعت_یې()"])
