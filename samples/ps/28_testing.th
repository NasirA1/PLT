# ژبه: ps
# ۲۸ - ازموینه: د پروګرام کتنه د ازموینې ماډیول سره
#
# راوړه "testing" ولیکئ او هره ازموینه د یوې دندې په توګه ولیکئ: دننه یې تمه.برابر او ملګري
# وايي چې څه باید رښتیا وي. ازموینه.وچلوه() دنده د یوه نوم لاندې چلوي او "✓ نوم" چاپوي کله
# چې هره تمه پوره شوه، یا "✗ نوم: څه ناسم شول" د هرې هغې لپاره چې پوره نه شوه.
# ازموینه.پای_ته_ورسوه() ټولګه چاپوي او که کومه ازموینه ناکامه وي پروګرام د وتلو کوډ ۱ سره
# پای ته رسوي.
#
# هغه ازموینې چې سره تړاو لري په یوه ټولګي کې ځي: ټولګی د ازموینو یوه ډله ده. نوم یې د
# ازموینو پورته چاپېږي، شمېرې یې بېلې ساتل کېږي، او یوازې هم چلېدای شي.
#
# لکه هر پروګرام یې وچلوئ: ټولې ازموینې چلېږي. پر امر کرښه ازموینې یا ډلې نوم کړئ
# (thundervm 28_testing.thc "د لړۍ تر ټولو لوی"، یا thundervm 28_testing.thc متنونه_ازموینې)
# او یوازې هغه چلېږي - د VS Code د ازموینو لړ یوه ازموینه یا یوه ډله همداسې چلوي.
# docs/ps/testing.md ټول ماډیول لري.

راوړه "testing"

# هغه کوډ چې ازمویل کېږي.
دنده تر_ټولو_لوی(ارزښتونه: عدد[]): عدد
    متغیر غوره = ارزښتونه[۰]
    تکرار ارزښت په ارزښتونه
        که ارزښت > غوره
            غوره = ارزښت
    راګرځه غوره

دنده پالیندروم_دی(کلمه: متن): منطقي
    متغیر اړول_شوې = ""
    تکرار متغیر ش = اوږدوالی(کلمه) - ۱، ش >= ۰، ش = ش - ۱
        اړول_شوې = اړول_شوې + کلمه[ش]
    راګرځه اړول_شوې == کلمه

# ازموینې. هره یوه ساده دنده ده، بې پارامترونو؛ هر ټولګی یوه ډله ده.
ټولګی شمېرې
    دنده د_لړۍ_تر_ټولو_لوی()
        تمه.برابر(تر_ټولو_لوی([۳، ۹، ۲])، ۹)
        تمه.برابر(تر_ټولو_لوی([-۵])، -۵)

    دنده اعشاري_په_زغم_پرتله_کېږي()
        تمه.نږدې(۱.۰ / ۳.۰، ۰.۳۳۳۳، ۰.۰۰۱)
        تمه.دا_وي(اوږدوالی("الف") == ۳، "ستاسې خپل پیغام")

ټولګی متنونه_ازموینې
    دنده پالیندرومونه()
        تمه.رښتیا_وي(پالیندروم_دی("level"))
        تمه.درواغ_وي(پالیندروم_دی("تندر"))

    دنده لړۍ_د_توکو_له_مخې_پرتله_کېږي()
        متغیر مربعونه: عدد[] = []
        تکرار ن په [۱، ۲، ۳]
            ورزیات کړه(مربعونه، ن * ن)
        تمه.برابر(مربعونه، [۱، ۴، ۹])
        تمه.نابرابر(مربعونه، [۱، ۲، ۳])

ازموینه.وچلوه("د لړۍ تر ټولو لوی"، شمېرې.د_لړۍ_تر_ټولو_لوی)
ازموینه.وچلوه("اعشاري په زغم پرتله کېږي"، شمېرې.اعشاري_په_زغم_پرتله_کېږي)
ازموینه.وچلوه("پالیندرومونه"، متنونه_ازموینې.پالیندرومونه)
ازموینه.وچلوه("لړۍ د توکو له مخې پرتله کېږي"، متنونه_ازموینې.لړۍ_د_توکو_له_مخې_پرتله_کېږي)
ازموینه.پای_ته_ورسوه()
