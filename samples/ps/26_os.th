# ژبه: ps
# ۲۶ - عامل سیسټم (د سیسټم ماډیول)
#
# دننی ماډیول «سیسټم» (انګلیسي: os) پروګرامونو ته فایلونه، امرونه، ساعت او
# چاپېریال ورکوي. دندې یې یوازې له «راوړه سیسټم» وروسته شته، نو دا نومونه
# د هغو پروګرامونو لپاره خالي پاتې کېږي چې ورته اړتیا نلري.
#
# هڅه وکړئ: د قوماندې له کرښې: thundervm 26_os.thc یو دوه
# «یو» او «دوه» پروګرام ته ورکوي (لاندې دلیلونه وګورئ).

راوړه سیسټم
راوړه فایل

# عامل سیسټم() د پلیټفارم ګڼنې یو غړی راګرځوي (پلیټفارم.لینکس، .وینډوز، .مېک یا .ناپېژندلی)؛
# دا چې کوم یو، په ماشین پورې اړه لري، نو دا پروګرام یوازې هغه چاپوي چې هر ځای رښتیا وي.
کرښه چاپ("پېژندل شوی سیسټم؟ "، شامل دی(سیسټم.پلیټفارم.ارزښتونه، سیسټم.عامل سیسټم())، " (له "، سیسټم.پلیټفارم.شمېر، " څخه یو)")
کرښه چاپ("دلیلونه: "، سیسټم.دلیلونه())
متغیر ښه_راغلاست = سیسټم.د چاپېریال ارزښت("THUNDER_GREETING")
که ښه_راغلاست == ""
    ښه_راغلاست = "(THUNDER_GREETING نه دی ټاکل شوی)"
کرښه چاپ("ښه راغلاست: "، ښه_راغلاست)

# فایلونه: نسبي نومونه د پروګرام په کاري پوښۍ کې دي.
متغیر مسیر = "د_تندر_بېلګه.txt"
فایل.ولیکه(مسیر، "لومړۍ کرښه\ن")
فایل.ورزیات کړه(مسیر، "دوهمه کرښه\ن")
کرښه چاپ("فایل وايي: "، متن.وېشه(متن.پاک کړه(فایل.ولوله(مسیر))، "\ن"))
فایل.ړنګ کړه(مسیر)
کرښه چاپ("لا شته؟ "، فایل.شته(مسیر))

# امرونه د سیسټم په شیل کې چلېږي؛ «وچلوه» یې وتنه پروګرام ته ورکوي.
متغیر حالت = سیسټم.وچلوه("echo 42")
کرښه چاپ("د وتلو حالت "، حالت)
متغیر (کوډ، متن_یې) = سیسټم.د چلولو پایله("echo 7")
کرښه چاپ("د چلولو پایله "، کوډ، " او ["، متن.پاک کړه(متن_یې)، "] وه")

متغیر پیل = سیسټم.ساعت()
سیسټم.انتظار(۲۰)
کرښه چاپ("لږ تر لږه ۲۰ ملي ثانیې ویده و؟ "، سیسټم.ساعت() - پیل >= ۲۰)
کرښه چاپ("نېټه او وخت "، اوږدوالی(سیسټم.نېټه او وخت())، " توري لري، لکه 2026-11-06 14:30:00")
سیسټم.پای ته ورسوه(۰)
کرښه چاپ("«پای ته ورسوه» پروګرام ختموي، نو دا کرښه هېڅکله نه اجرا کېږي")
