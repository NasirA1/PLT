# ژبه: ps
# پرمختللی ۰۲ - د الګوریتمونو کتابتون
#
# راوړه "algorithms" د ترتیب او لټون کلاسیک الګوریتمونه راوړي، پخپله په تندر کې لیکل
# شوي (lib/thunder/ps) او د توکو پر ډول عمومي. کتابتون پرانیزئ او ولولئ چې هر یو
# څنګه کار کوي؛ تشریح یې په docs/ps/algorithms.md کې ده.

راوړه "algorithms"

# --- پنځه لارې، همغه عددونه --------------------------------------------------------
متغیر ا = [۵، ۲، ۹، ۱، ۵، ۶]
ترتیب.حبابي(ا)
متغیر ب = [۵، ۲، ۹، ۱، ۵، ۶]
ترتیب.غوراوی(ب)
متغیر ج = [۵، ۲، ۹، ۱، ۵، ۶]
ترتیب.ننویستل(ج)
متغیر د = [۵، ۲، ۹، ۱، ۵، ۶]
ترتیب.چټک(د)
متغیر ه = [۵، ۲، ۹، ۱، ۵، ۶]
ترتیب.ګډولو(ه)
کرښه چاپ(ا)
کرښه چاپ("ټول یو شان؟ "، متن کړه(ا) == متن کړه(ب) او متن کړه(ب) == متن کړه(ج) او متن کړه(ج) == متن کړه(د) او متن کړه(د) == متن کړه(ه))

# --- همدا الګوریتمونه کلمې هم اڼي ---------------------------------------------------
متغیر کلمې = ["ناک"، "مڼه"، "انځر"، "خرما"]
ترتیب.چټک(کلمې)
کرښه چاپ(کلمې)

# --- لټون: پرله پسې هر ځای کار کوي، نیمایي ترتیب شوې ننوتنه غواړي -------------------
کرښه چاپ("انځر په پرله پسې لټون: ځای "، لټون.پرله_پسې(کلمې، "انځر"))
کرښه چاپ("انځر په نیمایي لټون: ځای "، لټون.نیمایي(کلمې، "انځر"))
کرښه چاپ("ورک ارزښت: "، لټون.نیمایي(کلمې، "اننګور"))

# --- مرستندویې ----------------------------------------------------------------------
کرښه چاپ("د "، ا، " کمینه په ځای "، لټون.د_کمینې_ځای(ا))
تصادفي.بنسټ(۷)
ترتیب.ګډوډه_کړه(ا)
کرښه چاپ("ګډوډه شوه، لا هم "، اوږدوالی(ا)، " ارزښتونه؛ ترتیب شوې؟ "، ترتیب.شوې_ده(ا))
ترتیب.چټک(ا)
کرښه چاپ("او بېرته په ترتیب: "، ا)

# --- متن: لټون، سرچپه ورته والی، مختاړي او د بدلون واټن ------------------------------
کرښه چاپ("نړۍ پیلېږي په: "، متنونه.ومومه("سلام نړۍ"، "نړۍ"))
کرښه چاپ("اا په ااااا کې په: "، متنونه.ټول_ومومه("ااااا"، "اا"))
کرښه چاپ("۱۲۳۲۱ سرچپه ورته ده؟ "، متنونه.سرچپه_ورته_ده("۱۲۳۲۱")، "؛ مڼه؟ "، متنونه.سرچپه_ورته_ده("مڼه"))
کرښه چاپ("ګډ مختاړی: "، متنونه.تر_ټولو_اوږد_ګډ_مختاړی(["کوربه"، "کورنۍ"، "کور"]))
کرښه چاپ("کور ← کار "، متنونه.د_بدلون_واټن("کور"، "کار")، " بدلون غواړي")
