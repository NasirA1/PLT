# ژبه: ps
# شکلونه، د ټولګي په توګه: هغه پروګرام چې دا فایل راوړي، غړي یې د ټولګي له نوم سره کاروي -
# هندسه.څلور_اړخیز، هندسه.مساحت(خونه).
#
#     راوړه "lib/shapes"

ټولګی هندسه
    جوړښت څلور_اړخیز
        پلنوالی: عدد
        لوړوالی: عدد

    دنده مساحت(ش: څلور_اړخیز): عدد
        راګرځه ش.پلنوالی × ش.لوړوالی

    دنده کړۍ(ش: څلور_اړخیز): عدد
        راګرځه ۲ × (ش.پلنوالی + ش.لوړوالی)

    دنده مربع_دی(ش: څلور_اړخیز): منطقي
        راګرځه ش.پلنوالی == ش.لوړوالی

    دنده بیان(ش: څلور_اړخیز): متن
        راګرځه متن.بڼه کړه("{}×{}: مساحت {}، کړۍ {}"، ش.پلنوالی، ش.لوړوالی، مساحت(ش)، کړۍ(ش))
