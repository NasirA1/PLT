# ژبه: ps
# testing.th (lib/thunder/ps) - د ازموینو چوکاټ، پخپله په تندر کې لیکل شوی (docs/ps/testing.md)
#
# ازموینې په خپلو فایلونو کې اوسي. هره ازموینه په @ازموینه نښه کړئ - یوه دنده، یا ټول یو
# جوړښت یا ټولګی (یوه ډله) - او فایل وچلوئ؛ ژباړونکی ازموینې پیدا کوي، دا فایل راوړي او
# ازموینې یوه په بل پسې چلوي، بیا لنډیز چاپوي:
#
#     راوړه "lib/ډېرۍ"                     # هغه کوډ چې ازمویل کېږي
#
#     @ازموینه
#     دنده جمع_سمه_ده()                    # د «جمع سمه ده» په نوم ښکاري
#         تمه.برابر(۲ + ۲، ۴)
#
#     @ازموینه("نوې ډېرۍ")
#     جوړښت نوې_ډېرۍ                       # ډله: هره عامه دنده چې پارامټر نه لري یوه
#         _ډېرۍ: ډېرۍ<عدد>                  # ازموینه ده، هر ځل پر یوې نوې نوې_ډېرۍ چلېږي
#
#         نوې_ډېرۍ()                       # جوړوونکی هره ازموینه چمتو کوي ...
#             _ډېرۍ = ډېرۍ()
#
#         دنده تشه_ده()
#             تمه.رښتیا_وي(_ډېرۍ.تشه_ده())
#
#         دنده وتړه()                       # ... او وتړه()، که وي، پاکوي یې
#             تېر
#
# یو ټولګی هم ډله کېدای شي (پر ټولګي @ازموینه: عامې دندې یې چې پارامټر نه لري ازموینې دي)،
# او پر یوې دندې @ازموینه یوازې هماغه نښه کوي، د خوښې له تشریح سره: @ازموینه("یو توکی ورزیاتوي").
#
# د ازموینې فایل یوازې ازموینې لري - نه خپل امرونه او نه اصلي() - او د پروګرام فایل دا ټولګی
# نشي کارولای: د ازموینې کوډ له اصلي کوډ څخه بېل پاتې کېږي.
#
# هره ازموینه یوه کرښه چاپوي - "✓ نوم" کله چې تېره شي، "✗ نوم: څه ناسم شول" د هرې هغې تمې
# لپاره چې پوره نه شوه - د خپلې ډلې د نوم لاندې، او لنډیز پروګرام د وتلو کوډ ۱ سره پای ته
# رسوي کله چې کومه ازموینه ناکامه وي (نو یو سکریپټ، یا د VS Code غځونه، پوهېدلی شي). د
# پروګرام دلیلونه ټاکي چې کومې ازموینې وچلېږي: "thundervm tests.thc جمع" یوازې هغه ازموینې
# (یا ډلې) چلوي چې نوم یې پر امر کرښه راغلی - "ډله/ازموینه" د یوې ډلې یوه ازموینه نوموي - د
# VS Code د ازموینو لړ یوه ازموینه یا یوه ډله همداسې چلوي.
#
# پېښه ګران. «@پېښه ګر جوړښت پېښه_ګر_ساعت: ساعت» د هغو برسېرونو ځای نیوونکی جوړوي چې جوړښت یې
# نوموي: د هغوی هره دنده خپلې بلنې ثبتوي، بیا د جوړښت د خپلې همنومې دندې ځواب ورکوي، یا، که
# نه وي، هېڅ نه کوي او اصلي ارزښت راګرځوي (۰، ""، درواغ، هېڅ، []). جوړښت د پېښه ګران ګډون دندې
# لري چې وپوښتي څه پېښ شول:
#
#     برسېر ساعت
#         دنده ساعت_یې(): عدد
#
#     @پېښه ګر
#     جوړښت پېښه_ګر_ساعت: ساعت
#         وخت: عدد                         # هغه چې ازموینه غواړي ساعت یې ووايي
#         دنده ساعت_یې(): عدد
#             راګرځه وخت
#
#     @ازموینه
#     دنده سهار_پخیر_وايي()
#         متغیر ګړۍ = پېښه_ګر_ساعت(وخت: ۹)
#         تمه.برابر(ستاینه(ګړۍ)، "سهار پخیر")
#         ګړۍ.تمه_د_بللو("ساعت_یې"، ۱)
#
# دلته هېڅ بهرنی نشته: دا ساده تندر دی، د لوستلو لپاره لیکل شوی.

راوړه سیسټم

ټولګی ازموینه
    # په یوې ازموینې څه وشول: چېرې اړه لري، څه نومېږي او څه ناسم شول.
    جوړښت پایله
        ډله: متن
        نوم: متن
        ناکامۍ: متن[]

        # رښتیا که د ازموینې هېڅ تمه ناکامه نه شوه.
        دنده تېره_شوه(): منطقي
            راګرځه اوږدوالی(ناکامۍ) == ۰

    # ازموینې چلوي، پایلې یې ساتي او لیکنه یې چاپوي. د ژباړونکي بلنې د ازموینه.وچلوه او
    # ازموینه.پای_ته_ورسوه له لارې لاندې یوازینی چلوونکي ته ځي.
    جوړښت چلوونکی
        پایلې: پایله[]
        _ټاکل_شوې: متن[]      # پر امر کرښه نومول شوې ازموینې او ډلې (هېڅ: ټولې وچلوه)
        _اوسنۍ: پایله         # هغه ازموینه چې بدنه یې چلېږي (د ازموینو ترمنځ هېڅ)
        _ډله: متن             # د وروستۍ چلېدلې ازموینې ډله ("" که نه وي)
        _ډلې: متن[]           # ډلې، په هغه ترتیب چې لومړی وچلېدې

        چلوونکی(ټاکل_شوې: متن[])
            _ټاکل_شوې = ټاکل_شوې
            _اوسنۍ = هېڅ

        # رښتیا که دا ازموینه باید وچلېږي: هره ازموینه کله چې پر امر کرښه هېڅ نوم نه وي ورکړل
        # شوی، کنه یوازې نومول شوې ازموینې، د نومول شوو ډلو ازموینې او "ډله/ازموینه".
        دنده غواړي(ډله: متن، نوم: متن): منطقي
            که اوږدوالی(_ټاکل_شوې) == ۰
                راګرځه رښتیا
            راګرځه شامل دی(_ټاکل_شوې، نوم) یا (ډله != "" او (شامل دی(_ټاکل_شوې، ډله) یا شامل دی(_ټاکل_شوې، ډله + "/" + نوم)))

        # یوه ازموینه چلوي: دنده «بدنه»، چې د «ډله» په ډله کې د «نوم» لاندې راپور کېږي ("" که
        # ډله نه وي). ازموینه تېرېږي کله چې د بدنې هېڅ تمه ناکامه نه شي.
        دنده وچلوه(ډله: متن، نوم: متن، بدنه: دنده())
            که نه غواړي(ډله، نوم)
                راګرځه
            که ډله != _ډله
                _ډله = ډله
                که ډله != ""
                    کرښه چاپ(ډله)
                    که نه شامل دی(_ډلې، ډله)
                        ورزیات کړه(_ډلې، ډله)
            _اوسنۍ = پایله(ډله: ډله، نوم: نوم، ناکامۍ: [])
            بدنه()
            ورزیات کړه(پایلې، _اوسنۍ)
            که _اوسنۍ.تېره_شوه()
                کرښه چاپ(_پیل_تشه()، "✓ "، نوم)
            _اوسنۍ = هېڅ

        # اوسنۍ ازموینه د یوه پیغام سره ناکامه کوي. هره ناکامه تمه له همدې ځایه تېرېږي، نو هره
        # یوه خپله کرښه چاپوي، او ازموینه یو ځل ناکامه شمېرل کېږي.
        دنده ناکامه_کړه(پیغام: متن)
            که _اوسنۍ == هېڅ
                کرښه چاپ("✗ "، پیغام)    # یوه تمه چې د هېڅ ازموینې دننه نه ده
                راګرځه
            ورزیات کړه(_اوسنۍ.ناکامۍ، پیغام)
            کرښه چاپ(_پیل_تشه()، "✗ "، _اوسنۍ.نوم، ": "، پیغام)

        # د «ډله» د ازموینو څو تېرې شوې او څو ناکامې شوې ("" د ټولو ازموینو لپاره).
        دنده شمېرې(ډله: متن): (عدد، عدد)
            متغیر تېرې_شوې = ۰
            متغیر ناکامې = ۰
            تکرار پایله_یې په پایلې
                که ډله == "" یا پایله_یې.ډله == ډله
                    که پایله_یې.تېره_شوه()
                        تېرې_شوې += ۱
                    کنه
                        ناکامې += ۱
            راګرځه (تېرې_شوې، ناکامې)

        # لنډیز چاپوي - کله چې څو ډلې وي، د هرې ډلې شمېرې لومړی - او ځوابوي چې څو ازموینې
        # ناکامې شوې.
        دنده راپور(): عدد
            که اوږدوالی(_ډلې) > ۱
                تکرار ډله په _ډلې
                    متغیر (تېرې_شوې، ناکامې) = شمېرې(ډله)
                    کرښه چاپ(ډله، ": "، تېرې_شوې، " تېرې شوې، "، ناکامې، " ناکامې")
            متغیر (تېرې_شوې، ناکامې) = شمېرې("")
            کرښه چاپ(تېرې_شوې، " تېرې شوې، "، ناکامې، " ناکامې")
            راګرځه ناکامې

        دنده _پیل_تشه(): متن
            که _ډله == ""
                راګرځه ""
            راګرځه "  "

    متغیر د_ازموینو_چلوونکی = چلوونکی(سیسټم.دلیلونه())

    # یوه ازموینه چلوي (ژباړونکی د هرې ازموینې لپاره یوه بلنه لیکي).
    دنده وچلوه(ډله: متن، نوم: متن، بدنه: دنده())
        د_ازموینو_چلوونکی.وچلوه(ډله، نوم، بدنه)

    # اوسنۍ ازموینه د خپل پیغام سره ناکامه کوي.
    دنده ناکامه_کړه(پیغام: متن)
        د_ازموینو_چلوونکی.ناکامه_کړه(پیغام)

    # لنډیز چاپوي او پروګرام پای ته رسوي: د وتلو کوډ ۱ کله چې کومه ازموینه ناکامه وي (ژباړونکی
    # بلنه یې له وروستۍ ازموینې وروسته لیکي).
    دنده پای_ته_ورسوه()
        که د_ازموینو_چلوونکی.راپور() > ۰
            سیسټم.پای ته ورسوه(۱)

    # هغه څه چې هر @پېښه ګر جوړښت یې رانغاړي: د هغو بلنو ثبت چې ورته شوې، او هغه پوښتنې چې
    # ازموینه یې پرې کوي. هره بلنه د خپلو دلیلونو سره د متن په بڼه ثبتېږي (لکه متن کړه یې ښيي).
    ګډون پېښه_ګر
        _بلنې: متن[]            # د هرې بلنې دنده، په ترتیب
        _دلیلونه: متن[][]       # د هرې بلنې دلیلونه

        # د پېښه ګران دندې یې بولي (ژباړونکی بلنه لیکي): «غړي» ته یوه بلنه.
        دنده _ثبت_کړه(غړی: متن، دلیلونه: متن[])
            ورزیات کړه(_بلنې، غړی)
            ورزیات کړه(_دلیلونه، دلیلونه)

        # رښتیا که «غړی» لږ تر لږه یو ځل بلل شوی وي.
        دنده وبلل_شو(غړی: متن): منطقي
            راګرځه شامل دی(_بلنې، غړی)

        # «غړی» څو ځله بلل شوی.
        دنده د_بلنو_شمېر(غړی: متن): عدد
            متغیر شمېر = ۰
            تکرار نوم په _بلنې
                که نوم == غړی
                    شمېر += ۱
            راګرځه شمېر

        # «غړي» ته د هرې بلنې دلیلونه، په ترتیب، هر یو د متن په بڼه.
        دنده دلیلونه_یې(غړی: متن): متن[][]
            متغیر موندل_شوي: متن[][] = []
            تکرار (ځای، نوم) په شمېره ورکړه(_بلنې)
                که نوم == غړی
                    ورزیات کړه(موندل_شوي، _دلیلونه[ځای])
            راګرځه موندل_شوي

        # هره بلنه، په ترتیب، د بلنې په بڼه لیکل شوې: ساعت_یې()، خوندي_کړه(کیلي، ۳).
        دنده بلنې(): متن[]
            متغیر لیکل_شوې: متن[] = []
            تکرار (ځای، نوم) په شمېره ورکړه(_بلنې)
                ورزیات کړه(لیکل_شوې، نوم + "(" + متن.یو ځای کړه(_دلیلونه[ځای]، "، ") + ")")
            راګرځه لیکل_شوې

        # تر اوسه ثبت شوې بلنې هېروي.
        دنده بلنې_هېرې_کړه()
            _بلنې = []
            _دلیلونه = []

        # یوه تمه: اوسنۍ ازموینه ناکامه کوي مګر دا چې «غړی» سم «ځله» بلل شوی وي.
        دنده تمه_د_بللو(غړی: متن، ځله: عدد)
            متغیر شمېر = د_بلنو_شمېر(غړی)
            که شمېر != ځله
                ناکامه_کړه(متن.بڼه کړه("تمه وه چې {} {} ځله وبلل شي، خو {} ځله وبلل شو"، غړی، ځله، شمېر))

# تمې. هره یوه اوسنۍ ازموینه، له پیغام سره، ناکامه کوي کله چې شرط یې پوره نه وي؛ کنه چوپه ده.
ټولګی تمه
    # ستاسې خپل شرط، له هغه پیغام سره چې که درواغ وي چاپ شي.
    دنده دا_وي(شرط: منطقي، پیغام: متن)
        که نه شرط
            ازموینه.ناکامه_کړه(پیغام)

    # اوسنۍ ازموینه ناکامه کوي که شرط رښتیا نه وي.
    دنده رښتیا_وي(شرط: منطقي)
        دا_وي(شرط، "تمه رښتیا وه، درواغ ترلاسه شو")

    # اوسنۍ ازموینه ناکامه کوي که شرط درواغ نه وي.
    دنده درواغ_وي(شرط: منطقي)
        دا_وي(نه شرط، "تمه درواغ وه، رښتیا ترلاسه شو")

    # برابر دي کله چې دواړه ارزښتونه یو شان چاپ شي - نو لړۍ، ټاپلونه، نقشې او جوړښتونه د خپلو
    # توکو له مخې پرتله کېږي، او پیغام دواړه هغسې ښيي لکه چې چاپ کېږي.
    دنده برابر<ت>(ترلاسه: ت، تمه_شوی: ت)
        که متن کړه(ترلاسه) != متن کړه(تمه_شوی)
            ازموینه.ناکامه_کړه(متن.بڼه کړه("تمه {} وه، {} ترلاسه شو"، تمه_شوی، ترلاسه))

    # اوسنۍ ازموینه ناکامه کوي که دواړه ارزښتونه یو شان چاپېږي.
    دنده نابرابر<ت>(ترلاسه: ت، ناغوښتل: ت)
        که متن کړه(ترلاسه) == متن کړه(ناغوښتل)
            ازموینه.ناکامه_کړه(متن.بڼه کړه("تمه له {} پرته بل څه وو"، ناغوښتل))

    # د اعشاري شمېرو لپاره، چې لږ کله بشپړ برابرې وي: تېرېږي کله چې دواړه په «زغم» کې وي.
    دنده نږدې(ترلاسه: اعشاري، تمه_شوی: اعشاري، زغم: اعشاري)
        که ریاضي.مطلق(ترلاسه - تمه_شوی) > زغم
            ازموینه.ناکامه_کړه(متن.بڼه کړه("تمه {} وه (په {} کې)، {} ترلاسه شو"، تمه_شوی، زغم، ترلاسه))
