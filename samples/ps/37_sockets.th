# ژبه: ps
# ۳۷ - د شبکې له لارې خبرې (ساکټونه)
#
# په بېلابېلو کمپیوټرونو پروګرامونه د ساکټونو له لارې خبرې کوي: یو لوری پر یوه
# پورټ اوري، بل نښلي، او بیا متن دواړو لورو ته بهېږي. تندر ساکټونه د بهرني
# ماډیول thunder_sockets څخه (++C په lib/native/sockets/ کې) د تندر فایل
# sockets.th (lib/thunder) له لارې اخلي، چې د ساکټ جوړښت او درې ټولګي اعلانوي:
# ټي_سي_پي، یو_ډي_پي او کوربه - د ټول API لپاره هغه فایل ولولئ، او د کیسې لپاره
# docs/ps/sockets.md (مرسته > د ساکټونو لارښود).
#
# دا پروګرام هم سرور دی او هم پېرېدونکی، نو هر ځای بې دویم کمپیوټره چلېږي: هر
# څه له 127.0.0.1 څخه تېرېږي، هغه پته چې تل مانا «همدا ماشین». د رښتیني هڅې
# لپاره یې دوه ټوټې کړئ: اورېدونکې نیمايي پر یوه کمپیوټر، نښلېدونکې پر بل، د
# هغه له پتې سره.
#
# ساکټ یو شی دی چې دندې لري - اړیکه.کرښه_ولېږه("سلام")، اړیکه.کرښه_واخله() -
# او سرچینه ده: «سره» یې د خپل بلاک په پای کې تړي، که بلاک هر ډول پای ته
# ورسېږي، نو هېڅ ساکټ په ناپامۍ پرانیستی نه پاتې کېږي.
#
# که «چلول» ووايي «بهرنی کتابتون ... نشي پرانیستل کېدای» (R028)، توکپانګه بیا
# جوړه کړئ (په لینکس کې ./run_tests.sh یا ./run.sh، په وینډوز کې .\run.ps1):
# هغه thunder_sockets د thundervm تر څنګ جوړوي.

راوړه "sockets"

# پروتوکول یوازې د کرښو په اړه یوه موافقه ده. دلته: پېرېدونکی پوښتي، سرور ځوابوي.
دنده ځواب(پوښتنه: متن): متن
    که پوښتنه == "وخت؟"
        راګرځه "نه پوهېږم، زه یوه بېلګه یم"
    راګرځه "بښنه؟"

# --- سرور: پر دې کمپیوټر واوره، پر هغه پورټ چې سیسټم یې ټاکي (۰) -----------------
سرور سره = ټي_سي_پي.اورېدونکی_جوړ_کړه("127.0.0.1"، ۰)
    که سرور == هېڅ
        کرښه چاپ("اورېدل نشي: "، ساکټ.تېروتنه())
    متغیر پورټ = سرور.پورټ()
    کرښه چاپ("سرور اوري؛ سیسټم ورته پورټ ورکړ: "، پورټ > ۰)

    # --- پېرېدونکی: ورسره ونښلېږه، بیا سرور اړیکه مني -----------------------------
    پېرېدونکی سره = ټي_سي_پي.ونښلېږه("127.0.0.1"، پورټ)
        اړیکه سره = ټي_سي_پي.اړیکه_ومنه(سرور)
            کرښه چاپ("نښلول شوي: "، پېرېدونکی != هېڅ او اړیکه != هېڅ)
            کرښه چاپ("سرور پېرېدونکی پر دې پته ویني: "،
                    متن.پیلېږي په(اړیکه.مقابل_لوری()، "127.0.0.1:"))

            # متن کرښه په کرښه له تاره تېرېږي.
            پېرېدونکی.کرښه_ولېږه("سلام له پېرېدونکي")
            کرښه چاپ("سرور ترلاسه کړل: "، اړیکه.کرښه_واخله())
            اړیکه.کرښه_ولېږه("سلام له سرور")
            کرښه چاپ("پېرېدونکي ترلاسه کړل: "، پېرېدونکی.کرښه_واخله())

            پېرېدونکی.کرښه_ولېږه("وخت؟")
            اړیکه.کرښه_ولېږه(ځواب(اړیکه.کرښه_واخله()))
            کرښه چاپ("پېرېدونکي وخت وپوښت او دا یې ترلاسه کړل: "، پېرېدونکی.کرښه_واخله())

            # د یوه سر تړل: بل سر "" لولي او ویني چې اړیکه ولاړه.
            پېرېدونکی.وتړه()
            کرښه چاپ("د پېرېدونکي له تړلو وروسته سرور لولي \""، اړیکه.کرښه_واخله()،
                    "\"؛ لا پرانیستې؟ "، اړیکه.پرانیستی_دی())
    # دلته «سره» لومړی اړیکه، بیا پېرېدونکی (چې دمخه تړل شوی و: دوه ځله تړل هېڅ زیان نه
    # لري) وتړل، تر ټولو دننه یې لومړی؛ سرور د خپل بلاک په پای کې تړل کېږي.

# --- UDP: یو یو پیغام بې اړیکې --------------------------------------------------
اخیستونکی سره = یو_ډي_پي.پرانیزه(۰)
    لېږونکی سره = یو_ډي_پي.پرانیزه(۰)
        یو_ډي_پي.ولېږه(لېږونکی، "127.0.0.1"، اخیستونکی.پورټ()، "یو ډاټاګرام")
        کرښه چاپ("پر UDP اخیستونکي ترلاسه کړل: "، یو_ډي_پي.واخله(اخیستونکی، ۱۰۰))

# د شبکې ستونزه ارزښت دی، نه چاودنه: داسې پورټ ته نښلېدل چې څوک پرې نه اوري
# هېڅ ورکوي، او ساکټ.تېروتنه() وايي ولې. *تېروتنه* - لکه له تړلو وروسته د ساکټ
# کارول - پروګرام دروي، لکه د دننۍ دندې ناسمه بلنه.
متغیر هېڅوک = ټي_سي_پي.ونښلېږه("127.0.0.1"، ۱)
کرښه چاپ("هلته نښلېدل چې څوک نه اوري هېڅ ورکوي: "، هېڅوک == هېڅ، " ("، ساکټ.تېروتنه() != ""، ")")
