# ژبه: ps
# testing.th (lib/thunder/ps) - د ازموینو یو کوچنی چوکاټ، پخپله په تندر کې لیکل شوی
# (docs/ps/testing.md)
#
# راوړه "testing" ولیکئ، هره ازموینه د یوې دندې په توګه ولیکئ، له نوم سره یې ازموینه() ته
# ورکړئ، او پروګرام د ازموینې_پای_کړه() سره پای ته ورسوئ:
#
#     راوړه "testing"
#
#     دنده جمع_سمه_ده()
#         برابر_تمه(۲ + ۲، ۴)
#
#     ازموینه("جمع سمه ده"، جمع_سمه_ده)
#     ازموینې_پای_کړه()
#
# هره ازموینه یوه کرښه چاپوي - "✓ نوم" کله چې تېره شي، "✗ نوم: څه ناسم شول" د هرې هغه تمې
# لپاره چې پوره نه شوه - او ازموینې_پای_کړه() شمېري چې څو تېرې شوې او څو ناکامې، او که کومه
# ناکامه وي پروګرام د وتلو کوډ ۱ سره پای ته رسوي (نو یو سکریپټ، یا د VS Code غځونه، پوهېدلی
# شي). د پروګرام دلیلونه ټاکي چې کومې ازموینې وچلېږي: "thundervm tests.thc جمع" یوازې هغه
# چلوي چې نوم یې پر امر کرښه راغلی - د VS Code د ازموینو لړ یوه ازموینه همداسې چلوي.
#
# دلته هېڅ بهرنی نشته: دا ساده تندر دی، د لوستلو لپاره لیکل شوی.

راوړه سیسټم

متغیر تېرې_شوې = ۰
متغیر ناکامې = ۰
متغیر اوسنۍ_ازموینه = ""        # هغه ازموینه چې بدنه یې چلېږي
متغیر اوسنۍ_ناکامه = درواغ        # د اوسنۍ ازموینې کومه تمه ناکامه شوه؟
متغیر ټاکل_شوې: متن[] = []        # پر امر کرښه ورکړل شوي نومونه (هېڅ: ټولې وچلوه)
متغیر ټاکل_شوې_لوستل_شوې = درواغ

# رښتیا که دې نوم لرونکې ازموینه باید وچلېږي: هره ازموینه کله چې پر امر کرښه هېڅ نوم نه وي
# ورکړل شوی، کنه یوازې نومول شوې.
دنده ازموینه_غوښتل_شوې(نوم: متن): منطقي
    که نه ټاکل_شوې_لوستل_شوې
        ټاکل_شوې = دلیلونه()
        ټاکل_شوې_لوستل_شوې = رښتیا
    که اوږدوالی(ټاکل_شوې) == ۰
        راګرځه رښتیا
    راګرځه شامل دی(ټاکل_شوې، نوم)

# یوه ازموینه چلوي: دنده «بدنه»، چې د «نوم» لاندې راپور کېږي. ازموینه تېرېږي کله چې د بدنې
# هېڅ تمه ناکامه نه شي.
دنده ازموینه(نوم: متن، بدنه: دنده())
    که نه ازموینه_غوښتل_شوې(نوم)
        راګرځه
    اوسنۍ_ازموینه = نوم
    اوسنۍ_ناکامه = درواغ
    بدنه()
    که اوسنۍ_ناکامه
        ناکامې = ناکامې + ۱
    کنه
        تېرې_شوې = تېرې_شوې + ۱
        کرښه چاپ("✓ "، نوم)

# اوسنۍ ازموینه د خپل پیغام سره ناکامه کوي. هره ناکامه تمه له همدې ځایه تېرېږي، نو هره یوه
# خپله کرښه چاپوي، او ازموینه یو ځل ناکامه شمېرل کېږي.
دنده ناکامه_کړه(پیغام: متن)
    اوسنۍ_ناکامه = رښتیا
    کرښه چاپ("✗ "، اوسنۍ_ازموینه، ": "، پیغام)

# تمې. هره یوه اوسنۍ ازموینه، له پیغام سره، ناکامه کوي کله چې شرط یې پوره نه وي؛ کنه چوپه ده.

# ستاسې خپل شرط، له هغه پیغام سره چې که درواغ وي چاپ شي.
دنده تمه(شرط: منطقي، پیغام: متن)
    که نه شرط
        ناکامه_کړه(پیغام)

# اوسنۍ ازموینه ناکامه کوي که شرط رښتیا نه وي.
دنده رښتیا_تمه(شرط: منطقي)
    تمه(شرط، "تمه رښتیا وه، درواغ ترلاسه شو")

# اوسنۍ ازموینه ناکامه کوي که شرط درواغ نه وي.
دنده درواغ_تمه(شرط: منطقي)
    تمه(نه شرط، "تمه درواغ وه، رښتیا ترلاسه شو")

# برابر دي کله چې دواړه ارزښتونه یو شان چاپ شي - نو لړۍ، ټاپلونه، نقشې او جوړښتونه د خپلو
# توکو له مخې پرتله کېږي، او پیغام دواړه هغسې ښيي لکه چې چاپ کېږي.
دنده برابر_تمه<ت>(ترلاسه: ت، تمه_شوی: ت)
    که متن کړه(ترلاسه) != متن کړه(تمه_شوی)
        ناکامه_کړه(بڼه کړه("تمه {} وه، {} ترلاسه شو"، تمه_شوی، ترلاسه))

# اوسنۍ ازموینه ناکامه کوي که دواړه ارزښتونه یو شان چاپېږي.
دنده نابرابر_تمه<ت>(ترلاسه: ت، ناغوښتل: ت)
    که متن کړه(ترلاسه) == متن کړه(ناغوښتل)
        ناکامه_کړه(بڼه کړه("تمه له {} پرته بل څه وو"، ناغوښتل))

# د اعشاري شمېرو لپاره، چې لږ کله بشپړ برابرې وي: تېرېږي کله چې دواړه په «زغم» کې وي.
دنده نږدې_تمه(ترلاسه: اعشاري، تمه_شوی: اعشاري، زغم: اعشاري)
    که مطلق(ترلاسه - تمه_شوی) > زغم
        ناکامه_کړه(بڼه کړه("تمه {} وه (په {} کې)، {} ترلاسه شو"، تمه_شوی، زغم، ترلاسه))

# لنډیز چاپوي او پروګرام پای ته رسوي: د وتلو کوډ ۱ کله چې کومه ازموینه ناکامه وي. وروستۍ یې
# وبولئ.
دنده ازموینې_پای_کړه()
    کرښه چاپ(تېرې_شوې، " تېرې شوې، "، ناکامې، " ناکامې")
    که ناکامې > ۰
        پای ته ورسوه(۱)
