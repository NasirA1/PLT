# ژبه: ps
# ۲۴ - انځور کښل (ګرافیک ماډیول)
#
# «راوړه ګرافیک» پروګرام ته د انځور کښلو لپاره یو ټاټ ورکوي. ځایونه په
# پکسلونو دي: س ښي لور ته لویېږي، ص کښته لور ته لویېږي، او (۰، ۰) پورته
# کیڼ کونج دی. رنګ د رنګونه ګڼنې یو غړی (رنګونه.سور، رنګونه.اسماني)، په قوسونو کې
# یو نوم ("خړ")، یو کوډ ("#ff8800") یا رنګ(...) دی. شکلونه په ترتیب کښل کېږي، نو
# وروستي شکلونه مخکیني پټوي.
#
# هڅه وکړئ: «چلول» کښېکښئ - انځور د ټاټ په پاڼه کې ښکاري. بیا لمر بل ځای
# ته یوسئ، رنګونه بدل کړئ، یا کور ته دوهمه کړکۍ ورکړئ.

راوړه ګرافیک

ټاټ(۴۰۰، ۳۰۰)

# آسمان د افق خوا ته روښانه کېږي: ۲۲ پټې، هره یو څه بل ډول شین.
تکرار متغیر پټه = ۰، پټه < ۲۲، پټه = پټه + ۱
    مستطیل(۰، پټه * ۱۰، ۴۰۰، ۱۰، رنګ(۴۰ + پټه * ۶، ۱۱۰ + پټه * ۵، ۲۳۰))

# لمر او وړانګې یې (د س او ص د توپیرونو جوړې: زاویو ته اړتیا نشته).
متغیر وړانګې = [(۰، -۵۰)، (۳۵، -۳۵)، (۵۰، ۰)، (۳۵، ۳۵)، (۰، ۵۰)، (-۳۵، ۳۵)، (-۵۰، ۰)، (-۳۵، -۳۵)]
د لیکې پلنوالی(۳)
تکرار متغیر ش = ۰، ش < اوږدوالی(وړانګې)، ش = ش + ۱
    متغیر (توپیر_س، توپیر_ص) = وړانګې[ش]
    لیکه(۳۳۰، ۶۰، ۳۳۰ + توپیر_س، ۶۰ + توپیر_ص، رنګونه.نارنجي)
دایره(۳۳۰، ۶۰، ۲۸، رنګونه.طلايي)

# ځمکه
مستطیل(۰، ۲۲۰، ۴۰۰، ۸۰، رنګ(۶۰، ۱۶۰، ۶۰))

# کور: دېوالونه، له لنډېدونکو لیکو جوړ چت، دروازه او کړکۍ.
مستطیل(۶۰، ۱۵۰، ۱۲۰، ۸۰، رنګونه.سپین)
د لیکې پلنوالی(۱)
تکرار متغیر قطار = ۰، قطار < ۵۰، قطار = قطار + ۱
    لیکه(۵۰ + قطار، ۱۵۰ - قطار، ۱۹۰ - قطار، ۱۵۰ - قطار، رنګ(۱۲۸، ۰، ۰))
مستطیل(۱۰۵، ۱۸۵، ۳۰، ۴۵، رنګونه.نسواري)
مستطیل(۱۴۰، ۱۶۵، ۲۸، ۲۴، رنګونه.اسماني)
د مستطیل څنډه(۱۴۰، ۱۶۵، ۲۸، ۲۴، رنګونه.تور)
لیکه(۱۵۴، ۱۶۵، ۱۵۴، ۱۸۹، رنګونه.تور)

# ونه
مستطیل(۲۶۲، ۱۶۵، ۱۶، ۶۰، رنګونه.نسواري)
دایره(۲۷۰، ۱۵۰، ۳۰، رنګونه.زرغون)
دایره(۲۵۵، ۱۶۵، ۲۰، رنګونه.زرغون)
دایره(۲۸۷، ۱۶۳، ۲۲، رنګونه.زرغون)

د لیکنې اندازه(۲۰)
لیکنه(۱۲، ۱۲، "د تندر ګرافیک"، رنګونه.سپین)
د لیکنې اندازه(۱۴)
لیکنه(۱۲، ۲۷۰، "(۰، ۰) پورته کیڼ کونج دی"، رنګونه.سپین)
