# ژبه: ps
# e4 - د اجرا تېروتنه
#
# دا پروګرام جوړېږي: د هغه ډولونه سم دي. ستونزه یوازې د اجرا پر مهال
# ښکاره کېږي، کله چې VM په صفر وېش ته اړ کېږي. د تېروتنې پیغام کرښه ښيي،
# او د بلنو سټک ښيي چې اجرا څنګه هلته ورسېده.

دنده اوسط(ارزښتونه_یې: عدد[]): عدد
    متغیر مجموعه_یې = ۰
    لپاره متغیر ش = ۰، ش < اوږدوالی(ارزښتونه_یې)، ش = ش + ۱
        مجموعه_یې = مجموعه_یې + ارزښتونه_یې[ش]
    راګرځه مجموعه_یې / اوږدوالی(ارزښتونه_یې)

کرښه چاپ("د [۴، ۸، ۶] اوسط = "، اوسط([۴، ۸، ۶]))
متغیر تش: عدد[] = []
کرښه چاپ("د [] اوسط = "، اوسط(تش))
کرښه چاپ("دې کرښې ته هېڅکله نه رسېږو")
