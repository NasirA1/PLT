# Advanced 01 - The data structures library
#
# import "datastructures" brings the classic structures: a stack, a queue, a linked list,
# a binary search tree and a heap, all written in Thunder itself (lib/thunder/en). Each is
# an object: make one with its constructor - Stack(), Queue() - and use it through its
# methods. All are generic - the element type in <angle brackets> is named where the
# variable is declared. The library is explained in docs/datastructures.md.

import "datastructures"

# --- a stack of strings: last in, first out --------------------------------------------
var plates: Stack<string> = Stack()
plates.push("washed")
plates.push("dried")
plates.push("put away")
println("top of the pile: ", plates.peek())
while not plates.is_empty()
    println("take: ", plates.pop())

# --- a queue of customers: first in, first out -----------------------------------------
var waiting: Queue<string> = Queue()
waiting.add("Anna")
waiting.add("Bashir")
waiting.add("Caro")
println("serving ", waiting.take(), "; next is ", waiting.peek(),
    " of ", waiting.size())

# --- a linked list: a chain of nodes ended by nothing ----------------------------------
var chain: LinkedList<int> = LinkedList()
chain.add_last(2)
chain.add_first(1)
chain.add_last(3)
println("as an array: ", chain.to_array(), ", has 3? ", chain.has(3))
var removed = chain.remove_value(2)
println("after removing 2 (", removed, "): ", chain.to_array())

# --- a binary search tree keeps its values in order ------------------------------------
var search_tree: BinaryTree<int> = BinaryTree()
for n in [50, 30, 80, 10, 40, 70, 90]
    search_tree.insert(n)
println("sorted: ", search_tree.sorted())
println("size ", search_tree.size(), ", height ", search_tree.height(),
    ", smallest ", search_tree.smallest(), ", largest ", search_tree.largest())
var gone = search_tree.remove(50)
println("removed the root? ", gone, "; without it: ", search_tree.sorted())

# --- a heap always hands out the smallest first ----------------------------------------
var todo: Heap<int> = Heap()
for priority in [7, 2, 9, 1, 5]
    todo.add(priority)
while not todo.is_empty()
    print(todo.take(), " ")
println()

# --- a set keeps every value once; an ordered set keeps them sorted too ----------------
var seen: Set<string> = Set()
for color in ["red", "blue", "red", "green", "blue"]
    seen.add(color)
println("unique colors: ", seen.values(), " (", seen.size(), " of 5 added)")
var cold: Set<string> = Set()
cold.add("blue")
cold.add("green")
println("warm only: ", seen.difference(cold).values())

var scores: OrderedSet<int> = OrderedSet()
for score in [70, 40, 90, 70, 40]
    scores.add(score)
println("distinct scores, sorted: ", scores.values(),
    ", from ", scores.smallest(), " to ", scores.largest())

# --- a deque is open at both ends; a doubly linked list walks both ways ----------------
var lane: Deque<string> = Deque()
lane.add_last("second")
lane.add_first("first")
lane.add_last("third")
println("deque: ", lane.to_array(), ", from the back: ", lane.take_last())

var history: DoublyLinkedList<string> = DoublyLinkedList()
history.add_last("one")
history.add_last("two")
history.add_last("three")
println("forwards: ", history.to_array(), ", backwards: ", history.to_array_reversed())

# --- a graph: towns, roads, and the shortest way between them --------------------------
var roads: Graph<string> = Graph()
roads.connect("Kabul", "Ghazni")
roads.connect("Ghazni", "Kandahar")
roads.connect("Kabul", "Bamyan")
roads.connect("Bamyan", "Herat")
roads.connect("Kandahar", "Herat")
println("from Kabul, nearest first: ", roads.bfs("Kabul"))
println("shortest road to Herat: ", roads.shortest_path("Kabul", "Herat"))

# --- a trie answers prefix questions in the length of the word -------------------------
var dictionary = Trie()
for word in ["car", "cart", "cat", "dog"]
    dictionary.add(word)
println("words: ", dictionary.words(), "; starts with ca? ", dictionary.has_prefix("ca"),
    "; is ca a word? ", dictionary.has("ca"))
