# ژبه: ps
# ۳۳ - رپېدونکی ځنګنده (حرکت)
#
# د L اوږدوالي ځنګنده په دې دوره رپېږي:
#     T = ۲ * پای() * جذر(L / g)
# او د وړې رپېدنې لپاره، زاویه یې له وخت سره:
#     زاویه(و) = پیل * تتمیم جیب(۲ * پای() * و / T) * نمايي(-زغم * و)
# د نمايي() برخه هغه هوا ده چې ورو ورو یې ودروي.
#
# دویم ځنګنده د همدې فورمول پر ځای ګام په ګام حل کېږي، په دقیق قانون:
# «زاویه‌يي شتاب -g / L * جیب(زاویه) دی». د وړې رپېدنې لپاره دواړه سره سم
# دي؛ د لویې لپاره نه — همدا د فورمول د «وړې رپېدنې» شرط مانا ده.
#
# هڅه وکړه: «چلول» کښېکښه. «پیل» لوی کړه (۲٫۲ وآزمایه) او وګوره چې دواړه
# څنګه سره بېلېږي، یا زغم ۰٫۰ کړه چې تل ورپېږي.

راوړه ګرافیک

ثابت پلنوالی = ۴۸۰
ثابت لوړوالی = ۳۲۰
ګرافیک.ټاټ(پلنوالی، لوړوالی)
ګرافیک.د چوکاټ چټکتیا(۳۰)
ګرافیک.د لیکنې اندازه(۱۲)

ثابت جاذبه = ۹٫۸۱           # متر پر ثانیه مربع
ثابت اوږدوالی_یې = ۱٫۶      # متره
ثابت پیل = ۰٫۶              # د پیل زاویه، په رادیانو (شاوخوا ۳۴ درجې)
ثابت زغم = ۰٫۰۸
ثابت ګام = ۱٫۰ / ۳۰٫۰       # یو چوکاټ، په ثانیو
ثابت پیمانه = ۱۱۵٫۰         # پکسله پر متر
ثابت سر_ص = ۵۰٫۰

ثابت دوره = ۲٫۰ * ریاضي.پای() * ریاضي.جذر(اوږدوالی_یې / جاذبه)

متغیر زاویه = پیل
متغیر چټکتیا = ۰٫۰          # رادیان پر ثانیه
متغیر وخت_یې = ۰٫۰

دنده پزه_س(سر: اعشاري، ز: اعشاري): اعشاري
    راګرځه سر + ریاضي.جیب(ز) * اوږدوالی_یې * پیمانه

دنده پزه_ص(ز: اعشاري): اعشاري
    راګرځه سر_ص + ریاضي.تتمیم جیب(ز) * اوږدوالی_یې * پیمانه

دنده وکاږه(سر: اعشاري، ز: اعشاري، رنګ_یې: متن، نوم: متن)
    متغیر س = پزه_س(سر، ز)
    متغیر ص = پزه_ص(ز)
    ګرافیک.د لیکې پلنوالی(۲٫۰)
    ګرافیک.لیکه(سر، سر_ص، س، ص، رنګ_یې)
    ګرافیک.دایره(س، ص، ۱۴٫۰، رنګ_یې)
    ګرافیک.دایره(س - ۴٫۰، ص - ۴٫۰، ۴٫۰، "#ffffff")
    ګرافیک.دایره(سر، سر_ص، ۴٫۰، "#8894b0")
    ګرافیک.لیکنه(سر - ۴۶٫۰، ۱۶٫۰، نوم، "#c9d1e4")

ترڅو رښتیا
    ګرافیک.ټاټ پاک کړه("#0b1020")

    # هغه کمان چې هر ځنګنده پکې ګرځي.
    ګرافیک.د لیکې پلنوالی(۱٫۰)
    تکرار متغیر ن = -۱۰، ن <= ۱۰، ن = ن + ۱
        متغیر ز = پیل * ن / ۱۰٫۰
        ګرافیک.ټکی(پزه_س(۱۴۰٫۰، ز)، پزه_ص(ز)، "#2b344a")
        ګرافیک.ټکی(پزه_س(۳۴۰٫۰، ز)، پزه_ص(ز)، "#2b344a")

    # کیڼ: فورمول، چې وړه رپېدنه فرض کوي.
    متغیر فورمول = پیل * ریاضي.تتمیم جیب(۲٫۰ * ریاضي.پای() * وخت_یې / دوره) * ریاضي.نمايي(-زغم * وخت_یې)
    وکاږه(۱۴۰٫۰، فورمول، "#4cc9f0"، "فورمول")

    # ښي: د حرکت د دقیق قانون یو ګام (له همغه زغم سره).
    چټکتیا = چټکتیا - جاذبه / اوږدوالی_یې * ریاضي.جیب(زاویه) * ګام - زغم * چټکتیا * ګام
    زاویه = زاویه + چټکتیا * ګام
    وکاږه(۳۴۰٫۰، زاویه، "#f7b801"، "ګام په ګام")

    ګرافیک.لیکنه(۱۴، لوړوالی - ۴۶، "دوره " + متن کړه(ریاضي.نیژدې کړه(دوره * ۱۰۰٫۰) / ۱۰۰٫۰) + " ثانیې"
        + "   (۲ * پای * جذر(L / g)، L = " + متن کړه(اوږدوالی_یې) + " م)"، "#8894b0")
    ګرافیک.لیکنه(۱۴، لوړوالی - ۲۸، "توپیر " + متن کړه(ریاضي.نیژدې کړه(ریاضي.مطلق(فورمول - زاویه) * ۱۰۰۰٫۰) / ۱۰۰۰٫۰)
        + " رادیان، له " + متن کړه(ریاضي.نیژدې کړه(وخت_یې)) + " ثانیو وروسته"، "#8894b0")
    ګرافیک.چوکاټ()
    وخت_یې = وخت_یې + ګام
