# 27 - The operating system (module os)
#
# The built-in module "os" gives programs files, commands, the clock and the
# environment. Its functions are only available after "import os", so these
# names stay free for programs that do not need them.
#
# Try it: from the command line, thundervm 27_os.thc one two
# passes "one" and "two" to the program (see args below).

import os
import file

# platform() answers with a member of the Platform enum (Platform.linux, .windows, .macos or
# .unknown); which one depends on the machine, so this program only prints what is true everywhere.
println("a known platform? ", contains(os.Platform.values, os.platform()), " (one of ", os.Platform.count, ")")
println("arguments: ", os.args())
var greeting = os.get_env("THUNDER_GREETING")
if greeting == ""
    greeting = "(THUNDER_GREETING is not set)"
println("greeting: ", greeting)

# Files: relative names are in the program's working directory.
var path = "thunder_demo.txt"
file.write(path, "first line\n")
file.append(path, "second line\n")
println("the file says: ", string.split(string.trim(file.read(path)), "\n"))
file.remove(path)
println("still there? ", file.exists(path))

# Commands run in the system shell; run passes their output through.
var status = os.run("echo Hello from the shell")
println("exit status ", status)
var (code, text) = os.run_output("echo captured")
println("run_output gave ", code, " and [", string.trim(text), "]")

var start = os.clock_ms()
os.sleep(20)
println("slept at least 20 ms? ", os.clock_ms() - start >= 20)
println("date and time have ", len(os.date_time()), " characters, e.g. 2026-11-06 14:30:00")
os.exit(0)
println("exit ends the program, so this line never runs")
