# ژبه: ps
# شکلونه، د ماډیول په توګه: هر څه چې دا فایل یې اعلانوي، هغه فایل یې کارولی شي چې دا راوړي.
#
#     راوړه "lib/shapes"

جوړښت څلور_اړخیز
    پلنوالی: عدد
    لوړوالی: عدد

دنده مساحت(ش: څلور_اړخیز): عدد
    راګرځه ش.پلنوالی × ش.لوړوالی

دنده کړۍ(ش: څلور_اړخیز): عدد
    راګرځه ۲ × (ش.پلنوالی + ش.لوړوالی)

دنده مربع_دی(ش: څلور_اړخیز): منطقي
    راګرځه ش.پلنوالی == ش.لوړوالی

دنده بیان(ش: څلور_اړخیز): متن
    راګرځه بڼه کړه("{}×{}: مساحت {}، کړۍ {}"، ش.پلنوالی، ش.لوړوالی، مساحت(ش)، کړۍ(ش))
