# ژبه: ps
# datastructures.th (lib/thunder/ps) - کلاسیک ډېټا جوړښتونه، پخپله په تندر کې لیکل شوي
# (docs/ps/datastructures.md)
#
# راوړه "datastructures" ولیکئ او ټول لاندې جوړښتونه ستاسې دي (thunderc دا فایل د ځان تر
# څنګ په lib/thunder کې مومي، یا یوه پوښۍ د --module-path سره ورکړئ). د ساکټونو یا ګرافیک
# په خلاف دلته هېڅ بهرنی نشته: دا ساده تندر دی، د لوستلو لپاره لیکل شوی - دا فایل پرانیزئ
# او وګورئ چې ډېرۍ، لیکه، ځنځیر، د لټون دوه‌اړخیزه ونه او د لومړیتوب لیکه رښتیا څنګه کار کوي.
#
# توکي عددونه دي. تندر عمومي (generic) ډولونه نه لري، نو د متنونو (یا ستاسې د خپل جوړښت)
# جوړښت داسې جوړېږي چې اړین جوړښت خپل پروګرام ته کاپي کړئ او د توکي ډول یې بدل کړئ -
# الګوریتمونه په خپل حال پاتې کېږي.
#
# له تش جوړښته اخیستل د پروګرام تېروتنه ده او پروګرام دروي، لکه د دننۍ دندې ناسمه بلنه.
# لومړی ډېرۍ_تشه_ده / لیکه_تشه_ده / لومړیتوب_لیکه_تشه_ده وپوښتئ.

# ------------------------------------------------- ډېرۍ (وروستی دننه، لومړی بهر)
#
# د کاسو ډېرۍ: ورزیاتول یو ارزښت سر ته ږدي، اخیستل همغه سر بېرته راوړي.
# هره عملیه O(1) ده.

جوړښت ډېرۍ
    توکي: عدد[]

# یوه نوې، تشه ډېرۍ.
دنده نوې_ډېرۍ(): ډېرۍ
    متغیر تش: عدد[] = []
    راګرځه ډېرۍ(توکي: تش)

# یو ارزښت سر ته ږدي.
دنده ډېرۍ_ته_ورزیات_کړه(ډېرۍ_: ډېرۍ، ارزښت: عدد)
    ورزیات کړه(ډېرۍ_.توکي، ارزښت)

# د سر ارزښت اخلي او راګرځوي یې.
دنده له_ډېرۍ_واخله(ډېرۍ_: ډېرۍ): عدد
    راګرځه وروستی واخله(ډېرۍ_.توکي)

# د سر ارزښت، بې له اخیستلو.
دنده ډېرۍ_وګوره(ډېرۍ_: ډېرۍ): عدد
    راګرځه ډېرۍ_.توکي[اوږدوالی(ډېرۍ_.توکي) - ۱]

# ډېرۍ څومره ارزښتونه لري.
دنده د_ډېرۍ_کچه(ډېرۍ_: ډېرۍ): عدد
    راګرځه اوږدوالی(ډېرۍ_.توکي)

دنده ډېرۍ_تشه_ده(ډېرۍ_: ډېرۍ): منطقي
    راګرځه اوږدوالی(ډېرۍ_.توکي) == ۰

# ------------------------------------------------- لیکه (لومړی دننه، لومړی بهر)
#
# د دوکان مخې ته لیکه: لیکې_ته_ورزیات_کړه پای ته درېږي، له_لیکې_واخله سر ته رسیدلی
# خدمتوي. د سر شاخص ښویېږي، د هر توکي له کښته کولو پرته، نو دواړه په منځني ډول O(1) دي؛
# د خدمت شویو توکو ځای هر کله چې له پاتې نورو لوی شي بېرته اخیستل کېږي.

جوړښت لیکه
    توکي: عدد[]
    سر: عدد

# یوه نوې، تشه لیکه.
دنده نوې_لیکه(): لیکه
    متغیر تش: عدد[] = []
    راګرځه لیکه(توکي: تش، سر: ۰)

# د لیکې پای ته درېږي.
دنده لیکې_ته_ورزیات_کړه(لیکه_: لیکه، ارزښت: عدد)
    ورزیات کړه(لیکه_.توکي، ارزښت)

# د لیکې سر خدمتوي (لیرې کوي یې او راګرځوي یې).
دنده له_لیکې_واخله(لیکه_: لیکه): عدد
    متغیر ارزښت = لیکه_.توکي[لیکه_.سر]
    لیکه_.سر = لیکه_.سر + ۱
    که لیکه_.سر * ۲ >= اوږدوالی(لیکه_.توکي) او لیکه_.سر > ۸
        لیکه_.توکي = ټوټه(لیکه_.توکي، لیکه_.سر، اوږدوالی(لیکه_.توکي))
        لیکه_.سر = ۰
    راګرځه ارزښت

# د لیکې سر، بې له خدمتولو.
دنده لیکه_وګوره(لیکه_: لیکه): عدد
    راګرځه لیکه_.توکي[لیکه_.سر]

# څومره ارزښتونه انتظار کوي.
دنده د_لیکې_کچه(لیکه_: لیکه): عدد
    راګرځه اوږدوالی(لیکه_.توکي) - لیکه_.سر

دنده لیکه_تشه_ده(لیکه_: لیکه): منطقي
    راګرځه د_لیکې_کچه(لیکه_) == ۰

# ------------------------------------------------- ځنځیر (یو اړخیز تړلی لړ)
#
# د غوټیو ځنځیر، چې هره غوټۍ یوازې خپل ارزښت او راتلونکې غوټۍ پېژني. د تندر جوړښتونه
# ځانونه نشي رانغښتلای، نو غوټۍ په دوو موازي لړیو کې ژوند کوي او «اشاره» یې شاخص دی:
# راتلونکی[غ] له غ وروسته غوټۍ ده، او -۱ مانا «هېڅ» - همداسې ځنځیرونه د هغو ژبو دننه
# جوړېږي چې اشارې (pointers) هم نه لري. سر ته ورزیاتول O(1) دي؛ د لیرې شویو غوټیو
# ځایونه تر هغو پاتې کېږي چې ځنځیر پخپله پرېښودل شي.

جوړښت ځنځیر
    ارزښتونه: عدد[]
    راتلونکی: عدد[]
    سر: عدد
    شمېر: عدد

# یو نوی، تش ځنځیر.
دنده نوی_ځنځیر(): ځنځیر
    متغیر ارزښتونه_: عدد[] = []
    متغیر راتلونکی_: عدد[] = []
    راګرځه ځنځیر(ارزښتونه: ارزښتونه_، راتلونکی: راتلونکی_، سر: -۱، شمېر: ۰)

# یو ارزښت سر ته ورزیاتوي: نوې غوټۍ پخواني سر ته اشاره کوي.
دنده ځنځیر_سر_ته_ورزیات_کړه(ځنځیر_: ځنځیر، ارزښت: عدد)
    ورزیات کړه(ځنځیر_.ارزښتونه، ارزښت)
    ورزیات کړه(ځنځیر_.راتلونکی، ځنځیر_.سر)
    ځنځیر_.سر = اوږدوالی(ځنځیر_.ارزښتونه) - ۱
    ځنځیر_.شمېر = ځنځیر_.شمېر + ۱

# یو ارزښت پای ته ورزیاتوي: تر وروستۍ غوټۍ ولاړ شه، نوې پرې وځړوه.
دنده ځنځیر_پای_ته_ورزیات_کړه(ځنځیر_: ځنځیر، ارزښت: عدد)
    ورزیات کړه(ځنځیر_.ارزښتونه، ارزښت)
    ورزیات کړه(ځنځیر_.راتلونکی، -۱)
    متغیر غوټۍ = اوږدوالی(ځنځیر_.ارزښتونه) - ۱
    که ځنځیر_.سر == -۱
        ځنځیر_.سر = غوټۍ
    کنه
        متغیر وروستۍ = ځنځیر_.سر
        ترڅو ځنځیر_.راتلونکی[وروستۍ] != -۱
            وروستۍ = ځنځیر_.راتلونکی[وروستۍ]
        ځنځیر_.راتلونکی[وروستۍ] = غوټۍ
    ځنځیر_.شمېر = ځنځیر_.شمېر + ۱

# د سر ارزښت لیرې کوي او راګرځوي یې.
دنده ځنځیر_له_سره_واخله(ځنځیر_: ځنځیر): عدد
    متغیر ارزښت = ځنځیر_.ارزښتونه[ځنځیر_.سر]
    ځنځیر_.سر = ځنځیر_.راتلونکی[ځنځیر_.سر]
    ځنځیر_.شمېر = ځنځیر_.شمېر - ۱
    راګرځه ارزښت

# لومړۍ هغه غوټۍ لیرې کوي چې دا ارزښت لري. رښتیا که ومونده.
دنده له_ځنځیره_لیرې_کړه(ځنځیر_: ځنځیر، ارزښت: عدد): منطقي
    متغیر غوټۍ = ځنځیر_.سر
    متغیر پخوانۍ = -۱
    ترڅو غوټۍ != -۱
        که ځنځیر_.ارزښتونه[غوټۍ] == ارزښت
            که پخوانۍ == -۱
                ځنځیر_.سر = ځنځیر_.راتلونکی[غوټۍ]
            کنه
                ځنځیر_.راتلونکی[پخوانۍ] = ځنځیر_.راتلونکی[غوټۍ]
            ځنځیر_.شمېر = ځنځیر_.شمېر - ۱
            راګرځه رښتیا
        پخوانۍ = غوټۍ
        غوټۍ = ځنځیر_.راتلونکی[غوټۍ]
    راګرځه درواغ

# رښتیا که کومه غوټۍ دا ارزښت لري.
دنده ځنځیر_لري(ځنځیر_: ځنځیر، ارزښت: عدد): منطقي
    متغیر غوټۍ = ځنځیر_.سر
    ترڅو غوټۍ != -۱
        که ځنځیر_.ارزښتونه[غوټۍ] == ارزښت
            راګرځه رښتیا
        غوټۍ = ځنځیر_.راتلونکی[غوټۍ]
    راګرځه درواغ

# ځنځیر څومره ارزښتونه لري.
دنده د_ځنځیر_کچه(ځنځیر_: ځنځیر): عدد
    راګرځه ځنځیر_.شمېر

# ارزښتونه د ځنځیر په ترتیب، د ساده لړۍ په بڼه.
دنده ځنځیر_لړۍ_کړه(ځنځیر_: ځنځیر): عدد[]
    متغیر پایله: عدد[] = []
    متغیر غوټۍ = ځنځیر_.سر
    ترڅو غوټۍ != -۱
        ورزیات کړه(پایله، ځنځیر_.ارزښتونه[غوټۍ])
        غوټۍ = ځنځیر_.راتلونکی[غوټۍ]
    راګرځه پایله

# ------------------------------------------------- د لټون دوه‌اړخیزه ونه
#
# د هرې غوټۍ کیڼه څانګه کوچني ارزښتونه لري، ښۍ یې لوی، نو یو ارزښت په O(لوړوالی)
# ګامونو کې موندل کېږي - O(log n) کله چې ونه په مناسب ډول برابره وي. غوټۍ لکه په
# ځنځیر کې په موازي لړیو کې دي: کیڼ[غ] او ښی[غ] د غ بچي دي، -۱ مانا «بچی نشته».
# تکراري ارزښتونه د ورزیاتولو پر مهال له پامه غورځول کېږي.

جوړښت ونه
    ارزښتونه: عدد[]
    کیڼ: عدد[]
    ښی: عدد[]
    ریښه: عدد
    شمېر: عدد

# یوه نوې، تشه ونه.
دنده نوې_ونه(): ونه
    متغیر ارزښتونه_: عدد[] = []
    متغیر کیڼ_: عدد[] = []
    متغیر ښی_: عدد[] = []
    راګرځه ونه(ارزښتونه: ارزښتونه_، کیڼ: کیڼ_، ښی: ښی_، ریښه: -۱، شمېر: ۰)

# یو ارزښت پر خپل ترتیب شوي ځای ورزیاتوي. ارزښت چې له وړاندې په ونه کې وي، همداسې پرېښودل کېږي.
دنده ونې_ته_ورزیات_کړه(ونه_: ونه، ارزښت: عدد)
    ورزیات کړه(ونه_.ارزښتونه، ارزښت)
    ورزیات کړه(ونه_.کیڼ، -۱)
    ورزیات کړه(ونه_.ښی، -۱)
    متغیر غوټۍ = اوږدوالی(ونه_.ارزښتونه) - ۱
    که ونه_.ریښه == -۱
        ونه_.ریښه = غوټۍ
        ونه_.شمېر = ۱
        راګرځه
    متغیر ځای = ونه_.ریښه
    ترڅو رښتیا
        که ارزښت == ونه_.ارزښتونه[ځای]
            راګرځه
        که ارزښت < ونه_.ارزښتونه[ځای]
            که ونه_.کیڼ[ځای] == -۱
                ونه_.کیڼ[ځای] = غوټۍ
                ونه_.شمېر = ونه_.شمېر + ۱
                راګرځه
            ځای = ونه_.کیڼ[ځای]
        کنه
            که ونه_.ښی[ځای] == -۱
                ونه_.ښی[ځای] = غوټۍ
                ونه_.شمېر = ونه_.شمېر + ۱
                راګرځه
            ځای = ونه_.ښی[ځای]

# رښتیا که ارزښت په ونه کې وي.
دنده ونه_لري(ونه_: ونه، ارزښت: عدد): منطقي
    متغیر ځای = ونه_.ریښه
    ترڅو ځای != -۱
        که ارزښت == ونه_.ارزښتونه[ځای]
            راګرځه رښتیا
        که ارزښت < ونه_.ارزښتونه[ځای]
            ځای = ونه_.کیڼ[ځای]
        کنه
            ځای = ونه_.ښی[ځای]
    راګرځه درواغ

# ونه څومره ارزښتونه لري.
دنده د_ونې_کچه(ونه_: ونه): عدد
    راګرځه ونه_.شمېر

# له ریښې کښته تر ټولو اوږده لار له څومره غوټیو تېرېږي (د تشې ونې لپاره ۰).
دنده د_ونې_لوړوالی(ونه_: ونه): عدد
    راګرځه _د_غوټۍ_لوړوالی(ونه_، ونه_.ریښه)

دنده _د_غوټۍ_لوړوالی(ونه_: ونه، غوټۍ: عدد): عدد
    که غوټۍ == -۱
        راګرځه ۰
    متغیر کیڼه_خوا = _د_غوټۍ_لوړوالی(ونه_، ونه_.کیڼ[غوټۍ])
    متغیر ښۍ_خوا = _د_غوټۍ_لوړوالی(ونه_، ونه_.ښی[غوټۍ])
    راګرځه ۱ + اعظمه(کیڼه_خوا، ښۍ_خوا)

# تر ټولو کوچنی ارزښت: همېش کیڼ لور ته ځه.
دنده د_ونې_کمینه(ونه_: ونه): عدد
    متغیر ځای = ونه_.ریښه
    ترڅو ونه_.کیڼ[ځای] != -۱
        ځای = ونه_.کیڼ[ځای]
    راګرځه ونه_.ارزښتونه[ځای]

# تر ټولو لوی ارزښت: همېش ښي لور ته ځه.
دنده د_ونې_اعظمه(ونه_: ونه): عدد
    متغیر ځای = ونه_.ریښه
    ترڅو ونه_.ښی[ځای] != -۱
        ځای = ونه_.ښی[ځای]
    راګرځه ونه_.ارزښتونه[ځای]

# هر ارزښت په پورته کېدونکي ترتیب (منځنی تګ: کیڼه څانګه، غوټۍ، ښۍ څانګه).
دنده ونه_په_ترتیب(ونه_: ونه): عدد[]
    متغیر پایله: عدد[] = []
    _د_ونې_تګ(ونه_، ونه_.ریښه، پایله)
    راګرځه پایله

دنده _د_ونې_تګ(ونه_: ونه، غوټۍ: عدد، پایله: عدد[])
    که غوټۍ == -۱
        راګرځه
    _د_ونې_تګ(ونه_، ونه_.کیڼ[غوټۍ]، پایله)
    ورزیات کړه(پایله، ونه_.ارزښتونه[غوټۍ])
    _د_ونې_تګ(ونه_، ونه_.ښی[غوټۍ]، پایله)

# یو ارزښت لیرې کوي. رښتیا که په ونه کې و. غوټۍ چې دوه بچي لري خپل ارزښت د ښۍ څانګې
# له کمینې (په ترتیب کې راتلونکی ارزښت) سره بدلوي او بیا همغه غوټۍ، چې تر یوه زیات
# بچي نه لري، له ونې ایستل کېږي.
دنده له_ونې_لیرې_کړه(ونه_: ونه، ارزښت: عدد): منطقي
    متغیر ځای = ونه_.ریښه
    متغیر مور = -۱
    ترڅو ځای != -۱ او ونه_.ارزښتونه[ځای] != ارزښت
        مور = ځای
        که ارزښت < ونه_.ارزښتونه[ځای]
            ځای = ونه_.کیڼ[ځای]
        کنه
            ځای = ونه_.ښی[ځای]
    که ځای == -۱
        راګرځه درواغ
    که ونه_.کیڼ[ځای] != -۱ او ونه_.ښی[ځای] != -۱
        متغیر ځایناستی = ونه_.ښی[ځای]
        متغیر د_ځایناستي_مور = ځای
        ترڅو ونه_.کیڼ[ځایناستی] != -۱
            د_ځایناستي_مور = ځایناستی
            ځایناستی = ونه_.کیڼ[ځایناستی]
        ونه_.ارزښتونه[ځای] = ونه_.ارزښتونه[ځایناستی]
        ځای = ځایناستی
        مور = د_ځایناستي_مور
    متغیر بچی = ونه_.کیڼ[ځای]
    که بچی == -۱
        بچی = ونه_.ښی[ځای]
    که مور == -۱
        ونه_.ریښه = بچی
    کنه که ونه_.کیڼ[مور] == ځای
        ونه_.کیڼ[مور] = بچی
    کنه
        ونه_.ښی[مور] = بچی
    ونه_.شمېر = ونه_.شمېر - ۱
    راګرځه رښتیا

# ------------------------------------------------- د لومړیتوب لیکه (کمینه-ګودام)
#
# له_لومړیتوب_لیکې_واخله همېش تر ټولو کوچنی ارزښت لومړی راکوي، ارزښتونه چې هر ترتیب
# راغلي وي. لیکه یوه دوه‌اړخیزه ونه ده چې په یوه لړۍ کې ځای شوې: د ش شاخص غوټۍ بچي په
# ۲*ش + ۱ او ۲*ش + ۲ کې ناست دي، او هره مور <= خپلو بچیو ده. ورزیاتول او اخیستل O(log n) دي.

جوړښت لومړیتوب_لیکه
    توکي: عدد[]

# یوه نوې، تشه د لومړیتوب لیکه.
دنده نوې_لومړیتوب_لیکه(): لومړیتوب_لیکه
    متغیر تش: عدد[] = []
    راګرځه لومړیتوب_لیکه(توکي: تش)

# یو ارزښت ورزیاتوي: پای ته یې ولیکه، بیا دې پورته ځي ترڅو له خپلې مور کوچنی وي.
دنده لومړیتوب_لیکې_ته_ورزیات_کړه(لیکه_: لومړیتوب_لیکه، ارزښت: عدد)
    ورزیات کړه(لیکه_.توکي، ارزښت)
    متغیر ځای = اوږدوالی(لیکه_.توکي) - ۱
    ترڅو ځای > ۰
        متغیر مور = (ځای - ۱) / ۲
        که لیکه_.توکي[مور] <= لیکه_.توکي[ځای]
            ودرېږه
        متغیر ساتلی = لیکه_.توکي[مور]
        لیکه_.توکي[مور] = لیکه_.توکي[ځای]
        لیکه_.توکي[ځای] = ساتلی
        ځای = مور

# تر ټولو کوچنی ارزښت لیرې کوي او راګرځوي یې: وروستی توکی ریښې ته خېژي، بیا تر هر
# کوچني بچي لاندې ډوبېږي.
دنده له_لومړیتوب_لیکې_واخله(لیکه_: لومړیتوب_لیکه): عدد
    متغیر کمینه_ = لیکه_.توکي[۰]
    متغیر وروستی = وروستی واخله(لیکه_.توکي)
    که اوږدوالی(لیکه_.توکي) == ۰
        راګرځه کمینه_
    لیکه_.توکي[۰] = وروستی
    متغیر ځای = ۰
    ترڅو رښتیا
        متغیر بچی = ځای * ۲ + ۱
        که بچی >= اوږدوالی(لیکه_.توکي)
            ودرېږه
        که بچی + ۱ < اوږدوالی(لیکه_.توکي) او لیکه_.توکي[بچی + ۱] < لیکه_.توکي[بچی]
            بچی = بچی + ۱
        که لیکه_.توکي[ځای] <= لیکه_.توکي[بچی]
            ودرېږه
        متغیر ساتلی = لیکه_.توکي[ځای]
        لیکه_.توکي[ځای] = لیکه_.توکي[بچی]
        لیکه_.توکي[بچی] = ساتلی
        ځای = بچی
    راګرځه کمینه_

# تر ټولو کوچنی ارزښت، بې له لیرې کولو.
دنده لومړیتوب_لیکه_وګوره(لیکه_: لومړیتوب_لیکه): عدد
    راګرځه لیکه_.توکي[۰]

# لیکه څومره ارزښتونه لري.
دنده د_لومړیتوب_لیکې_کچه(لیکه_: لومړیتوب_لیکه): عدد
    راګرځه اوږدوالی(لیکه_.توکي)

دنده لومړیتوب_لیکه_تشه_ده(لیکه_: لومړیتوب_لیکه): منطقي
    راګرځه اوږدوالی(لیکه_.توکي) == ۰
