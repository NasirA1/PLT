# ژبه: ps
# د څو فایلونو یو پروګرام په پښتو - د VS Code د پراخونې د ازمویلو لپاره، په ځانګړي توګه
# د ښي-نه-کیڼ سمونګر لپاره (Thunder: Open in the Right-to-Left Editor).
#
# هڅه یې وکړئ: پر «هندسه.مساحت» یا «هندسه.څلور_اړخیز» F12 lib/shapes.th ته ورځي، او
# پر «احصایه.منځنی» F12 lib/statistics.th ته.

راوړه "lib/shapes"
راوړه "lib/statistics"
راوړه سیسټم

ثابت د_خونو_شمېر = ۳

دنده خونې(): هندسه.څلور_اړخیز[]
    راګرځه [هندسه.څلور_اړخیز(۴، ۳)، هندسه.څلور_اړخیز(۲، ۷)، هندسه.څلور_اړخیز(۵، ۵)]

دنده راپور(ټولې_خونې: هندسه.څلور_اړخیز[])
    تکرار خونه په ټولې_خونې
        چاپ("  "، هندسه.بیان(خونه))
        که هندسه.مربع_دی(خونه)
            چاپ("  (مربع)")
        کرښه چاپ("")

دنده اصلي()
    متغیر ټولې_خونې = خونې()
    کرښه چاپ("پروګرام "، اوږدوالی(ټولې_خونې)، " له "، د_خونو_شمېر، " تمه شویو خونو لري؛ د قوماندې کرښې وویل "،
            سیسټم.دلیلونه()، ":")
    راپور(ټولې_خونې)
    متغیر مساحتونه = [هندسه.مساحت(ټولې_خونې[۰])، هندسه.مساحت(ټولې_خونې[۱])، هندسه.مساحت(ټولې_خونې[۲])]
    کرښه چاپ("ټول مساحت: "، احصایه.ټول_مساحت(ټولې_خونې))
    کرښه چاپ("تر ټولو لویه خونه: "، احصایه.تر_ټولو_لوی(مساحتونه))
    کرښه چاپ("منځنی مساحت: "، احصایه.منځنی(مساحتونه))
    کرښه چاپ("په شپاړسیز: "، شپاړسیز کړه(احصایه.ټول_مساحت(ټولې_خونې)))
