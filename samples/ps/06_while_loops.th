// ژبه: ps
// ۰۶ - د «ترڅو» تکرار
//
// «ترڅو» خپله برخه تر هغه تکراروي چې شرط رښتیا وي. «ودرېږه» تکرار له
// وخته مخکې ختموي؛ «دوام» راتلونکې ازموینې ته ځي.
//
// دا پروګرام د کولاتز لړۍ تعقیبوي: جفت عددونه نیمول، او طاق عدد ن په
// ۳ن + ۱ اړول، تر هغه چې ۱ ته ورسېږي.

متغیر ن = ۲۷
متغیر ګامونه = ۰
متغیر لوړ = ن

ترڅو ن != ۱
    که ن % ۲ == ۰
        ن = ن / ۲
    کنه
        ن = ۳ * ن + ۱
    که ن > لوړ
        لوړ = ن
    ګامونه = ګامونه + ۱

کرښه چاپ("۲۷ له "، ګامونه، " ګامونو وروسته ۱ ته رسېږي")
کرښه چاپ("په لاره کې تر ټولو لوړ ارزښت "، لوړ، " و")

// له ۲۰ نه کوچني طاق عددونه جمع کړه، او په ۱۵ کې ودرېږه.
متغیر ش = ۰
متغیر مجموعه_یې = ۰
ترڅو رښتیا
    ش = ش + ۱
    که ش > ۱۵
        ودرېږه
    که ش % ۲ == ۰
        دوام
    مجموعه_یې = مجموعه_یې + ش
کرښه چاپ("۱ + ۳ + ... + ۱۵ = "، مجموعه_یې)
