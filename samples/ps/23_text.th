# ژبه: ps
# ۲۳ - له متن سره کار
#
# دننۍ دندې متن ټوټې کوي او بیا یې سره یو ځای کوي. ځایونه توري شمېري
# (پښتو توري هم) او له ۰ پیلېږي. یو واټن له پیل څخه تر پای پورې پیل پکې
# شامل دی خو پای نه: د متن برخه("تندر"، ۰، ۲) "تن" دی.
#
# هڅه وکړئ: هغه جلا کوونکی بدل کړئ چې وېشه ته ورکول کېږي، یا د «ریکارډ» متن.

متغیر ریکارډ = "  ملالۍ میوندوال، ۱۸۶۱، میوند  "
متغیر پاک = متن.پاک کړه(ریکارډ)
کرښه چاپ("["، پاک، "]")

متغیر برخې = متن.وېشه(پاک، "، ")
کرښه چاپ(برخې، " "، اوږدوالی(برخې)، " برخې لري")
متغیر نوم = برخې[۰]
کرښه چاپ("لوی توري: "، متن.لوی توري کړه("Thunder")، " / کوچنی توري: "، متن.کوچنی توري کړه("THUNDER"))
کرښه چاپ("لومړی نوم: "، متن.برخه(نوم، ۰، ځای یې(نوم، " ")))
کرښه چاپ("په ملالۍ پیلېږي؟ "، متن.پیلېږي په(نوم، "ملالۍ")، "، په وال پایېږي؟ "، متن.پایېږي په(نوم، "وال"))
کرښه چاپ("میوند یادوي؟ "، شامل دی(پاک، "میوند")، "، کابل؟ "، شامل دی(پاک، "کابل"))
کرښه چاپ(متن.بدل کړه(پاک، "، "، " | "))
کرښه چاپ(متن.یو ځای کړه(سرچپه کړه(برخې)، " ← ")، " "، سرچپه کړه("ګل"))
کرښه چاپ(متن.تکرار کړه("=-"، ۱۲))

که متن.عدد دی(برخې[۱])
    کرښه چاپ("دوه سوه کاله وروسته: "، عدد کړه(برخې[۱]) + ۲۰۰)

# هر توری یوه شمېره لري (د یونیکوډ کوډ یې).
کرښه چاپ(متن.د توري کوډ("A")، " "، متن.د توري کوډ("ا")، " "، متن.د کوډ توری(متن.د توري کوډ("ا") + ۱))

# د قیصر رمز هر انګلیسي توری د الفبا په اوږدو کې درې ځایه مخکې وړي.
دنده قیصر(متن_یې: متن، ګام: عدد): متن
    متغیر پایله = ""
    تکرار متغیر ش = ۰، ش < اوږدوالی(متن_یې)، ش = ش + ۱
        متغیر کوډ = متن.د توري کوډ(متن_یې[ش])
        که کوډ >= متن.د توري کوډ("a") او کوډ <= متن.د توري کوډ("z")
            کوډ = (کوډ - متن.د توري کوډ("a") + ګام + ۲۶) % ۲۶ + متن.د توري کوډ("a")
        پایله = پایله + متن.د کوډ توری(کوډ)
    راګرځه پایله

متغیر راز = قیصر("hello world"، ۳)
کرښه چاپ(راز، " ← "، قیصر(راز، -۳))
