# ژبه: ps
# ۱۳ - دوه بُعدي لړۍ
#
# عدد[][] داسې لړۍ ده چې توکي یې عدد[] لړۍ دي: یوه جال.
# لړۍ(قطارونه، لړۍ(ستونونه، ۰)) خپلواک قطارونه جوړوي (هر قطار کاپي ده).

دنده ماتریس_جوړ_کړه(قطارونه: عدد، ستونونه: عدد): عدد[][]
    راګرځه لړۍ(قطارونه، لړۍ(ستونونه، ۰))

دنده ضرب(الف: عدد[][]، ب: عدد[][]): عدد[][]
    متغیر پایله = ماتریس_جوړ_کړه(اوږدوالی(الف)، اوږدوالی(ب[۰]))
    لپاره متغیر قطار = ۰، قطار < اوږدوالی(الف)، قطار = قطار + ۱
        لپاره متغیر ستون = ۰، ستون < اوږدوالی(ب[۰])، ستون = ستون + ۱
            متغیر جمع = ۰
            لپاره متغیر ک = ۰، ک < اوږدوالی(ب)، ک = ک + ۱
                جمع = جمع + الف[قطار][ک] * ب[ک][ستون]
            پایله[قطار][ستون] = جمع
    راګرځه پایله

دنده ښودل(نوم: متن، م: عدد[][])
    کرښه چاپ(نوم، ":")
    لپاره متغیر ش = ۰، ش < اوږدوالی(م)، ش = ش + ۱
        کرښه چاپ("  "، م[ش])

متغیر الف = [[۱، ۲]، [۳، ۴]]
متغیر ب = [[۵، ۶]، [۷، ۸]]
ښودل("الف"، الف)
ښودل("ب"، ب)
ښودل("الف × ب"، ضرب(الف، ب))

متغیر واحد = ماتریس_جوړ_کړه(۳، ۳)
لپاره متغیر ش = ۰، ش < ۳، ش = ش + ۱
    واحد[ش][ش] = ۱
ښودل("واحد ماتریس"، واحد)
