# ژبه: ps
# ۱۱ - د بلبلې ترتیب
#
# یو مشهور الګوریتم چې له تکرارونو، پرتلو او د لړۍ له بدلونونو جوړ دی.
# هر تېرېدل تر ټولو لوی پاتې ارزښت، لکه بلبله، د لړۍ پای ته رسوي.

دنده ببلي_ترتیب(ارزښتونه_یې: عدد[])
    متغیر ن = اوږدوالی(ارزښتونه_یې)
    لپاره متغیر پړاو = ۰، پړاو < ن - ۱، پړاو = پړاو + ۱
        متغیر بدل_شول = درواغ
        لپاره متغیر ش = ۰، ش < ن - ۱ - پړاو، ش = ش + ۱
            که ارزښتونه_یې[ش] > ارزښتونه_یې[ش + ۱]
                متغیر لنډمهاله = ارزښتونه_یې[ش]
                ارزښتونه_یې[ش] = ارزښتونه_یې[ش + ۱]
                ارزښتونه_یې[ش + ۱] = لنډمهاله
                بدل_شول = رښتیا
        کرښه چاپ("له "، پړاو + ۱، " تېرېدو وروسته: "، ارزښتونه_یې)
        که نه بدل_شول
            راګرځه     # دمخه ترتیب ده: وخت دمخه ودرېږه

متغیر معلومات = [۲۹، ۱۰، ۱۴، ۳۷، ۱۳، ۵]
کرښه چاپ("مخکې: "، معلومات)
ببلي_ترتیب(معلومات)
کرښه چاپ("ترتیب شوې: "، معلومات)
