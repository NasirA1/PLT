# ژبه: ps
# algorithms.th (lib/thunder/ps) - د ترتیب او لټون کلاسیک الګوریتمونه، پخپله په تندر کې
# لیکل شوي (docs/ps/algorithms.md)
#
# راوړه "algorithms" ولیکئ او ټولې لاندې دندې ستاسې دي. دلته هېڅ بهرنی نشته: دا ساده
# تندر دی، د لوستلو لپاره لیکل شوی - دا فایل پرانیزئ او وګورئ چې هغه الګوریتمونه چې هره
# ژبه یې لري رښتیا څنګه کار کوي. (د ورځنۍ کارونې لپاره تندر دننۍ دنده ترتیب کړه() لري؛
# دلته لیکل شوي دي چې داسې دنده دننه څه کوي.)
#
# هر ترتیب پر عدد[] کار کوي او پر خپل ځای یې په پورته کېدونکي ترتیب اڼي. لټونونه د
# ارزښت ځای (شاخص) راګرځوي، یا -۱ کله چې نه وي.

# ---------------------------------------------------------------- ترتیب

# حبابي ترتیب، O(n²): لړۍ بیا بیا جارو کړه او هغه ګاونډیان چې ترتیب یې ناسم وي بدل
# کړه. له هر جارو وروسته تر ټولو لوی ارزښت خپل وروستي ځای ته «راپورته» شوی وي؛ جارو
# چې هېڅ نه بدلوي مانا لړۍ ترتیب شوې ده.
دنده حبابي_ترتیب(ارزښتونه: عدد[])
    متغیر ناترتیب = اوږدوالی(ارزښتونه)
    ترڅو ناترتیب > ۱
        متغیر بدل_شو = درواغ
        لپاره متغیر ش = ۱، ش < ناترتیب، ش = ش + ۱
            که ارزښتونه[ش - ۱] > ارزښتونه[ش]
                متغیر ساتلی = ارزښتونه[ش - ۱]
                ارزښتونه[ش - ۱] = ارزښتونه[ش]
                ارزښتونه[ش] = ساتلی
                بدل_شو = رښتیا
        که نه بدل_شو
            راګرځه
        ناترتیب = ناترتیب - ۱

# غوراوی ترتیب، O(n²): د ناترتیب پاتې برخې کمینه ومومه او مخ ته یې بدله کړه، بیا
# پاتې برخه همداسې. ساده دی، او هر ارزښت تر یوه ځله زیات نه خوځوي.
دنده غوراوی_ترتیب(ارزښتونه: عدد[])
    لپاره متغیر پیل = ۰، پیل < اوږدوالی(ارزښتونه) - ۱، پیل = پیل + ۱
        متغیر کوچنی = پیل
        لپاره متغیر ش = پیل + ۱، ش < اوږدوالی(ارزښتونه)، ش = ش + ۱
            که ارزښتونه[ش] < ارزښتونه[کوچنی]
                کوچنی = ش
        که کوچنی != پیل
            متغیر ساتلی = ارزښتونه[پیل]
            ارزښتونه[پیل] = ارزښتونه[کوچنی]
            ارزښتونه[کوچنی] = ساتلی

# ننویستل ترتیب، O(n²) خو نږدې ترتیب شوې ننوتنه O(n): بل ارزښت واخله او له هر لوی
# ارزښته یې کیڼ لور ته وښویوه - لکه ډېری خلک چې د پتو پاڼې اڼي.
دنده ننویستل_ترتیب(ارزښتونه: عدد[])
    لپاره متغیر ش = ۱، ش < اوږدوالی(ارزښتونه)، ش = ش + ۱
        متغیر ارزښت = ارزښتونه[ش]
        متغیر ځای = ش
        ترڅو ځای > ۰ او ارزښتونه[ځای - ۱] > ارزښت
            ارزښتونه[ځای] = ارزښتونه[ځای - ۱]
            ځای = ځای - ۱
        ارزښتونه[ځای] = ارزښت

# چټک ترتیب (quicksort)، په منځني ډول O(n log n): یو محور وټاکه، سیمه پر دوو برخو
# ووېشه - له محوره کوچني او له محوره لوی - بیا دواړې خواوې ترتیب کړه: ووېشه او وګټه.
دنده چټک_ترتیب(ارزښتونه: عدد[])
    _چټک_ترتیب_سیمه(ارزښتونه، ۰، اوږدوالی(ارزښتونه) - ۱)

دنده _چټک_ترتیب_سیمه(ارزښتونه: عدد[]، ښکته: عدد، پورته: عدد)
    که ښکته >= پورته
        راګرځه
    # وېش د منځني توکي پر شاوخوا (Hoare)، چې ترتیب شوې ننوتنه هم O(n log n) پاتې کېږي.
    متغیر محور = ارزښتونه[(ښکته + پورته) / ۲]
    متغیر ش = ښکته
    متغیر ص = پورته
    ترڅو ش <= ص
        ترڅو ارزښتونه[ش] < محور
            ش = ش + ۱
        ترڅو ارزښتونه[ص] > محور
            ص = ص - ۱
        که ش <= ص
            متغیر ساتلی = ارزښتونه[ش]
            ارزښتونه[ش] = ارزښتونه[ص]
            ارزښتونه[ص] = ساتلی
            ش = ش + ۱
            ص = ص - ۱
    _چټک_ترتیب_سیمه(ارزښتونه، ښکته، ص)
    _چټک_ترتیب_سیمه(ارزښتونه، ش، پورته)

# ګډولو ترتیب (merge sort)، همېش O(n log n): هره نیمایي ترتیب کړه، بیا دواړه ترتیب
# شوې نیمایي سره ګډې کړه - هر ځل د مخې کوچنی ارزښت اخلې. ډاډمن، د مرستندویه ځای په بیه.
دنده ګډولو_ترتیب(ارزښتونه: عدد[])
    که اوږدوالی(ارزښتونه) < ۲
        راګرځه
    متغیر منځ = اوږدوالی(ارزښتونه) / ۲
    متغیر کیڼه = ټوټه(ارزښتونه، ۰، منځ)
    متغیر ښۍ = ټوټه(ارزښتونه، منځ، اوږدوالی(ارزښتونه))
    ګډولو_ترتیب(کیڼه)
    ګډولو_ترتیب(ښۍ)
    متغیر ش = ۰
    متغیر ص = ۰
    لپاره متغیر ځای = ۰، ځای < اوږدوالی(ارزښتونه)، ځای = ځای + ۱
        که ص >= اوږدوالی(ښۍ) یا (ش < اوږدوالی(کیڼه) او کیڼه[ش] <= ښۍ[ص])
            ارزښتونه[ځای] = کیڼه[ش]
            ش = ش + ۱
        کنه
            ارزښتونه[ځای] = ښۍ[ص]
            ص = ص + ۱

# ---------------------------------------------------------------- لټون

# پرله پسې لټون، O(n): هر ارزښت وګوره ترڅو همغه وي. پر هره لړۍ کار کوي.
دنده پرله_پسې_لټون(ارزښتونه: عدد[]، غوښتل_شوی: عدد): عدد
    لپاره متغیر ش = ۰، ش < اوږدوالی(ارزښتونه)، ش = ش + ۱
        که ارزښتونه[ش] == غوښتل_شوی
            راګرځه ش
    راګرځه -۱

# نیمایي (دوه‌اړخیز) لټون، O(log n): لړۍ باید ترتیب شوې وي. له منځني سره یې پرتله
# کړه، بیا یوازې هغه نیمایي ولټوه چې ارزښت لا پکې کېدای شي.
دنده نیمایي_لټون(ارزښتونه: عدد[]، غوښتل_شوی: عدد): عدد
    متغیر ښکته = ۰
    متغیر پورته = اوږدوالی(ارزښتونه) - ۱
    ترڅو ښکته <= پورته
        متغیر منځ = (ښکته + پورته) / ۲
        که ارزښتونه[منځ] == غوښتل_شوی
            راګرځه منځ
        که ارزښتونه[منځ] < غوښتل_شوی
            ښکته = منځ + ۱
        کنه
            پورته = منځ - ۱
    راګرځه -۱

# ---------------------------------------------------------------- مرستندویې

# رښتیا که لړۍ په پورته کېدونکي ترتیب وي (مساوي ګاونډیان روا دي).
دنده ترتیب_شوې_ده(ارزښتونه: عدد[]): منطقي
    لپاره متغیر ش = ۱، ش < اوږدوالی(ارزښتونه)، ش = ش + ۱
        که ارزښتونه[ش - ۱] > ارزښتونه[ش]
            راګرځه درواغ
    راګرځه رښتیا

# د تر ټولو کوچني ارزښت ځای (د تشې لړۍ لپاره -۱).
دنده د_کمینې_ځای(ارزښتونه: عدد[]): عدد
    که اوږدوالی(ارزښتونه) == ۰
        راګرځه -۱
    متغیر کوچنی = ۰
    لپاره متغیر ش = ۱، ش < اوږدوالی(ارزښتونه)، ش = ش + ۱
        که ارزښتونه[ش] < ارزښتونه[کوچنی]
            کوچنی = ش
    راګرځه کوچنی

# ارزښتونه په تصادفي ترتیب اڼي (Fisher-Yates): له پایه راروان شه، هر توکی له یوه
# تصادفي توکي سره چې په همغه ځای یا تر هغه مخکې وي بدلوه. تصادفي بنسټ() ترتیب تکرارېدونکی کوي.
دنده ګډوډه_کړه(ارزښتونه: عدد[])
    لپاره متغیر ش = اوږدوالی(ارزښتونه) - ۱، ش > ۰، ش = ش - ۱
        متغیر ص = تصادفي عدد(۰، ش)
        متغیر ساتلی = ارزښتونه[ش]
        ارزښتونه[ش] = ارزښتونه[ص]
        ارزښتونه[ص] = ساتلی
