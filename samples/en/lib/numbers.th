# lib/numbers.th - a module, imported by lib/geometry.th
#
# "import" looks for a file next to the file that imports it, so geometry.th
# imports this file as "numbers" (not "lib/numbers").

const pi_times_100 = 314

# a / b rounded to the nearest whole number (for numbers that are not negative).
func round_div(a: int, b: int): int
    return (a + b / 2) / b
