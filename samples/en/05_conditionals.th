// 05 - Conditionals: if / else if / else
//
// A condition must have type bool. Comparison operators (== != < <= > >=)
// produce bools, and the words and, or, not combine them. "and" and "or"
// "short-circuit": the right side is only evaluated when it can change the result.
//
// Try it: open the Bytecode tab and find the JUMP_IF_FALSE instructions that
// implement each branch.

func grade(score: int): string
    if score >= 90
        return "A"
    else if score >= 75
        return "B"
    else if score >= 50
        return "C"
    else
        return "F"

println("95 -> ", grade(95))
println("80 -> ", grade(80))
println("50 -> ", grade(50))
println("12 -> ", grade(12))

var year = 2024
var leap = (year % 4 == 0 and year % 100 != 0) or year % 400 == 0
if leap
    println(year, " is a leap year")
else
    println(year, " is not a leap year")
