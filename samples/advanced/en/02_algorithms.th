# Advanced 02 - The algorithms library
#
# import "algorithms" brings the classic sorting and searching algorithms, written in
# Thunder itself (lib/thunder/en) and generic over the element type. Open the library to
# read how each one works; it is explained in docs/algorithms.md.

import "algorithms"

# --- five ways to sort the same numbers -------------------------------------------------
var a = [5, 2, 9, 1, 5, 6]
sorting.bubble(a)
var b = [5, 2, 9, 1, 5, 6]
sorting.selection(b)
var c = [5, 2, 9, 1, 5, 6]
sorting.insertion(c)
var d = [5, 2, 9, 1, 5, 6]
sorting.quick(d)
var e = [5, 2, 9, 1, 5, 6]
sorting.merge(e)
println(a)
println("all agree? ", str(a) == str(b) and str(b) == str(c) and str(c) == str(d) and str(d) == str(e))

# --- the same algorithms sort words -----------------------------------------------------
var words = ["pear", "apple", "fig", "date"]
sorting.quick(words)
println(words)

# --- searching: linear works anywhere, binary needs sorted input ------------------------
println("fig by linear search: index ", searching.linear(words, "fig"))
println("fig by binary search: index ", searching.binary(words, "fig"))
println("missing value: ", searching.binary(words, "mango"))

# --- helpers ----------------------------------------------------------------------------
println("smallest of ", a, " is at index ", searching.index_of_smallest(a))
random.seed(7)
sorting.shuffle(a)
println("shuffled, still ", len(a), " values; sorted? ", sorting.is_sorted(a))
sorting.quick(a)
println("and back in order: ", a)

# --- text: searching, palindromes, prefixes and edit distance ---------------------------
println("world starts at: ", text.find("hello world", "world"))
println("aa in aaaa at: ", text.find_all("aaaa", "aa"))
println("level is a palindrome? ", text.is_palindrome("level"), "; apple? ", text.is_palindrome("apple"))
println("common prefix: ", text.longest_common_prefix(["flower", "flow", "flight"]))
println("kitten -> sitting takes ", text.edit_distance("kitten", "sitting"), " edits")
