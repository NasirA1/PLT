# ژبه: ps
# datastructures.th (lib/thunder/ps) - کلاسیک ډېټا جوړښتونه، پخپله په تندر کې لیکل شوي
# (docs/ps/datastructures.md)
#
# راوړه "datastructures" ولیکئ او ټول لاندې جوړښتونه ستاسې دي (thunderc دا فایل د ځان تر
# څنګ په lib/thunder کې مومي، یا یوه پوښۍ د --module-path سره ورکړئ). د ساکټونو یا ګرافیک
# په خلاف دلته هېڅ بهرنی نشته: دا ساده تندر دی، د لوستلو لپاره لیکل شوی - دا فایل پرانیزئ
# او وګورئ چې ډېرۍ، لیکه، ځنځیر، د لټون دوه‌اړخیزه ونه او د لومړیتوب لیکه رښتیا څنګه کار کوي.
#
# هر جوړښت عمومي (generic) دی: ډېرۍ[ت] د هر ډول توکو لپاره کار کوي، او ت له کارونې
# معلومېږي - د متنونو ډېرۍ یا ډېرۍ(توکي: [«الف»]) ده، یا
# «متغیر د: ډېرۍ[متن] = نوې_ډېرۍ()». ونه او د لومړیتوب لیکه خپل توکي د < سره پرتله کوي،
# نو توکي یې عددونه یا متنونه دي.
#
# له تش جوړښته اخیستل د پروګرام تېروتنه ده او پروګرام دروي، لکه د دننۍ دندې ناسمه بلنه.
# لومړی ډېرۍ_تشه_ده / لیکه_تشه_ده / لومړیتوب_لیکه_تشه_ده وپوښتئ.

# ------------------------------------------------- ډېرۍ (وروستی دننه، لومړی بهر)
#
# د کاسو ډېرۍ: ورزیاتول یو ارزښت سر ته ږدي، اخیستل همغه سر بېرته راوړي.
# هره عملیه O(1) ده.

جوړښت ډېرۍ[ت]
    توکي: ت[]

# یوه نوې، تشه ډېرۍ («متغیر د: ډېرۍ[عدد] = نوې_ډېرۍ()» وايي څه به ساتي).
دنده نوې_ډېرۍ[ت](): ډېرۍ[ت]
    متغیر تش: ت[] = []
    راګرځه ډېرۍ(توکي: تش)

# یو ارزښت سر ته ږدي.
دنده ډېرۍ_ته_ورزیات_کړه[ت](ډېرۍ_: ډېرۍ[ت]، ارزښت: ت)
    ورزیات کړه(ډېرۍ_.توکي، ارزښت)

# د سر ارزښت اخلي او راګرځوي یې.
دنده له_ډېرۍ_واخله[ت](ډېرۍ_: ډېرۍ[ت]): ت
    راګرځه وروستی واخله(ډېرۍ_.توکي)

# د سر ارزښت، بې له اخیستلو.
دنده ډېرۍ_وګوره[ت](ډېرۍ_: ډېرۍ[ت]): ت
    راګرځه ډېرۍ_.توکي[اوږدوالی(ډېرۍ_.توکي) - ۱]

# ډېرۍ څومره ارزښتونه لري.
دنده د_ډېرۍ_کچه[ت](ډېرۍ_: ډېرۍ[ت]): عدد
    راګرځه اوږدوالی(ډېرۍ_.توکي)

دنده ډېرۍ_تشه_ده[ت](ډېرۍ_: ډېرۍ[ت]): منطقي
    راګرځه اوږدوالی(ډېرۍ_.توکي) == ۰

# ------------------------------------------------- لیکه (لومړی دننه، لومړی بهر)
#
# د دوکان مخې ته لیکه: لیکې_ته_ورزیات_کړه پای ته درېږي، له_لیکې_واخله سر ته رسیدلی
# خدمتوي. د سر شاخص ښویېږي، د هر توکي له کښته کولو پرته، نو دواړه په منځني ډول O(1) دي؛
# د خدمت شویو توکو ځای هر کله چې له پاتې نورو لوی شي بېرته اخیستل کېږي.

جوړښت لیکه[ت]
    توکي: ت[]
    سر: عدد

# یوه نوې، تشه لیکه («متغیر ل: لیکه[متن] = نوې_لیکه()» وايي څه به ساتي).
دنده نوې_لیکه[ت](): لیکه[ت]
    متغیر تش: ت[] = []
    راګرځه لیکه(توکي: تش، سر: ۰)

# د لیکې پای ته درېږي.
دنده لیکې_ته_ورزیات_کړه[ت](لیکه_: لیکه[ت]، ارزښت: ت)
    ورزیات کړه(لیکه_.توکي، ارزښت)

# د لیکې سر خدمتوي (لیرې کوي یې او راګرځوي یې).
دنده له_لیکې_واخله[ت](لیکه_: لیکه[ت]): ت
    متغیر ارزښت = لیکه_.توکي[لیکه_.سر]
    لیکه_.سر = لیکه_.سر + ۱
    که لیکه_.سر * ۲ >= اوږدوالی(لیکه_.توکي) او لیکه_.سر > ۸
        لیکه_.توکي = ټوټه(لیکه_.توکي، لیکه_.سر، اوږدوالی(لیکه_.توکي))
        لیکه_.سر = ۰
    راګرځه ارزښت

# د لیکې سر، بې له خدمتولو.
دنده لیکه_وګوره[ت](لیکه_: لیکه[ت]): ت
    راګرځه لیکه_.توکي[لیکه_.سر]

# څومره ارزښتونه انتظار کوي.
دنده د_لیکې_کچه[ت](لیکه_: لیکه[ت]): عدد
    راګرځه اوږدوالی(لیکه_.توکي) - لیکه_.سر

دنده لیکه_تشه_ده[ت](لیکه_: لیکه[ت]): منطقي
    راګرځه د_لیکې_کچه(لیکه_) == ۰

# ------------------------------------------------- ځنځیر (یو اړخیز تړلی لړ)
#
# د غوټیو ځنځیر: هره غوټۍ خپل ارزښت او راتلونکې غوټۍ ساتي؛ «هېڅ» ځنځیر پای ته رسوي.
# سر ته ورزیاتول O(1) دي؛ پای ته ورزیاتول او لټون ځنځیر ګرځي، O(n).
# دا د درسي کتابونو انځور دی، له یوه تکراري جوړښته جوړ.

جوړښت د_ځنځیر_غوټۍ[ت]
    ارزښت: ت
    راتلونکې: د_ځنځیر_غوټۍ[ت]

جوړښت ځنځیر[ت]
    سر: د_ځنځیر_غوټۍ[ت]
    شمېر: عدد

# یو نوی، تش ځنځیر («متغیر ځ: ځنځیر[عدد] = نوی_ځنځیر()»).
دنده نوی_ځنځیر[ت](): ځنځیر[ت]
    راګرځه ځنځیر(سر: هېڅ، شمېر: ۰)

# یو ارزښت سر ته ورزیاتوي: نوې غوټۍ پخواني سر ته اشاره کوي.
دنده ځنځیر_سر_ته_ورزیات_کړه[ت](ځنځیر_: ځنځیر[ت]، ارزښت: ت)
    ځنځیر_.سر = د_ځنځیر_غوټۍ(ارزښت: ارزښت، راتلونکې: ځنځیر_.سر)
    ځنځیر_.شمېر = ځنځیر_.شمېر + ۱

# یو ارزښت پای ته ورزیاتوي: تر وروستۍ غوټۍ ولاړ شه، نوې پرې وځړوه.
دنده ځنځیر_پای_ته_ورزیات_کړه[ت](ځنځیر_: ځنځیر[ت]، ارزښت: ت)
    متغیر غوټۍ = د_ځنځیر_غوټۍ(ارزښت: ارزښت، راتلونکې: هېڅ)
    که ځنځیر_.سر == هېڅ
        ځنځیر_.سر = غوټۍ
    کنه
        متغیر وروستۍ = ځنځیر_.سر
        ترڅو وروستۍ.راتلونکې != هېڅ
            وروستۍ = وروستۍ.راتلونکې
        وروستۍ.راتلونکې = غوټۍ
    ځنځیر_.شمېر = ځنځیر_.شمېر + ۱

# د سر ارزښت لیرې کوي او راګرځوي یې.
دنده ځنځیر_له_سره_واخله[ت](ځنځیر_: ځنځیر[ت]): ت
    متغیر ارزښت = ځنځیر_.سر.ارزښت
    ځنځیر_.سر = ځنځیر_.سر.راتلونکې
    ځنځیر_.شمېر = ځنځیر_.شمېر - ۱
    راګرځه ارزښت

# لومړۍ هغه غوټۍ لیرې کوي چې دا ارزښت لري. رښتیا که ومونده.
دنده له_ځنځیره_لیرې_کړه[ت](ځنځیر_: ځنځیر[ت]، ارزښت: ت): منطقي
    متغیر غوټۍ = ځنځیر_.سر
    متغیر پخوانۍ: د_ځنځیر_غوټۍ[ت] = هېڅ
    ترڅو غوټۍ != هېڅ
        که غوټۍ.ارزښت == ارزښت
            که پخوانۍ == هېڅ
                ځنځیر_.سر = غوټۍ.راتلونکې
            کنه
                پخوانۍ.راتلونکې = غوټۍ.راتلونکې
            ځنځیر_.شمېر = ځنځیر_.شمېر - ۱
            راګرځه رښتیا
        پخوانۍ = غوټۍ
        غوټۍ = غوټۍ.راتلونکې
    راګرځه درواغ

# رښتیا که کومه غوټۍ دا ارزښت لري.
دنده ځنځیر_لري[ت](ځنځیر_: ځنځیر[ت]، ارزښت: ت): منطقي
    متغیر غوټۍ = ځنځیر_.سر
    ترڅو غوټۍ != هېڅ
        که غوټۍ.ارزښت == ارزښت
            راګرځه رښتیا
        غوټۍ = غوټۍ.راتلونکې
    راګرځه درواغ

# ځنځیر څومره ارزښتونه لري.
دنده د_ځنځیر_کچه[ت](ځنځیر_: ځنځیر[ت]): عدد
    راګرځه ځنځیر_.شمېر

# ارزښتونه د ځنځیر په ترتیب، د ساده لړۍ په بڼه.
دنده ځنځیر_لړۍ_کړه[ت](ځنځیر_: ځنځیر[ت]): ت[]
    متغیر پایله: ت[] = []
    متغیر غوټۍ = ځنځیر_.سر
    ترڅو غوټۍ != هېڅ
        ورزیات کړه(پایله، غوټۍ.ارزښت)
        غوټۍ = غوټۍ.راتلونکې
    راګرځه پایله

# ------------------------------------------------- د لټون دوه‌اړخیزه ونه
#
# د هرې غوټۍ کیڼه څانګه کوچني ارزښتونه لري، ښۍ یې لوی، نو یو ارزښت په O(لوړوالی)
# ګامونو کې موندل کېږي - O(log n) کله چې ونه په مناسب ډول برابره وي. توکي د < سره
# پرتله کېږي، نو عددونه یا متنونه دي. تکراري ارزښتونه له پامه غورځول کېږي.

جوړښت د_ونې_غوټۍ[ت]
    ارزښت: ت
    کیڼ: د_ونې_غوټۍ[ت]
    ښی: د_ونې_غوټۍ[ت]

جوړښت ونه[ت]
    ریښه: د_ونې_غوټۍ[ت]
    شمېر: عدد

# یوه نوې، تشه ونه («متغیر و: ونه[عدد] = نوې_ونه()»).
دنده نوې_ونه[ت](): ونه[ت]
    راګرځه ونه(ریښه: هېڅ، شمېر: ۰)

# یو ارزښت پر خپل ترتیب شوي ځای ورزیاتوي. ارزښت چې له وړاندې په ونه کې وي، همداسې پرېښودل کېږي.
دنده ونې_ته_ورزیات_کړه[ت](ونه_: ونه[ت]، ارزښت: ت)
    متغیر غوټۍ = د_ونې_غوټۍ(ارزښت: ارزښت، کیڼ: هېڅ، ښی: هېڅ)
    که ونه_.ریښه == هېڅ
        ونه_.ریښه = غوټۍ
        ونه_.شمېر = ۱
        راګرځه
    متغیر ځای = ونه_.ریښه
    ترڅو رښتیا
        که ارزښت == ځای.ارزښت
            راګرځه
        که ارزښت < ځای.ارزښت
            که ځای.کیڼ == هېڅ
                ځای.کیڼ = غوټۍ
                ونه_.شمېر = ونه_.شمېر + ۱
                راګرځه
            ځای = ځای.کیڼ
        کنه
            که ځای.ښی == هېڅ
                ځای.ښی = غوټۍ
                ونه_.شمېر = ونه_.شمېر + ۱
                راګرځه
            ځای = ځای.ښی

# رښتیا که ارزښت په ونه کې وي.
دنده ونه_لري[ت](ونه_: ونه[ت]، ارزښت: ت): منطقي
    متغیر ځای = ونه_.ریښه
    ترڅو ځای != هېڅ
        که ارزښت == ځای.ارزښت
            راګرځه رښتیا
        که ارزښت < ځای.ارزښت
            ځای = ځای.کیڼ
        کنه
            ځای = ځای.ښی
    راګرځه درواغ

# ونه څومره ارزښتونه لري.
دنده د_ونې_کچه[ت](ونه_: ونه[ت]): عدد
    راګرځه ونه_.شمېر

# له ریښې کښته تر ټولو اوږده لار له څومره غوټیو تېرېږي (د تشې ونې لپاره ۰).
دنده د_ونې_لوړوالی[ت](ونه_: ونه[ت]): عدد
    راګرځه _د_غوټۍ_لوړوالی(ونه_.ریښه)

دنده _د_غوټۍ_لوړوالی[ت](غوټۍ: د_ونې_غوټۍ[ت]): عدد
    که غوټۍ == هېڅ
        راګرځه ۰
    راګرځه ۱ + اعظمه(_د_غوټۍ_لوړوالی(غوټۍ.کیڼ)، _د_غوټۍ_لوړوالی(غوټۍ.ښی))

# تر ټولو کوچنی ارزښت: همېش کیڼ لور ته ځه.
دنده د_ونې_کمینه[ت](ونه_: ونه[ت]): ت
    متغیر ځای = ونه_.ریښه
    ترڅو ځای.کیڼ != هېڅ
        ځای = ځای.کیڼ
    راګرځه ځای.ارزښت

# تر ټولو لوی ارزښت: همېش ښي لور ته ځه.
دنده د_ونې_اعظمه[ت](ونه_: ونه[ت]): ت
    متغیر ځای = ونه_.ریښه
    ترڅو ځای.ښی != هېڅ
        ځای = ځای.ښی
    راګرځه ځای.ارزښت

# هر ارزښت په پورته کېدونکي ترتیب (منځنی تګ: کیڼه څانګه، غوټۍ، ښۍ څانګه).
دنده ونه_په_ترتیب[ت](ونه_: ونه[ت]): ت[]
    متغیر پایله: ت[] = []
    _د_ونې_تګ(ونه_.ریښه، پایله)
    راګرځه پایله

دنده _د_ونې_تګ[ت](غوټۍ: د_ونې_غوټۍ[ت]، پایله: ت[])
    که غوټۍ == هېڅ
        راګرځه
    _د_ونې_تګ(غوټۍ.کیڼ، پایله)
    ورزیات کړه(پایله، غوټۍ.ارزښت)
    _د_ونې_تګ(غوټۍ.ښی، پایله)

# یو ارزښت لیرې کوي. رښتیا که په ونه کې و. غوټۍ چې دوه بچي لري خپل ارزښت د ښۍ څانګې
# له کمینې (په ترتیب کې راتلونکی ارزښت) سره بدلوي او بیا همغه غوټۍ، چې تر یوه زیات
# بچي نه لري، له ونې ایستل کېږي.
دنده له_ونې_لیرې_کړه[ت](ونه_: ونه[ت]، ارزښت: ت): منطقي
    متغیر ځای = ونه_.ریښه
    متغیر مور: د_ونې_غوټۍ[ت] = هېڅ
    ترڅو ځای != هېڅ او ځای.ارزښت != ارزښت
        مور = ځای
        که ارزښت < ځای.ارزښت
            ځای = ځای.کیڼ
        کنه
            ځای = ځای.ښی
    که ځای == هېڅ
        راګرځه درواغ
    که ځای.کیڼ != هېڅ او ځای.ښی != هېڅ
        متغیر ځایناستی = ځای.ښی
        متغیر د_ځایناستي_مور = ځای
        ترڅو ځایناستی.کیڼ != هېڅ
            د_ځایناستي_مور = ځایناستی
            ځایناستی = ځایناستی.کیڼ
        ځای.ارزښت = ځایناستی.ارزښت
        ځای = ځایناستی
        مور = د_ځایناستي_مور
    متغیر بچی = ځای.کیڼ
    که بچی == هېڅ
        بچی = ځای.ښی
    که مور == هېڅ
        ونه_.ریښه = بچی
    کنه که مور.کیڼ == ځای
        مور.کیڼ = بچی
    کنه
        مور.ښی = بچی
    ونه_.شمېر = ونه_.شمېر - ۱
    راګرځه رښتیا

# ------------------------------------------------- د لومړیتوب لیکه (کمینه-ګودام)
#
# له_لومړیتوب_لیکې_واخله همېش تر ټولو کوچنی ارزښت لومړی راکوي، ارزښتونه چې هر ترتیب
# راغلي وي. لیکه یوه دوه‌اړخیزه ونه ده چې په یوه لړۍ کې ځای شوې: د ش شاخص غوټۍ بچي په
# ۲*ش + ۱ او ۲*ش + ۲ کې ناست دي، او هره مور <= خپلو بچیو ده. ورزیاتول او اخیستل O(log n) دي.
# توکي د < سره پرتله کېږي، نو عددونه یا متنونه دي.

جوړښت لومړیتوب_لیکه[ت]
    توکي: ت[]

# یوه نوې، تشه د لومړیتوب لیکه («متغیر م: لومړیتوب_لیکه[عدد] = نوې_لومړیتوب_لیکه()»).
دنده نوې_لومړیتوب_لیکه[ت](): لومړیتوب_لیکه[ت]
    متغیر تش: ت[] = []
    راګرځه لومړیتوب_لیکه(توکي: تش)

# یو ارزښت ورزیاتوي: پای ته یې ولیکه، بیا دې پورته ځي ترڅو له خپلې مور کوچنی وي.
دنده لومړیتوب_لیکې_ته_ورزیات_کړه[ت](لیکه_: لومړیتوب_لیکه[ت]، ارزښت: ت)
    ورزیات کړه(لیکه_.توکي، ارزښت)
    متغیر ځای = اوږدوالی(لیکه_.توکي) - ۱
    ترڅو ځای > ۰
        متغیر مور = (ځای - ۱) / ۲
        که لیکه_.توکي[مور] <= لیکه_.توکي[ځای]
            ودرېږه
        متغیر ساتلی = لیکه_.توکي[مور]
        لیکه_.توکي[مور] = لیکه_.توکي[ځای]
        لیکه_.توکي[ځای] = ساتلی
        ځای = مور

# تر ټولو کوچنی ارزښت لیرې کوي او راګرځوي یې: وروستی توکی ریښې ته خېژي، بیا تر هر
# کوچني بچي لاندې ډوبېږي.
دنده له_لومړیتوب_لیکې_واخله[ت](لیکه_: لومړیتوب_لیکه[ت]): ت
    متغیر کمینه_ = لیکه_.توکي[۰]
    متغیر وروستی = وروستی واخله(لیکه_.توکي)
    که اوږدوالی(لیکه_.توکي) == ۰
        راګرځه کمینه_
    لیکه_.توکي[۰] = وروستی
    متغیر ځای = ۰
    ترڅو رښتیا
        متغیر بچی = ځای * ۲ + ۱
        که بچی >= اوږدوالی(لیکه_.توکي)
            ودرېږه
        که بچی + ۱ < اوږدوالی(لیکه_.توکي) او لیکه_.توکي[بچی + ۱] < لیکه_.توکي[بچی]
            بچی = بچی + ۱
        که لیکه_.توکي[ځای] <= لیکه_.توکي[بچی]
            ودرېږه
        متغیر ساتلی = لیکه_.توکي[ځای]
        لیکه_.توکي[ځای] = لیکه_.توکي[بچی]
        لیکه_.توکي[بچی] = ساتلی
        ځای = بچی
    راګرځه کمینه_

# تر ټولو کوچنی ارزښت، بې له لیرې کولو.
دنده لومړیتوب_لیکه_وګوره[ت](لیکه_: لومړیتوب_لیکه[ت]): ت
    راګرځه لیکه_.توکي[۰]

# لیکه څومره ارزښتونه لري.
دنده د_لومړیتوب_لیکې_کچه[ت](لیکه_: لومړیتوب_لیکه[ت]): عدد
    راګرځه اوږدوالی(لیکه_.توکي)

دنده لومړیتوب_لیکه_تشه_ده[ت](لیکه_: لومړیتوب_لیکه[ت]): منطقي
    راګرځه اوږدوالی(لیکه_.توکي) == ۰
