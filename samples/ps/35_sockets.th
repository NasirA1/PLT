// ژبه: ps
// ۳۵ - د شبکې له لارې خبرې (ساکټونه)
//
// په بېلابېلو کمپیوټرونو پروګرامونه د ساکټونو له لارې خبرې کوي: یو لوری پر یوه
// پورټ اوري، بل نښلي، او بیا متن دواړو لورو ته بهېږي. تندر ساکټونه د بهرني
// ماډیول thunder_sockets څخه (++C په lib/native/sockets/ کې) د وړوکي تندر
// ماډیول lib/sockets.th له لارې اخلي - د ټول API لپاره هغه فایل ولولئ، او د کیسې
// لپاره docs/ps/sockets.md (مرسته > د ساکټونو لارښود).
//
// دا پروګرام هم سرور دی او هم پېرېدونکی، نو هر ځای بې دویم کمپیوټره چلېږي: هر
// څه له 127.0.0.1 څخه تېرېږي، هغه پته چې تل مانا «همدا ماشین». د رښتیني هڅې
// لپاره یې دوه ټوټې کړئ: اورېدونکې نیمايي پر یوه کمپیوټر، نښلېدونکې پر بل، د
// هغه له پتې سره.
//
// که «چلول» ووايي «بهرنی کتابتون ... نشي پرانیستل کېدای» (R028)، توکپانګه بیا
// جوړه کړئ (په لینکس کې ./run_tests.sh یا ./run.sh، په وینډوز کې .\run.ps1):
// هغه thunder_sockets د thundervm تر څنګ جوړوي.

راوړه "lib/sockets"

// --- سرور: پر دې کمپیوټر واوره، پر هغه پورټ چې سیسټم یې ټاکي (۰) -----------------
متغیر سرور = اورېدونکی_جوړ_کړه("127.0.0.1"، ۰)
که سرور < ۰
    کرښه چاپ("اورېدل نشي: "، ساکټ_تېروتنه())
متغیر پورټ = ساکټ_پورټ(سرور)
کرښه چاپ("سرور اوري؛ سیسټم ورته پورټ ورکړ: "، پورټ > ۰)

// --- پېرېدونکی: ورسره ونښلېږه، بیا سرور اړیکه مني ---------------------------------
متغیر پېرېدونکی = ونښلېږه("127.0.0.1"، پورټ)
متغیر اړیکه = اړیکه_ومنه(سرور)
کرښه چاپ("نښلول شوي: "، پېرېدونکی >= ۰ او اړیکه >= ۰)
کرښه چاپ("سرور پېرېدونکی پر دې پته ویني: "، پیلېږي په(ساکټ_مقابل_لوری(اړیکه)، "127.0.0.1:"))

// متن کرښه په کرښه له تاره تېرېږي.
ساکټ_کرښه_ولېږه(پېرېدونکی، "سلام له پېرېدونکي")
کرښه چاپ("سرور ترلاسه کړل: "، ساکټ_کرښه_واخله(اړیکه))
ساکټ_کرښه_ولېږه(اړیکه، "سلام له سرور")
کرښه چاپ("پېرېدونکي ترلاسه کړل: "، ساکټ_کرښه_واخله(پېرېدونکی))

// پروتوکول یوازې د کرښو په اړه یوه موافقه ده. دلته: پېرېدونکی پوښتي، سرور ځوابوي.
دنده ځواب(پوښتنه: متن): متن
    که پوښتنه == "وخت؟"
        راګرځه "نه پوهېږم، زه یوه بېلګه یم"
    راګرځه "بښنه؟"

ساکټ_کرښه_ولېږه(پېرېدونکی، "وخت؟")
ساکټ_کرښه_ولېږه(اړیکه، ځواب(ساکټ_کرښه_واخله(اړیکه)))
کرښه چاپ("پېرېدونکي وخت وپوښت او دا یې ترلاسه کړل: "، ساکټ_کرښه_واخله(پېرېدونکی))

// د یوه سر تړل: بل سر "" لولي او ویني چې اړیکه ولاړه.
ساکټ_وتړه(پېرېدونکی)
کرښه چاپ("د پېرېدونکي له تړلو وروسته سرور لولي \""، ساکټ_کرښه_واخله(اړیکه)،
        "\"؛ لا پرانیستې؟ "، ساکټ_پرانیستی_دی(اړیکه))
ساکټ_وتړه(اړیکه)
ساکټ_وتړه(سرور)

// --- UDP: یو یو پیغام بې اړیکې --------------------------------------------------
متغیر اخیستونکی = یو_ډي_پي_پرانیزه(۰)
متغیر لېږونکی = یو_ډي_پي_پرانیزه(۰)
یو_ډي_پي_ولېږه(لېږونکی، "127.0.0.1"، ساکټ_پورټ(اخیستونکی)، "یو ډاټاګرام")
کرښه چاپ("پر UDP اخیستونکي ترلاسه کړل: "، یو_ډي_پي_واخله(اخیستونکی، ۱۰۰))
ساکټ_وتړه(لېږونکی)
ساکټ_وتړه(اخیستونکی)

// د شبکې ستونزه ارزښت دی، نه چاودنه: داسې پورټ ته نښلېدل چې څوک پرې نه اوري
// -۱ ورکوي، او ساکټ_تېروتنه() وايي ولې. *تېروتنه* - داسې نښه کارول چې پرانیستې
// نه ده، لکه ساکټ_ولېږه(۹۹، "x") - پروګرام دروي، لکه د دننۍ دندې ناسمه بلنه.
متغیر هېڅوک = ونښلېږه("127.0.0.1"، ۱)
کرښه چاپ("هلته نښلېدل چې څوک نه اوري "، هېڅوک، " ورکوي ("، ساکټ_تېروتنه() != ""، ")")
