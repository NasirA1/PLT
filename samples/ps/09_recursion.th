// ژبه: ps
// ۰۹ - تکراري دندې
//
// تکراري دنده ځان د یوې کوچنۍ ستونزې لپاره بیا بولي، تر هغه چې بنسټیز
// حالت ته ورسېږي. هره بلنه خپل چوکاټ او د ځایي متغیرونو خپله کاپي لري.
//
// هڅه وکړئ: دا پروګرام ډیبګ کړئ او د VM په پاڼه کې وګورئ چې څنګه چوکاټونه
// سره راټولېږي کله چې فکتوریل ځان بولي، او بیا یو په یو بېرته راګرځي.

دنده فکتوریل(ن: عدد): عدد
    که ن <= ۱
        راګرځه ۱     // بنسټیز حالت
    راګرځه ن * فکتوریل(ن - ۱)

دنده فیبوناچي(ن: عدد): عدد
    که ن < ۲
        راګرځه ن
    راګرځه فیبوناچي(ن - ۱) + فیبوناچي(ن - ۲)

دنده توان(بنسټ: عدد، توانونکی: عدد): عدد
    که توانونکی == ۰
        راګرځه ۱
    متغیر نیمه = توان(بنسټ، توانونکی / ۲)
    که توانونکی % ۲ == ۰
        راګرځه نیمه * نیمه
    راګرځه نیمه * نیمه * بنسټ

کرښه چاپ("۵! = "، فکتوریل(۵))
کرښه چاپ("۲۰! = "، فکتوریل(۲۰))

متغیر کرښه = ""
لپاره متغیر ش = ۰، ش < ۱۲، ش = ش + ۱
    کرښه = کرښه + متن کړه(فیبوناچي(ش)) + " "
کرښه چاپ("فیبوناچي: "، کرښه)
کرښه چاپ("۲^۶۲ = "، توان(۲، ۶۲))
