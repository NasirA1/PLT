# ژبه: ps
# ۳۴ - له تندر څخه د ++C بلل (بهرنی اړیکی)
#
# تر دې ځایه هر څه تندر و. کله کله داسې څه ته اړتیا لرئ چې تندر یې نه لري: یوه
# چټکه شمېریزه کړنلار، یوه وسیله، یا هغه کتابتون چې بل چا لیکلی. «راوړه بهرنی»
# هغه شریک کتابتون راوړي چې له C یا ++C جوړ شوی، او «بهرنی دنده» وايي چې د
# هغه یوه دنده څه بڼه لري — نو جوړونکی هره بلنه سم هغسې ګوري لکه د تندر بلنه.
#
# د دندو نومونه د ++C کتابتون ټاکي؛ دا یو په پښتو هم ورکوي (وګورئ thunder_demo.cpp).
# دلته کارېدونکی کتابتون، thunder_demo، له توکپانګې سره جوړېږي او د thunderc
# او thundervm تر څنګ کېني، نو «چلول» سمدستي کار کوي. سرچینه یې په
# lib/native/thunder_demo.cpp کې ده — شاوخوا سل کرښې ساده ++C — او ټول
# هغه اړیکی چې کاروي یې یو سرلیک دی: include/thunder/native.h.
#
# د دندو نومونه ++C کتابتون ټاکي، او نوم یوازې UTF-8 متن دی: thunder_demo هره
# دنده په انګلیسي او په پښتو نوم دواړو ثبتوي، نو دا پروګرام پښتو نومونه بولي.
#
# که «چلول» ووايي «بهرنی کتابتون ... نشي پرانیستل کېدای» (R028)، نو کتابتون نه
# دی جوړ شوی: توکپانګه بیا جوړه کړئ (په لینکس کې ./run_tests.sh یا ./run.sh،
# په وینډوز کې .\run.ps1)، چې thunder_demo هم ورسره جوړېږي.
#
# هڅه وکړئ: د «بایټ کوډ» پاڼه پرانیزئ او CALL_NATIVE ومومئ — یوه لارښوونه،
# لکه CALL_BUILTIN. بیا lib/native/README.md ولولئ چې خپل یو ولیکئ.

راوړه بهرنی "thunder_demo"

# هره لاندې کرښه په thunder_demo.cpp کې یوه دنده ده. یوازې عدد، اعشاري،
# منطقي، متن او بیا-بلنې له پولې اوړي؛ لړۍ او جوړښتونه نه.
بهرنی دنده وتر(س: اعشاري، ص: اعشاري): اعشاري
بهرنی دنده چیغه(متن_یې: متن): متن
بهرنی دنده شمېرنه(متن_یې: متن): عدد
بهرنی دنده هر_لومړنی(حد: عدد، راپور: دنده(عدد))
بهرنی دنده دوه_ځله(ارزښت: عدد، ف: دنده(عدد): عدد): عدد

کرښه چاپ("++C وویل وتر(۳، ۴) = "، وتر(۳، ۴))     # بشپړ عددونه پخپله پراخېږي
کرښه چاپ(چیغه("سلام له تندره"))
کرښه چاپ("د \"thunder\" کنټرول شمېره = "، شمېرنه("thunder"))

# بله لار: ++C د تندر یوه دنده بولي. هر_لومړنی په ++C کې غربال چلوي او د هرې
# موندل شوې لومړنۍ عدد لپاره وښایه() بولي.
متغیر لومړني: عدد[] = []
دنده وښایه_یې(ل: عدد)
    ورزیات کړه(لومړني، ل)

هر_لومړنی(۴۰، وښایه_یې)
کرښه چاپ("له ۴۰ کم لومړني عددونه: "، لومړني)
کرښه چاپ("دا یې "، اوږدوالی(لومړني)، " دي، مجموعه یې "، مجموعه(لومړني))

# بیا-بلنه ارزښت هم راګرځولای شي.
دنده درې_چنده(ن: عدد): عدد
    راګرځه ن * ۳
کرښه چاپ("دوه_ځله(۷، درې_چنده) = "، دوه_ځله(۷، درې_چنده))

# بهرنۍ دنده تېروتنه هم هغسې راپوروي لکه دننۍ دنده: پروګرام په R030 درېږي او
# همغه پیغام ښيي چې ++C ورکړی. د نمونې وېشل() د صفر وېشونکي لپاره همدا کوي —
# دوې لاندې کرښې له تبصرې راوباسئ چې یې وګورئ.
# بهرنی دنده وېشل(الف: عدد، ب: عدد): عدد
# کرښه چاپ(وېشل(۱، ۰))
