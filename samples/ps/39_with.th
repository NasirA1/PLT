# ژبه: ps
# ۳۹ - سره: هغه سرچینې چې ځان تړي
#
# ځینې ارزښتونه له پروګرام بهر د یو څه استازي دي چې پروګرام یې له کار وروسته باید بېرته
# ورکړي: پرانیستی فایل، د شبکې اړیکه، یو قلف. د یوه تړل هېرول اسانه تېروتنه ده - په
# ځانګړي توګه کله چې دنده وختي راوګرځي یا تکرار ودرېږي.
#
#     نوم سره = سرچینه
#         ... نوم وکاروئ ...
#
# «سره» سرچینه هغه مهال تړي چې بلاک یې پای ته ورسېږي، که هر ډول پای ته ورسېږي: د بلاک
# په پای کې، یا په راګرځه، ودرېږه یا دوام. جوړښت هغه مهال سرچینه ده چې د وتړه() دنده
# ولري - «سره» یې ستاسې لپاره بلي (دا RAII دی: Resource Acquisition Is Initialisation).
# بل هر ارزښت - د بېلګې په توګه د عدد نښه - د هغه ټولګي «وتړه» تړي چې دندې یې جوړ
# کړی. هغه جوړښت چې هېڅ وي نه تړل کېږي، او یو په بل کې «سره» بلاکونه تر ټولو دننني
# لومړی تړي. د ۳۸_sockets.th ساکټونه همداسې تړل کېږي.
#
# پښتو دا کلیدي کلمه له نوم وروسته لیکي - «نوم سره = سرچینه» - یا کله چې نوم نه وي له
# ارزښت وروسته، لکه ژبه چې یې وايي: «ساکټ سره» (انګلیسي «with» د کرښې په پیل کې لیکي:
# with the socket).

راوړه فایل

# زموږ خپله یوه سرچینه: یادښت چې کرښې راټولوي او کله چې وتړل شي، خپل فایل ته یې لیکي.
# هر جوړښت سرچینه کېږي کله چې د وتړه() دنده ولري.
جوړښت یادښت
    مسیر_: متن
    کرښې_: متن[]

    یادښت(مسیر: متن)
        مسیر_ = مسیر
        کرښې_ = []
        کرښه چاپ("  ("، مسیر، " پرانیستل شو)")

    دنده ولیکه(کرښه: متن)
        ورزیات کړه(کرښې_، کرښه)

    # «سره» دا د بلاک په پای کې بلي.
    دنده وتړه()
        فایل.ولیکه(مسیر_، متن.یو ځای کړه(کرښې_، "\ن") + "\ن")
        کرښه چاپ("  ("، مسیر_، " وتړل شو: "، اوږدوالی(کرښې_)، " کرښې ولیکل شوې)")

کرښه چاپ("۱. د بلاک پای یې تړي:")
یادښتونه سره = یادښت("thunder_notes.txt")
    یادښتونه.ولیکه("لومړۍ")
    یادښتونه.ولیکه("دوهمه")
کرښه چاپ("  فایل وايي: "، متن.وېشه(متن.پاک کړه(فایل.ولوله("thunder_notes.txt"))، "\ن"))

کرښه چاپ("۲. همداسې راګرځه هم، له ژورې دننه:")
دنده لومړی_منفي(عددونه: عدد[]): عدد
    څرک سره = یادښت("thunder_trace.txt")
        تکرار ع په عددونه
            څرک.ولیکه("وکتل شو " + متن کړه(ع))
            که ع < ۰
                راګرځه ع
    راګرځه ۰

کرښه چاپ("  لومړی منفي: "، لومړی_منفي([۴، ۸، -۱۵، ۱۶]))

کرښه چاپ("۳. او ودرېږه او دوام:")
تکرار پړاو په واټن(۱، ۴)
    هڅه سره = یادښت("thunder_round.txt")
        که پړاو == ۲
            دوام
        هڅه.ولیکه("پړاو " + متن کړه(پړاو))
        که پړاو == ۳
            ودرېږه

کرښه چاپ("۴. یو په بل کې بلاکونه تر ټولو دننني لومړی تړي:")
دباندنی سره = یادښت("thunder_outer.txt")
    دننی سره = یادښت("thunder_inner.txt")
        دننی.ولیکه("دننه")
    دباندنی.ولیکه("بهر")

کرښه چاپ("۵. هغه سرچینه چې هېڅ وي نه تړل کېږي:")
دنده کېدای_شي_پرانیزه(غوښتل_شوی: منطقي): یادښت
    که غوښتل_شوی
        راګرځه یادښت("thunder_maybe.txt")
    راګرځه هېڅ

شاید سره = کېدای_شي_پرانیزه(درواغ)
    کرښه چاپ("  هېڅ ترلاسه شو؟ "، شاید == هېڅ)

کرښه چاپ("۶. مخکې جوړ شوی ارزښت هم «سره» ته ورکول کېدای شي:")
متغیر راپور = یادښت("thunder_report.txt")
راپور.ولیکه("له بلاک مخکې جوړ شو")
راپور سره
    راپور.ولیکه("په دننه کې ولیکل شو")

تکرار مسیر په ["thunder_notes.txt"، "thunder_trace.txt"، "thunder_round.txt"، "thunder_outer.txt"، "thunder_inner.txt"،
        "thunder_report.txt"]
    فایل.ړنګ کړه(مسیر)
