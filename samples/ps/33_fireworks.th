# ژبه: ps
# ۳۳ - اورلګېدنې (د ذرو سمولېشن)
#
# هره پشکه یو جوړښت دی چې ځای او چټکتیا لري. په هر چوکاټ کې جاذبه چټکتیا
# لږ څه کښته کاږي، او چټکتیا پشکه خوځوي. تندر یوازې بشپړ عددونه لري، نو
# ځایونه د پکسل په لسمو برخو کې ساتل کېږي («ثابت ټکی»): ۱۵ چټکتیا یوه پشکه
# په هر چوکاټ کې ۱.۵ پکسله خوځوي.
#
# هڅه وکړئ: «چلول» کښېکښئ، بیا پر ټاټ کلیک وکړئ چې خپل توغندي وغورځوئ.
# تصادفي عدد(الف، ب) هر ځل بله ننداره جوړوي.

راوړه ګرافیک

ثابت پلنوالی = ۴۰۰
ثابت لوړوالی = ۳۰۰
ثابت جاذبه = ۲          # د پکسل لسمې برخې په هر چوکاټ کې، په هر چوکاټ کې

جوړښت پشکه
    س: عدد              # د پکسل په لسمو برخو کې
    ص: عدد
    ګام_س: عدد
    ګام_ص: عدد
    رنګ_یې: متن
    ژوند: عدد           # پاتې چوکاټونه

متغیر پشکې: پشکه[] = []
متغیر پالېټ = ["سور"، "ژېړ"، "زرغون"، "اسماني"، "ګلابي"، "نارنجي"، "سپین"]

دنده چاودنه(س: عدد، ص: عدد)
    متغیر رنګ_یې = پالېټ[تصادفي.عدد(۰، اوږدوالی(پالېټ) - ۱)]
    تکرار متغیر ش = ۰، ش < ۴۰، ش = ش + ۱
        ورزیات کړه(پشکې، پشکه(س * ۱۰، ص * ۱۰، تصادفي.عدد(-۴۰، ۴۰)، تصادفي.عدد(-۵۰، ۲۰)، رنګ_یې، تصادفي.عدد(۲۵، ۵۰)))

دنده ژوندۍ(پ: پشکه): منطقي
    راګرځه پ.ژوند > ۰ او پ.ص < لوړوالی * ۱۰

ګرافیک.ټاټ(پلنوالی، لوړوالی)
متغیر چوکاټونه = ۰
متغیر مخکې_کښېکښل_شوی = درواغ
ترڅو رښتیا
    # هره ثانیه یو توغندی، او یو هم هلته چې موږک کلیک کړي.
    که چوکاټونه % ۳۰ == ۰
        چاودنه(تصادفي.عدد(۶۰، پلنوالی - ۶۰)، تصادفي.عدد(۵۰، ۱۵۰))
    که ګرافیک.موږک کښېکښل شوی() او نه مخکې_کښېکښل_شوی
        چاودنه(ګرافیک.موږک افقي()، ګرافیک.موږک عمودي())
    مخکې_کښېکښل_شوی = ګرافیک.موږک کښېکښل شوی()

    ګرافیک.ټاټ پاک کړه("تور")
    تکرار متغیر ش = ۰، ش < اوږدوالی(پشکې)، ش = ش + ۱
        متغیر پ = پشکې[ش]
        پ.ګام_ص = پ.ګام_ص + جاذبه
        پ.س = پ.س + پ.ګام_س
        پ.ص = پ.ص + پ.ګام_ص
        پ.ژوند = پ.ژوند - ۱
        متغیر اندازه = ۱ + پ.ژوند / ۲۰
        ګرافیک.دایره(پ.س / ۱۰، پ.ص / ۱۰، اندازه، پ.رنګ_یې)
    پشکې = چاڼ کړه(پشکې، ژوندۍ)     # سوځېدلې پشکې هېرې کړه
    ګرافیک.لیکنه(۱۰، ۱۰، متن کړه(اوږدوالی(پشکې)) + " پشکې - د توغندي لپاره کلیک وکړئ"، "خړ")
    ګرافیک.چوکاټ()
    چوکاټونه = چوکاټونه + ۱
