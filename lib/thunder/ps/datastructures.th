    ځنځیر_.پای = غوټۍ.مخکېنۍ
    که ځنځیر_.پای == هېڅ
        ځنځیر_.سر = هېڅ
    کنه
        ځنځیر_.پای.راتلونکې = هېڅ
    ځنځیر_.شمېر = ځنځیر_.شمېر - ۱
    راګرځه غوټۍ.ارزښت

# لومړۍ هغه غوټۍ لیرې کوي چې دا ارزښت لري. رښتیا که ومونده.
دنده له_دوه_اړخیز_ځنځیره_لیرې_کړه<ت>(ځنځیر_: دوه_اړخیز_ځنځیر<ت>، ارزښت: ت): منطقي
    متغیر غوټۍ = ځنځیر_.سر
    ترڅو غوټۍ != هېڅ
        که غوټۍ.ارزښت == ارزښت
            که غوټۍ.مخکېنۍ == هېڅ
                ځنځیر_.سر = غوټۍ.راتلونکې
            کنه
                غوټۍ.مخکېنۍ.راتلونکې = غوټۍ.راتلونکې
            که غوټۍ.راتلونکې == هېڅ
                ځنځیر_.پای = غوټۍ.مخکېنۍ
            کنه
                غوټۍ.راتلونکې.مخکېنۍ = غوټۍ.مخکېنۍ
            ځنځیر_.شمېر = ځنځیر_.شمېر - ۱
            راګرځه رښتیا
        غوټۍ = غوټۍ.راتلونکې
    راګرځه درواغ

# رښتیا که کومه غوټۍ دا ارزښت لري.
دنده دوه_اړخیز_ځنځیر_لري<ت>(ځنځیر_: دوه_اړخیز_ځنځیر<ت>، ارزښت: ت): منطقي
