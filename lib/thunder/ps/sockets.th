# ژبه: ps
# sockets.th (lib/thunder/ps) - د شبکې له لارې خبرې: TCP او UDP ساکټونه (docs/ps/sockets.md)
#
# راوړه "sockets" ولیکئ او څلور ټولګي ستاسې دي (thunderc دا فایل د ځان تر څنګ په
# lib/thunder کې مومي، یا یوه پوښۍ د --module-path سره ورکړئ):
#
#     ټي_سي_پي    اړیکې: اورېدل، منل، نښلول، او غوښتنه (یوه بشپړه تبادله)
#     یو_ډي_پي    یو یو پیغام (ډاټاګرام): پرانیستل، لېږل، اخیستل، لېږونکی
#     ساکټ        هغه څه چې هر ساکټ یې کولای شي: د متن یا بایټونو لېږل او اخیستل، تړل، د وخت حد ...
#     کوربه       نومونه او پتې: کوربه.پته("example.org")، کوربه.نوم()
#
# کار په ++C کې کېږي (lib/native/sockets/thunder_sockets.cpp)، چې له توکپانګې سره د بهرني
# کتابتون thunder_sockets په بڼه جوړېږي، د thunderc او thundervm تر څنګ کېني او د بسته
# شوي پروګرام تر څنګ پخپله کاپي کېږي.
#
# ساکټ یو ساکټ.ساکټ دی. پرانیستل یې ناکامېدای شي - څوک نه اوري، پورټ نیول شوی وي - او
# بیا ځواب هېڅ دی، او ساکټ.تېروتنه() وايي ولې. ساکټ سرچینه ده، نو «سره» یې ستاسې لپاره د
# بلاک په پای کې تړي، که بلاک هر ډول پای ته ورسېږي:
#
#     اړیکه = ټي_سي_پي.ونښلېږه("localhost"، ۷۰۰۰) سره
#         که اړیکه != هېڅ
#             ساکټ.کرښه_ولېږه(اړیکه، "سلام")
#
# داسې ساکټ ورکول چې دمخه تړل شوی وي د پروګرام تېروتنه ده او پروګرام دروي، لکه د دننۍ
# دندې ناسمه بلنه.

راوړه بهرنی "thunder_sockets"

# --- هر ساکټ: اړیکې، اورېدونکي او UDP ساکټونه ------------------------------------------

ټولګی ساکټ
    # یو ساکټ. نښه یې هغه شمېره ده چې ++C یې پرې پېژني، لکه د ټکټ شمېره.
    جوړښت ساکټ
        نښه: عدد

    بهرنی دنده _ولېږه(نښه: عدد، متن_یې: متن): عدد
    بهرنی دنده _کرښه_ولېږه(نښه: عدد، متن_یې: متن): عدد
    بهرنی دنده _واخله(نښه: عدد، تر_ټولو_ډېر_بایټونه: عدد): متن
    بهرنی دنده _کرښه_واخله(نښه: عدد): متن
    بهرنی دنده _بایټونه_ولېږه(نښه: عدد، ډېټا: بایټ[]): عدد
    بهرنی دنده _بایټونه_واخله(نښه: عدد، تر_ټولو_ډېر_بایټونه: عدد): بایټ[]
    بهرنی دنده _پرانیستی_دی(نښه: عدد): منطقي
    بهرنی دنده _وتړه(نښه: عدد)
    بهرنی دنده _وخت_حد(نښه: عدد، ملي_ثانیې: عدد): منطقي
    بهرنی دنده _پورټ(نښه: عدد): عدد
    بهرنی دنده _مقابل_لوری(نښه: عدد): متن
    بهرنی دنده _تېروتنه(): متن

    # متن لېږي (د UTF-8 بایټونو په بڼه)؛ د لېږل شویو بایټونو شمېر راګرځوي، یا -۱.
    دنده ولېږه(س: ساکټ، متن_یې: متن): عدد
        راګرځه _ولېږه(س.نښه، متن_یې)

    # متن د کرښې له پایه سره لېږي: د ساده پروتوکولونو طبیعي واحد.
    دنده کرښه_ولېږه(س: ساکټ، متن_یې: متن): عدد
        راګرځه _کرښه_ولېږه(س.نښه، متن_یې)

    # تر تر_ټولو_ډېر_بایټونه پورې متن ته انتظار کوي. "" کله چې بل لوري تړلی وي
    # (ساکټ.پرانیستی_دی بیا درواغ کېږي)، وخت پای ته ورسېږي، یا تېروتنه وشي (ساکټ.تېروتنه وګورئ).
    دنده واخله(س: ساکټ، تر_ټولو_ډېر_بایټونه: عدد): متن
        راګرځه _واخله(س.نښه، تر_ټولو_ډېر_بایټونه)

    # یوې کرښې ته انتظار کوي او پرته له خپل پای څخه یې راګرځوي.
    دنده کرښه_واخله(س: ساکټ): متن
        راګرځه _کرښه_واخله(س.نښه)

    # د متن پر ځای خامه ډېټا: بایټ[] لکه چې دی لېږي (فایل، د دوه‌ییز پروتوکول بسته).
    دنده بایټونه_ولېږه(س: ساکټ، ډېټا: بایټ[]): عدد
        راګرځه _بایټونه_ولېږه(س.نښه، ډېټا)

    # تر تر_ټولو_ډېر_بایټونه پورې هر څه چې راځي ته انتظار کوي او د بایټ[] په توګه یې راګرځوي (تشه
    # لړۍ کله چې بل لوري تړلی وي، وخت پای ته ورسېږي یا تېروتنه وشي).
    دنده بایټونه_واخله(س: ساکټ، تر_ټولو_ډېر_بایټونه: عدد): بایټ[]
        راګرځه _بایټونه_واخله(س.نښه، تر_ټولو_ډېر_بایټونه)

    # تر هغه رښتیا چې اړیکه لا څه راوړلای شي.
    دنده پرانیستی_دی(س: ساکټ): منطقي
        راګرځه _پرانیستی_دی(س.نښه)

    # ساکټ تړي (اړیکه، اورېدونکی یا UDP). بل لوری یې پوهېږي. «سره» دا ستاسې لپاره د خپل
    # بلاک په پای کې بلي؛ د یوه ساکټ دوه ځله تړل هېڅ زیان نه لري.
    دنده وتړه(س: ساکټ)
        _وتړه(س.نښه)

    # منل او اخیستل څومره انتظار کولای شي، په ملي ثانیو (-۱: تل، اصلي).
    دنده وخت_حد(س: ساکټ، ملي_ثانیې: عدد): منطقي
        راګرځه _وخت_حد(س.نښه، ملي_ثانیې)

    # پر دې کمپیوټر پورټ، لکه هغه چې ټي_سي_پي.اورېدونکی_جوړ_کړه(پته، ۰) ته ورکړل شو.
    دنده پورټ(س: ساکټ): عدد
        راګرځه _پورټ(س.نښه)

    # د اړیکې د بل لوري پته، لکه "ip:port".
    دنده مقابل_لوری(س: ساکټ): متن
        راګرځه _مقابل_لوری(س.نښه)

    # ولې وروستۍ بلنه چې ناکامه شوه (هېڅ، -۱ یا "") داسې وشوه.
    دنده تېروتنه(): متن
        راګرځه _تېروتنه()

    # د هغې نښې ساکټ چې ++C راوګرځوله؛ د -۱ لپاره هېڅ (کار یې ونه کړ). لاندې ټولګي یې
    # کاروي، او ستاسې خپل بهرنی کتابتون یې هم کارولای شي که ساکټونه پرانیزي.
    دنده له_نښې(نښه: عدد): ساکټ
        که نښه < ۰
            راګرځه هېڅ
        راګرځه ساکټ(نښه)

# --- TCP: اړیکه چې متن په ترتیب، دواړو لورو ته وړي ------------------------------------

ټولګی ټي_سي_پي
    بهرنی دنده _اورېدونکی_جوړ_کړه(پته: متن، پورټ: عدد): عدد
    بهرنی دنده _اړیکه_ومنه(اورېدونکی: عدد): عدد
    بهرنی دنده _ونښلېږه(سرور: متن، پورټ: عدد): عدد

    # په دې کمپیوټر اړیکو ته انتظار کوي. پته "" مانا هره پته؛ پورټ ۰ سیسټم ته پرېږدي
    # چې یو وټاکي (ساکټ.پورټ وپوښتئ). اورېدونکی راګرځوي، یا هېڅ.
    دنده اورېدونکی_جوړ_کړه(پته: متن، پورټ: عدد): ساکټ.ساکټ
        راګرځه ساکټ.له_نښې(_اورېدونکی_جوړ_کړه(پته، پورټ))

    # د اورېدونکي راتلونکي پېرېدونکي ته انتظار کوي او ورسره اړیکه راګرځوي، یا هېڅ
    # (که پر اورېدونکي ساکټ.وخت_حد ټاکل شوی وي، هغه مهال هم چې څوک په وخت رانغی).
    دنده اړیکه_ومنه(اورېدونکی: ساکټ.ساکټ): ساکټ.ساکټ
        راګرځه ساکټ.له_نښې(_اړیکه_ومنه(اورېدونکی.نښه))

    # له یوه سرور سره نښلي ("localhost"، "192.168.1.5"، "example.org"). که رد شي هېڅ.
    دنده ونښلېږه(سرور: متن، پورټ: عدد): ساکټ.ساکټ
        راګرځه ساکټ.له_نښې(_ونښلېږه(سرور، پورټ))

    # یوه بشپړه تبادله: ونښلېږه، یوه کرښه ولېږه، ځواب ولوله، اړیکه پرې کړه.
    # "" که سرور ته نه رسېدل کېږي.
    دنده غوښتنه(سرور: متن، پورټ: عدد، کرښه: متن): متن
        اړیکه = ونښلېږه(سرور، پورټ) سره
            که اړیکه == هېڅ
                راګرځه ""
            ساکټ.کرښه_ولېږه(اړیکه، کرښه)
            راګرځه ساکټ.کرښه_واخله(اړیکه)

# --- UDP: یو یو پیغام (ډاټاګرام) بې اړیکې، هرې پتې ته ----------------------------------

ټولګی یو_ډي_پي
    بهرنی دنده _پرانیزه(پورټ: عدد): عدد
    بهرنی دنده _ولېږه(نښه: عدد، سرور: متن، پورټ: عدد، متن_یې: متن): عدد
    بهرنی دنده _واخله(نښه: عدد، تر_ټولو_ډېر_بایټونه: عدد): متن
    بهرنی دنده _بایټونه_ولېږه(نښه: عدد، سرور: متن، پورټ: عدد، ډېټا: بایټ[]): عدد
    بهرنی دنده _بایټونه_واخله(نښه: عدد، تر_ټولو_ډېر_بایټونه: عدد): بایټ[]
    بهرنی دنده _لېږونکی(): متن

    # د دې کمپیوټر پر یوه پورټ UDP ساکټ پرانیزي (۰: هر تش پورټ)؛ که ناکام شي هېڅ.
    دنده پرانیزه(پورټ: عدد): ساکټ.ساکټ
        راګرځه ساکټ.له_نښې(_پرانیزه(پورټ))

    # یو ډاټاګرام سرور:پورټ ته لېږي؛ لېږل شوي بایټونه راګرځوي، یا -۱.
    دنده ولېږه(س: ساکټ.ساکټ، سرور: متن، پورټ: عدد، متن_یې: متن): عدد
        راګرځه _ولېږه(س.نښه، سرور، پورټ، متن_یې)

    # یوه ډاټاګرام ته انتظار کوي او متن یې راګرځوي ("" د وخت پای یا تېروتنې پر مهال).
    دنده واخله(س: ساکټ.ساکټ، تر_ټولو_ډېر_بایټونه: عدد): متن
        راګرځه _واخله(س.نښه، تر_ټولو_ډېر_بایټونه)

    # د خامو بایټونو ډاټاګرام سرور:پورټ ته لېږي؛ لېږل شوي بایټونه راګرځوي، یا -۱.
    دنده بایټونه_ولېږه(س: ساکټ.ساکټ، سرور: متن، پورټ: عدد، ډېټا: بایټ[]): عدد
        راګرځه _بایټونه_ولېږه(س.نښه، سرور، پورټ، ډېټا)

    # یوه ډاټاګرام ته انتظار کوي او د بایټ[] په توګه یې راګرځوي ([] د وخت پای یا تېروتنې پر مهال).
    دنده بایټونه_واخله(س: ساکټ.ساکټ، تر_ټولو_ډېر_بایټونه: عدد): بایټ[]
        راګرځه _بایټونه_واخله(س.نښه، تر_ټولو_ډېر_بایټونه)

    # چا هغه ډاټاګرام لېږلی چې یو_ډي_پي.واخله وروستی راوګرځاوه، لکه "ip:port".
    دنده لېږونکی(): متن
        راګرځه _لېږونکی()

# --- نومونه او پتې ----------------------------------------------------------------------

ټولګی کوربه
    # د یوه نوم IP پته ("example.org" -> "93.184.216.34")، یا "" که نامعلوم وي.
    بهرنی دنده پته(نوم: متن): متن
    # د همدې کمپیوټر خپل نوم.
    بهرنی دنده نوم(): متن
