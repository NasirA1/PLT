# ژبه: ps
# پرمختللی ۰۲ - د الګوریتمونو کتابتون
#
# راوړه "algorithms" د ترتیب او لټون کلاسیک الګوریتمونه راوړي، پخپله په تندر کې لیکل
# شوي (lib/thunder/ps) او د توکو پر ډول عمومي. کتابتون پرانیزئ او ولولئ چې هر یو
# څنګه کار کوي؛ تشریح یې په docs/ps/algorithms.md کې ده.

راوړه "algorithms"

# --- پنځه لارې، همغه عددونه --------------------------------------------------------
متغیر ا = [۵، ۲، ۹، ۱، ۵، ۶]
حبابي_ترتیب(ا)
متغیر ب = [۵، ۲، ۹، ۱، ۵، ۶]
غوراوی_ترتیب(ب)
متغیر ج = [۵، ۲، ۹، ۱، ۵، ۶]
ننویستل_ترتیب(ج)
متغیر د = [۵، ۲، ۹، ۱، ۵، ۶]
چټک_ترتیب(د)
متغیر ه = [۵، ۲، ۹، ۱، ۵، ۶]
ګډولو_ترتیب(ه)
کرښه چاپ(ا)
کرښه چاپ("ټول یو شان؟ "، متن کړه(ا) == متن کړه(ب) او متن کړه(ب) == متن کړه(ج) او متن کړه(ج) == متن کړه(د) او متن کړه(د) == متن کړه(ه))

# --- همدا الګوریتمونه کلمې هم اڼي ---------------------------------------------------
متغیر کلمې = ["ناک"، "مڼه"، "انځر"، "خرما"]
چټک_ترتیب(کلمې)
کرښه چاپ(کلمې)

# --- لټون: پرله پسې هر ځای کار کوي، نیمایي ترتیب شوې ننوتنه غواړي -------------------
کرښه چاپ("انځر په پرله پسې لټون: ځای "، پرله_پسې_لټون(کلمې، "انځر"))
کرښه چاپ("انځر په نیمایي لټون: ځای "، نیمایي_لټون(کلمې، "انځر"))
کرښه چاپ("ورک ارزښت: "، نیمایي_لټون(کلمې، "اننګور"))

# --- مرستندویې ----------------------------------------------------------------------
کرښه چاپ("د "، ا، " کمینه په ځای "، د_کمینې_ځای(ا))
تصادفي بنسټ(۷)
ګډوډه_کړه(ا)
کرښه چاپ("ګډوډه شوه، لا هم "، اوږدوالی(ا)، " ارزښتونه؛ ترتیب شوې؟ "، ترتیب_شوې_ده(ا))
چټک_ترتیب(ا)
کرښه چاپ("او بېرته په ترتیب: "، ا)
