# ژبه: ps
# ۳۹ - سره: هغه سرچینې چې ځان تړي
#
# ځینې ارزښتونه له پروګرام بهر د یو څه استازي دي چې پروګرام یې له کار وروسته باید بېرته
# ورکړي: پرانیستی فایل، د شبکې اړیکه، یو قلف. د یوه تړل هېرول اسانه تېروتنه ده - په
# ځانګړي توګه کله چې دنده وختي راوګرځي یا تکرار ودرېږي.
#
#     نوم = سرچینه سره
#         ... نوم وکاروئ ...
#
# «سره» سرچینه هغه مهال تړي چې بلاک یې پای ته ورسېږي، که هر ډول پای ته ورسېږي: د بلاک
# په پای کې، یا په راګرځه، ودرېږه یا دوام. سرچینه یو جوړښت دی، او هغه دنده چې دا تړي د
# جوړښت د ټولګي «وتړه» ده، چې له سرچینې سره بلل کېږي (دا RAII دی: Resource Acquisition
# Is Initialisation). هغه سرچینه چې هېڅ وي نه تړل کېږي، او یو په بل کې «سره» بلاکونه
# تر ټولو دننني لومړی تړي. د ۳۸_sockets.th ساکټونه همداسې تړل کېږي.
#
# پښتو دا کلیدي کلمه د کرښې په پای کې لیکي، لکه ژبه چې یې وايي: «ساکټ سره» (انګلیسي
# «with» د کرښې په پیل کې لیکي: with the socket).

راوړه فایل

# زموږ خپله یوه سرچینه: یادښت چې کرښې راټولوي او کله چې وتړل شي، خپل فایل ته یې لیکي.
# هر جوړښت سرچینه کېږي کله چې ټولګی یې د هغه لپاره د وتړه دنده ولري.
ټولګی یادښت
    جوړښت یادښت
        مسیر: متن
        کرښې: متن[]

    دنده پرانیزه(مسیر: متن): یادښت
        کرښه چاپ("  ("، مسیر، " پرانیستل شو)")
        راګرځه یادښت(مسیر، [])

    دنده ولیکه(ی: یادښت، کرښه: متن)
        ورزیات کړه(ی.کرښې، کرښه)

    # «سره» دا د بلاک په پای کې بلي.
    دنده وتړه(ی: یادښت)
        فایل.ولیکه(ی.مسیر، متن.یو ځای کړه(ی.کرښې، "\ن") + "\ن")
        کرښه چاپ("  ("، ی.مسیر، " وتړل شو: "، اوږدوالی(ی.کرښې)، " کرښې ولیکل شوې)")

کرښه چاپ("۱. د بلاک پای یې تړي:")
یادښتونه = یادښت.پرانیزه("thunder_notes.txt") سره
    یادښت.ولیکه(یادښتونه، "لومړۍ")
    یادښت.ولیکه(یادښتونه، "دوهمه")
کرښه چاپ("  فایل وايي: "، متن.وېشه(متن.پاک کړه(فایل.ولوله("thunder_notes.txt"))، "\ن"))

کرښه چاپ("۲. همداسې راګرځه هم، له ژورې دننه:")
دنده لومړی_منفي(عددونه: عدد[]): عدد
    څرک = یادښت.پرانیزه("thunder_trace.txt") سره
        تکرار ع په عددونه
            یادښت.ولیکه(څرک، "وکتل شو " + متن کړه(ع))
            که ع < ۰
                راګرځه ع
    راګرځه ۰

کرښه چاپ("  لومړی منفي: "، لومړی_منفي([۴، ۸، -۱۵، ۱۶]))

کرښه چاپ("۳. او ودرېږه او دوام:")
تکرار پړاو په واټن(۱، ۴)
    هڅه = یادښت.پرانیزه("thunder_round.txt") سره
        که پړاو == ۲
            دوام
        یادښت.ولیکه(هڅه، "پړاو " + متن کړه(پړاو))
        که پړاو == ۳
            ودرېږه

کرښه چاپ("۴. یو په بل کې بلاکونه تر ټولو دننني لومړی تړي:")
دباندنی = یادښت.پرانیزه("thunder_outer.txt") سره
    دننی = یادښت.پرانیزه("thunder_inner.txt") سره
        یادښت.ولیکه(دننی، "دننه")
    یادښت.ولیکه(دباندنی، "بهر")

کرښه چاپ("۵. هغه سرچینه چې هېڅ وي نه تړل کېږي:")
دنده کېدای_شي_پرانیزه(غوښتل_شوی: منطقي): یادښت.یادښت
    که غوښتل_شوی
        راګرځه یادښت.پرانیزه("thunder_maybe.txt")
    راګرځه هېڅ

شاید = کېدای_شي_پرانیزه(درواغ) سره
    کرښه چاپ("  هېڅ ترلاسه شو؟ "، شاید == هېڅ)

کرښه چاپ("۶. مخکې جوړ شوی ارزښت هم «سره» ته ورکول کېدای شي:")
متغیر راپور = یادښت.پرانیزه("thunder_report.txt")
یادښت.ولیکه(راپور، "له بلاک مخکې جوړ شو")
راپور سره
    یادښت.ولیکه(راپور، "په دننه کې ولیکل شو")

تکرار مسیر په ["thunder_notes.txt"، "thunder_trace.txt"، "thunder_round.txt"، "thunder_outer.txt"، "thunder_inner.txt"،
        "thunder_report.txt"]
    فایل.ړنګ کړه(مسیر)
