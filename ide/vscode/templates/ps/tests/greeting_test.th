# ژبه: ps
# د lib/greeting.th ازموینې.
#
# هره ازموینه یوه دنده ده؛ ازموینه.وچلوه نوم ورکوي او چلوي یې، او ازموینه.پای_ته_ورسوه()
# لنډیز چاپوي او که څه ناکام شي، پروګرام په ۱ حالت پای ته رسوي. په VS Code کې د Testing
# کتنه یې لیستوي، او «Thunder: Run All Tests» د پروژې ټولې ازموینې چلوي.

راوړه "testing"
راوړه "../lib/greeting"

دنده سلام_په_نوم_کوي()
    تمه.برابر(ښه_راغلاست.سلام("نړۍ")، "سلام، نړۍ!")
    تمه.برابر(ښه_راغلاست.سلام("تندر")، "سلام، تندر!")

دنده سلام_تل_څه_وايي()
    تمه.رښتیا_وي(اوږدوالی(ښه_راغلاست.سلام("الف")) > ۰)

ازموینه.وچلوه("سلام په نوم کوي"، سلام_په_نوم_کوي)
ازموینه.وچلوه("سلام تل څه وايي"، سلام_تل_څه_وايي)
ازموینه.پای_ته_ورسوه()
