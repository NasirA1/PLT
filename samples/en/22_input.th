// 22 - Reading input
//
// input() reads one line typed by the user (input("prompt") writes a prompt
// first). end_of_input() tells when there is nothing more to read.
//
// Try it: press Run, then type into the Input line under the Output panel and
// press Enter. "End input" ends the input (Ctrl+D in a terminal).
// From the command line: thundervm 22_input.thc < numbers.txt

var name = trim(input("What is your name? "))
println("Hello, ", name, "!")

println("Type some numbers, one per line; an empty line ends the list.")
var total = 0
var count = 0
while !end_of_input()
    var line = trim(input())
    if line == ""
        break
    if is_int(line)
        total = total + to_int(line)
        count = count + 1
    else
        println("'", line, "' is not a number, so it is skipped")
println(count, " number(s), total ", total)
