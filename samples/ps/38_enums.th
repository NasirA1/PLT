# ژبه: ps
# ۳۸ - ګڼنې: یو ډول چې د نومول شویو ارزښتونو ټاکلې ټولګه لري
#
# ګڼنه خپل غړي لیکي، په هره کرښه کې یو. هر غړی د نوي ډول یو ارزښت دی، چې
# ډول.غړی لیکل کېږي، او یو ځای لري: لومړی ۰، بل ۱، او داسې نور. ګڼنې د «جادويي»
# متنونو او عددونو ځای نیسي: لوری غلط نشي لیکل کېدای، او کمپایلر هر هغه ارزښت
# پېژني چې اخیستلای یې شي.
#
# هڅه وکړئ: لوری ته یو غړی ورزیات کړئ او وګورئ چې لاندې هر تکرار یې راخلي.

ګڼنه لوری
    شمال
    ختیځ
    سهیل
    لوېدیځ

ګڼنه ورځ
    دوشنبه، سه‌شنبه، چهارشنبه، پنجشنبه، جمعه، شنبه، یکشنبه

متغیر مخه = لوری.شمال
کرښه چاپ(مخه، " "، عدد کړه(مخه)، " "، لوری.شمېر، " غړي: "، لوری.ارزښتونه)

# یو غړی له خپل ځای یا نوم څخه، چې د پروګرام په چلېدو کې موندل کېږي.
کرښه چاپ(لوری(۲)، " "، لوری("لوېدیځ")، " "، لوری(عدد کړه(مخه) + ۱))

# ښي لور ته تاوېدل: راتلونکی غړی، چې په پای کې بېرته پیل ته راګرځي.
دنده ښي_ته_وګرځه(ل: لوری): لوری
    راګرځه لوری((عدد کړه(ل) + ۱) % لوری.شمېر)
متغیر تاوونه = ۰
ترڅو تاوونه < ۵
    چاپ(مخه، " -> ")
    مخه = ښي_ته_وګرځه(مخه)
    تاوونه += ۱
کرښه چاپ(مخه)

# غړي د ځای له مخې پرتله کېږي، ترتیبېږي، او د نقشې کیلۍ کېږي.
کرښه چاپ(ورځ.دوشنبه < ورځ.جمعه، " "، ترتیب کړه([ورځ.یکشنبه، ورځ.دوشنبه، ورځ.چهارشنبه]))
متغیر مقابل = {لوری.شمال: لوری.سهیل، لوری.سهیل: لوری.شمال،
               لوری.ختیځ: لوری.لوېدیځ، لوری.لوېدیځ: لوری.ختیځ}
تکرار ل په لوری.ارزښتونه
    چاپ(ل، " مقابل "، مقابل[ل]، "؛ ")
کرښه چاپ()
دنده رخصتي_ده(و: ورځ): منطقي
    راګرځه و >= ورځ.شنبه
متغیر رخصتي = چاڼ کړه(ورځ.ارزښتونه، رخصتي_ده)
کرښه چاپ("رخصتي: "، رخصتي، " ("، اوږدوالی(رخصتي)، " ورځې)")

# د اوزارو خپلې ګڼنې: رنګونه (راوړه ګرافیک) او پلیټفارم (راوړه سیسټم).
راوړه سیسټم
کرښه چاپ("چلېږي په "، عامل سیسټم()، ": "، عامل سیسټم() == پلیټفارم.لینکس یا عامل سیسټم() != پلیټفارم.لینکس)
