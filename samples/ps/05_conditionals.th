// ژبه: ps
// ۰۵ - شرطونه: که / کنه
//
// شرط باید منطقي (رښتیا یا دروغ) وي. د پرتلې عملګر (== != < <= > >=)
// منطقي ارزښت جوړوي، او && || ! یې سره یوځای کوي.
//
// هڅه وکړئ: د «بایټ کوډ» پاڼه پرانیزئ او JUMP_IF_FALSE لارښوونې ومومئ.

دنده درجه(نمره: عدد): متن
{
    که (نمره >= ۹۰)
    {
        راګرځه «الف»
    }
    کنه که (نمره >= ۷۵)
    {
        راګرځه «ب»
    }
    کنه که (نمره >= ۵۰)
    {
        راګرځه «ج»
    }
    کنه
    {
        راګرځه «ناکام»
    }
}

چاپ_کرښه(«۹۵ ← »، درجه(۹۵))
چاپ_کرښه(«۸۰ ← »، درجه(۸۰))
چاپ_کرښه(«۵۰ ← »، درجه(۵۰))
چاپ_کرښه(«۱۲ ← »، درجه(۱۲))

متغیر کال = ۲۰۲۴
متغیر کبیسه = (کال ٪ ۴ == ۰ && کال ٪ ۱۰۰ != ۰) || کال ٪ ۴۰۰ == ۰
که (کبیسه)
{
    چاپ_کرښه(کال، « کبیسه کال دی»)
}
کنه
{
    چاپ_کرښه(کال، « کبیسه کال نه دی»)
}
