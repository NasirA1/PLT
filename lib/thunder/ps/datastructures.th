    متغیر مخکښه: لیکه<ت> = نوې_لیکه()
    ټولګې_ته_ورزیات_کړه(لیدلي، پیل)
    لیکې_ته_ورزیات_کړه(مخکښه، پیل)
    ترڅو نه لیکه_تشه_ده(مخکښه)
