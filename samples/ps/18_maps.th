// ژبه: ps
// ۱۸ - نقشې
//
// نقشه ارزښتونه د کیلیو لاندې ساتي: {"ناصر": ۴۰} د {متن: عدد} ډول لري.
// کیلۍ عدد، منطقي یا متن کېدای شي. نقشه[کیلۍ] یو ارزښت لولي (که کیلۍ نه
// وي، د اجرا تېروتنه ده)، نقشه[کیلۍ] = ارزښت یو ارزښت ورزیاتوي یا بدلوي، او
// لري، لرې کړه، کیلۍ او ارزښتونه دننۍ دندې دي. نقشې د ورزیاتېدو ترتیب ساتي.
//
// هڅه وکړئ: له ډیبګ وروسته د VM پاڼه پرانیزئ او وګورئ چې نقشه څنګه لویېږي.

متغیر عمرونه = {"ناصر": ۴۰، "ساره": ۷}
عمرونه["علي"] = ۱۲                 // یوه کیلۍ ورزیاتوي
عمرونه["ساره"] = ۸                 // یو ارزښت بدلوي
کرښه چاپ(عمرونه)
کرښه چاپ("ناصر "، عمرونه["ناصر"]، " کلن دی")
کرښه چاپ(اوږدوالی(عمرونه)، " کسان؛ ساره شته؟ "، لري(عمرونه، "ساره")، "؛ عمر شته؟ "، لري(عمرونه، "عمر"))

متغیر کلمې = ["پیشو"، "سپی"، "او"، "پیشو"، "موږک"، "او"، "پیشو"، "سپی"]
متغیر شمېرنې: {متن: عدد} = {}     // تشه نقشه د ډول ښودنې ته اړتیا لري
لپاره متغیر ش = ۰، ش < اوږدوالی(کلمې)، ش = ش + ۱
    متغیر کلمه = کلمې[ش]
    که لري(شمېرنې، کلمه)
        شمېرنې[کلمه] = شمېرنې[کلمه] + ۱
    کنه
        شمېرنې[کلمه] = ۱
کرښه چاپ(شمېرنې)

متغیر نومونه = کیلۍ(شمېرنې)
لپاره متغیر ش = ۰، ش < اوږدوالی(نومونه)، ش = ش + ۱
    کرښه چاپ(نومونه[ش]، ": "، ارزښتونه(شمېرنې)[ش])

لرې کړه(شمېرنې، "پیشو")
کرښه چاپ("پرته له «پیشو»: "، شمېرنې)

// لکه لړۍ، نقشې هم شریکېږي؛ کاپي() خپلواکه نقشه جوړوي.
متغیر شریکه = عمرونه
شریکه["ناصر"] = ۴۱
متغیر جلا = کاپي(عمرونه)
جلا["ناصر"] = ۹۹
کرښه چاپ(عمرونه["ناصر"]، " "، شریکه["ناصر"]، " "، جلا["ناصر"])
