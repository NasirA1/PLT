// 08 - Functions
//
// A function has typed parameters and an optional return type. A function
// without a return type returns nothing. Functions can be called before the
// line where they are declared, because the compiler collects every function
// signature before checking any code.
//
// If a program defines main(), it runs after the top-level statements.
//
// Try it: open the Bytecode tab. Each function becomes its own block of code;
// parameters live in the first local slots, and CALL / RETURN move between them.

func area(width: int, height: int): int
{
    return width * height
}

func max(a: int, b: int): int
{
    if (a > b)
    {
        return a
    }
    return b
}

func describe(name: string, width: int, height: int)
{
    println(name, ": ", width, " x ", height, " = ", area(width, height))
}

func main()
{
    describe("door", 1, 2)
    describe("table", 2, 3)
    println("bigger area: ", max(area(1, 2), area(2, 3)))
}

println("Top-level statements run first; then main() is called.")
