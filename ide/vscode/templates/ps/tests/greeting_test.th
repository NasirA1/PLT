راوړه "../lib/greeting"

@ازموینه("سلام په نوم کوي")
دنده سلام_په_نوم_کوي()
    تمه.برابر(ښه_راغلاست.سلام("نړۍ")، "سلام، نړۍ!")
    تمه.برابر(ښه_راغلاست.سلام("تندر")، "سلام، تندر!")

@ازموینه
دنده سلام_تل_څه_وايي()
    تمه.رښتیا_وي(متن.اوږدوالی(ښه_راغلاست.سلام("الف")) > ۰)
