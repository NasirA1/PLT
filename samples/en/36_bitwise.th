# 36 - Bits: hexadecimal, binary and the bitwise operators
#
# A whole number is a row of 64 bits. Writing it in binary (0b...) or in
# hexadecimal (0x..., four bits per digit) shows those bits, and the bitwise
# operators work on them one by one:
#     &  AND   1 where both have a 1        |  OR    1 where either has a 1
#     ^  XOR   1 where they differ          ~  NOT   every bit flipped
#     << >>    shift the bits left or right (<< multiplies by 2, >> divides)
# They bind tighter than comparisons, so  flags & mask != 0  means  (flags & mask) != 0.
#
# Try it: open the Bits tab (Under the bonnet), type 12 and 10, and watch
# each operator. Then open the Bytecode tab: each operator is one instruction.

println(0b1100, " ", 0x0C, " ", 12)          # three spellings of twelve
println(12 & 10, " ", 12 | 10, " ", 12 ^ 10)  # 8 14 6
println(~0, " ", ~12)                         # -1 -13: ~a is -a - 1

# Shifts: each step left doubles, each step right halves (keeping the sign).
println(1 << 4, " ", 0b1000 >> 3, " ", -16 >> 2)

# Flags: one bit per setting, packed into a single number.
const BOLD = 0b001
const ITALIC = 0b010
const UNDERLINE = 0b100
var style = BOLD | UNDERLINE                  # switch two flags on
println("bold? ", style & BOLD != 0, "  italic? ", style & ITALIC != 0)
style = style & ~BOLD                         # switch one off again
println("bold? ", style & BOLD != 0, "  as bits: ", style)

# Masks pick out part of a number: the low byte of a colour, say. format() with the
# {x} and {b} placeholders - and the hex() and bin() conversions - show the bits.
var colour = 0x336699
println(format("red {} green {} blue {}", colour >> 16 & 0xFF, colour >> 8 & 0xFF, colour & 0xFF))
println(format("style {b} is {} is {x}", style, style, style))
println(hex(255), " ", bin(5), " ", to_int("0x2a"), " ", to_int(bin(42)))

# Counting the 1 bits of a number by hand.
func count_bits(n: int): int
    var count = 0
    while n != 0
        count = count + (n & 1)
        n = n >> 1
    return count
println("0b101101 has ", count_bits(0b101101), " bits set; 0xFF has ", count_bits(0xFF))
