# A multi-file Thunder project, for trying the VS Code extension on something bigger than a
# single file. See README.md next to this file.
#
# Things worth trying here:
#   * F12 on "geometry.area" or "geometry.Rectangle" jumps into lib/geometry.th
#   * typing "room." offers width and height, from the struct in the other file
#   * F5 steps through the program - and backwards
#   * breaking lib/geometry.th shows the error in that file, not in this one

import "lib/geometry"
import "lib/statistics"
import os

const ROOM_COUNT = 3

func rooms(): geometry.Rectangle[]
    return [geometry.Rectangle(4, 3), geometry.Rectangle(2, 7), geometry.Rectangle(5, 5)]

func report(all_rooms: geometry.Rectangle[])
    for room in all_rooms
        print("  ", geometry.describe(room))
        if geometry.is_square(room)
            print("  (a square)")
        println("")

func main()
    var all_rooms = rooms()
    println("The project has ", len(all_rooms), " of an expected ", ROOM_COUNT,
            " room(s); the command line said ", os.args(), ":")
    report(all_rooms)
    var areas = [geometry.area(all_rooms[0]), geometry.area(all_rooms[1]), geometry.area(all_rooms[2])]
    println("total area:   ", statistics.total_area(all_rooms))
    println("largest room: ", statistics.largest(areas))
    println("average area: ", statistics.mean(areas))
    println("in hex:       ", hex(statistics.total_area(all_rooms)))
