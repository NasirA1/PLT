# ژبه: ps
# ۳۲ - دایروي حرکت: مدارونه او سپیروګراف (حرکت)
#
# هر څه چې په دایره کې ګرځي، تتمیم جیب او جیب دي: د (مس، مص) پر شاوخوا د و
# وړانګې په دایره کې، په زاویه ز کې یو ټکی دا دی:
#     س = مس + تتمیم جیب(ز) * و
#     ص = مص + جیب(ز) * و
# هغه سیاره چې یوه ګرځېدنه یې «دوره» ثانیې وخت نیسي، زاویه یې
# ۲ * پای() * وخت / دوره ده.
#
# ښي خوا سپیروګراف کاږي: یوه کوچنۍ څرخه چې د یوې لویې دننه ګرځي — همدا دوه
# فورمولونه سره جمع شوي.
#
# هڅه وکړه: «چلول» کښېکښه. د یوې سیارې دوره، یا د سپیروګراف «څرخه» او «قلم»
# بدل کړه چې بل نقش جوړ شي.

راوړه ګرافیک

ثابت پلنوالی = ۵۲۰
ثابت لوړوالی = ۳۲۰
ټاټ(پلنوالی، لوړوالی)
د چوکاټ چټکتیا(۳۰)
د لیکنې اندازه(۱۲)

جوړښت سیاره
    نوم: متن
    واټن_یې: اعشاري
    دوره: اعشاري        # د یوې بشپړې ګرځېدنې ثانیې
    اندازه: اعشاري
    رنګ_یې: متن

متغیر سیارې = [
    سیاره("۱"، ۳۴٫۰، ۲٫۰، ۵٫۰، "#f7b801")،
    سیاره("۲"، ۵۸٫۰، ۳٫۶، ۷٫۵، "#4cc9f0")،
    سیاره("۳"، ۸۶٫۰، ۶٫۴، ۶٫۰، "#f55d3e")،
    سیاره("۴"، ۱۱۸٫۰، ۱۱٫۰، ۹٫۰، "#90be6d")]

ثابت لمر_س = ۱۴۰٫۰
ثابت لمر_ص = ۱۶۰٫۰

# سپیروګراف: یو قلم پر کوچنۍ څرخه چې د «کړۍ» په وړانګه دننه ګرځي.
ثابت کړۍ = ۱۱۰٫۰
ثابت څرخه = ۳۱٫۰
ثابت قلم = ۶۲٫۰
ثابت سپ_س = ۳۹۰٫۰
ثابت سپ_ص = ۱۶۰٫۰

دنده سپیرو(ز: اعشاري، محور: عدد): اعشاري
    ثابت ک = (کړۍ - څرخه) / څرخه
    که محور == ۰
        راګرځه سپ_س + (کړۍ - څرخه) * تتمیم جیب(ز) + قلم * تتمیم جیب(ک * ز)
    راګرځه سپ_ص + (کړۍ - څرخه) * جیب(ز) - قلم * جیب(ک * ز)

متغیر وخت_یې = ۰٫۰
ترڅو رښتیا
    ټاټ پاک کړه("#0b1020")

    # ---- مدارونه
    د لیکې پلنوالی(۱٫۰)
    لپاره س په سیارې
        د دایرې څنډه(لمر_س، لمر_ص، س.واټن_یې، "#2b344a")
    دایره(لمر_س، لمر_ص، ۱۴٫۰، "#ffd166")
    د دایرې څنډه(لمر_س، لمر_ص، ۲۰٫۰، "#8a6d1f")

    لپاره س په سیارې
        متغیر ز = ۲٫۰ * پای() * وخت_یې / س.دوره
        متغیر ځ_س = لمر_س + تتمیم جیب(ز) * س.واټن_یې
        متغیر ځ_ص = لمر_ص + جیب(ز) * س.واټن_یې
        دایره(ځ_س، ځ_ص، س.اندازه، س.رنګ_یې)
        لیکنه(ځ_س + س.اندازه + ۳٫۰، ځ_ص - ۷٫۰، س.نوم، "#8894b0")
    لیکنه(۲۰، ۲۰، "مدارونه: د ۲*پای*و/دوره جیب او تتمیم جیب"، "#c9d1e4")

    # ---- سپیروګراف، چې په هر چوکاټ کې یو څه نور کښل کېږي
    د لیکې پلنوالی(۱٫۵)
    متغیر کښل_شوی = وخت_یې * ۲٫۶
    متغیر ګام = ۰٫۰۸
    متغیر ز = ۰٫۰
    ترڅو ز < کښل_شوی
        متغیر بل = کمینه(ز + ګام، کښل_شوی)
        لیکه(سپیرو(ز، ۰)، سپیرو(ز، ۱)، سپیرو(بل، ۰)، سپیرو(بل، ۱)، "#c77dff")
        ز = ز + ګام
    د دایرې څنډه(سپ_س، سپ_ص، کړۍ، "#2b344a")
    دایره(سپیرو(کښل_شوی، ۰)، سپیرو(کښل_شوی، ۱)، ۳٫۵، "#ffffff")
    لیکنه(۳۰۰، ۲۰، "سپیروګراف: دوې دایرې سره جمع"، "#c9d1e4")

    چوکاټ()
    وخت_یې = وخت_یې + ۱٫۰ / ۳۰٫۰
    که وخت_یې > ۶۰٫۰
        وخت_یې = ۰٫۰
