# ژبه: ps
# پرمختللی ۰۱ - د ډېټا جوړښتونو کتابتون
#
# راوړه "datastructures" کلاسیک جوړښتونه راوړي: ډېرۍ، لیکه، ځنځیر، د لټون دوه‌اړخیزه
# ونه او د لومړیتوب لیکه - ټول پخپله په تندر کې لیکل شوي (lib/thunder/ps) او ټول
# عمومي: د توکو ډول په <زاویه قوسونو> کې له کارونې معلومېږي.
# کتابتون په docs/ps/datastructures.md کې تشریح شوی دی.

راوړه "datastructures"

# --- د متنونو ډېرۍ: وروستی دننه، لومړی بهر ------------------------------------------
متغیر کاسې: ډېرۍ.ډېرۍ<متن> = ډېرۍ.نوې()
ډېرۍ.ورزیات_کړه(کاسې، "ومینځل شوه")
ډېرۍ.ورزیات_کړه(کاسې، "وچه شوه")
ډېرۍ.ورزیات_کړه(کاسې، "کېښودل شوه")
کرښه چاپ("د ډېرۍ سر: "، ډېرۍ.وګوره(کاسې))
ترڅو نه ډېرۍ.تشه_ده(کاسې)
    کرښه چاپ("واخله: "، ډېرۍ.واخله(کاسې))

# --- د پېرودونکو لیکه: لومړی دننه، لومړی بهر ----------------------------------------
متغیر انتظار: لیکه.لیکه<متن> = لیکه.نوې()
لیکه.ورزیات_کړه(انتظار، "انا")
لیکه.ورزیات_کړه(انتظار، "بشیر")
لیکه.ورزیات_کړه(انتظار، "ثریا")
کرښه چاپ("خدمت: "، لیکه.واخله(انتظار)، "؛ راتلونکی "، لیکه.وګوره(انتظار)،
    " له "، لیکه.کچه(انتظار))

# --- ځنځیر: د غوټیو کړۍ چې هېڅ یې پای ته رسوي ---------------------------------------
متغیر کړۍ: ځنځیر.ځنځیر<عدد> = ځنځیر.نوی()
ځنځیر.پای_ته_ورزیات_کړه(کړۍ، ۲)
ځنځیر.سر_ته_ورزیات_کړه(کړۍ، ۱)
ځنځیر.پای_ته_ورزیات_کړه(کړۍ، ۳)
کرښه چاپ("د لړۍ په بڼه: "، ځنځیر.لړۍ_کړه(کړۍ)، "، ۳ لري؟ "، ځنځیر.لري(کړۍ، ۳))
متغیر لیرې_شو = ځنځیر.لیرې_کړه(کړۍ، ۲)
کرښه چاپ("د ۲ له لیرې کولو ("، لیرې_شو، ") وروسته: "، ځنځیر.لړۍ_کړه(کړۍ))

# --- د لټون دوه‌اړخیزه ونه خپل ارزښتونه په ترتیب ساتي -------------------------------
متغیر ونه_: ونه.ونه<عدد> = ونه.نوې()
تکرار ن په [۵۰، ۳۰، ۸۰، ۱۰، ۴۰، ۷۰، ۹۰]
    ونه.ورزیات_کړه(ونه_، ن)
کرښه چاپ("ترتیب شوې: "، ونه.په_ترتیب(ونه_))
کرښه چاپ("کچه "، ونه.کچه(ونه_)، "، لوړوالی "، ونه.لوړوالی(ونه_)،
    "، کمینه "، ونه.کمینه(ونه_)، "، اعظمه "، ونه.اعظمه(ونه_))
متغیر ووت = ونه.لیرې_کړه(ونه_، ۵۰)
کرښه چاپ("ریښه لیرې شوه؟ "، ووت، "؛ پرته له هغې: "، ونه.په_ترتیب(ونه_))

# --- د لومړیتوب لیکه همېش کمینه لومړی راکوي -----------------------------------------
متغیر کارونه: لومړیتوب_لیکه.لومړیتوب_لیکه<عدد> = لومړیتوب_لیکه.نوې()
تکرار لومړیتوب په [۷، ۲، ۹، ۱، ۵]
    لومړیتوب_لیکه.ورزیات_کړه(کارونه، لومړیتوب)
ترڅو نه لومړیتوب_لیکه.تشه_ده(کارونه)
    چاپ(لومړیتوب_لیکه.واخله(کارونه)، " ")
کرښه چاپ()

# --- ټولګه هر ارزښت یو ځل ساتي؛ ترتیب شوې ټولګه یې اڼلي هم ساتي ---------------------
متغیر لیدل_شوي: ټولګه.ټولګه<متن> = ټولګه.نوې()
تکرار رنګ په ["سور"، "شین"، "سور"، "زرغون"، "شین"]
    ټولګه.ورزیات_کړه(لیدل_شوي، رنګ)
کرښه چاپ("ځانګړي رنګونه: "، ټولګه.ارزښتونه(لیدل_شوي)، " (له ۵ څخه "، ټولګه.کچه(لیدل_شوي)، ")")
متغیر ساړه: ټولګه.ټولګه<متن> = ټولګه.نوې()
ټولګه.ورزیات_کړه(ساړه، "شین")
ټولګه.ورزیات_کړه(ساړه، "زرغون")
کرښه چاپ("یوازې تاوده: "، ټولګه.ارزښتونه(ټولګه.توپیر(لیدل_شوي، ساړه)))

متغیر نمرې: ترتیب_شوې_ټولګه.ترتیب_شوې_ټولګه<عدد> = ترتیب_شوې_ټولګه.نوې()
تکرار نمره په [۷۰، ۴۰، ۹۰، ۷۰، ۴۰]
    ترتیب_شوې_ټولګه.ورزیات_کړه(نمرې، نمره)
کرښه چاپ("ځانګړې نمرې، اڼل شوې: "، ترتیب_شوې_ټولګه.ارزښتونه(نمرې)،
    "، له "، ترتیب_شوې_ټولګه.کمینه(نمرې)، " تر "، ترتیب_شوې_ټولګه.اعظمه(نمرې))

# --- دوسرې لیکه دواړه سرونه پرانیستي لري؛ دوه اړخیز ځنځیر دواړه لوري ګرځي -------------
متغیر لاره: دوسرې_لیکه.دوسرې_لیکه<متن> = دوسرې_لیکه.نوې()
دوسرې_لیکه.پای_ته_ورزیات_کړه(لاره، "دویم")
دوسرې_لیکه.سر_ته_ورزیات_کړه(لاره، "لومړی")
دوسرې_لیکه.پای_ته_ورزیات_کړه(لاره، "درېیم")
کرښه چاپ("دوسرې لیکه: "، دوسرې_لیکه.لړۍ_کړه(لاره)، "، له شا: "، دوسرې_لیکه.له_پایه_واخله(لاره))

متغیر پېښلیک: دوه_اړخیز_ځنځیر.دوه_اړخیز_ځنځیر<متن> = دوه_اړخیز_ځنځیر.نوی()
دوه_اړخیز_ځنځیر.پای_ته_ورزیات_کړه(پېښلیک، "یو")
دوه_اړخیز_ځنځیر.پای_ته_ورزیات_کړه(پېښلیک، "دوه")
دوه_اړخیز_ځنځیر.پای_ته_ورزیات_کړه(پېښلیک، "درې")
کرښه چاپ("مخ ته: "، دوه_اړخیز_ځنځیر.لړۍ_کړه(پېښلیک)، "، شا ته: "، دوه_اړخیز_ځنځیر.سرچپه_لړۍ_کړه(پېښلیک))

# --- ګراف: ښارونه، لارې، او تر ټولو لنډه لار د دوی تر منځ -----------------------------
متغیر لارې: ګراف.ګراف<متن> = ګراف.نوی()
ګراف.ونښلوه(لارې، "کابل"، "غزني")
ګراف.ونښلوه(لارې، "غزني"، "کندهار")
ګراف.ونښلوه(لارې، "کابل"، "بامیان")
ګراف.ونښلوه(لارې، "بامیان"، "هرات")
ګراف.ونښلوه(لارې، "کندهار"، "هرات")
کرښه چاپ("له کابله، لومړی نږدې: "، ګراف.پلن_لټون(لارې، "کابل"))
کرښه چاپ("هرات ته لنډه لار: "، ګراف.لنډه_لار(لارې، "کابل"، "هرات"))

# --- مختاړې ونه د مختاړي پوښتنو ته د ویي په اوږدوالي ځواب ورکوي -----------------------
متغیر سیند = مختاړې_ونه.نوې()
تکرار ویی په ["کور"، "کورنۍ"، "کار"، "لار"]
    مختاړې_ونه.ورزیات_کړه(سیند، ویی)
کرښه چاپ("وییونه: "، مختاړې_ونه.وییونه(سیند)، "؛ په «کو» پیلېږي؟ "، مختاړې_ونه.مختاړی_لري(سیند، "کو")،
    "؛ «کو» پخپله ویی دی؟ "، مختاړې_ونه.لري(سیند، "کو"))
