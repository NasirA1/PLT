// ژبه: ps
// ۱۷ - ټاپلونه
//
// ټاپل یو ټاکلی شمېر ارزښتونه، چې ډولونه یې توپیر لرلای شي، سره راټولوي:
// (۱، "یو") د (عدد، متن) ډول لري. ټاپلونه نه بدلېږي؛ توکي یې په .0، .1 ...
// ولولئ یا یې په متغیرونو کې خلاص کړئ. یوه دنده کولای شي ټاپل راوګرځوي
// چې څو پایلې په یو ځل بېرته ورکړي.
//
// هڅه وکړئ: د «نحوي ونه» پاڼه پرانیزئ او د Tuple او TupleIndex غوټې ومومئ.

متغیر جوړه = (۱، "یو")
کرښه چاپ(جوړه، " "، اوږدوالی(جوړه)، " توکي لري: "، جوړه.0، " او "، جوړه.1)

متغیر (شمېره، کلمه) = جوړه          // خلاصول: شمېره = ۱، کلمه = "یو"
کرښه چاپ(شمېره، " ← "، کلمه)

دنده کم_او_ډېر(ارزښتونه_یې: عدد[]): (عدد، عدد)
    متغیر کم = ارزښتونه_یې[۰]
    متغیر ډېر = ارزښتونه_یې[۰]
    لپاره متغیر ش = ۱، ش < اوږدوالی(ارزښتونه_یې)، ش = ش + ۱
        که ارزښتونه_یې[ش] < کم
            کم = ارزښتونه_یې[ش]
        که ارزښتونه_یې[ش] > ډېر
            ډېر = ارزښتونه_یې[ش]
    راګرځه (کم، ډېر)

متغیر (کم، ډېر) = کم_او_ډېر([۵، ۳، ۹، ۱، ۷])
کرښه چاپ("کم "، کم، "، ډېر "، ډېر)

// ټاپلونه توکی په توکی پرتله کېږي.
کرښه چاپ((کم، ډېر) == (۱، ۹)، " "، (۱، ۲) == (۲، ۱))

متغیر ټکي: (عدد، عدد)[] = [(۰، ۰)، (۳، ۴)]
متغیر واټن = (ټکي[۱].0 - ټکي[۰].0، ټکي[۱].1 - ټکي[۰].1)
کرښه چاپ("واټن: "، واټن)
