# lang: en

struct Employee
    _id: int
    _first_name: string
    _last_name: string

    Employee(id: int, first_name: string, last_name: string)
        _id = id
        _first_name = first_name
        _last_name = last_name


struct Department
    name: string
    supervisor: Employee

var emp = Employee(12, "Department", "Supervisor")
println(emp)

var dept = Department()
println(dept)

struct Game
    name: string
    Game(name: string)
        my.name = name
