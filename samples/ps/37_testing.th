# ژبه: ps
# ۳۷ - ازموینه: د پروګرام کتنه د ازموینې ماډیول سره
#
# راوړه "testing" ولیکئ او هره ازموینه د یوې دندې په توګه ولیکئ: دننه یې برابر_تمه او ملګري
# وايي چې څه باید رښتیا وي. ازموینه() دنده د یوه نوم لاندې چلوي او "✓ نوم" چاپوي کله چې هره
# تمه پوره شوه، یا "✗ نوم: څه ناسم شول" د هرې هغې لپاره چې پوره نه شوه. ازموینې_پای_کړه()
# ټولګه چاپوي او که کومه ازموینه ناکامه وي پروګرام د وتلو کوډ ۱ سره پای ته رسوي.
#
# لکه هر پروګرام یې وچلوئ: ټولې ازموینې چلېږي. پر امر کرښه ازموینې نوم کړئ
# (thundervm 37_testing.thc "د لړۍ تر ټولو لوی") او یوازې هغه چلېږي - د VS Code د ازموینو لړ
# یوه ازموینه همداسې چلوي. docs/ps/testing.md ټول ماډیول لري.

راوړه "testing"

# هغه کوډ چې ازمویل کېږي.
دنده تر_ټولو_لوی(ارزښتونه: عدد[]): عدد
    متغیر غوره = ارزښتونه[۰]
    لپاره ارزښت په ارزښتونه
        که ارزښت > غوره
            غوره = ارزښت
    راګرځه غوره

دنده پالیندروم_دی(کلمه: متن): منطقي
    متغیر اړول_شوې = ""
    لپاره متغیر ش = اوږدوالی(کلمه) - ۱، ش >= ۰، ش = ش - ۱
        اړول_شوې = اړول_شوې + کلمه[ش]
    راګرځه اړول_شوې == کلمه

# ازموینې. هره یوه ساده دنده ده، بې پارامترونو.
دنده د_لړۍ_تر_ټولو_لوی()
    برابر_تمه(تر_ټولو_لوی([۳، ۹، ۲])، ۹)
    برابر_تمه(تر_ټولو_لوی([-۵])، -۵)

دنده پالیندرومونه()
    رښتیا_تمه(پالیندروم_دی("level"))
    درواغ_تمه(پالیندروم_دی("تندر"))

دنده لړۍ_د_توکو_له_مخې_پرتله_کېږي()
    متغیر مربعونه: عدد[] = []
    لپاره ن په [۱، ۲، ۳]
        ورزیات کړه(مربعونه، ن * ن)
    برابر_تمه(مربعونه، [۱، ۴، ۹])
    نابرابر_تمه(مربعونه، [۱، ۲، ۳])

دنده اعشاري_په_زغم_پرتله_کېږي()
    نږدې_تمه(۱.۰ / ۳.۰، ۰.۳۳۳۳، ۰.۰۰۱)
    تمه(اوږدوالی("الف") == ۳، "ستاسې خپل پیغام")

ازموینه("د لړۍ تر ټولو لوی"، د_لړۍ_تر_ټولو_لوی)
ازموینه("پالیندرومونه"، پالیندرومونه)
ازموینه("لړۍ د توکو له مخې پرتله کېږي"، لړۍ_د_توکو_له_مخې_پرتله_کېږي)
ازموینه("اعشاري په زغم پرتله کېږي"، اعشاري_په_زغم_پرتله_کېږي)
ازموینې_پای_کړه()
