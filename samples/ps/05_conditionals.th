// ژبه: ps
// ۰۵ - شرطونه: که / کنه
//
// شرط باید منطقي (رښتیا یا دروغ) وي. د پرتلې عملګر (== != < <= > >=)
// منطقي ارزښت جوړوي، او && || ! یې سره یوځای کوي.
//
// هڅه وکړئ: د «بایټ کوډ» پاڼه پرانیزئ او JUMP_IF_FALSE لارښوونې ومومئ.

دنده درجه(نمره: عدد): متن
    که نمره >= ۹۰
        راګرځه "الف"
    کنه که نمره >= ۷۵
        راګرځه "ب"
    کنه که نمره >= ۵۰
        راګرځه "ج"
    کنه
        راګرځه "ناکام"

کرښه چاپ("۹۵ ← ", درجه(۹۵))
کرښه چاپ("۸۰ ← ", درجه(۸۰))
کرښه چاپ("۵۰ ← ", درجه(۵۰))
کرښه چاپ("۱۲ ← ", درجه(۱۲))

متغیر کال = ۲۰۲۴
متغیر کبیسه = (کال % ۴ == ۰ && کال % ۱۰۰ != ۰) || کال % ۴۰۰ == ۰
که کبیسه
    کرښه چاپ(کال, " کبیسه کال دی")
کنه
    کرښه چاپ(کال, " کبیسه کال نه دی")
