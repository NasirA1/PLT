# ژبه: ps
# پرمختللی ۰۳ - څو کاره په یوه وخت کې
#
# کار د پروګرام هغه برخه ده چې د نورو تر څنګ ځي. د «کار» جوړول یې پیلول دي؛
# راته_ودرېږه() د پای انتظار باسي. کارونه پر یوه مزي وار په وار ځي - مجازي ماشین
# روان کار هرو سلو لارښوونو وروسته یو خوا کوي - نو له یوه کاره چټک نه دي، خو دا
# پرېږدي چې دوه داسې برخې چې هره یوه *انتظار* باسي، لکه دوه ساده کرښې ولیکل شي.
#
# څه چې شریکوي رښتیا شریک دي: لاندې عام «یادښت»، او هغه متغیرونه چې د دوی تړلې دندې یې نیسي.
راوړه "concurrency"

متغیر یادښت: متن[] = []

# هر کار خپله د بلنو ډېرۍ لري، نو یوه دنده په یوه وخت کې درې ځله روانه کېدای شي.
دنده تر_پورې(نوم: متن، تر: عدد)
    تکرار ا په واټن(۱، تر + ۱)
        ورزیات کړه(یادښت، نوم + " " + متن کړه(ا))

# هغه دنده چې تړلې دنده جوړوي، کار ته خپل څه ورکوي: پارامټر «ن» د همدې بلنې دی، نو
# هر چار خپله شمېره یادوي.
دنده چار(ن: عدد): دنده()
    متغیر چلول = دنده() ورزیات کړه(یادښت، کارونه.نوم(کارونه.اوسنی()) + " چار " + متن کړه(ن) + " وکړ")
    راګرځه چلول

کرښه چاپ("۱. دوه کاره، پیل شوي او انتظار یې وشو:")
متغیر یو = کار(دنده() تر_پورې("یو"، ۳))
متغیر دوه = کار(دنده() تر_پورې("دوه"، ۳))
یو.راته_ودرېږه()
دوه.راته_ودرېږه()
کرښه چاپ("  "، متن.یو ځای کړه(یادښت، "، "))

کرښه چاپ("۲. درې کاره، هر یو یې خپل کار لري:")
یادښت = []
متغیر کارګران: کار[] = []
تکرار ن په واټن(۱، ۴)
    ورزیات کړه(کارګران، کار(چار(ن)))
تکرار ک په کارګران
    ک.راته_ودرېږه()
کرښه چاپ("  "، متن.یو ځای کړه(یادښت، "؛ "))

کرښه چاپ("۳. لار ورکړه نورو ته وار ورکوي، پرته له دې چې د څه انتظار وباسي:")
یادښت = []
متغیر لومړی = دنده()
    ورزیات کړه(یادښت، "الف۱")
    کارونه.لار ورکړه()
    ورزیات کړه(یادښت، "الف۲")
متغیر دوهم = دنده()
    ورزیات کړه(یادښت، "ب۱")
    کارونه.لار ورکړه()
    ورزیات کړه(یادښت، "ب۲")
متغیر ادبناک = کار(لومړی)
متغیر بل = کار(دوهم)
ادبناک.راته_ودرېږه()
بل.راته_ودرېږه()
کرښه چاپ("  "، متن.یو ځای کړه(یادښت، " "))

کرښه چاپ("۴. هغه کار چې پروګرام پکې پیلېږي نوم یې دی "، کارونه.نوم(کارونه.اوسنی()))
کرښه چاپ("  لا روان کارونه (دا یو هم پکې): "، کارونه.شمېر())
کرښه چاپ("  آیا لومړی پای ته رسېدلی؟ "، یو.پای_ته_رسېدلی())
