// ژبه: ps
// e4 - د اجرا تېروتنه
//
// دا پروګرام جوړېږي: د هغه ډولونه سم دي. ستونزه یوازې د اجرا پر مهال
// ښکاره کېږي، کله چې VM په صفر وېش ته اړ کېږي.

دنده منځنی(ارزښتونه: عدد[]): عدد
{
    متغیر ټول = ۰
    لپاره (متغیر i = ۰؛ i < اوږدوالی(ارزښتونه)؛ i = i + ۱)
    {
        ټول = ټول + ارزښتونه[i]
    }
    راګرځه ټول / اوږدوالی(ارزښتونه)
}

چاپ_کرښه(«د [۴، ۸، ۶] منځنی = »، منځنی([۴، ۸، ۶]))
متغیر تش: عدد[] = []
چاپ_کرښه(«د [] منځنی = »، منځنی(تش))
