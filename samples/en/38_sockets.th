# 38 - Talking over the network (sockets)
#
# Programs on different computers talk through sockets: one side listens on a
# port, the other connects, and then text flows both ways. Thunder gets sockets
# from the native module thunder_sockets (C++ in lib/native/sockets/) through
# the Thunder file sockets.th (lib/thunder), which declares four modules: tcp,
# udp, socket and host - read that file for the whole API, and docs/sockets.md
# (Help > Sockets reference) for the story.
#
# This program is both the server and the client, so it runs anywhere with no
# second computer: everything goes through 127.0.0.1, the address that always
# means "this machine". To try it for real, split it in two: put the listening
# half on one computer and the connecting half on another, with its address.
#
# A socket is a resource: "with" closes it at the end of its block, however the
# block ends, so no socket is ever left open by accident.
#
# If Run reports "cannot load the native library" (R028), build the toolchain
# again (./run_tests.sh or ./run.sh on Linux, .\run.ps1 on Windows): that builds
# thunder_sockets next to thundervm.

import "sockets"

# A protocol is just an agreement about the lines. Here: the client asks, the server answers.
func answer(question: string): string
    if question == "time?"
        return "no idea, I am a sample"
    return "pardon?"

# --- the server: listen on this computer, on a port the system picks (0) ---------
with server = tcp.listen("127.0.0.1", 0)
    if server == nothing
        println("cannot listen: ", socket.error())
    var port = socket.port(server)
    println("the server is listening; the system gave it a port: ", port > 0)

    # --- the client: connect to it, then the server accepts the connection --------
    with client = tcp.connect("127.0.0.1", port)
        with connection = tcp.accept(server)
            println("connected: ", client != nothing and connection != nothing)
            println("the server sees the client at this address: ",
                    string.starts_with(socket.peer(connection), "127.0.0.1:"))

            # Text goes over the wire line by line.
            socket.send_line(client, "hello from the client")
            println("server received: ", socket.receive_line(connection))
            socket.send_line(connection, "hello from the server")
            println("client received: ", socket.receive_line(client))

            socket.send_line(client, "time?")
            socket.send_line(connection, answer(socket.receive_line(connection)))
            println("the client asked for the time and got: ", socket.receive_line(client))

            # Closing one end: the other end reads "" and sees that the connection is gone.
            socket.close(client)
            println("after the client closed, the server reads \"", socket.receive_line(connection),
                    "\"; still open? ", socket.is_open(connection))
    # Here the connection, then the client (closed already: closing twice does no harm) were
    # closed by "with", innermost first; the server is closed at the end of its own block.

# --- UDP: single messages without a connection ------------------------------------
with receiver = udp.open(0)
    with sender = udp.open(0)
        udp.send(sender, "127.0.0.1", socket.port(receiver), "a datagram")
        println("over UDP the receiver got: ", udp.receive(receiver, 100))

# Network trouble is a value, not a crash: connecting to a port nobody listens on
# gives nothing, and socket.error() says why. A *mistake* - using a socket after it
# was closed, say - stops the program, as a wrong built-in call would.
var nobody = tcp.connect("127.0.0.1", 1)
println("connecting where nobody listens gives nothing: ", nobody == nothing, " (", socket.error() != "", ")")
