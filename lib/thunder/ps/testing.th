# ژبه: ps
# testing.th (lib/thunder/ps) - د ازموینو یو کوچنی چوکاټ، پخپله په تندر کې لیکل شوی
# (docs/ps/testing.md)
#
# راوړه "testing" ولیکئ او دوه ټولګي ستاسې دي: ازموینه ازموینې چلوي، تمه وايي چې څه باید
# رښتیا وي. هره ازموینه د یوې بې پارامترونو دندې په توګه ولیکئ، له نوم سره یې ازموینه.وچلوه ته
# ورکړئ، او پروګرام د ازموینه.پای_ته_ورسوه() سره پای ته ورسوئ:
#
#     راوړه "testing"
#
#     دنده جمع_سمه_ده()
#         تمه.برابر(۲ + ۲، ۴)
#
#     ازموینه.وچلوه("جمع سمه ده"، جمع_سمه_ده)
#     ازموینه.پای_ته_ورسوه()
#
# د ازموینو ډلې ټولګي دي. هغه ازموینې چې سره تړاو لري په خپل یوه ټولګي کې کېږدئ، او د ټولګي
# نوم د ډلې نوم کېږي: ازموینې یې د هغه لاندې چاپېږي، د هغه لاندې شمېرل کېږي، او کله چې د ډلې
# نوم پر امر کرښه ورکړئ، یو ځای چلېدای شي.
#
#     ټولګی حساب
#         دنده جمع_سمه_ده()
#             تمه.برابر(۲ + ۲، ۴)
#
#     ازموینه.وچلوه("جمع سمه ده"، حساب.جمع_سمه_ده)    # "حساب" د "  ✓ جمع سمه ده" پورته چاپوي
#
# هره ازموینه یوه کرښه چاپوي - "✓ نوم" کله چې تېره شي، "✗ نوم: څه ناسم شول" د هرې هغې تمې
# لپاره چې پوره نه شوه - او ازموینه.پای_ته_ورسوه() شمېري چې څو تېرې شوې او څو ناکامې، او که
# کومه ناکامه وي پروګرام د وتلو کوډ ۱ سره پای ته رسوي (نو یو سکریپټ، یا د VS Code غځونه،
# پوهېدلی شي). د پروګرام دلیلونه ټاکي چې کومې ازموینې وچلېږي: "thundervm tests.thc جمع" یوازې
# هغه ازموینې (یا ډلې) چلوي چې نوم یې پر امر کرښه راغلی - "ډله/ازموینه" د یوې ډلې یوه ازموینه
# نوموي - د VS Code د ازموینو لړ یوه ازموینه یا یوه ډله همداسې چلوي.
#
# دلته هېڅ بهرنی نشته: دا ساده تندر دی، د لوستلو لپاره لیکل شوی.

راوړه سیسټم

ټولګی ازموینه
    متغیر _تېرې_شوې = ۰
    متغیر _ناکامې = ۰
    متغیر _اوسنۍ_ازموینه = ""        # هغه ازموینه چې بدنه یې چلېږي
    متغیر _اوسنۍ_ناکامه = درواغ        # د اوسنۍ ازموینې کومه تمه ناکامه شوه؟
    متغیر _ډله = ""                    # د وروستۍ چلېدلې ازموینې ډله (ټولګی) ("" که نه وي)
    متغیر _ټاکل_شوې: متن[] = []        # پر امر کرښه نومول شوې ازموینې او ډلې (هېڅ: ټولې وچلوه)
    متغیر _ټاکل_شوې_لوستل_شوې = درواغ
    متغیر _ډلې: متن[] = []                         # ډلې، په هغه ترتیب چې لومړی وچلېدې
    متغیر _د_ډلو_شمېرې: {متن: (عدد، عدد)} = {}    # ډله -> (تېرې شوې، ناکامې)

    # هغه ډله چې ازموینه پکې ده: هغه ټولګی چې دنده یې پکې اعلان شوې ("" د هغې دندې لپاره چې له
    # هر ټولګي بهر اعلان شوې).
    دنده د_ټولګي_نوم(بدنه: دنده()): متن
        متغیر نوم = د دندې نوم(بدنه)
        متغیر ټکی = ځای یې(نوم، ".")
        که ټکی < ۰
            راګرځه ""
        راګرځه ټوټه(نوم، ۰، ټکی)

    # رښتیا که دا ازموینه باید وچلېږي: هره ازموینه کله چې پر امر کرښه هېڅ نوم نه وي ورکړل شوی،
    # کنه یوازې نومول شوې ازموینې، د نومول شوو ډلو ازموینې او "ډله/ازموینه".
    دنده _غوښتل_شوې(ډله: متن، نوم: متن): منطقي
        که نه _ټاکل_شوې_لوستل_شوې
            _ټاکل_شوې = سیسټم.دلیلونه()
            _ټاکل_شوې_لوستل_شوې = رښتیا
        که اوږدوالی(_ټاکل_شوې) == ۰
            راګرځه رښتیا
        راګرځه شامل دی(_ټاکل_شوې، نوم) یا (ډله != "" او (شامل دی(_ټاکل_شوې، ډله) یا شامل دی(_ټاکل_شوې، ډله + "/" + نوم)))

    # یوه ازموینه چلوي: دنده «بدنه»، چې د «نوم» لاندې راپور کېږي. ازموینه تېرېږي کله چې د بدنې
    # هېڅ تمه ناکامه نه شي. کله چې «بدنه» د یوه ټولګي وي، ازموینه د هغې ډلې ده: د ډلې نوم د
    # لومړۍ ازموینې پورته چاپېږي، او ازموینې یې ننوتې چاپېږي.
    دنده وچلوه(نوم: متن، بدنه: دنده())
        متغیر ډله = د_ټولګي_نوم(بدنه)
        که نه _غوښتل_شوې(ډله، نوم)
            راګرځه
        که ډله != _ډله
            _ډله = ډله
            که ډله != ""
                کرښه چاپ(ډله)
                که نه لري(_د_ډلو_شمېرې، ډله)
                    ورزیات کړه(_ډلې، ډله)
                    _د_ډلو_شمېرې[ډله] = (۰، ۰)
        _اوسنۍ_ازموینه = نوم
        _اوسنۍ_ناکامه = درواغ
        بدنه()
        متغیر (تېرې_شوې، ناکامې) = ترلاسه کړه(_د_ډلو_شمېرې، ډله، (۰، ۰))
        که _اوسنۍ_ناکامه
            _ناکامې += ۱
            ناکامې += ۱
        کنه
            _تېرې_شوې += ۱
            تېرې_شوې += ۱
            کرښه چاپ(_پیل_تشه()، "✓ "، نوم)
        که ډله != ""
            _د_ډلو_شمېرې[ډله] = (تېرې_شوې، ناکامې)

    دنده _پیل_تشه(): متن
        که _ډله == ""
            راګرځه ""
        راګرځه "  "

    # اوسنۍ ازموینه د خپل پیغام سره ناکامه کوي. هره ناکامه تمه له همدې ځایه تېرېږي، نو هره یوه
    # خپله کرښه چاپوي، او ازموینه یو ځل ناکامه شمېرل کېږي.
    دنده ناکامه_کړه(پیغام: متن)
        _اوسنۍ_ناکامه = رښتیا
        کرښه چاپ(_پیل_تشه()، "✗ "، _اوسنۍ_ازموینه، ": "، پیغام)

    # لنډیز چاپوي او پروګرام پای ته رسوي: د وتلو کوډ ۱ کله چې کومه ازموینه ناکامه وي. وروستۍ یې
    # وبولئ. کله چې ډلې وي، د هرې ډلې شمېرې لومړی راځي.
    دنده پای_ته_ورسوه()
        که اوږدوالی(_ډلې) > ۱
            تکرار ډله په _ډلې
                متغیر (تېرې_شوې، ناکامې) = _د_ډلو_شمېرې[ډله]
                کرښه چاپ(ډله، ": "، تېرې_شوې، " تېرې شوې، "، ناکامې، " ناکامې")
        کرښه چاپ(_تېرې_شوې، " تېرې شوې، "، _ناکامې، " ناکامې")
        که _ناکامې > ۰
            سیسټم.پای ته ورسوه(۱)

# تمې. هره یوه اوسنۍ ازموینه، له پیغام سره، ناکامه کوي کله چې شرط یې پوره نه وي؛ کنه چوپه ده.
ټولګی تمه
    # ستاسې خپل شرط، له هغه پیغام سره چې که درواغ وي چاپ شي.
    دنده دا_وي(شرط: منطقي، پیغام: متن)
        که نه شرط
            ازموینه.ناکامه_کړه(پیغام)

    # اوسنۍ ازموینه ناکامه کوي که شرط رښتیا نه وي.
    دنده رښتیا_وي(شرط: منطقي)
        دا_وي(شرط، "تمه رښتیا وه، درواغ ترلاسه شو")

    # اوسنۍ ازموینه ناکامه کوي که شرط درواغ نه وي.
    دنده درواغ_وي(شرط: منطقي)
        دا_وي(نه شرط، "تمه درواغ وه، رښتیا ترلاسه شو")

    # برابر دي کله چې دواړه ارزښتونه یو شان چاپ شي - نو لړۍ، ټاپلونه، نقشې او جوړښتونه د خپلو
    # توکو له مخې پرتله کېږي، او پیغام دواړه هغسې ښيي لکه چې چاپ کېږي.
    دنده برابر<ت>(ترلاسه: ت، تمه_شوی: ت)
        که متن کړه(ترلاسه) != متن کړه(تمه_شوی)
            ازموینه.ناکامه_کړه(متن.بڼه کړه("تمه {} وه، {} ترلاسه شو"، تمه_شوی، ترلاسه))

    # اوسنۍ ازموینه ناکامه کوي که دواړه ارزښتونه یو شان چاپېږي.
    دنده نابرابر<ت>(ترلاسه: ت، ناغوښتل: ت)
        که متن کړه(ترلاسه) == متن کړه(ناغوښتل)
            ازموینه.ناکامه_کړه(متن.بڼه کړه("تمه له {} پرته بل څه وو"، ناغوښتل))

    # د اعشاري شمېرو لپاره، چې لږ کله بشپړ برابرې وي: تېرېږي کله چې دواړه په «زغم» کې وي.
    دنده نږدې(ترلاسه: اعشاري، تمه_شوی: اعشاري، زغم: اعشاري)
        که ریاضي.مطلق(ترلاسه - تمه_شوی) > زغم
            ازموینه.ناکامه_کړه(متن.بڼه کړه("تمه {} وه (په {} کې)، {} ترلاسه شو"، تمه_شوی، زغم، ترلاسه))
