# The tests of lib/greeting.th.
#
# A test file holds tests only: each function marked @test is one, and running the file runs
# them all and prints the summary (exit status 1 if anything failed). In VS Code the Testing
# view lists them, and "Thunder: Run All Tests" runs every test file of the project.

import "../lib/greeting"

@test("hello greets by name")
func hello_greets_by_name()
    expect.equal(greeting.hello("world"), "Hello, world!")
    expect.equal(greeting.hello("Thunder"), "Hello, Thunder!")

@test
func hello_always_says_something()
    expect.is_true(string.len(greeting.hello("a")) > 0)
