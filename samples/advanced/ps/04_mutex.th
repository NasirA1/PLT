# ژبه: ps
# پرمختللی ۰۴ - ورک شوی بدلون، او هغه قلف چې یې دروي
#
# دوه کاره چې یوه شمېرګر ته ورزیاتوي، د همکارې پروګرام‌لیکنې تر ټولو زوړ بګ دی.
# «ټولټال += ۱» یو ګام نه دی: ماشین شمېره لولي، یو ورزیاتوي، او بېرته یې ساتي. که
# بل کار د لوستلو او ساتلو ترمنځ خپله وارۍ ترلاسه کړي، هغه هم زړه شمېره لولي، او له
# دوو ورزیاتونو یو ورکېږي.
#
# په تندر کې دا د بخت خبره نه ده: کارونه په هر ځل کې په یوه ډول وار اخلي، نو بګ هر
# ځل ځان ښيي، او ډیبګر یې ګام په ګام تېرولای شي. (thundervm --schedule-seed n وارۍ
# بدلوي، په تکرارېدونکې توګه، چې هغه ننګونې ومومي چې ثابته وارۍ یې پټوي.)
راوړه "concurrency"

ثابت چکرونه = ۵۰۰

متغیر ټولټال = ۰

دنده بې_قلفه_ورزیاته()
    متغیر پاتې = چکرونه
    ترڅو پاتې > ۰
        ټولټال += ۱
        پاتې -= ۱

متغیر ساتونکې = قلف()

دنده په_قلف_ورزیاته()
    متغیر پاتې = چکرونه
    ترڅو پاتې > ۰
        ساتونکې.قلف_کړه() سره
            ټولټال += ۱
        پاتې -= ۱

کرښه چاپ("۱. دوه کاره، بې قلفه:")
متغیر الف = کار(بې_قلفه_ورزیاته)
متغیر ب = کار(بې_قلفه_ورزیاته)
الف.راته_ودرېږه()
ب.راته_ودرېږه()
کرښه چاپ("  وشمېرل شول "، ټولټال، " له "، ۲ * چکرونه، "؛ بدلونونه ورک شول: "، ټولټال < ۲ * چکرونه)

کرښه چاپ("۲. همدا دوه کاره، د حساسې برخې پر شا قلف سره:")
ټولټال = ۰
متغیر ج = کار(په_قلف_ورزیاته)
متغیر د = کار(په_قلف_ورزیاته)
ج.راته_ودرېږه()
د.راته_ودرېږه()
کرښه چاپ("  وشمېرل شول "، ټولټال، " له "، ۲ * چکرونه، "؛ بدلونونه ورک شول: "، ټولټال < ۲ * چکرونه)

# «سره» قلف د بلاک په پای کې بېرته ورکوي، په هر ډول چې بلاک پای ته ورسېږي - نو د
# حساسې برخې په منځ کې راګرځه یا ودرېږه نور قلف نیولی نه پرېږدي.
دنده لومړی_تر_پورته(عددونه: عدد[]، بریده: عدد): عدد
    تکرار ع په عددونه
        ساتونکې.قلف_کړه() سره
            که ع > بریده
                راګرځه ع
    راګرځه -۱

کرښه چاپ("۳. له حساسې برخې راګرځه بیا هم خلاصوي: "، لومړی_تر_پورته([۱، ۵، ۹]، ۴))
کرښه چاپ("  قلف بیا خلاص دی: "، ساتونکې.هڅه_وکړه())
ساتونکې.خلاص_کړه()

# هڅه_وکړه() هېڅکله انتظار نه باسي: وايي چې قلف یې ترلاسه کړ که نه.
متغیر نیول_شوی = قلف()
متغیر بوخت = نیول_شوی.قلف_کړه()
کرښه چاپ("۴. هڅه_وکړه پر هغه قلف چې څوک یې لري: "، نیول_شوی.هڅه_وکړه())
بوخت.وتړه()
کرښه چاپ("  او کله چې بېرته ورکړل شو: "، نیول_شوی.هڅه_وکړه())
