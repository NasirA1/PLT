# 28 - Testing: checking a program with the testing module
#
# import "testing" and write each test as a function: inside it, expect_equal and friends say
# what should be true. test() runs the function under a name and prints "✓ name" when every
# expectation held, or "✗ name: what went wrong" for each one that did not. finish_tests()
# prints the totals and ends the program with exit status 1 if any test failed.
#
# Run it as any program: all the tests run. Name tests on the command line
# (thundervm 28_testing.thc "largest of a list") and only those run - which is how the
# VS Code Test Explorer runs a single test. docs/testing.md has the whole module.

import "testing"

# The code under test.
func largest(values: int[]): int
    var best = values[0]
    for value in values
        if value > best
            best = value
    return best

func is_palindrome(word: string): bool
    var reversed = ""
    for var i = len(word) - 1, i >= 0, i = i - 1
        reversed = reversed + word[i]
    return reversed == word

# The tests. Each is a plain function with no parameters.
func largest_of_a_list()
    expect_equal(largest([3, 9, 2]), 9)
    expect_equal(largest([-5]), -5)

func palindromes()
    expect_true(is_palindrome("level"))
    expect_false(is_palindrome("thunder"))

func arrays_compare_by_contents()
    var squares: int[] = []
    for n in [1, 2, 3]
        push(squares, n * n)
    expect_equal(squares, [1, 4, 9])
    expect_not_equal(squares, [1, 2, 3])

func decimals_are_compared_with_a_tolerance()
    expect_near(1.0 / 3.0, 0.3333, 0.001)
    expect(len("abc") == 3, "a message of your own")

test("largest of a list", largest_of_a_list)
test("palindromes", palindromes)
test("arrays compare by contents", arrays_compare_by_contents)
test("decimals are compared with a tolerance", decimals_are_compared_with_a_tolerance)
finish_tests()
