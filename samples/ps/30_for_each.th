// ژبه: ps
// ۳۰ - «لپاره ... په» تکرار او لنډ ورکول
//
// «لپاره ارزښت په ټولګه» د لړۍ توکي، د متن توري یا د نقشې کیلۍ یو په یو
// ګرځوي. له لړ شمېرې سره له شمېرلو لنډ او خوندي دی، ځکه چې هېڅ لړ شمېره
// نشته چې تېروتنه پکې وشي.
//
// «ش += ۱» د «ش = ش + ۱» مانا لري. همدا ډول -= *= /= %= هم کار کوي، او د
// لړۍ په توکو او د جوړښت په برخو هم. موخه یوازې یو ځل ارزول کېږي.
//
// هڅه وکړئ: د «بایټ کوډ» پاڼه پرانیزئ او دا تکرار له ۰۷ سره پرتله کړئ.

متغیر نمرې = [۷۱، ۸۴، ۶۶، ۹۰]
متغیر ټولټال = ۰
لپاره نمره په نمرې
    ټولټال += نمره
کرښه چاپ("ټولټال "، ټولټال، "، منځنۍ "، اعشاري کړه(ټولټال) / اوږدوالی(نمرې))

// د متن توري:
متغیر واولونه = ۰
لپاره توری په "programming language technology"
    که شامل دی("aeiou"، توری)
        واولونه += ۱
کرښه چاپ("واولونه: "، واولونه)

// د نقشې کیلۍ (که ارزښتونه هم غواړئ، توکي(نقشه) وکاروئ):
متغیر پلورنځی = {"قلمونه": ۱۲، "کتابونه": ۳}
لپاره توکی په پلورنځی
    کرښه چاپ(توکی، ": "، پلورنځی[توکی])

// څو نومونه یو ټاپل وېشي، چې شمېره ورکړه() او توکي() همدا راګرځوي:
لپاره (ځای، نمره) په شمېره ورکړه(نمرې)
    چاپ(ځای، "->"، نمره، " ")
کرښه چاپ()
لپاره (نوم، شمېر) په توکي(پلورنځی)
    کرښه چاپ(نوم، " "، شمېر، " وو")
    پلورنځی[نوم] += ۱
کرښه چاپ(پلورنځی)

// ودرېږه او دوام لکه په هر بل تکرار کې کار کوي.
لپاره نمره په نمرې
    که نمره < ۷۰
        دوام
    که نمره > ۸۵
        ودرېږه
    کرښه چاپ("ښه نمره چې تر ټولو لوړه نه ده: "، نمره)

// کله چې ګام یو نه وي، لا هم زوړ ډول په کار دی:
لپاره متغیر ش = ۱۰، ش > ۰، ش = ش - ۳
    چاپ(ش، " ")
کرښه چاپ()
