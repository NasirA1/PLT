// ژبه: ps
// ۲۴ - انځور کښل (ګرافیک ماډیول)
//
// «راوړه ګرافیک» پروګرام ته د انځور کښلو لپاره یو ټاټ ورکوي. ځایونه په
// پکسلونو دي: س ښي لور ته لویېږي، ص ښکته لور ته لویېږي، او (۰، ۰) پورته
// کیڼ کونج دی. رنګ یو نوم ("سور"، "اسماني")، یو کوډ ("#ff8800") یا رنګ(...)
// دی. شکلونه په ترتیب کښل کېږي، نو وروستي شکلونه مخکیني پټوي.
//
// هڅه وکړئ: «چلول» کښېکښئ - انځور د ټاټ په پاڼه کې ښکاري. بیا لمر بل ځای
// ته یوسئ، رنګونه بدل کړئ، یا کور ته دوهمه کړکۍ ورکړئ.

راوړه ګرافیک

ټاټ(۴۰۰، ۳۰۰)

// آسمان د افق خوا ته روښانه کېږي: ۲۲ پټې، هره یو څه بل ډول آبي.
لپاره متغیر پټه = ۰، پټه < ۲۲، پټه = پټه + ۱
    مستطیل(۰، پټه * ۱۰، ۴۰۰، ۱۰، رنګ(۴۰ + پټه * ۶، ۱۱۰ + پټه * ۵، ۲۳۰))

// لمر او وړانګې یې (د س او ص د توپیرونو جوړې: زاویو ته اړتیا نشته).
متغیر وړانګې = [(۰، -۵۰)، (۳۵، -۳۵)، (۵۰، ۰)، (۳۵، ۳۵)، (۰، ۵۰)، (-۳۵، ۳۵)، (-۵۰، ۰)، (-۳۵، -۳۵)]
د لیکې پلنوالی(۳)
لپاره متغیر ش = ۰، ش < اوږدوالی(وړانګې)، ش = ش + ۱
    متغیر (توپیر_س، توپیر_ص) = وړانګې[ش]
    لیکه(۳۳۰، ۶۰، ۳۳۰ + توپیر_س، ۶۰ + توپیر_ص، "نارنجي")
دایره(۳۳۰، ۶۰، ۲۸، "طلايي")

// ځمکه
مستطیل(۰، ۲۲۰، ۴۰۰، ۸۰، رنګ(۶۰، ۱۶۰، ۶۰))

// کور: دېوالونه، له لنډېدونکو لیکو جوړ چت، دروازه او کړکۍ.
مستطیل(۶۰، ۱۵۰، ۱۲۰، ۸۰، "سپین")
د لیکې پلنوالی(۱)
لپاره متغیر قطار = ۰، قطار < ۵۰، قطار = قطار + ۱
    لیکه(۵۰ + قطار، ۱۵۰ - قطار، ۱۹۰ - قطار، ۱۵۰ - قطار، رنګ(۱۲۸، ۰، ۰))
مستطیل(۱۰۵، ۱۸۵، ۳۰، ۴۵، "نسواري")
مستطیل(۱۴۰، ۱۶۵، ۲۸، ۲۴، "اسماني")
د مستطیل څنډه(۱۴۰، ۱۶۵، ۲۸، ۲۴، "تور")
لیکه(۱۵۴، ۱۶۵، ۱۵۴، ۱۸۹، "تور")

// ونه
مستطیل(۲۶۲، ۱۶۵، ۱۶، ۶۰، "نسواري")
دایره(۲۷۰، ۱۵۰، ۳۰، "زرغون")
دایره(۲۵۵، ۱۶۵، ۲۰، "زرغون")
دایره(۲۸۷، ۱۶۳، ۲۲، "زرغون")

د لیکنې اندازه(۲۰)
لیکنه(۱۲، ۱۲، "د تندر ګرافیک"، "سپین")
د لیکنې اندازه(۱۴)
لیکنه(۱۲، ۲۷۰، "(۰، ۰) پورته کیڼ کونج دی"، "سپین")
