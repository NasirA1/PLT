# e4 - A runtime error
#
# This program compiles: nothing is wrong with its types. The problem only
# appears while it runs, when the VM is asked to divide by zero. The error
# message shows the line, and the call stack shows how execution got there.

func average(values: int[]): int
    var sum = 0
    for var i = 0, i < len(values), i = i + 1
        sum = sum + values[i]
    return sum / len(values)

println("average of [4, 8, 6] = ", average([4, 8, 6]))
var empty: int[] = []
println("average of [] = ", average(empty))
println("this line is never reached")
