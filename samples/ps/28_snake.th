// ژبه: ps
// ۲۸ - مار (یوه لوبه)
//
// مار د غشو په تڼیو چلوئ او سرې مڼې وخورئ. هره مڼه مار اوږدوي؛ له دېوال
// یا خپل ځان سره ټکر لوبه پای ته رسوي.
//
// مار د (ستون، قطار) جوړو لړۍ ده، لومړی یې سر دی. د خوځېدو لپاره پروګرام
// د تګ په لوري نوی سر ورزیاتوي او لکۍ لرې کوي - مګر دا چې مار همدا اوس
// خوړلي وي، چې دا یې د غټېدو لاره ده.
//
// هڅه وکړئ: «چلول» کښېکښئ، پر ټاټ کلیک وکړئ چې تڼۍ ترلاسه کړي، او لوبه
// وکړئ. تشه نوې لوبه پیلوي. د چوکاټ چټکتیا د لوبې چټکتیا ټاکي.

راوړه ګرافیک

ثابت خونه = ۲۰
ثابت ستونونه = ۲۰
ثابت قطارونه = ۱۵
ټاټ(ستونونه * خونه، قطارونه * خونه)
د چوکاټ چټکتیا(۸)

متغیر مار: (عدد، عدد)[] = []
متغیر لوری = (۱، ۰)
متغیر مڼه = (۰، ۰)
متغیر نمره = ۰
متغیر غوره = ۰
متغیر لوبه_روانه = درواغ

دنده مڼه_کېږده()
    مڼه = (تصادفي عدد(۰، ستونونه - ۱)، تصادفي عدد(۰، قطارونه - ۱))
    ترڅو شامل دی(مار، مڼه)
        مڼه = (تصادفي عدد(۰، ستونونه - ۱)، تصادفي عدد(۰، قطارونه - ۱))

دنده نوې_لوبه()
    مار = [(۶، ۷)، (۵، ۷)، (۴، ۷)]
    لوری = (۱، ۰)
    نمره = ۰
    لوبه_روانه = رښتیا
    مڼه_کېږده()

// مار کیڼ یا ښي ته ګرځېدای شي، خو نېغ په خپل ځان کې بېرته نه.
دنده چلول(تڼۍ: متن)
    متغیر (ګام_س، ګام_ص) = لوری
    که تڼۍ == "کیڼ" او ګام_س == ۰
        لوری = (-۱، ۰)
    کنه که تڼۍ == "ښي" او ګام_س == ۰
        لوری = (۱، ۰)
    کنه که تڼۍ == "پورته" او ګام_ص == ۰
        لوری = (۰، -۱)
    کنه که تڼۍ == "ښکته" او ګام_ص == ۰
        لوری = (۰، ۱)

دنده خوځېدل()
    متغیر سر = (لومړی(مار[۰]) + لومړی(لوری)، دوهم(مار[۰]) + دوهم(لوری))
    متغیر (س، ص) = سر
    که س < ۰ یا س >= ستونونه یا ص < ۰ یا ص >= قطارونه یا شامل دی(مار، سر)
        لوبه_روانه = درواغ
        که نمره > غوره
            غوره = نمره
        راګرځه
    ننباسه(مار، ۰، سر)
    که سر == مڼه
        نمره = نمره + ۱
        مڼه_کېږده()
    کنه
        وروستی واخله(مار)        // مڼه نشته: لکۍ هم مخکې ځي

دنده کښل()
    ټاټ پاک کړه(رنګ(۲۰، ۳۰، ۲۰))
    دایره(لومړی(مڼه) * خونه + خونه / ۲، دوهم(مڼه) * خونه + خونه / ۲، خونه / ۲ - ۲، "سور")
    لپاره متغیر ش = ۰، ش < اوږدوالی(مار)، ش = ش + ۱
        متغیر (س، ص) = مار[ش]
        متغیر رنګ_یې = "زرغون"
        که ش == ۰
            رنګ_یې = رنګ(۰، ۲۵۵، ۰)
        مستطیل(س * خونه + ۱، ص * خونه + ۱، خونه - ۲، خونه - ۲، رنګ_یې)
    لیکنه(۶، ۴، "نمره " + متن کړه(نمره) + "   غوره " + متن کړه(غوره)، "سپین")
    که نه لوبه_روانه
        مستطیل(۷۰، ۹۵، ۲۶۰، ۸۵، "تور")
        د مستطیل څنډه(۷۰، ۹۵، ۲۶۰، ۸۵، "ژېړ")
        د لیکنې اندازه(۲۴)
        لیکنه(۹۵، ۱۰۵، "لوبه پای ته ورسېده"، "ژېړ")
        د لیکنې اندازه(۱۶)
        لیکنه(۹۰، ۱۴۵، "د بیا لوبې لپاره تشه کښېکښئ"، "سپین")

نوې_لوبه()
ترڅو رښتیا
    متغیر تڼۍ = کښېکښل شوې تڼۍ()     // په هر ګام کې یوه تڼۍ، نو دوه چټک ګرځېدل ورک نه شي
    که لوبه_روانه
        چلول(تڼۍ)
        خوځېدل()
    کنه که تڼۍ == "تشه"
        نوې_لوبه()
    کښل()
    چوکاټ()
