# ژبه: ps
# lib/geometry.th - یو ماډیول، چې ۱۹_modules.th یې راوړي
#
# ماډیول د اعلانونو فایل دی - دندې، جوړښتونه، متغیرونه او ثابتونه - چې نور
# پروګرامونه یې له دې وروسته کاروي:  راوړه "lib/geometry"
# ماډیول خپل امرونه نه لري، نو راوړل یې هېڅ نه چاپوي. ماډیول کولای شي نور
# ماډیولونه راوړي؛ هر فایل یوازې یو ځل لوستل کېږي.

راوړه "numbers"

جوړښت مستطیل
    پلنوالی: عدد
    لوړوالی: عدد

دنده مساحت(م: مستطیل): عدد
    راګرځه م.پلنوالی * م.لوړوالی

دنده چاپېریال(م: مستطیل): عدد
    راګرځه ۲ * (م.پلنوالی + م.لوړوالی)

دنده مربع_دی(م: مستطیل): منطقي
    راګرځه م.پلنوالی == م.لوړوالی

# د دایرې مساحت، بشپړ عدد ته ګرد شوی (تندر کسرونه نه لري).
دنده د_دایرې_مساحت(وړانګه: عدد): عدد
    راګرځه ګرد_وېش(پای_سل_ځله * وړانګه * وړانګه، ۱۰۰)
