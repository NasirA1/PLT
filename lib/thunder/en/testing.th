# testing.th (lib/thunder/en) - the test framework, written in Thunder itself (docs/testing.md)
#
# Tests live in test files of their own. Mark each test with @test - a function, or a whole
# struct or module (a suite) - and run the file; the compiler finds the tests, imports this
# file and runs them, one after another, then prints the summary:
#
#     import "lib/stack"                   # the code under test
#
#     @test
#     func adds_up()                       # shown as "adds up"
#         expect.equal(2 + 2, 4)
#
#     @test("a new stack")
#     struct NewStack                      # a suite: every public method without parameters
#         _stack: Stack<int>               # is a test, run on a new NewStack each time
#
#         NewStack()                       # the constructor prepares each test ...
#             _stack = Stack()
#
#         func is_empty()
#             expect.is_true(_stack.is_empty())
#
#         func close()                     # ... and close(), when there is one, tidies up
#             pass
#
# A module can be a suite too (@test on the module: its public functions without parameters are
# the tests), and @test on a single method or function marks just that one, with an optional
# description: @test("pushes one item").
#
# A test file holds tests only - no statements of its own and no main() - and a program file may
# not use this module: test code stays out of production code.
#
# Every test prints one line - "✓ name" when it passed, "✗ name: what went wrong" for each
# expectation that failed - under its suite's name, and the summary ends the program with exit
# status 1 when any test failed (so a script, or the VS Code extension, can tell). Program
# arguments choose which tests run: "thundervm tests.thc adds" runs only the tests (or the
# suites) named on the command line - "suite/test" names one test of one suite - which is how
# VS Code's Test Explorer runs a single test or a single suite.
#
# Mocks. "@mock struct FakeClock: Clock" makes a stand-in for the interfaces the struct lists:
# every method of theirs records its calls, then answers with the struct's own method of that
# name, or, without one, does nothing and returns a default value (0, "", false, nothing, []).
# The struct has the Mock mixin's methods to ask what happened:
#
#     interface Clock
#         func hour(): int
#
#     @mock
#     struct FakeClock: Clock
#         time: int                        # what the test wants the clock to say
#         func hour(): int
#             return time
#
#     @test
#     func says_good_morning()
#         var clock = FakeClock(time: 9)
#         expect.equal(greeting(clock), "Good morning")
#         clock.expect_called("hour", 1)
#
# Nothing here is native: this is ordinary Thunder, written to be read.

import os

module test
    # What happened to one test: where it belongs, what it is called and what went wrong.
    struct Result
        suite: string
        name: string
        failures: string[]

        # True if no expectation of the test failed.
        func passed(): bool
            return len(failures) == 0

    # Runs the tests, keeps their results and prints the transcript. The compiler's calls go to
    # the one runner below, through test.run and test.finish.
    struct Runner
        results: Result[]
        _chosen: string[]      # the tests and suites named on the command line (none: run all)
        _current: Result       # the test whose body is running (nothing between tests)
        _suite: string         # the suite of the test that ran last ("" for none)
        _suites: string[]      # the suites, in the order they first ran

        Runner(chosen: string[])
            _chosen = chosen
            _current = nothing

        # True if this test should run: every test when nothing was named on the command line,
        # otherwise the named tests, the tests of the named suites and "suite/test".
        func wants(suite: string, name: string): bool
            if len(_chosen) == 0
                return true
            return contains(_chosen, name) or (suite != "" and (contains(_chosen, suite) or contains(_chosen, suite + "/" + name)))

        # Runs one test: the function 'body', reported under 'name' in 'suite' ("" for none).
        # It passes when none of the expectations in its body failed.
        func run(suite: string, name: string, body: func())
            if not wants(suite, name)
                return
            if suite != _suite
                _suite = suite
                if suite != ""
                    println(suite)
                    if not contains(_suites, suite)
                        push(_suites, suite)
            _current = Result(suite: suite, name: name, failures: [])
            body()
            push(results, _current)
            if _current.passed()
                println(_indent(), "✓ ", name)
            _current = nothing

        # Fails the current test with a message. Every failed expectation comes through here, so
        # each prints its own line, and the test counts as failed once.
        func fail(message: string)
            if _current == nothing
                println("✗ ", message)    # an expectation outside any test
                return
            push(_current.failures, message)
            println(_indent(), "✗ ", _current.name, ": ", message)

        # How many of the tests of 'suite' passed and failed ("" for every test).
        func counts(suite: string): (int, int)
            var passed = 0
            var failed = 0
            for result in results
                if suite == "" or result.suite == suite
                    if result.passed()
                        passed += 1
                    else
                        failed += 1
            return (passed, failed)

        # Prints the summary - each suite's counts first when there are several - and answers
        # how many tests failed.
        func report(): int
            if len(_suites) > 1
                for suite in _suites
                    var (passed, failed) = counts(suite)
                    println(suite, ": ", passed, " passed, ", failed, " failed")
            var (passed, failed) = counts("")
            println(passed, " passed, ", failed, " failed")
            return failed

        func _indent(): string
            if _suite == ""
                return ""
            return "  "

    var runner = Runner(os.args())

    # Runs one test (the compiler writes one call per test).
    func run(suite: string, name: string, body: func())
        runner.run(suite, name, body)

    # Fails the current test with a message of your own.
    func fail(message: string)
        runner.fail(message)

    # Prints the summary and ends the program: exit status 1 when any test failed (the compiler
    # writes the call, after the last test).
    func finish()
        if runner.report() > 0
            os.exit(1)

    # What every @mock struct includes: the record of the calls made to it, and the questions a
    # test asks about them. A call is recorded with its arguments as text (as str shows them).
    mixin Mock
        _calls: string[]          # the method of each call, in order
        _arguments: string[][]    # the arguments of each call

        # Called by the mock's methods (the compiler writes the call): one call to 'method'.
        func _record(method: string, arguments: string[])
            push(_calls, method)
            push(_arguments, arguments)

        # True if 'method' was called at least once.
        func called(method: string): bool
            return contains(_calls, method)

        # How many times 'method' was called.
        func call_count(method: string): int
            var count = 0
            for name in _calls
                if name == method
                    count += 1
            return count

        # The arguments of every call to 'method', in order, each as text.
        func arguments_of(method: string): string[][]
            var found: string[][] = []
            for (position, name) in enumerate(_calls)
                if name == method
                    push(found, _arguments[position])
            return found

        # Every call, in order, written like a call: hour(), save(key, 3).
        func calls(): string[]
            var written: string[] = []
            for (position, name) in enumerate(_calls)
                push(written, name + "(" + string.join(_arguments[position], ", ") + ")")
            return written

        # Forgets the calls recorded so far.
        func forget_calls()
            _calls = []
            _arguments = []

        # An expectation: fails the current test unless 'method' was called exactly 'times' times.
        func expect_called(method: string, times: int)
            var count = call_count(method)
            if count != times
                fail(string.format("expected {} to be called {} time(s), but it was called {} time(s)", method, times, count))

# The expectations. Each fails the current test, with a message, when its condition does not
# hold; otherwise it is silent.
module expect
    # A condition of your own, with the message to print if it is false.
    func that(condition: bool, message: string)
        if not condition
            test.fail(message)

    # Fails the current test unless the condition is true.
    func is_true(condition: bool)
        that(condition, "expected true, got false")

    # Fails the current test unless the condition is false.
    func is_false(condition: bool)
        that(not condition, "expected false, got true")

    # Equal when the two values print the same - so arrays, tuples, maps and structs compare by
    # their contents, and the message shows both as they print.
    func equal<T>(actual: T, expected: T)
        if str(actual) != str(expected)
            test.fail(string.format("expected {}, got {}", expected, actual))

    # Fails the current test when the two values print the same.
    func not_equal<T>(actual: T, unexpected: T)
        if str(actual) == str(unexpected)
            test.fail(string.format("expected something other than {}", unexpected))

    # For decimals, which rarely compare exactly: passes when the two are within 'tolerance'.
    func near(actual: float, expected: float, tolerance: float)
        if math.abs(actual - expected) > tolerance
            test.fail(string.format("expected {} (within {}), got {}", expected, tolerance, actual))
