# ژبه: ps
# د څو فایلونو یو پروګرام په پښتو - د VS Code د پراخونې د ازمویلو لپاره، په ځانګړي توګه
# د ښي-نه-کیڼ سمونګر لپاره (Thunder: Open in the Right-to-Left Editor).

راوړه "lib/shapes"

ثابت د_خونو_شمېر = ۳

دنده خونې(): څلور_اړخیز[]
    راګرځه [څلور_اړخیز(۴، ۳)، څلور_اړخیز(۲، ۷)، څلور_اړخیز(۵، ۵)]

دنده راپور(ټولې_خونې: څلور_اړخیز[])
    لپاره خونه په ټولې_خونې
        چاپ("  "، بیان(خونه))
        که مربع_دی(خونه)
            چاپ("  (مربع)")
        کرښه چاپ("")

دنده اصلي()
    متغیر ټولې_خونې = خونې()
    کرښه چاپ("پروګرام "، اوږدوالی(ټولې_خونې)، " له "، د_خونو_شمېر، " خونې لري:")
    راپور(ټولې_خونې)
    متغیر ټولټال = ۰
    لپاره خونه په ټولې_خونې
        ټولټال += مساحت(خونه)
    کرښه چاپ("ټول مساحت: "، ټولټال)
