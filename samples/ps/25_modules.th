# ژبه: ps
# ۲۵ - ماډیولونه
#
# ټولګی (ماډیول) د اعلانونو یوه نوم لرونکې ډله ده - دندې، جوړښتونه، ګڼنې، متغیرونه
# او ثابتونه - چې سره تړاو لري:
#     ټولګی ښه_راغلاست
#         دنده سلام(نوم: متن): متن ...
# له ټولګي بهر یې غړي د ټولګي له نوم سره لیکل کېږي، لکه ښه_راغلاست.سلام("ملالۍ")؛
# دننه یې لنډ نومونه بس دي. هغه غړی چې نوم یې په _ پیلېږي پټ دی: یوازې خپل ټولګی
# یې کارولای شي.
#
# یو پروګرام په څو فایلونو هم وېشل کېدای شي. «راوړه» بل فایل لولي او ټولګي یې (او
# هر څه چې نور یې اعلانوي) دلته د کارولو وړ کوي:
#     راوړه "lib/geometry"     د دې فایل تر څنګ lib/geometry.th لولي
#
# د ژبې خپلې دندې هم همداسې منظمې شوې دي: ریاضي.جذر، متن.پاک کړه، تصادفي.عدد،
# بایټونه.له متنه. هغه ټولګي چې له پروګرام بهر رسېږي - سیسټم، فایل او ګرافیک - په
# نوم، پرته له قوسونو، راوړل کېږي، لکه: راوړه سیسټم (۲۷_os.th وګورئ).
#
# هڅه وکړئ: «جوړول» کښېکښئ او د نښانونو پاڼه پرانیزئ - هندسه.مستطیل او هندسه.مساحت
# له lib/geometry.th راځي، شمېرې.ګرد_وېش له lib/numbers.th څخه، چې geometry.th یې راوړي.
# د بایټ کوډ په پاڼه کې د هغوی لارښوونې هغه فایل ښيي چې ترې راغلې دي.

راوړه "lib/geometry"

متغیر کوټه = هندسه.مستطیل(۴، ۳)
کرښه چاپ("مساحت: "، هندسه.مساحت(کوټه)، "، چاپېریال: "، هندسه.چاپېریال(کوټه))
کرښه چاپ("مربع ده؟ "، هندسه.مربع_دی(کوټه)، " او "، هندسه.مربع_دی(هندسه.مستطیل(۲، ۲)))
کرښه چاپ("د ۱۰ وړانګې دایره نیژدې "، هندسه.د_دایرې_مساحت(۱۰)، " مساحت لري")
کرښه چاپ("پای نیژدې "، شمېرې.پای_سل_ځله، " / ۱۰۰ دی")

# د همدې پروګرام خپل یو ټولګی. هغه خپله شمېرنه هم ساتي.
ټولګی ښه_راغلاست
    متغیر ورکړل_شوي = ۰

    دنده سلام(نوم: متن): متن
        ورکړل_شوي += ۱
        راګرځه _درناوی("سلام") + "، " + نوم + "!"

    # لومړی توری لوی کوي (پښتو لوی توري نه لري، نو پښتو کلمه همغسې پاتې کېږي).
    دنده _درناوی(کلمه: متن): متن
        راګرځه متن.لوی توري کړه(متن.برخه(کلمه، ۰، ۱)) + متن.برخه(کلمه، ۱، اوږدوالی(کلمه))

کرښه چاپ(ښه_راغلاست.سلام("ملالۍ")، " "، ښه_راغلاست.سلام("خوشال")، " ("، ښه_راغلاست.ورکړل_شوي، " سلامونه)")
کرښه چاپ("دننۍ ټولګي: "، ریاضي.جذر(۱۶٫۰)، " "، متن.پاک کړه("  پاک شوی  ")، " "، ریاضي.اعظمه(۳، ۷))
