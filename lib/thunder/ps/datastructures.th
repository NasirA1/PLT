<<<<<<< HEAD
# د غوټیو ځنځیر: هره غوټۍ خپل ارزښت او راتلونکې غوټۍ ساتي؛ «هېڅ» ځنځیر پای ته رسوي.
# سر ته ورزیاتول O(1) دي؛ پای ته ورزیاتول او لټون ځنځیر ګرځي، O(n).
# دا د درسي کتابونو انځور دی، له یوه تکراري جوړښته جوړ.

جوړښت د_ځنځیر_غوټۍ[ت]
    ارزښت: ت
    راتلونکې: د_ځنځیر_غوټۍ[ت]

جوړښت ځنځیر[ت]
    سر: د_ځنځیر_غوټۍ[ت]
    شمېر: عدد

# یو نوی، تش ځنځیر («متغیر ځ: ځنځیر[عدد] = نوی_ځنځیر()»).
دنده نوی_ځنځیر[ت](): ځنځیر[ت]
    راګرځه ځنځیر(سر: هېڅ، شمېر: ۰)

# یو ارزښت سر ته ورزیاتوي: نوې غوټۍ پخواني سر ته اشاره کوي.
دنده ځنځیر_سر_ته_ورزیات_کړه[ت](ځنځیر_: ځنځیر[ت]، ارزښت: ت)
    ځنځیر_.سر = د_ځنځیر_غوټۍ(ارزښت: ارزښت، راتلونکې: ځنځیر_.سر)
    ځنځیر_.شمېر = ځنځیر_.شمېر + ۱

# یو ارزښت پای ته ورزیاتوي: تر وروستۍ غوټۍ ولاړ شه، نوې پرې وځړوه.
دنده ځنځیر_پای_ته_ورزیات_کړه[ت](ځنځیر_: ځنځیر[ت]، ارزښت: ت)
    متغیر غوټۍ = د_ځنځیر_غوټۍ(ارزښت: ارزښت، راتلونکې: هېڅ)
    که ځنځیر_.سر == هېڅ
        ځنځیر_.سر = غوټۍ
    کنه
        متغیر وروستۍ = ځنځیر_.سر
        ترڅو وروستۍ.راتلونکې != هېڅ
            وروستۍ = وروستۍ.راتلونکې
        وروستۍ.راتلونکې = غوټۍ
    ځنځیر_.شمېر = ځنځیر_.شمېر + ۱

# د سر ارزښت لیرې کوي او راګرځوي یې.
دنده ځنځیر_له_سره_واخله[ت](ځنځیر_: ځنځیر[ت]): ت
    متغیر ارزښت = ځنځیر_.سر.ارزښت
    ځنځیر_.سر = ځنځیر_.سر.راتلونکې
=======
# د غوټیو ځنځیر، چې هره غوټۍ یوازې خپل ارزښت او راتلونکې غوټۍ پېژني. د تندر جوړښتونه
# ځانونه نشي رانغښتلای، نو غوټۍ په دوو موازي لړیو کې ژوند کوي او «اشاره» یې شاخص دی:
# راتلونکی[غ] له غ وروسته غوټۍ ده، او -۱ مانا «هېڅ» - همداسې ځنځیرونه د هغو ژبو دننه
# جوړېږي چې اشارې (pointers) هم نه لري. سر ته ورزیاتول O(1) دي؛ د لیرې شویو غوټیو
# ځایونه تر هغو پاتې کېږي چې ځنځیر پخپله پرېښودل شي.

جوړښت ځنځیر
    ارزښتونه: عدد[]
    راتلونکی: عدد[]
    سر: عدد
    شمېر: عدد

# یو نوی، تش ځنځیر.
دنده نوی_ځنځیر(): ځنځیر
    متغیر ارزښتونه_: عدد[] = []
    متغیر راتلونکی_: عدد[] = []
    راګرځه ځنځیر(ارزښتونه: ارزښتونه_، راتلونکی: راتلونکی_، سر: -۱، شمېر: ۰)

# یو ارزښت سر ته ورزیاتوي: نوې غوټۍ پخواني سر ته اشاره کوي.
دنده ځنځیر_سر_ته_ورزیات_کړه(ځنځیر_: ځنځیر، ارزښت: عدد)
    ورزیات کړه(ځنځیر_.ارزښتونه، ارزښت)
    ورزیات کړه(ځنځیر_.راتلونکی، ځنځیر_.سر)
    ځنځیر_.سر = اوږدوالی(ځنځیر_.ارزښتونه) - ۱
    ځنځیر_.شمېر = ځنځیر_.شمېر + ۱

# یو ارزښت پای ته ورزیاتوي: تر وروستۍ غوټۍ ولاړ شه، نوې پرې وځړوه.
دنده ځنځیر_پای_ته_ورزیات_کړه(ځنځیر_: ځنځیر، ارزښت: عدد)
    ورزیات کړه(ځنځیر_.ارزښتونه، ارزښت)
    ورزیات کړه(ځنځیر_.راتلونکی، -۱)
    متغیر غوټۍ = اوږدوالی(ځنځیر_.ارزښتونه) - ۱
    که ځنځیر_.سر == -۱
        ځنځیر_.سر = غوټۍ
    کنه
        متغیر وروستۍ = ځنځیر_.سر
        ترڅو ځنځیر_.راتلونکی[وروستۍ] != -۱
            وروستۍ = ځنځیر_.راتلونکی[وروستۍ]
        ځنځیر_.راتلونکی[وروستۍ] = غوټۍ
    ځنځیر_.شمېر = ځنځیر_.شمېر + ۱

# د سر ارزښت لیرې کوي او راګرځوي یې.
دنده ځنځیر_له_سره_واخله(ځنځیر_: ځنځیر): عدد
    متغیر ارزښت = ځنځیر_.ارزښتونه[ځنځیر_.سر]
    ځنځیر_.سر = ځنځیر_.راتلونکی[ځنځیر_.سر]
>>>>>>> 569b8c585e5087db3fc8ba2ce2172f3b7b18f4ce
    ځنځیر_.شمېر = ځنځیر_.شمېر - ۱
    راګرځه ارزښت

# لومړۍ هغه غوټۍ لیرې کوي چې دا ارزښت لري. رښتیا که ومونده.
<<<<<<< HEAD
دنده له_ځنځیره_لیرې_کړه[ت](ځنځیر_: ځنځیر[ت]، ارزښت: ت): منطقي
    متغیر غوټۍ = ځنځیر_.سر
    متغیر پخوانۍ: د_ځنځیر_غوټۍ[ت] = هېڅ
    ترڅو غوټۍ != هېڅ
        که غوټۍ.ارزښت == ارزښت
            که پخوانۍ == هېڅ
                ځنځیر_.سر = غوټۍ.راتلونکې
            کنه
                پخوانۍ.راتلونکې = غوټۍ.راتلونکې
            ځنځیر_.شمېر = ځنځیر_.شمېر - ۱
            راګرځه رښتیا
        پخوانۍ = غوټۍ
        غوټۍ = غوټۍ.راتلونکې
    راګرځه درواغ

# رښتیا که کومه غوټۍ دا ارزښت لري.
دنده ځنځیر_لري[ت](ځنځیر_: ځنځیر[ت]، ارزښت: ت): منطقي
    متغیر غوټۍ = ځنځیر_.سر
    ترڅو غوټۍ != هېڅ
        که غوټۍ.ارزښت == ارزښت
            راګرځه رښتیا
        غوټۍ = غوټۍ.راتلونکې
    راګرځه درواغ

# ځنځیر څومره ارزښتونه لري.
دنده د_ځنځیر_کچه[ت](ځنځیر_: ځنځیر[ت]): عدد
    راګرځه ځنځیر_.شمېر

# ارزښتونه د ځنځیر په ترتیب، د ساده لړۍ په بڼه.
دنده ځنځیر_لړۍ_کړه[ت](ځنځیر_: ځنځیر[ت]): ت[]
    متغیر پایله: ت[] = []
    متغیر غوټۍ = ځنځیر_.سر
    ترڅو غوټۍ != هېڅ
        ورزیات کړه(پایله، غوټۍ.ارزښت)
        غوټۍ = غوټۍ.راتلونکې
=======
دنده له_ځنځیره_لیرې_کړه(ځنځیر_: ځنځیر، ارزښت: عدد): منطقي
    متغیر غوټۍ = ځنځیر_.سر
    متغیر پخوانۍ = -۱
    ترڅو غوټۍ != -۱
        که ځنځیر_.ارزښتونه[غوټۍ] == ارزښت
            که پخوانۍ == -۱
                ځنځیر_.سر = ځنځیر_.راتلونکی[غوټۍ]
            کنه
                ځنځیر_.راتلونکی[پخوانۍ] = ځنځیر_.راتلونکی[غوټۍ]
            ځنځیر_.شمېر = ځنځیر_.شمېر - ۱
