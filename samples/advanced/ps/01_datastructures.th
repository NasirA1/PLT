# ژبه: ps
# پرمختللی ۰۱ - د ډېټا جوړښتونو کتابتون
#
# راوړه "datastructures" کلاسیک جوړښتونه راوړي: ډېرۍ، لیکه، ځنځیر، د لټون دوه‌اړخیزه
# ونه او د لومړیتوب لیکه - ټول پخپله په تندر کې لیکل شوي (lib/thunder/ps) او ټول
# عمومي: د توکو ډول په <زاویه قوسونو> کې له کارونې معلومېږي.
# کتابتون په docs/ps/datastructures.md کې تشریح شوی دی.

راوړه "datastructures"

# --- د متنونو ډېرۍ: وروستی دننه، لومړی بهر ------------------------------------------
متغیر کاسې: ډېرۍ<متن> = نوې_ډېرۍ()
ډېرۍ_ته_ورزیات_کړه(کاسې، "ومینځل شوه")
ډېرۍ_ته_ورزیات_کړه(کاسې، "وچه شوه")
ډېرۍ_ته_ورزیات_کړه(کاسې، "کېښودل شوه")
کرښه چاپ("د ډېرۍ سر: "، ډېرۍ_وګوره(کاسې))
ترڅو نه ډېرۍ_تشه_ده(کاسې)
    کرښه چاپ("واخله: "، له_ډېرۍ_واخله(کاسې))

# --- د پېرودونکو لیکه: لومړی دننه، لومړی بهر ----------------------------------------
متغیر انتظار: لیکه<متن> = نوې_لیکه()
لیکې_ته_ورزیات_کړه(انتظار، "انا")
لیکې_ته_ورزیات_کړه(انتظار، "بشیر")
لیکې_ته_ورزیات_کړه(انتظار، "ثریا")
کرښه چاپ("خدمت: "، له_لیکې_واخله(انتظار)، "؛ راتلونکی "، لیکه_وګوره(انتظار)،
    " له "، د_لیکې_کچه(انتظار))

# --- ځنځیر: د غوټیو کړۍ چې هېڅ یې پای ته رسوي ---------------------------------------
متغیر کړۍ: ځنځیر<عدد> = نوی_ځنځیر()
ځنځیر_پای_ته_ورزیات_کړه(کړۍ، ۲)
ځنځیر_سر_ته_ورزیات_کړه(کړۍ، ۱)
ځنځیر_پای_ته_ورزیات_کړه(کړۍ، ۳)
کرښه چاپ("د لړۍ په بڼه: "، ځنځیر_لړۍ_کړه(کړۍ)، "، ۳ لري؟ "، ځنځیر_لري(کړۍ، ۳))
متغیر لیرې_شو = له_ځنځیره_لیرې_کړه(کړۍ، ۲)
کرښه چاپ("د ۲ له لیرې کولو ("، لیرې_شو، ") وروسته: "، ځنځیر_لړۍ_کړه(کړۍ))

# --- د لټون دوه‌اړخیزه ونه خپل ارزښتونه په ترتیب ساتي -------------------------------
متغیر ونه_: ونه<عدد> = نوې_ونه()
لپاره ن په [۵۰، ۳۰، ۸۰، ۱۰، ۴۰، ۷۰، ۹۰]
    ونې_ته_ورزیات_کړه(ونه_، ن)
کرښه چاپ("ترتیب شوې: "، ونه_په_ترتیب(ونه_))
کرښه چاپ("کچه "، د_ونې_کچه(ونه_)، "، لوړوالی "، د_ونې_لوړوالی(ونه_)،
    "، کمینه "، د_ونې_کمینه(ونه_)، "، اعظمه "، د_ونې_اعظمه(ونه_))
متغیر ووت = له_ونې_لیرې_کړه(ونه_، ۵۰)
کرښه چاپ("ریښه لیرې شوه؟ "، ووت، "؛ پرته له هغې: "، ونه_په_ترتیب(ونه_))

# --- د لومړیتوب لیکه همېش کمینه لومړی راکوي -----------------------------------------
متغیر کارونه: لومړیتوب_لیکه<عدد> = نوې_لومړیتوب_لیکه()
لپاره لومړیتوب په [۷، ۲، ۹، ۱، ۵]
    لومړیتوب_لیکې_ته_ورزیات_کړه(کارونه، لومړیتوب)
ترڅو نه لومړیتوب_لیکه_تشه_ده(کارونه)
    چاپ(له_لومړیتوب_لیکې_واخله(کارونه)، " ")
کرښه چاپ()

# --- ټولګه هر ارزښت یو ځل ساتي؛ ترتیب شوې ټولګه یې اڼلي هم ساتي ---------------------
متغیر لیدل_شوي: ټولګه<متن> = نوې_ټولګه()
لپاره رنګ په ["سور"، "شین"، "سور"، "زرغون"، "شین"]
    ټولګې_ته_ورزیات_کړه(لیدل_شوي، رنګ)
کرښه چاپ("ځانګړي رنګونه: "، د_ټولګې_ارزښتونه(لیدل_شوي)، " (له ۵ څخه "، د_ټولګې_کچه(لیدل_شوي)، ")")
متغیر ساړه: ټولګه<متن> = نوې_ټولګه()
ټولګې_ته_ورزیات_کړه(ساړه، "شین")
ټولګې_ته_ورزیات_کړه(ساړه، "زرغون")
کرښه چاپ("یوازې تاوده: "، د_ټولګې_ارزښتونه(د_ټولګو_توپیر(لیدل_شوي، ساړه)))

متغیر نمرې: ترتیب_شوې_ټولګه<عدد> = نوې_ترتیب_شوې_ټولګه()
لپاره نمره په [۷۰، ۴۰، ۹۰، ۷۰، ۴۰]
    ترتیب_شوې_ټولګې_ته_ورزیات_کړه(نمرې، نمره)
کرښه چاپ("ځانګړې نمرې، اڼل شوې: "، د_ترتیب_شوې_ټولګې_ارزښتونه(نمرې)،
    "، له "، د_ترتیب_شوې_ټولګې_کمینه(نمرې)، " تر "، د_ترتیب_شوې_ټولګې_اعظمه(نمرې))
