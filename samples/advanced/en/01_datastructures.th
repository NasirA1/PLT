# Advanced 01 - The data structures library
#
# import "datastructures" brings the classic structures: a stack, a queue, a linked list,
# a binary search tree and a heap, all written in Thunder itself (lib/thunder/en) and all
# generic - the element type in <angle brackets> is deduced from how each structure is used.
# The library is explained in docs/datastructures.md.

import "datastructures"

# --- a stack of strings: last in, first out --------------------------------------------
var plates: stack.Stack<string> = stack.new()
stack.push(plates, "washed")
stack.push(plates, "dried")
stack.push(plates, "put away")
println("top of the pile: ", stack.peek(plates))
while not stack.is_empty(plates)
    println("take: ", stack.pop(plates))

# --- a queue of customers: first in, first out -----------------------------------------
var waiting: queue.Queue<string> = queue.new()
queue.add(waiting, "Anna")
queue.add(waiting, "Bashir")
queue.add(waiting, "Caro")
println("serving ", queue.take(waiting), "; next is ", queue.peek(waiting),
    " of ", queue.size(waiting))

# --- a linked list: a chain of nodes ended by nothing ----------------------------------
var chain: linked_list.LinkedList<int> = linked_list.new()
linked_list.add_last(chain, 2)
linked_list.add_first(chain, 1)
linked_list.add_last(chain, 3)
println("as an array: ", linked_list.to_array(chain), ", has 3? ", linked_list.has(chain, 3))
var removed = linked_list.remove_value(chain, 2)
println("after removing 2 (", removed, "): ", linked_list.to_array(chain))

# --- a binary search tree keeps its values in order ------------------------------------
var search_tree: tree.BinaryTree<int> = tree.new()
for n in [50, 30, 80, 10, 40, 70, 90]
    tree.insert(search_tree, n)
println("sorted: ", tree.sorted(search_tree))
println("size ", tree.size(search_tree), ", height ", tree.height(search_tree),
    ", smallest ", tree.smallest(search_tree), ", largest ", tree.largest(search_tree))
var gone = tree.remove(search_tree, 50)
println("removed the root? ", gone, "; without it: ", tree.sorted(search_tree))

# --- a heap always hands out the smallest first ----------------------------------------
var todo: heap.Heap<int> = heap.new()
for priority in [7, 2, 9, 1, 5]
    heap.add(todo, priority)
while not heap.is_empty(todo)
    print(heap.take(todo), " ")
println()

# --- a set keeps every value once; an ordered set keeps them sorted too ----------------
var seen: set.Set<string> = set.new()
for color in ["red", "blue", "red", "green", "blue"]
    set.add(seen, color)
println("unique colors: ", set.values(seen), " (", set.size(seen), " of 5 added)")
var cold: set.Set<string> = set.new()
set.add(cold, "blue")
set.add(cold, "green")
println("warm only: ", set.values(set.difference(seen, cold)))

var scores: ordered_set.OrderedSet<int> = ordered_set.new()
for score in [70, 40, 90, 70, 40]
    ordered_set.add(scores, score)
println("distinct scores, sorted: ", ordered_set.values(scores),
    ", from ", ordered_set.smallest(scores), " to ", ordered_set.largest(scores))

# --- a deque is open at both ends; a doubly linked list walks both ways ----------------
var lane: deque.Deque<string> = deque.new()
deque.add_last(lane, "second")
deque.add_first(lane, "first")
deque.add_last(lane, "third")
println("deque: ", deque.to_array(lane), ", from the back: ", deque.take_last(lane))

var history: doubly_linked_list.DoublyLinkedList<string> = doubly_linked_list.new()
doubly_linked_list.add_last(history, "one")
doubly_linked_list.add_last(history, "two")
doubly_linked_list.add_last(history, "three")
println("forwards: ", doubly_linked_list.to_array(history), ", backwards: ", doubly_linked_list.to_array_reversed(history))

# --- a graph: towns, roads, and the shortest way between them --------------------------
var roads: graph.Graph<string> = graph.new()
graph.connect(roads, "Kabul", "Ghazni")
graph.connect(roads, "Ghazni", "Kandahar")
graph.connect(roads, "Kabul", "Bamyan")
graph.connect(roads, "Bamyan", "Herat")
graph.connect(roads, "Kandahar", "Herat")
println("from Kabul, nearest first: ", graph.bfs(roads, "Kabul"))
println("shortest road to Herat: ", graph.shortest_path(roads, "Kabul", "Herat"))

# --- a trie answers prefix questions in the length of the word -------------------------
var dictionary = trie.new()
for word in ["car", "cart", "cat", "dog"]
    trie.add(dictionary, word)
println("words: ", trie.words(dictionary), "; starts with ca? ", trie.has_prefix(dictionary, "ca"),
    "; is ca a word? ", trie.has(dictionary, "ca"))
