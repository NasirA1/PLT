# 22 - Working with text
#
# Built-in functions take strings apart and put them together again. Positions
# count characters (Pashto letters too) and start at 0. A range start..end
# includes start but not end: substring("thunder", 0, 3) is "thu".
#
# Try it: change the separator given to split, or the text in "record".

var record = "  Ada Lovelace, 1815, London  "
var clean = string.trim(record)
println("[", clean, "]")

var parts = string.split(clean, ", ")
println(parts, " has ", len(parts), " parts")
var name = parts[0]
println(string.to_upper(name), " / ", string.to_lower(name))
println("first name: ", string.substring(name, 0, index_of(name, " ")))
println("starts with Ada? ", string.starts_with(name, "Ada"), ", ends with ce? ", string.ends_with(name, "ce"))
println("mentions London? ", contains(clean, "London"), ", Paris? ", contains(clean, "Paris"))
println(string.replace(clean, ", ", " | "))
println(string.join(reverse(parts), " <- "), " ", reverse("stressed"))
println(string.repeat("=-", 12))

if string.is_int(parts[1])
    println("two hundred years later: ", to_int(parts[1]) + 200)

# Every character has a number (its Unicode code point).
println(string.char_code("A"), " ", string.char_code("a"), " ", string.from_char_code(string.char_code("A") + 2))

# A Caesar cipher moves every letter three places along the alphabet.
func caesar(text: string, shift: int): string
    var result = ""
    for var i = 0, i < len(text), i = i + 1
        var code = string.char_code(text[i])
        if code >= string.char_code("a") and code <= string.char_code("z")
            code = (code - string.char_code("a") + shift + 26) % 26 + string.char_code("a")
        result = result + string.from_char_code(code)
    return result

var secret = caesar("hello world", 3)
println(secret, " -> ", caesar(secret, -3))
