# ژبه: ps
# datastructures.th (lib/thunder/ps) - کلاسیک ډېټا جوړښتونه، پخپله په تندر کې لیکل شوي
# (docs/ps/datastructures.md)
#
# راوړه "datastructures" ولیکئ او ټول لاندې جوړښتونه ستاسې دي (thunderc دا فایل د ځان تر
# څنګ په lib/thunder کې مومي، یا یوه پوښۍ د --module-path سره ورکړئ). د ساکټونو یا ګرافیک
# په خلاف دلته هېڅ بهرنی نشته: دا ساده تندر دی، د لوستلو لپاره لیکل شوی - دا فایل پرانیزئ
# او وګورئ چې ډېرۍ، لیکه، ځنځیر، د لټون دوه‌اړخیزه ونه او د لومړیتوب لیکه رښتیا څنګه کار کوي.
#
# هر جوړښت یو جوړښت دی چې جوړوونکې دنده او خپلې دندې لري: په خپل نوم یې جوړ کړئ
# («متغیر د: ډېرۍ<عدد> = ډېرۍ()») او د دندو له لارې یې وکاروئ («د.ورزیات_کړه(۱)»،
# «د.واخله()»). ډېری یې عمومي (generic) دي: ډېرۍ<ت> د هر ډول توکو لپاره کار کوي، او ت
# هلته نومول کېږي چې متغیر اعلانېږي. ونه او د لومړیتوب لیکه خپل توکي د < سره پرتله کوي،
# نو توکي یې عددونه یا متنونه دي. غړی چې نوم یې په '_' پیلېږي شخصي دی: یوازې د
# جوړښت خپلې دندې یې لمسولای شي - پروګرامونه دندې کاروي، هېڅکله دننۍ برخې نه.
#
# له تش جوړښته اخیستل د پروګرام تېروتنه ده او پروګرام دروي، لکه د دننۍ دندې ناسمه بلنه.
# لومړی تشه_ده وپوښتئ.

# ------------------------------------------------- ډېرۍ (وروستی دننه، لومړی بهر)
#
# د کاسو ډېرۍ: ورزیات_کړه یو ارزښت سر ته ږدي، واخله همغه سر بېرته راوړي.
# هره عملیه O(1) ده.
جوړښت ډېرۍ<ت>
    _توکي: ت[]

    # یوه نوې، تشه ډېرۍ («متغیر د: ډېرۍ<عدد> = ډېرۍ()» وايي څه به ساتي).
    ډېرۍ()
        _توکي = []

    # یو ارزښت سر ته ږدي.
    دنده ورزیات_کړه(ارزښت: ت)
        ورزیات کړه(_توکي، ارزښت)

    # د سر ارزښت اخلي او راګرځوي یې.
    دنده واخله(): ت
        راګرځه وروستی واخله(_توکي)

    # د سر ارزښت، بې له اخیستلو.
    دنده وګوره(): ت
        راګرځه _توکي[اوږدوالی(_توکي) - ۱]

    # ډېرۍ څومره ارزښتونه لري.
    دنده کچه(): عدد
        راګرځه اوږدوالی(_توکي)

    # رښتیا که ډېرۍ هېڅ نه لري.
    دنده تشه_ده(): منطقي
        راګرځه اوږدوالی(_توکي) == ۰

# ------------------------------------------------- لیکه (لومړی دننه، لومړی بهر)
#
# د دوکان مخې ته لیکه: ورزیات_کړه پای ته درېږي، واخله سر ته رسیدلی خدمتوي.
# د سر شاخص ښویېږي، د هر توکي له کښته کولو پرته، نو دواړه په منځني ډول O(1) دي؛
# د خدمت شویو توکو ځای هر کله چې له پاتې نورو لوی شي بېرته اخیستل کېږي.
جوړښت لیکه<ت>
    _توکي: ت[]
    _سر: عدد

    # یوه نوې، تشه لیکه («متغیر ل: لیکه<متن> = لیکه()» وايي څه به ساتي).
    لیکه()
        _توکي = []
        _سر = ۰

    # د لیکې پای ته درېږي.
    دنده ورزیات_کړه(ارزښت: ت)
        ورزیات کړه(_توکي، ارزښت)

    # د لیکې سر خدمتوي (لیرې کوي یې او راګرځوي یې).
    دنده واخله(): ت
        متغیر ارزښت = _توکي[_سر]
        _سر = _سر + ۱
        که _سر * ۲ >= اوږدوالی(_توکي) او _سر > ۸
            _توکي = ټوټه(_توکي، _سر، اوږدوالی(_توکي))
            _سر = ۰
        راګرځه ارزښت

    # د لیکې سر، بې له خدمتولو.
    دنده وګوره(): ت
        راګرځه _توکي[_سر]

    # څومره ارزښتونه انتظار کوي.
    دنده کچه(): عدد
        راګرځه اوږدوالی(_توکي) - _سر

    # رښتیا که لیکه هېڅ نه لري.
    دنده تشه_ده(): منطقي
        راګرځه کچه() == ۰

# ------------------------------------------------- ځنځیر (یو اړخیز تړلی لړ)
#
# د غوټیو ځنځیر: هره غوټۍ خپل ارزښت او راتلونکې غوټۍ ساتي؛ «هېڅ» ځنځیر پای ته رسوي.
# سر ته ورزیاتول O(1) دي؛ پای ته ورزیاتول او لټون ځنځیر ګرځي، O(n).
# دا د درسي کتابونو انځور دی، له یوه تکراري جوړښته جوړ. غوټۍ پخپله ساده ډېټا دي -
# ځنځیر هغه شی دی چې د لړ خاوند دی او چلوي یې.
جوړښت د_ځنځیر_غوټۍ<ت>
    ارزښت: ت
    راتلونکې: د_ځنځیر_غوټۍ<ت>

جوړښت ځنځیر<ت>
    _سر: د_ځنځیر_غوټۍ<ت>
    _شمېر: عدد

    # یو نوی، تش ځنځیر («متغیر ځ: ځنځیر<عدد> = ځنځیر()»).
    ځنځیر()
        _سر = هېڅ
        _شمېر = ۰

    # یو ارزښت سر ته ورزیاتوي: نوې غوټۍ پخواني سر ته اشاره کوي.
    دنده سر_ته_ورزیات_کړه(ارزښت: ت)
        _سر = د_ځنځیر_غوټۍ(ارزښت: ارزښت، راتلونکې: _سر)
        _شمېر = _شمېر + ۱

    # یو ارزښت پای ته ورزیاتوي: تر وروستۍ غوټۍ ولاړ شه، نوې پرې وځړوه.
    دنده پای_ته_ورزیات_کړه(ارزښت: ت)
        متغیر غوټۍ = د_ځنځیر_غوټۍ(ارزښت: ارزښت، راتلونکې: هېڅ)
        که _سر == هېڅ
            _سر = غوټۍ
        کنه
            متغیر وروستۍ = _سر
            ترڅو وروستۍ.راتلونکې != هېڅ
                وروستۍ = وروستۍ.راتلونکې
            وروستۍ.راتلونکې = غوټۍ
        _شمېر = _شمېر + ۱

    # د سر ارزښت لیرې کوي او راګرځوي یې.
    دنده له_سره_واخله(): ت
        متغیر ارزښت = _سر.ارزښت
        _سر = _سر.راتلونکې
        _شمېر = _شمېر - ۱
        راګرځه ارزښت

    # لومړۍ هغه غوټۍ لیرې کوي چې دا ارزښت لري. رښتیا که ومونده.
    دنده لیرې_کړه(ارزښت: ت): منطقي
        متغیر غوټۍ = _سر
        متغیر پخوانۍ: د_ځنځیر_غوټۍ<ت> = هېڅ
        ترڅو غوټۍ != هېڅ
            که غوټۍ.ارزښت == ارزښت
                که پخوانۍ == هېڅ
                    _سر = غوټۍ.راتلونکې
                کنه
                    پخوانۍ.راتلونکې = غوټۍ.راتلونکې
                _شمېر = _شمېر - ۱
                راګرځه رښتیا
            پخوانۍ = غوټۍ
            غوټۍ = غوټۍ.راتلونکې
        راګرځه درواغ

    # رښتیا که کومه غوټۍ دا ارزښت لري.
    دنده لري(ارزښت: ت): منطقي
        متغیر غوټۍ = _سر
        ترڅو غوټۍ != هېڅ
            که غوټۍ.ارزښت == ارزښت
                راګرځه رښتیا
            غوټۍ = غوټۍ.راتلونکې
        راګرځه درواغ

    # ځنځیر څومره ارزښتونه لري.
    دنده کچه(): عدد
        راګرځه _شمېر

    # ارزښتونه د ځنځیر په ترتیب، د ساده لړۍ په بڼه.
    دنده لړۍ_کړه(): ت[]
        متغیر پایله: ت[] = []
        متغیر غوټۍ = _سر
        ترڅو غوټۍ != هېڅ
            ورزیات کړه(پایله، غوټۍ.ارزښت)
            غوټۍ = غوټۍ.راتلونکې
        راګرځه پایله

# ------------------------------------------------- د لټون دوه‌اړخیزه ونه
#
# د هرې غوټۍ کیڼه څانګه کوچني ارزښتونه لري، ښۍ یې لوی، نو یو ارزښت په O(لوړوالی)
# ګامونو کې موندل کېږي - O(log n) کله چې ونه په مناسب ډول برابره وي. توکي د < سره
# پرتله کېږي، نو عددونه یا متنونه دي. تکراري ارزښتونه له پامه غورځول کېږي.
جوړښت د_ونې_غوټۍ<ت>
    ارزښت: ت
    کیڼ: د_ونې_غوټۍ<ت>
    ښی: د_ونې_غوټۍ<ت>

جوړښت ونه<ت>
    _ریښه: د_ونې_غوټۍ<ت>
    _شمېر: عدد

    # یوه نوې، تشه ونه («متغیر و: ونه<عدد> = ونه()»).
    ونه()
        _ریښه = هېڅ
        _شمېر = ۰

    # یو ارزښت پر خپل ترتیب شوي ځای ورزیاتوي. ارزښت چې له وړاندې په ونه کې وي، همداسې پرېښودل کېږي.
    دنده ورزیات_کړه(ارزښت: ت)
        متغیر غوټۍ = د_ونې_غوټۍ(ارزښت: ارزښت، کیڼ: هېڅ، ښی: هېڅ)
        که _ریښه == هېڅ
            _ریښه = غوټۍ
            _شمېر = ۱
            راګرځه
        متغیر ځای = _ریښه
        ترڅو رښتیا
            که ارزښت == ځای.ارزښت
                راګرځه
            که ارزښت < ځای.ارزښت
                که ځای.کیڼ == هېڅ
                    ځای.کیڼ = غوټۍ
                    _شمېر = _شمېر + ۱
                    راګرځه
                ځای = ځای.کیڼ
            کنه
                که ځای.ښی == هېڅ
                    ځای.ښی = غوټۍ
                    _شمېر = _شمېر + ۱
                    راګرځه
                ځای = ځای.ښی

    # رښتیا که ارزښت په ونه کې وي.
    دنده لري(ارزښت: ت): منطقي
        متغیر ځای = _ریښه
        ترڅو ځای != هېڅ
            که ارزښت == ځای.ارزښت
                راګرځه رښتیا
            که ارزښت < ځای.ارزښت
                ځای = ځای.کیڼ
            کنه
                ځای = ځای.ښی
        راګرځه درواغ

    # ونه څومره ارزښتونه لري.
    دنده کچه(): عدد
        راګرځه _شمېر

    # له ریښې کښته تر ټولو اوږده لار له څومره غوټیو تېرېږي (د تشې ونې لپاره ۰).
    دنده لوړوالی(): عدد
        راګرځه _د_غوټۍ_لوړوالی(_ریښه)

    # (شخصي) د یوې غوټۍ لاندې لوړوالی؛ هېڅ د ۰ لوړوالي ونه ده.
    دنده _د_غوټۍ_لوړوالی(غوټۍ: د_ونې_غوټۍ<ت>): عدد
        که غوټۍ == هېڅ
            راګرځه ۰
        راګرځه ۱ + ریاضي.اعظمه(_د_غوټۍ_لوړوالی(غوټۍ.کیڼ)، _د_غوټۍ_لوړوالی(غوټۍ.ښی))

    # تر ټولو کوچنی ارزښت: همېش کیڼ لور ته ځه.
    دنده کمینه(): ت
        متغیر ځای = _ریښه
        ترڅو ځای.کیڼ != هېڅ
            ځای = ځای.کیڼ
        راګرځه ځای.ارزښت

    # تر ټولو لوی ارزښت: همېش ښي لور ته ځه.
    دنده اعظمه(): ت
        متغیر ځای = _ریښه
        ترڅو ځای.ښی != هېڅ
            ځای = ځای.ښی
        راګرځه ځای.ارزښت

    # هر ارزښت په پورته کېدونکي ترتیب (منځنی تګ: کیڼه څانګه، غوټۍ، ښۍ څانګه).
    دنده په_ترتیب(): ت[]
        متغیر پایله: ت[] = []
        _تګ(_ریښه، پایله)
        راګرځه پایله

    # (شخصي) پخپله منځنی تګ.
    دنده _تګ(غوټۍ: د_ونې_غوټۍ<ت>، پایله: ت[])
        که غوټۍ == هېڅ
            راګرځه
        _تګ(غوټۍ.کیڼ، پایله)
        ورزیات کړه(پایله، غوټۍ.ارزښت)
        _تګ(غوټۍ.ښی، پایله)

    # یو ارزښت لیرې کوي. رښتیا که په ونه کې و. غوټۍ چې دوه بچي لري خپل ارزښت د ښۍ څانګې
    # له کمینې (په ترتیب کې راتلونکی ارزښت) سره بدلوي او بیا همغه غوټۍ، چې تر یوه زیات
    # بچي نه لري، له ونې ایستل کېږي.
    دنده لیرې_کړه(ارزښت: ت): منطقي
        متغیر ځای = _ریښه
        متغیر مور: د_ونې_غوټۍ<ت> = هېڅ
        ترڅو ځای != هېڅ او ځای.ارزښت != ارزښت
            مور = ځای
            که ارزښت < ځای.ارزښت
                ځای = ځای.کیڼ
            کنه
                ځای = ځای.ښی
        که ځای == هېڅ
            راګرځه درواغ
        که ځای.کیڼ != هېڅ او ځای.ښی != هېڅ
            متغیر ځایناستی = ځای.ښی
            متغیر د_ځایناستي_مور = ځای
            ترڅو ځایناستی.کیڼ != هېڅ
                د_ځایناستي_مور = ځایناستی
                ځایناستی = ځایناستی.کیڼ
            ځای.ارزښت = ځایناستی.ارزښت
            ځای = ځایناستی
            مور = د_ځایناستي_مور
        متغیر بچی = ځای.کیڼ
        که بچی == هېڅ
            بچی = ځای.ښی
        که مور == هېڅ
            _ریښه = بچی
        کنه که مور.کیڼ == ځای
            مور.کیڼ = بچی
        کنه
            مور.ښی = بچی
        _شمېر = _شمېر - ۱
        راګرځه رښتیا

# ------------------------------------------------- د لومړیتوب لیکه (کمینه-ګودام)
#
# واخله همېش تر ټولو کوچنی ارزښت لومړی راکوي، ارزښتونه چې هر ترتیب راغلي وي. لیکه
# یوه دوه‌اړخیزه ونه ده چې په یوه لړۍ کې ځای شوې: د ش شاخص غوټۍ بچي په ۲*ش + ۱ او
# ۲*ش + ۲ کې ناست دي، او هره مور <= خپلو بچیو ده. ورزیاتول او اخیستل O(log n) دي.
# توکي د < سره پرتله کېږي، نو عددونه یا متنونه دي.
جوړښت لومړیتوب_لیکه<ت>
    _توکي: ت[]

    # یوه نوې، تشه د لومړیتوب لیکه («متغیر م: لومړیتوب_لیکه<عدد> = لومړیتوب_لیکه()»).
    لومړیتوب_لیکه()
        _توکي = []

    # یو ارزښت ورزیاتوي: پای ته یې ولیکه، بیا دې پورته ځي ترڅو له خپلې مور کوچنی وي.
    دنده ورزیات_کړه(ارزښت: ت)
        ورزیات کړه(_توکي، ارزښت)
        متغیر ځای = اوږدوالی(_توکي) - ۱
        ترڅو ځای > ۰
            متغیر مور = (ځای - ۱) / ۲
            که _توکي[مور] <= _توکي[ځای]
                ودرېږه
            متغیر ساتلی = _توکي[مور]
            _توکي[مور] = _توکي[ځای]
            _توکي[ځای] = ساتلی
            ځای = مور

    # تر ټولو کوچنی ارزښت لیرې کوي او راګرځوي یې: وروستی توکی ریښې ته خېژي، بیا تر هر
    # کوچني بچي لاندې ډوبېږي.
    دنده واخله(): ت
        متغیر کمینه = _توکي[۰]
        متغیر وروستی = وروستی واخله(_توکي)
        که اوږدوالی(_توکي) == ۰
            راګرځه کمینه
        _توکي[۰] = وروستی
        متغیر ځای = ۰
        ترڅو رښتیا
            متغیر بچی = ځای * ۲ + ۱
            که بچی >= اوږدوالی(_توکي)
                ودرېږه
            که بچی + ۱ < اوږدوالی(_توکي) او _توکي[بچی + ۱] < _توکي[بچی]
                بچی = بچی + ۱
            که _توکي[ځای] <= _توکي[بچی]
                ودرېږه
            متغیر ساتلی = _توکي[ځای]
            _توکي[ځای] = _توکي[بچی]
            _توکي[بچی] = ساتلی
            ځای = بچی
        راګرځه کمینه

    # تر ټولو کوچنی ارزښت، بې له لیرې کولو.
    دنده وګوره(): ت
        راګرځه _توکي[۰]

    # لیکه څومره ارزښتونه لري.
    دنده کچه(): عدد
        راګرځه اوږدوالی(_توکي)

    # رښتیا که د لومړیتوب لیکه هېڅ نه لري.
    دنده تشه_ده(): منطقي
        راګرځه اوږدوالی(_توکي) == ۰

# ------------------------------------------------- ټولګه (ځانګړي توکي)
#
# داسې راټولونه چې هر ارزښت پکې یو ځل راځي. د تندر پر خپله نقشه جوړه ده - ارزښت کیلۍ
# ده، نو ورزیاتول، لیرې کول او شتون کتل ټول O(1) دي - چې مانا یې دا هم ده چې توکي د
# نقشې کیلۍ دي: عدد، منطقي یا متن. ارزښتونه() د ورزیاتېدو په ترتیب راځي؛ د ترتیب
# شویو توکو لپاره لاندې ترتیب_شوې_ټولګه وکاروئ.
جوړښت ټولګه<ت>
    _ننوتنې: {ت: منطقي}

    # یوه نوې، تشه ټولګه («متغیر ټ: ټولګه<متن> = ټولګه()» وايي څه به ساتي).
    ټولګه()
        _ننوتنې = {}

    # یو ارزښت ورننباسي؛ هغه چې له وړاندې وي، یو پاتې کېږي.
    دنده ورزیات_کړه(ارزښت: ت)
        _ننوتنې[ارزښت] = رښتیا

    # یو ارزښت باسي. رښتیا که هلته و.
    دنده لیرې_کړه(ارزښت: ت): منطقي
        که نه لري(_ننوتنې، ارزښت)
            راګرځه درواغ
        لیرې کړه(_ننوتنې، ارزښت)
        راګرځه رښتیا

    # رښتیا که ارزښت په ټولګه کې وي.
    دنده لري(ارزښت: ت): منطقي
        راګرځه لري(_ننوتنې، ارزښت)

    # ټولګه څومره ارزښتونه لري.
    دنده کچه(): عدد
        راګرځه اوږدوالی(_ننوتنې)

    # رښتیا که ټولګه هېڅ نه لري.
    دنده تشه_ده(): منطقي
        راګرځه اوږدوالی(_ننوتنې) == ۰

    # ارزښتونه، د لومړي ورزیاتېدو په ترتیب.
    دنده ارزښتونه(): ت[]
        راګرځه کیلۍ(_ننوتنې)

    # هر ارزښت چې په یوه یا بله ټولګه کې وي. (د دندې دننه لغړه «ارزښتونه()» به د دننۍ
    # دندې ارزښتونه(نقشه) مانا ولري - د دننیو دندو نومونه خوندي پاتې کېږي - نو ټولګه
    # خپله نقشه پخپله لولي.)
    دنده یوځای(بله: ټولګه<ت>): ټولګه<ت>
        متغیر پایله: ټولګه<ت> = ټولګه()
        تکرار ارزښت په کیلۍ(_ننوتنې)
            پایله.ورزیات_کړه(ارزښت)
        تکرار ارزښت په بله.ارزښتونه()
            پایله.ورزیات_کړه(ارزښت)
        راګرځه پایله

    # هر ارزښت چې په دواړو ټولګو کې وي.
    دنده ګډ(بله: ټولګه<ت>): ټولګه<ت>
        متغیر پایله: ټولګه<ت> = ټولګه()
        تکرار ارزښت په کیلۍ(_ننوتنې)
            که بله.لري(ارزښت)
                پایله.ورزیات_کړه(ارزښت)
        راګرځه پایله

    # د دې ټولګې هر هغه ارزښت چې په بله کې نشته.
    دنده توپیر(بله: ټولګه<ت>): ټولګه<ت>
        متغیر پایله: ټولګه<ت> = ټولګه()
        تکرار ارزښت په کیلۍ(_ننوتنې)
            که نه بله.لري(ارزښت)
                پایله.ورزیات_کړه(ارزښت)
        راګرځه پایله

# ------------------------------------------------- ترتیب شوې ټولګه (ځانګړي، اڼل شوي)
#
# ټولګه چې خپل ارزښتونه په پورته کېدونکي ترتیب ساتي: لاندې یې د لټون دوه‌اړخیزه ونه
# ده، نو ورزیاتول، لیرې کول او شتون کتل O(log n) دي او ارزښتونه ترتیب شوي راوځي.
# توکي د < سره پرتله کېږي، نو عددونه یا متنونه دي. یو شی پر بل جوړ: ترتیب شوې ټولګه
# یوه ونه لري او هره پوښتنه د ونې پوښتنه کوي.
جوړښت ترتیب_شوې_ټولګه<ت>
    _ونه: ونه<ت>

    # یوه نوې، تشه ترتیب شوې ټولګه («متغیر ټ: ترتیب_شوې_ټولګه<عدد> = ترتیب_شوې_ټولګه()»).
    ترتیب_شوې_ټولګه()
        _ونه = ونه()

    # یو ارزښت پر خپل ترتیب شوي ځای ورننباسي؛ هغه چې له وړاندې وي، یو پاتې کېږي.
    دنده ورزیات_کړه(ارزښت: ت)
        _ونه.ورزیات_کړه(ارزښت)

    # یو ارزښت باسي. رښتیا که هلته و.
    دنده لیرې_کړه(ارزښت: ت): منطقي
        راګرځه _ونه.لیرې_کړه(ارزښت)

    # رښتیا که ارزښت په ټولګه کې وي.
    دنده لري(ارزښت: ت): منطقي
        راګرځه _ونه.لري(ارزښت)

    # ټولګه څومره ارزښتونه لري.
    دنده کچه(): عدد
        راګرځه _ونه.کچه()

    # رښتیا که ټولګه هېڅ نه لري.
    دنده تشه_ده(): منطقي
        راګرځه _ونه.کچه() == ۰

    # ارزښتونه، په پورته کېدونکي ترتیب.
    دنده ارزښتونه(): ت[]
        راګرځه _ونه.په_ترتیب()

    # د ترتیب دواړه څنډې.
    دنده کمینه(): ت
        راګرځه _ونه.کمینه()

    # تر ټولو لوی توکی (ټولګه باید تشه نه وي).
    دنده اعظمه(): ت
        راګرځه _ونه.اعظمه()

# ------------------------------------------------- دوسرې لیکه (دواړه سرونه)
#
# لیکه چې دواړه سرونه یې پرانیستي دي: ارزښتونه له مخې او له شا دواړو ځایونو ننوځي او
# وځي. دوه ډېرۍ، شا په شا: «_مخ» نیمایي مخکېنۍ برخه سرچپه ساتي (وروستی توکی یې د
# لیکې لومړی دی)، «_شا» پاتې په ترتیب. هر سر O(1) دی؛ کله چې یو لوری وچ شي، له بل
# لوري ډکېږي، چې هره عملیه په منځني ډول O(1) پاتې کوي.
جوړښت دوسرې_لیکه<ت>
    _مخ: ت[]
    _شا: ت[]

    # یوه نوې، تشه دوسرې لیکه («متغیر د: دوسرې_لیکه<عدد> = دوسرې_لیکه()»).
    دوسرې_لیکه()
        _مخ = []
        _شا = []

    # یو ارزښت مخې ته ږدي.
    دنده سر_ته_ورزیات_کړه(ارزښت: ت)
        ورزیات کړه(_مخ، ارزښت)

    # یو ارزښت شا ته ږدي.
    دنده پای_ته_ورزیات_کړه(ارزښت: ت)
        ورزیات کړه(_شا، ارزښت)

    # مخکېنی ارزښت اخلي او راګرځوي یې.
    دنده له_سره_واخله(): ت
        که اوږدوالی(_مخ) == ۰
            _ډکه_کړه(_شا، _مخ)
        راګرځه وروستی واخله(_مخ)

    # شاتنی ارزښت اخلي او راګرځوي یې.
    دنده له_پایه_واخله(): ت
        که اوږدوالی(_شا) == ۰
            _ډکه_کړه(_مخ، _شا)
        راګرځه وروستی واخله(_شا)

    # (شخصي) هر څه له یوه لوري بل ته وړي، او په لاره کې ترتیب سرچپه کوي.
    دنده _ډکه_کړه(سرچینه: ت[]، موخه: ت[])
        ترڅو اوږدوالی(سرچینه) > ۰
            ورزیات کړه(موخه، وروستی واخله(سرچینه))

    # مخکېنی ارزښت، بې له اخیستلو.
    دنده سر_وګوره(): ت
        که اوږدوالی(_مخ) == ۰
            _ډکه_کړه(_شا، _مخ)
        راګرځه _مخ[اوږدوالی(_مخ) - ۱]

    # شاتنی ارزښت، بې له اخیستلو.
    دنده پای_وګوره(): ت
        که اوږدوالی(_شا) == ۰
            _ډکه_کړه(_مخ، _شا)
        راګرځه _شا[اوږدوالی(_شا) - ۱]

    # لیکه څومره ارزښتونه لري.
    دنده کچه(): عدد
        راګرځه اوږدوالی(_مخ) + اوږدوالی(_شا)

    # رښتیا که لیکه هېڅ نه لري.
    دنده تشه_ده(): منطقي
        راګرځه کچه() == ۰

    # ارزښتونه له مخې تر شا، د ساده لړۍ په بڼه.
    دنده لړۍ_کړه(): ت[]
        متغیر پایله: ت[] = []
        تکرار متغیر ش = اوږدوالی(_مخ) - ۱، ش >= ۰، ش = ش - ۱
            ورزیات کړه(پایله، _مخ[ش])
        تکرار متغیر ش = ۰، ش < اوږدوالی(_شا)، ش = ش + ۱
            ورزیات کړه(پایله، _شا[ش])
        راګرځه پایله

# ------------------------------------------------- دوه اړخیز ځنځیر
#
# لکه ځنځیر، خو هره غوټۍ مخکېنۍ غوټۍ هم پېژني، او ځنځیر دواړه سرونه ساتي - نو په
# دواړو سرونو کې ورزیاتول او لیرې کول O(1) دي، او شاتګ هم کېدای شي.
جوړښت د_دوه_اړخیز_ځنځیر_غوټۍ<ت>
    ارزښت: ت
    مخکېنۍ: د_دوه_اړخیز_ځنځیر_غوټۍ<ت>
    راتلونکې: د_دوه_اړخیز_ځنځیر_غوټۍ<ت>

جوړښت دوه_اړخیز_ځنځیر<ت>
    _سر: د_دوه_اړخیز_ځنځیر_غوټۍ<ت>
    _پای: د_دوه_اړخیز_ځنځیر_غوټۍ<ت>
    _شمېر: عدد

    # یو نوی، تش دوه اړخیز ځنځیر («متغیر ځ: دوه_اړخیز_ځنځیر<عدد> = دوه_اړخیز_ځنځیر()»).
    دوه_اړخیز_ځنځیر()
        _سر = هېڅ
        _پای = هېڅ
        _شمېر = ۰

    # یو ارزښت سر ته ورزیاتوي.
    دنده سر_ته_ورزیات_کړه(ارزښت: ت)
        متغیر غوټۍ = د_دوه_اړخیز_ځنځیر_غوټۍ(ارزښت: ارزښت، مخکېنۍ: هېڅ، راتلونکې: _سر)
        که _سر == هېڅ
            _پای = غوټۍ
        کنه
            _سر.مخکېنۍ = غوټۍ
        _سر = غوټۍ
        _شمېر = _شمېر + ۱

    # یو ارزښت پای ته ورزیاتوي.
    دنده پای_ته_ورزیات_کړه(ارزښت: ت)
        متغیر غوټۍ = د_دوه_اړخیز_ځنځیر_غوټۍ(ارزښت: ارزښت، مخکېنۍ: _پای، راتلونکې: هېڅ)
        که _پای == هېڅ
            _سر = غوټۍ
        کنه
            _پای.راتلونکې = غوټۍ
        _پای = غوټۍ
        _شمېر = _شمېر + ۱

    # مخکېنی ارزښت لیرې کوي او راګرځوي یې.
    دنده له_سره_واخله(): ت
        متغیر غوټۍ = _سر
        _سر = غوټۍ.راتلونکې
        که _سر == هېڅ
            _پای = هېڅ
        کنه
            _سر.مخکېنۍ = هېڅ
        _شمېر = _شمېر - ۱
        راګرځه غوټۍ.ارزښت

    # شاتنی ارزښت لیرې کوي او راګرځوي یې.
    دنده له_پایه_واخله(): ت
        متغیر غوټۍ = _پای
        _پای = غوټۍ.مخکېنۍ
        که _پای == هېڅ
            _سر = هېڅ
        کنه
            _پای.راتلونکې = هېڅ
        _شمېر = _شمېر - ۱
        راګرځه غوټۍ.ارزښت

    # لومړۍ هغه غوټۍ لیرې کوي چې دا ارزښت لري. رښتیا که ومونده.
    دنده لیرې_کړه(ارزښت: ت): منطقي
        متغیر غوټۍ = _سر
        ترڅو غوټۍ != هېڅ
            که غوټۍ.ارزښت == ارزښت
                که غوټۍ.مخکېنۍ == هېڅ
                    _سر = غوټۍ.راتلونکې
                کنه
                    غوټۍ.مخکېنۍ.راتلونکې = غوټۍ.راتلونکې
                که غوټۍ.راتلونکې == هېڅ
                    _پای = غوټۍ.مخکېنۍ
                کنه
                    غوټۍ.راتلونکې.مخکېنۍ = غوټۍ.مخکېنۍ
                _شمېر = _شمېر - ۱
                راګرځه رښتیا
            غوټۍ = غوټۍ.راتلونکې
        راګرځه درواغ

    # رښتیا که کومه غوټۍ دا ارزښت لري.
    دنده لري(ارزښت: ت): منطقي
        متغیر غوټۍ = _سر
        ترڅو غوټۍ != هېڅ
            که غوټۍ.ارزښت == ارزښت
                راګرځه رښتیا
            غوټۍ = غوټۍ.راتلونکې
        راګرځه درواغ

    # ځنځیر څومره ارزښتونه لري.
    دنده کچه(): عدد
        راګرځه _شمېر

    # ارزښتونه له سره تر پایه، او له پایه تر سره: د اضافي اشارې ګټه.
    دنده لړۍ_کړه(): ت[]
        متغیر پایله: ت[] = []
        متغیر غوټۍ = _سر
        ترڅو غوټۍ != هېڅ
            ورزیات کړه(پایله، غوټۍ.ارزښت)
            غوټۍ = غوټۍ.راتلونکې
        راګرځه پایله

    # توکي له وروستي تر لومړي، د لړۍ په توګه.
    دنده سرچپه_لړۍ_کړه(): ت[]
        متغیر پایله: ت[] = []
        متغیر غوټۍ = _پای
        ترڅو غوټۍ != هېڅ
            ورزیات کړه(پایله، غوټۍ.ارزښت)
            غوټۍ = غوټۍ.مخکېنۍ
        راګرځه پایله

# ------------------------------------------------- ګراف
#
# څوکې او د هغوی تر منځ غاړې، د ګاونډیتوب د نقشې په بڼه: هره څوکه هغو څوکو ته نقشه
# کېږي چې غاړه ورته ځي. غاړې یو لوري دي؛ ونښلوه د ناجهته ګراف لپاره دواړه لوري
# ورزیاتوي. څوکې د نقشې کیلۍ دي: عدد، منطقي یا متن.
جوړښت ګراف<ت>
    _ګاونډیتوب: {ت: ت[]}

    # یو نوی، تش ګراف («متغیر ګ: ګراف<متن> = ګراف()»).
    ګراف()
        _ګاونډیتوب = {}

    # یوه څوکه بې غاړو ورزیاتوي (هغه چې وي، همداسې پاتې کېږي).
    دنده څوکه_ورزیاته_کړه(څوکه: ت)
        که نه لري(_ګاونډیتوب، څوکه)
            متغیر تش: ت[] = []
            _ګاونډیتوب[څوکه] = تش

    # یولورې غاړه ورزیاتوي؛ دواړه څوکې په اړتیا ورزیاتېږي. تکراري غاړه یوه پاتې کېږي.
    دنده غاړه_ورزیاته_کړه(له_: ت، ته_: ت)
        څوکه_ورزیاته_کړه(له_)
        څوکه_ورزیاته_کړه(ته_)
        که نه شامل دی(_ګاونډیتوب[له_]، ته_)
            ورزیات کړه(_ګاونډیتوب[له_]، ته_)

    # دوه څوکې دواړه لوري نښلوي: ناجهته غاړه.
    دنده ونښلوه(الف_: ت، ب_: ت)
        غاړه_ورزیاته_کړه(الف_، ب_)
        غاړه_ورزیاته_کړه(ب_، الف_)

    # هره څوکه، د لومړي ورزیاتېدو په ترتیب.
    دنده څوکې(): ت[]
        راګرځه کیلۍ(_ګاونډیتوب)

    # هغه څوکې چې له دې ځایه غاړه ورته ځي (د ناپېژندلې څوکې لپاره تشه).
    دنده ګاونډیان(څوکه: ت): ت[]
        که نه لري(_ګاونډیتوب، څوکه)
            متغیر تش: ت[] = []
            راګرځه تش
        راګرځه _ګاونډیتوب[څوکه]

    # پلن لټون (BFS): هره هغه څوکه چې له پیله ورته رسېدل کېږي، لومړی نږدې کړۍ.
    # لیکه مخکښه برخه ساتي؛ ټولګه یاد ساتي چې څه لیدل شوي دي.
    دنده پلن_لټون(پیل: ت): ت[]
        متغیر پایله: ت[] = []
        که نه لري(_ګاونډیتوب، پیل)
            راګرځه پایله
        متغیر لیدلي: ټولګه<ت> = ټولګه()
        متغیر مخکښه: لیکه<ت> = لیکه()
        لیدلي.ورزیات_کړه(پیل)
        مخکښه.ورزیات_کړه(پیل)
        ترڅو نه مخکښه.تشه_ده()
            متغیر څوکه = مخکښه.واخله()
            ورزیات کړه(پایله، څوکه)
            تکرار ګاونډی په ګاونډیان(څوکه)
                که نه لیدلي.لري(ګاونډی)
                    لیدلي.ورزیات_کړه(ګاونډی)
                    مخکښه.ورزیات_کړه(ګاونډی)
        راګرځه پایله

    # ژور لټون (DFS): هره لار تر پایه تعقیب کړه، بیا بله هڅه وکړه.
    دنده ژور_لټون(پیل: ت): ت[]
        متغیر پایله: ت[] = []
        که نه لري(_ګاونډیتوب، پیل)
            راګرځه پایله
        متغیر لیدلي: ټولګه<ت> = ټولګه()
        _ژور_لټون_وګرځه(پیل، لیدلي، پایله)
        راګرځه پایله

    # (شخصي) د ژور تګ یوه څوکه او هر څه چې تر هغې لاندې دي.
    دنده _ژور_لټون_وګرځه(څوکه: ت، لیدلي: ټولګه<ت>، پایله: ت[])
        که لیدلي.لري(څوکه)
            راګرځه
        لیدلي.ورزیات_کړه(څوکه)
        ورزیات کړه(پایله، څوکه)
        تکرار ګاونډی په ګاونډیان(څوکه)
            _ژور_لټون_وګرځه(ګاونډی، لیدلي، پایله)

    # تر ټولو لنډه لار (تر ټولو لږې غاړې) له یوې څوکې بلې ته، په پلن لټون موندل شوې؛
    # تشه کله چې نه وي. دواړه سرونه پکې دي: [له، ...، ته].
    دنده لنډه_لار(له_: ت، ته_: ت): ت[]
        متغیر لار: ت[] = []
        که نه لري(_ګاونډیتوب، له_) یا نه لري(_ګاونډیتوب، ته_)
            راګرځه لار
        متغیر له_کومه: {ت: ت} = {}
        متغیر لیدلي: ټولګه<ت> = ټولګه()
        متغیر مخکښه: لیکه<ت> = لیکه()
        لیدلي.ورزیات_کړه(له_)
        مخکښه.ورزیات_کړه(له_)
        متغیر وموندل_شوه = له_ == ته_
        ترڅو نه مخکښه.تشه_ده() او نه وموندل_شوه
            متغیر څوکه = مخکښه.واخله()
            تکرار ګاونډی په ګاونډیان(څوکه)
                که نه لیدلي.لري(ګاونډی)
                    لیدلي.ورزیات_کړه(ګاونډی)
                    له_کومه[ګاونډی] = څوکه
                    که ګاونډی == ته_
                        وموندل_شوه = رښتیا
                        ودرېږه
                    مخکښه.ورزیات_کړه(ګاونډی)
        که نه وموندل_شوه
            راګرځه لار
        # د ډوډۍ د ذرو پر لاره بېرته کور ته، بیا پله سرچپه کړه.
        متغیر ګام = ته_
        ورزیات کړه(لار، ګام)
        ترڅو ګام != له_
            ګام = له_کومه[ګام]
            ورزیات کړه(لار، ګام)
        راګرځه سرچپه کړه(لار)

    # رښتیا که د غاړو کومه لړۍ له یوې څوکې بلې ته رسېږي.
    دنده لار_لري(له_: ت، ته_: ت): منطقي
        راګرځه اوږدوالی(لنډه_لار(له_، ته_)) > ۰

# ------------------------------------------------- مختاړې ونه (trie)
#
# د تورو ونه: هر ویی خپله لار له هر هغه ویي سره شریکوي چې همداسې پیلېږي، نو لټون او
# د مختاړي پوښتنې د ویي د اوږدوالي بیه لري، وییونه چې هر څومره وي - هغه جوړښت چې
# د بشپړونې (autocomplete) تر شا دی.
جوړښت د_مختاړې_ونې_غوټۍ
    بچي: {متن: د_مختاړې_ونې_غوټۍ}
    ویی_پای_ته_رسوي: منطقي

    # یوه نوې غوټۍ: لا بچي نشته، او هېڅ ویی دلته نه پای ته رسېږي.
    د_مختاړې_ونې_غوټۍ()
        بچي = {}
        ویی_پای_ته_رسوي = درواغ

جوړښت مختاړې_ونه
    _ریښه: د_مختاړې_ونې_غوټۍ
    _شمېر: عدد

    # یوه نوې، تشه مختاړې ونه.
    مختاړې_ونه()
        _ریښه = د_مختاړې_ونې_غوټۍ()
        _شمېر = ۰

    # یو ویی ورزیاتوي (دوه ځله ورزیاتول یې یو ساتي).
    دنده ورزیات_کړه(ویی: متن)
        متغیر غوټۍ = _ریښه
        تکرار متغیر ش = ۰، ش < اوږدوالی(ویی)، ش = ش + ۱
            متغیر توری = متن.برخه(ویی، ش، ش + ۱)
            که نه لري(غوټۍ.بچي، توری)
                غوټۍ.بچي[توری] = د_مختاړې_ونې_غوټۍ()
            غوټۍ = غوټۍ.بچي[توری]
        که نه غوټۍ.ویی_پای_ته_رسوي
            غوټۍ.ویی_پای_ته_رسوي = رښتیا
            _شمېر = _شمېر + ۱

    # رښتیا که همدا ویی ورزیات شوی و.
    دنده لري(ویی: متن): منطقي
        متغیر غوټۍ = _وګرځه(ویی)
        راګرځه غوټۍ != هېڅ او غوټۍ.ویی_پای_ته_رسوي

    # رښتیا که کوم ورزیات شوی ویی په دې مختاړي پیلېږي ("" د هر څه مختاړی دی).
    دنده مختاړی_لري(مختاړی: متن): منطقي
        راګرځه _وګرځه(مختاړی) != هېڅ

    # (شخصي) ویی توری په توري تعقیبوي؛ هېڅ کله چې لار نه وي.
    دنده _وګرځه(ویی: متن): د_مختاړې_ونې_غوټۍ
        متغیر غوټۍ = _ریښه
        تکرار متغیر ش = ۰، ش < اوږدوالی(ویی)، ش = ش + ۱
            متغیر توری = متن.برخه(ویی، ش، ش + ۱)
            که نه لري(غوټۍ.بچي، توری)
                راګرځه هېڅ
            غوټۍ = غوټۍ.بچي[توری]
        راګرځه غوټۍ

    # ونه څومره بېلابېل وییونه لري.
    دنده کچه(): عدد
        راګرځه _شمېر

    # هر ویی، د الفبا په ترتیب.
    دنده وییونه(): متن[]
        متغیر پایله: متن[] = []
        _راټوله_کړه(_ریښه، ""، پایله)
        راګرځه ترتیب کړه(پایله)

    # (شخصي) د یوې غوټۍ لاندې هر ویی راټولوي، توری په توري.
    دنده _راټوله_کړه(غوټۍ: د_مختاړې_ونې_غوټۍ، مختاړی: متن، پایله: متن[])
        که غوټۍ.ویی_پای_ته_رسوي
            ورزیات کړه(پایله، مختاړی)
        تکرار توری په غوټۍ.بچي
            _راټوله_کړه(غوټۍ.بچي[توری]، مختاړی + توری، پایله)
