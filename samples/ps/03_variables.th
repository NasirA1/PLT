// ژبه: ps
// ۰۳ - متغیرونه، ثابتونه او ډولونه
//
// «متغیر» یو نوی متغیر اعلانوي. ډول یې یا د دوه ټکو وروسته لیکل کېږي، یا
// د لومړني ارزښت نه معلومېږي. «ثابت» یو داسې نوم دی چې بیا نشي بدلېدای.
// د هر متغیر ډول هېڅکله نه بدلېږي.
//
// هڅه وکړئ: د «نښې» پاڼه پرانیزئ او د هر نوم ډول او ځای وګورئ.

متغیر کال: عدد = ۲۰۲۶
متغیر ژبه = "تندر"          // ډول یې متن دی
متغیر چمتو = رښتیا          // ډول یې منطقي دی
ثابت د_اونۍ_ورځې = ۷

متغیر اونۍ: عدد            // لومړنی ارزښت نلري: له ۰ پیلېږي
اونۍ = ۵۲

کرښه چاپ(ژبه، " په "، کال، " کې پیل شوه")
کرښه چاپ("چمتو؟ "، چمتو)
کرښه چاپ(اونۍ، " اونۍ = "، اونۍ * د_اونۍ_ورځې، " ورځې")

کال = کال + ۱
کرښه چاپ("راتلونکی کال: "، کال)
