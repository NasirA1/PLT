# Advanced 01 - The data structures library
#
# import "datastructures" brings the classic structures: a stack, a queue, a linked list,
# a binary search tree and a heap, all written in Thunder itself (lib/thunder/en) and all
# generic - the element type in <angle brackets> is deduced from how each structure is used.
# The library is explained in docs/datastructures.md.

import "datastructures"

# --- a stack of strings: last in, first out --------------------------------------------
var plates: Stack<string> = new_stack()
stack_push(plates, "washed")
stack_push(plates, "dried")
stack_push(plates, "put away")
println("top of the pile: ", stack_peek(plates))
while not stack_is_empty(plates)
    println("take: ", stack_pop(plates))

# --- a queue of customers: first in, first out -----------------------------------------
var waiting: Queue<string> = new_queue()
queue_add(waiting, "Anna")
queue_add(waiting, "Bashir")
queue_add(waiting, "Caro")
println("serving ", queue_take(waiting), "; next is ", queue_peek(waiting),
    " of ", queue_size(waiting))

# --- a linked list: a chain of nodes ended by nothing ----------------------------------
var chain: LinkedList<int> = new_linked_list()
list_add_last(chain, 2)
list_add_first(chain, 1)
list_add_last(chain, 3)
println("as an array: ", list_to_array(chain), ", has 3? ", list_has(chain, 3))
var removed = list_remove_value(chain, 2)
println("after removing 2 (", removed, "): ", list_to_array(chain))

# --- a binary search tree keeps its values in order ------------------------------------
var tree: BinaryTree<int> = new_tree()
for n in [50, 30, 80, 10, 40, 70, 90]
    tree_insert(tree, n)
println("sorted: ", tree_sorted(tree))
println("size ", tree_size(tree), ", height ", tree_height(tree),
    ", smallest ", tree_smallest(tree), ", largest ", tree_largest(tree))
var gone = tree_remove(tree, 50)
println("removed the root? ", gone, "; without it: ", tree_sorted(tree))

# --- a heap always hands out the smallest first ----------------------------------------
var todo: Heap<int> = new_heap()
for priority in [7, 2, 9, 1, 5]
    heap_add(todo, priority)
while not heap_is_empty(todo)
    print(heap_take(todo), " ")
println()

# --- a set keeps every value once; an ordered set keeps them sorted too ----------------
var seen: Set<string> = new_set()
for color in ["red", "blue", "red", "green", "blue"]
    set_add(seen, color)
println("unique colors: ", set_values(seen), " (", set_size(seen), " of 5 added)")
var cold: Set<string> = new_set()
set_add(cold, "blue")
set_add(cold, "green")
println("warm only: ", set_values(set_difference(seen, cold)))

var scores: OrderedSet<int> = new_ordered_set()
for score in [70, 40, 90, 70, 40]
    ordered_set_add(scores, score)
println("distinct scores, sorted: ", ordered_set_values(scores),
    ", from ", ordered_set_smallest(scores), " to ", ordered_set_largest(scores))

# --- a deque is open at both ends; a doubly linked list walks both ways ----------------
var lane: Deque<string> = new_deque()
deque_add_last(lane, "second")
deque_add_first(lane, "first")
deque_add_last(lane, "third")
println("deque: ", deque_to_array(lane), ", from the back: ", deque_take_last(lane))

var history: DoublyLinkedList<string> = new_dlist()
dlist_add_last(history, "one")
dlist_add_last(history, "two")
dlist_add_last(history, "three")
println("forwards: ", dlist_to_array(history), ", backwards: ", dlist_to_array_reversed(history))

# --- a graph: towns, roads, and the shortest way between them --------------------------
var roads: Graph<string> = new_graph()
graph_connect(roads, "Kabul", "Ghazni")
graph_connect(roads, "Ghazni", "Kandahar")
graph_connect(roads, "Kabul", "Bamyan")
graph_connect(roads, "Bamyan", "Herat")
graph_connect(roads, "Kandahar", "Herat")
println("from Kabul, nearest first: ", graph_bfs(roads, "Kabul"))
println("shortest road to Herat: ", graph_shortest_path(roads, "Kabul", "Herat"))

# --- a trie answers prefix questions in the length of the word -------------------------
var dictionary = new_trie()
for word in ["car", "cart", "cat", "dog"]
    trie_add(dictionary, word)
println("words: ", trie_words(dictionary), "; starts with ca? ", trie_has_prefix(dictionary, "ca"),
    "; is ca a word? ", trie_has(dictionary, "ca"))
