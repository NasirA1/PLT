// ژبه: ps
// ۲۹ - اعشاري شمېرې
//
// «اعشاري» د هغو شمېرو ډول دی چې کسر برخه لري. د اعشاري شمېرې په لیکلو کې
// باید د اعشاریې له دواړو خواوو یو عدد وي: ۳٫۱۴، ۰٫۵ - هېڅکله «٫۵» نه.
//
// هر چېرې چې اعشاري شمېره غوښتل کېږي، بشپړ عدد پخپله اعشاري کېږي، نو
// ۱ + ۰٫۵ لیکلای شئ او په ۲ وېشلای شئ، نه یوازې په ۲٫۰. بله لار پرانیستې
// نه ده: اعشاري شمېره یوازې هغه وخت بشپړ عدد کېږي چې وغواړئ، په
// نیژدې کړه()، کښته کړه()، پورته کړه() یا عدد کړه().
//
// هڅه وکړئ: د «نښې» پاڼه پرانیزئ او «۷ / ۲» له «۷ / ۲٫۰» سره پرتله کړئ.

کرښه چاپ(۷ / ۲، " "، ۷ / ۲٫۰)        // ۳ (د بشپړ عدد وېش) او ۳٫۵
کرښه چاپ(۰٫۱ + ۰٫۲)                  // ۰٫۳۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۴ - لاندې یادښت وګورئ
کرښه چاپ(۱ + ۰٫۵، " "، ۲٫۰ * ۳)      // بشپړ عددونه اعشاري کېږي

// منځنۍ اندازه هغه ورځنی کار دی چې اعشاري شمېرو ته یې اړتیا لرو.
دنده منځنی(ارزښتونه: عدد[]): اعشاري
    که اوږدوالی(ارزښتونه) == ۰
        راګرځه ۰٫۰
    راګرځه اعشاري کړه(مجموعه(ارزښتونه)) / اوږدوالی(ارزښتونه)

متغیر نمرې = [۷۱، ۸۴، ۶۶، ۹۰]
کرښه چاپ("منځنۍ نمره: "، منځنی(نمرې))

// د ریاضي دننۍ دندې. زاویې په رادیانو دي.
کرښه چاپ(جذر(۲٫۰)، " "، توان(۲٫۰، ۱۰٫۰)، " "، مطلق(-۳٫۲۵))
کرښه چاپ(نیژدې کړه(۲٫۵)، " "، کښته کړه(۲٫۷)، " "، پورته کړه(۲٫۱)، " "، عدد کړه(۲٫۹))
کرښه چاپ(کمینه(۳، ۷)، " "، اعظمه(۱٫۵، ۰٫۵)، " "، پای())

// د کاروونکي له متن څخه د اعشاري شمېرې لوستل:
متغیر لیکل_شوی = "۱۹٫۹۹"
که شمېره ده(لیکل_شوی)
    متغیر بیه = اعشاري کړه(لیکل_شوی)
    کرښه چاپ("له مالیې سره: "، نیژدې کړه(بیه * ۱٫۲ * ۱۰۰)، " پیسې")

// ولې ۰٫۱ + ۰٫۲ سم ۰٫۳ نه دی: اعشاري شمېره په دوه بنسټ کې ساتل کېږي، او
// ۰٫۱ په دوه بنسټ کې سمه بڼه نه لري، لکه څنګه چې ۱/۳ په لس بنسټ کې نه لري.
// نو اعشاري شمېرې د یوې کوچنۍ زغمنې سره پرتله کړئ، نه په == سره.
متغیر توپیر = مطلق((۰٫۱ + ۰٫۲) - ۰٫۳)
کرښه چاپ("بس دی نیژدې: "، توپیر < ۰٫۰۰۰۰۰۱)
