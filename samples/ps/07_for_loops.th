// ژبه: ps
// ۰۷ - د «لپاره» تکرار
//
// «لپاره پیل، شرط، ګام» او وروسته ننوتې برخه د «ترڅو» تکرار لنډه بڼه ده.
// د تکرار متغیر یوازې د تکرار دننه شته.
//
// هڅه وکړئ: «ډیبګ» وکاروئ او ګام په ګام لاړ شئ. د VM په پاڼه کې د «ش»
// ځای بدلون وګورئ.

// فیز باز: د مرکې یوه مشهوره پوښتنه.
لپاره متغیر ش = ۱، ش <= ۱۵، ش = ش + ۱
    که ش % ۱۵ == ۰
        کرښه چاپ("فیز باز")
    کنه که ش % ۳ == ۰
        کرښه چاپ("فیز")
    کنه که ش % ۵ == ۰
        کرښه چاپ("باز")
    کنه
        کرښه چاپ(ش)

// تکرار په تکرار کې: د ضرب کوچنی جدول.
لپاره متغیر قطار = ۱، قطار <= ۴، قطار = قطار + ۱
    متغیر کرښه = ""
    لپاره متغیر ستون = ۱، ستون <= ۴، ستون = ستون + ۱
        متغیر خونه = متن کړه(قطار * ستون)
        که اوږدوالی(خونه) < ۲
            خونه = " " + خونه
        کرښه = کرښه + خونه + " "
    کرښه چاپ(کرښه)
