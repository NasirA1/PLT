# ژبه: ps
# پرمختللی ۰۶ - هغه لارې چې کارونه یو بل ته انتظار باسي
#
# څلور کلاسیک، هر یو یې په lib/thunder/ps/concurrency.th کې څو کرښې تندر - پرانیزئ
# او ولولئ یې؛ له یوه قلف او یوه حالت پرته له بل څه نه دي جوړ شوي.
#
#   خنډ        هیڅوک نه تېرېږي ترڅو ټول ورسېږي (او بیا هم کارېدای شي)
#   ډله        د یوې ډلې کارونو انتظار، پرته له نومولو یې
#   دروازه     یوه دروازه چې یو ځل پرانیستل کېږي، کله چې شمېر صفر شي
#   سیمافور    شمېرل شوې اجازه: په یوه وخت کې تر ډېره n کاره دننه
راوړه "concurrency"

متغیر راپور: متن[] = []

کرښه چاپ("۱. خنډ: درې کاره، درې پړاوونه، هیڅوک یو پړاو مخکې نه:")
متغیر کتنځی = خنډ(۳)

دنده پړاوونه(څوک: متن): دنده()
    متغیر چلول = دنده()
        تکرار پړاو په واټن(۱، ۴)
            ورزیات کړه(راپور، څوک + " پړاو " + متن کړه(پړاو) + " بشپړ کړ")
            کتنځی.انتظار_وباسه()
    راګرځه چلول

متغیر منډوکي: کار[] = []
تکرار نوم په ["احمد"، "بریالی"، "ځلاند"]
    ورزیات کړه(منډوکي، کار(پړاوونه(نوم)))
تکرار م په منډوکي
    م.راته_ودرېږه()
تکرار کرښه په راپور
    کرښه چاپ("  "، کرښه)

کرښه چاپ("۲. د انتظار ډله: پنځه پیل کړه، د پنځو واړو انتظار، پرته له نومولو یې:")
متغیر ډله_ = ډله()
متغیر بشپړ_شوي: عدد[] = []

دنده یوه_برخه(کومه: عدد): دنده()
    متغیر چلول = دنده()
        ورزیات کړه(بشپړ_شوي، کومه)
        ډله_.بشپړه_شوه()
    راګرځه چلول

ډله_.ورزیات_کړه(۵)
متغیر برخې: کار[] = []
تکرار ن په واټن(۱، ۶)
    ورزیات کړه(برخې، کار(یوه_برخه(ن)))
ډله_.انتظار_وباسه()
کرښه چاپ("  بشپړې شوې برخې: "، اوږدوالی(بشپړ_شوي)، " له ۵")

کرښه چاپ("۳. دروازه: ټول پر دروازه انتظار باسي ترڅو چمتووالی بشپړ شي:")
متغیر ور = دروازه(۱)
متغیر ترتیب: متن[] = []

دنده انتظار_باسونکی(څوک: متن): دنده()
    متغیر چلول = دنده()
        ور.انتظار_وباسه()
        ورزیات کړه(ترتیب، څوک)
    راګرځه چلول

متغیر ا۱ = کار(انتظار_باسونکی("لومړی"))
متغیر ا۲ = کار(انتظار_باسونکی("دوهم"))
کارونه.لار ورکړه()                  # پرېږده چې دروازې ته ورسېږي
ورزیات کړه(ترتیب، "چمتووالی")
ور.یو_کم_کړه()                      # پرانیزه یې
ا۱.راته_ودرېږه()
ا۲.راته_ودرېږه()
کرښه چاپ("  "، متن.یو ځای کړه(ترتیب، " -> ")، "؛ دروازه پرانیستې ده: "، ور.پرانیستې_ده())

کرښه چاپ("۴. سیمافور: دوه اجازې، نو په یوه وخت کې تر ډېره دوه کاره دننه:")
متغیر اجازې = سیمافور(۲)
متغیر لیدل_شوي: عدد[] = []
متغیر دننه = ۰
متغیر تر_ټولو_ډېر = ۰

دنده لیدنه(کومه: عدد): دنده()
    متغیر چلول = دنده()
        اجازې.اجازه_واخله()
        ورزیات کړه(لیدل_شوي، کومه)
        دننه += ۱
        که دننه > تر_ټولو_ډېر
            تر_ټولو_ډېر = دننه
        کارونه.لار ورکړه()
        دننه -= ۱
        اجازې.بېرته_ورکړه()
    راګرځه چلول

متغیر لیدونکي: کار[] = []
تکرار ن په واټن(۱، ۷)
    ورزیات کړه(لیدونکي، کار(لیدنه(ن)))
تکرار ل په لیدونکي
    ل.راته_ودرېږه()
کرښه چاپ("  "، اوږدوالی(لیدل_شوي)، " لیدونکي، په یوه وخت کې تر ټولو ډېر "، تر_ټولو_ډېر،
        " دننه؛ اجازې بیا خلاصې: "، اجازې.شته_شمېر())
