// ژبه: ps
// ۱۵ - جوړښتونه
//
// جوړښت اړوند ارزښتونه په یو نوي ډول کې سره یوځای کوي. هر ارزښت یوه «برخه»
// ده چې نوم او ډول لري. د جوړښت ارزښت د هغه د نوم په بللو جوړېږي، برخې یا په
// ترتیب ورکول کېږي یا په نوم.
//
// متن کړه() او کرښه چاپ جوړښت په یوه کرښه ښيي؛ کتنه() بشپړ بیان راګرځوي او
// وښایه() یې چاپوي.

جوړښت ټکی
    x: عدد
    y: عدد

جوړښت مستطیل
    کونج: ټکی
    سور: عدد
    لوړوالی: عدد
    نوم: متن

دنده مساحت(م: مستطیل): عدد
    راګرځه م.سور * م.لوړوالی

دنده دننه_دی(م: مستطیل, ټ: ټکی): منطقي
    راګرځه ټ.x >= م.کونج.x && ټ.x < م.کونج.x + م.سور &&
        ټ.y >= م.کونج.y && ټ.y < م.کونج.y + م.لوړوالی

متغیر مبدا = ټکی(۰, ۰)                    // برخې په ترتیب
متغیر هدف = ټکی(y: ۳, x: ۷)              // یا په نوم، په هر ترتیب
متغیر کوټه = مستطیل(کونج: مبدا, سور: ۱۰, لوړوالی: ۴, نوم: "پخلنځی")

کرښه چاپ("هدف = ", هدف)
کرښه چاپ("کوټه = ", کوټه)
کرښه چاپ("د ", کوټه.نوم, " مساحت = ", مساحت(کوټه))
کرښه چاپ("ایا هدف دننه دی؟ ", دننه_دی(کوټه, هدف))

کوټه.سور = ۵
کرښه چاپ("تر کوچني کېدو وروسته: دننه دی؟ ", دننه_دی(کوټه, هدف))
وښایه(کوټه)
