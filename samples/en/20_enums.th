# 20 - Enums: a type with a fixed set of named values
#
# An enum lists its members, one per line. Each member is a value of the new type,
# written Type.member, with a position: the first is 0, the next 1, and so on.
# Enums replace "magic" strings and numbers: a direction cannot be misspelled, and
# the compiler knows every value it may take.
#
# Try it: add a member to Direction and watch every loop below pick it up.

enum Direction
    north
    east
    south
    west

enum Weekday
    monday, tuesday, wednesday, thursday, friday, saturday, sunday

var heading = Direction.north
println(heading, " ", to_int(heading), " ", Direction.count, " members: ", Direction.values)

# A member from its position or its name, found when the program runs.
println(Direction(2), " ", Direction("west"), " ", Direction(to_int(heading) + 1))

# Turning right: the next member, wrapping round at the end.
func turn_right(d: Direction): Direction
    return Direction((to_int(d) + 1) % Direction.count)
var turns = 0
while turns < 5
    print(heading, " -> ")
    heading = turn_right(heading)
    turns += 1
println(heading)

# Members compare by position, sort, and work as map keys.
println(Weekday.monday < Weekday.friday, " ", sort([Weekday.sunday, Weekday.monday, Weekday.wednesday]))
var opposite = {Direction.north: Direction.south, Direction.south: Direction.north,
    Direction.east: Direction.west, Direction.west: Direction.east}
for d in Direction.values
    print(d, " is opposite ", opposite[d], "; ")
println()
func is_weekend(d: Weekday): bool
    return d >= Weekday.saturday
var weekend = filter(Weekday.values, is_weekend)
println("weekend: ", weekend, " (", len(weekend), " days)")

# The toolchain's own enums: Color (import graphics) and Platform (import os). Which member
# platform() answers depends on the machine, so only what is true everywhere is printed.
import os
println("the platform is one of ", Platform.values, "? ", contains(Platform.values, platform()))
