# ------------------------------------------------- مختاړې ونه (trie)
#
# د تورو ونه: هر ویی خپله لار له هر هغه ویي سره شریکوي چې همداسې پیلېږي، نو لټون او
# د مختاړي پوښتنې د ویي د اوږدوالي بیه لري، وییونه چې هر څومره وي - هغه جوړښت چې
# د بشپړونې (autocomplete) تر شا دی.

جوړښت د_مختاړې_ونې_غوټۍ
    بچي: {متن: د_مختاړې_ونې_غوټۍ}
    ویی_پای_ته_رسوي: منطقي

جوړښت مختاړې_ونه
    ریښه: د_مختاړې_ونې_غوټۍ
    شمېر: عدد

# یوه نوې، تشه مختاړې ونه.
دنده نوې_مختاړې_ونه(): مختاړې_ونه
    راګرځه مختاړې_ونه(ریښه: _نوې_مختاړې_غوټۍ()، شمېر: ۰)

دنده _نوې_مختاړې_غوټۍ(): د_مختاړې_ونې_غوټۍ
    متغیر بچي_: {متن: د_مختاړې_ونې_غوټۍ} = {}
    راګرځه د_مختاړې_ونې_غوټۍ(بچي: بچي_، ویی_پای_ته_رسوي: درواغ)

# یو ویی ورزیاتوي (دوه ځله ورزیاتول یې یو ساتي).
دنده مختاړې_ونې_ته_ورزیات_کړه(ونه_: مختاړې_ونه، ویی: متن)
    متغیر غوټۍ = ونه_.ریښه
    لپاره متغیر ش = ۰، ش < اوږدوالی(ویی)، ش = ش + ۱
        متغیر توری = د متن برخه(ویی، ش، ش + ۱)
        که نه لري(غوټۍ.بچي، توری)
            غوټۍ.بچي[توری] = _نوې_مختاړې_غوټۍ()
        غوټۍ = غوټۍ.بچي[توری]
    که نه غوټۍ.ویی_پای_ته_رسوي
        غوټۍ.ویی_پای_ته_رسوي = رښتیا
        ونه_.شمېر = ونه_.شمېر + ۱

# رښتیا که همدا ویی ورزیات شوی و.
دنده مختاړې_ونه_لري(ونه_: مختاړې_ونه، ویی: متن): منطقي
    متغیر غوټۍ = _مختاړې_ونه_وګرځه(ونه_، ویی)
    راګرځه غوټۍ != هېڅ او غوټۍ.ویی_پای_ته_رسوي

# رښتیا که کوم ورزیات شوی ویی په دې مختاړي پیلېږي ("" د هر څه مختاړی دی).
دنده مختاړې_ونه_مختاړی_لري(ونه_: مختاړې_ونه، مختاړی: متن): منطقي
    راګرځه _مختاړې_ونه_وګرځه(ونه_، مختاړی) != هېڅ

# ویی توری په توري تعقیبوي؛ هېڅ کله چې لار نه وي.
دنده _مختاړې_ونه_وګرځه(ونه_: مختاړې_ونه، ویی: متن): د_مختاړې_ونې_غوټۍ
    متغیر غوټۍ = ونه_.ریښه
    لپاره متغیر ش = ۰، ش < اوږدوالی(ویی)، ش = ش + ۱
        متغیر توری = د متن برخه(ویی، ش، ش + ۱)
        که نه لري(غوټۍ.بچي، توری)
            راګرځه هېڅ
        غوټۍ = غوټۍ.بچي[توری]
