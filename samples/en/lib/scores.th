# lib/scores.th - the code that 27_testing.th tests
#
# A library file: it only declares things (a module), so a program can import it - and so can
# a test file. Production code and its tests live in files of their own.

module scores
    # The largest of a list of numbers (the list must not be empty).
    func largest(values: int[]): int
        var best = values[0]
        for value in values
            if value > best
                best = value
        return best

    # True if the word reads the same backwards.
    func is_palindrome(word: string): bool
        return string.reverse(word) == word

    # Where the time of day comes from: the real clock in a program, a stand-in in a test.
    interface Clock
        func hour(): int

    # A greeting for the time of day the clock tells.
    func greeting(clock: Clock): string
        if clock.hour() < 12
            return "Good morning"
        return "Good afternoon"

    # A running total.
    struct Tally
        _total: int

        func add(amount: int)
            _total += amount

        func total(): int
            return _total
