# ژبه: ps
# د یوې لړۍ عددونه. دا فایل بل فایل راوړي، نو پروژه یو کوچنی ځنځیر لري:
# main.th -> lib/statistics.th -> lib/shapes.th. فایل د هغه فایل تر څنګ لټول کېږي چې
# دی راوړي، نو له دې ځایه یې ورور "shapes" دی، نه "lib/shapes".

راوړه "shapes"

ټولګی احصایه
    دنده ټول_مساحت(کوټې: هندسه.څلور_اړخیز[]): عدد
        متغیر ټولټال = ۰
        تکرار خونه په کوټې
            ټولټال += هندسه.مساحت(خونه)
        راګرځه ټولټال

    دنده تر_ټولو_لوی(عددونه: عدد[]): عدد
        متغیر غوره = عددونه[۰]
        تکرار ارزښت په عددونه
            که ارزښت > غوره
                غوره = ارزښت
        راګرځه غوره

    دنده منځنی(عددونه: عدد[]): اعشاري
        راګرځه اعشاري کړه(مجموعه(عددونه)) / اعشاري کړه(اوږدوالی(عددونه))
