# ژبه: ps
# lib/scores.th - هغه کوډ چې 27_testing.th یې ازمویي
#
# یو کتابتون فایل: یوازې شیان اعلانوي (یو ټولګی)، نو یو پروګرام یې راوړلای شي - او د ازموینې
# فایل هم. اصلي کوډ او ازموینې یې په خپلو بېلو فایلونو کې اوسي.

ټولګی نمرې
    # د شمېرو د لړۍ تر ټولو لوی (لړۍ باید تشه نه وي).
    دنده تر_ټولو_لوی(ارزښتونه: عدد[]): عدد
        متغیر غوره = ارزښتونه[۰]
        تکرار ارزښت په ارزښتونه
            که ارزښت > غوره
                غوره = ارزښت
        راګرځه غوره

    # رښتیا که کلمه له شا هم همداسې ولوستل شي.
    دنده پالیندروم_دی(کلمه: متن): منطقي
        راګرځه متن.سرچپه کړه(کلمه) == کلمه

    # د ورځې وخت له کومه راځي: په پروګرام کې رښتینی ساعت، په ازموینه کې یو ځای نیوونکی.
    برسېر ساعت
        دنده ساعت_یې(): عدد

    # د هغه وخت ستاینه چې ساعت یې وايي.
    دنده ستاینه(ګړۍ: ساعت): متن
        که ګړۍ.ساعت_یې() < ۱۲
            راګرځه "سهار پخیر"
        راګرځه "غرمه پخیر"

    # یوه روانه مجموعه.
    جوړښت شمېرنه
        _ټول: عدد

        دنده ورزیات_کړه(اندازه: عدد)
            _ټول += اندازه

        دنده ټول_یې(): عدد
            راګرځه _ټول
