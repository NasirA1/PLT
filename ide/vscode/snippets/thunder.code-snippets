{
  "func.en": {
    "scope": "thunder",
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:n}: int): int",
      "\treturn ${0:$2}"
    ],
    "description": "Function"
  },
  "struct.en": {
    "scope": "thunder",
    "prefix": "struct",
    "body": [
      "struct ${1:Name}",
      "\t${2:field}: int",
      "\t$0"
    ],
    "description": "Structure"
  },
  "if.en": {
    "scope": "thunder",
    "prefix": "if",
    "body": [
      "if ${1:condition}",
      "\t${0:println(\"yes\")}"
    ],
    "description": "If"
  },
  "ifelse.en": {
    "scope": "thunder",
    "prefix": "ifelse",
    "body": [
      "if ${1:condition}",
      "\t${2:pass}",
      "else",
      "\t${0:pass}"
    ],
    "description": "If / else"
  },
  "while.en": {
    "scope": "thunder",
    "prefix": "while",
    "body": [
      "while ${1:condition}",
      "\t${0:pass}"
    ],
    "description": "While loop"
  },
  "for.en": {
    "scope": "thunder",
    "prefix": "for",
    "body": [
      "for var ${1:i} = 0, ${1:i} < ${2:10}, ${1:i} = ${1:i} + 1",
      "\t${0:println($1)}"
    ],
    "description": "Counting for loop"
  },
  "forin.en": {
    "scope": "thunder",
    "prefix": "forin",
    "body": [
      "for ${1:item} in ${2:items}",
      "\t${0:println($1)}"
    ],
    "description": "For each"
  },
  "var.en": {
    "scope": "thunder",
    "prefix": "var",
    "body": [
      "var ${1:name} = ${0:0}"
    ],
    "description": "Variable"
  },
  "const.en": {
    "scope": "thunder",
    "prefix": "const",
    "body": [
      "const ${1:NAME} = ${0:0}"
    ],
    "description": "Constant"
  },
  "import.en": {
    "scope": "thunder",
    "prefix": "import",
    "body": [
      "import \"${1:module}\""
    ],
    "description": "Import a module"
  },
  "importnative.en": {
    "scope": "thunder",
    "prefix": "importnative",
    "body": [
      "import native \"${1:library}\"",
      "native func ${2:name}(${3:n}: int): int"
    ],
    "description": "Import a C++ library"
  },
  "main.en": {
    "scope": "thunder",
    "prefix": "main",
    "body": [
      "func main()",
      "\t${0:println(\"Hello, Thunder\")}",
      "",
      "main()"
    ],
    "description": "main function"
  },
  "graphics.en": {
    "scope": "thunder",
    "prefix": "graphics",
    "body": [
      "import graphics",
      "",
      "while frame()",
      "\tclear(\"black\")",
      "\t${0:circle(50, 50, 10, \"white\")}"
    ],
    "description": "Graphics program"
  },
