// ژبه: ps
// ۲۰ - له متن سره کار
//
// دننۍ دندې متن ټوټې کوي او بیا یې سره یو ځای کوي. ځایونه توري شمېري
// (پښتو توري هم) او له ۰ پیلېږي. یو واټن له پیل څخه تر پای پورې پیل پکې
// شامل دی خو پای نه: د متن برخه("تندر"، ۰، ۲) "تن" دی.
//
// هڅه وکړئ: هغه جلا کوونکی بدل کړئ چې وېشه ته ورکول کېږي، یا د «ریکارډ» متن.

متغیر ریکارډ = "  ملالۍ میوندوال، ۱۸۶۱، میوند  "
متغیر پاک = پاک کړه(ریکارډ)
کرښه چاپ("["، پاک، "]")

متغیر برخې = وېشه(پاک، "، ")
کرښه چاپ(برخې، " "، اوږدوالی(برخې)، " برخې لري")
متغیر نوم = برخې[۰]
کرښه چاپ("لوی توري: "، لوی توري کړه("Thunder")، " / کوچنی توري: "، کوچنی توري کړه("THUNDER"))
کرښه چاپ("لومړی نوم: "، د متن برخه(نوم، ۰، ځای یې(نوم، " ")))
کرښه چاپ("په ملالۍ پیلېږي؟ "، پیلېږي په(نوم، "ملالۍ")، "، په وال پایېږي؟ "، پایېږي په(نوم، "وال"))
کرښه چاپ("میوند یادوي؟ "، شامل دی(پاک، "میوند")، "، کابل؟ "، شامل دی(پاک، "کابل"))
کرښه چاپ(بدل کړه(پاک، "، "، " | "))
کرښه چاپ(یو ځای کړه(سرچپه کړه(برخې)، " ← ")، " "، سرچپه کړه("ګل"))
کرښه چاپ(تکرار کړه("=-"، ۱۲))

که عدد دی(برخې[۱])
    کرښه چاپ("دوه سوه کاله وروسته: "، عدد کړه(برخې[۱]) + ۲۰۰)

// هر توری یوه شمېره لري (د یونیکوډ کوډ یې).
کرښه چاپ(د توري کوډ("A")، " "، د توري کوډ("ا")، " "، د کوډ توری(د توري کوډ("ا") + ۱))

// د قیصر رمز هر انګلیسي توری د الفبا په اوږدو کې درې ځایه مخکې وړي.
دنده قیصر(متن_یې: متن، ګام: عدد): متن
    متغیر پایله = ""
    لپاره متغیر ش = ۰، ش < اوږدوالی(متن_یې)، ش = ش + ۱
        متغیر کوډ = د توري کوډ(متن_یې[ش])
        که کوډ >= د توري کوډ("a") او کوډ <= د توري کوډ("z")
            کوډ = (کوډ - د توري کوډ("a") + ګام + ۲۶) % ۲۶ + د توري کوډ("a")
        پایله = پایله + د کوډ توری(کوډ)
    راګرځه پایله

متغیر راز = قیصر("hello world"، ۳)
کرښه چاپ(راز، " ← "، قیصر(راز، -۳))
