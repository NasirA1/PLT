// ژبه: ps
// ۲۷ - د ژوند لوبه (یو حجروي ماشین)
//
// د حجرو یوه جال، هره حجره یا ژوندۍ ده (۱) یا مړه (۰). په هر نسل کې، هغه
// مړه حجره چې دقیقاً درې ژوندي ګاونډیان ولري ژوندۍ کېږي، هغه ژوندۍ حجره چې
// دوه یا درې ولري ژوندۍ پاتې کېږي، او نورې ټولې مري. له دې ساده قاعدو
// الوتونکي، ټوپ وهونکي او وده کوونکي شکلونه جوړېږي (جان کانوې، ۱۹۷۰).
//
// جال شاوخوا د مړو حجرو یو اضافي قطار او ستون لري، نو هره حجره اته ګاونډیان
// لري چې جمع یې کړو - حتی په څنډو کې.
//
// هڅه وکړئ: «چلول» کښېکښئ. تشه ودروي، Enter نوې تصادفي نړۍ جوړوي، او کلیک
// (یا کښلول) حجرې ژوندۍ کوي.

راوړه ګرافیک

ثابت اندازه = ۱۵            // د هرې حجرې پکسلونه
ثابت ستونونه = ۳۲
ثابت قطارونه = ۲۰
ټاټ(ستونونه * اندازه، قطارونه * اندازه)
د چوکاټ چټکتیا(۱۰)

دنده تشه_نړۍ(): عدد[][]
    راګرځه لړۍ(قطارونه + ۲، لړۍ(ستونونه + ۲، ۰))

دنده تصادفي_نړۍ(): عدد[][]
    متغیر نړۍ = تشه_نړۍ()
    لپاره متغیر قطار = ۱، قطار <= قطارونه، قطار = قطار + ۱
        لپاره متغیر ستون = ۱، ستون <= ستونونه، ستون = ستون + ۱
            که تصادفي عدد(۱، ۱۰۰) <= ۳۰
                نړۍ[قطار][ستون] = ۱
    راګرځه نړۍ

دنده بل_نسل(نړۍ: عدد[][]): عدد[][]
    متغیر بله = تشه_نړۍ()
    لپاره متغیر قطار = ۱، قطار <= قطارونه، قطار = قطار + ۱
        متغیر پورته_قطار = نړۍ[قطار - ۱]
        متغیر دا_قطار = نړۍ[قطار]
        متغیر ښکته_قطار = نړۍ[قطار + ۱]
        لپاره متغیر ستون = ۱، ستون <= ستونونه، ستون = ستون + ۱
            متغیر ن = پورته_قطار[ستون - ۱] + پورته_قطار[ستون] + پورته_قطار[ستون + ۱] + دا_قطار[ستون - ۱] + دا_قطار[ستون + ۱] + ښکته_قطار[ستون - ۱] + ښکته_قطار[ستون] + ښکته_قطار[ستون + ۱]
            که ن == ۳ یا (ن == ۲ او دا_قطار[ستون] == ۱)
                بله[قطار][ستون] = ۱
    راګرځه بله

متغیر نړۍ = تصادفي_نړۍ()
متغیر نسل = ۰
متغیر درول_شوې = دروغ
ترڅو رښتیا
    متغیر تڼۍ = کښېکښل شوې تڼۍ()
    که تڼۍ == "تشه"
        درول_شوې = نه درول_شوې
    که تڼۍ == "ننوتل"
        نړۍ = تصادفي_نړۍ()
        نسل = ۰
    که موږک کښېکښل شوی()
        متغیر ستون = د موږک افقي ځای() / اندازه + ۱
        متغیر قطار = د موږک عمودي ځای() / اندازه + ۱
        که قطار >= ۱ او قطار <= قطارونه او ستون >= ۱ او ستون <= ستونونه
            نړۍ[قطار][ستون] = ۱

    ټاټ پاک کړه("تور")
    متغیر وګړي = ۰
    لپاره متغیر قطار = ۱، قطار <= قطارونه، قطار = قطار + ۱
        لپاره متغیر ستون = ۱، ستون <= ستونونه، ستون = ستون + ۱
            که نړۍ[قطار][ستون] == ۱
                مستطیل((ستون - ۱) * اندازه، (قطار - ۱) * اندازه، اندازه - ۱، اندازه - ۱، رنګ(۰، ۲۵۵، ۰))
                وګړي = وګړي + ۱
    لیکنه(۶، ۴، "نسل " + متن کړه(نسل) + "، " + متن کړه(وګړي) + " ژوندۍ"، "سپین")
    چوکاټ()
    که نه درول_شوې
        نړۍ = بل_نسل(نړۍ)
        نسل = نسل + ۱
