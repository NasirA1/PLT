# ژبه: ps
# concurrency.th (lib/thunder/ps) - څو کاره په یوه وخت کې (docs/ps/concurrency.md)
#
# راوړه "concurrency" ولیکئ او ټول لاندې شیان ستاسې دي (thunderc دا فایل د ځان تر څنګ په
# lib/thunder کې مومي، یا یوه پوښۍ د --module-path سره ورکړئ). دلته هېڅ بهرنی نشته: دا
# ساده تندر دی، د لوستلو لپاره لیکل شوی - دا فایل پرانیزئ او وګورئ چې سیمافور، خنډ، کانال
# او د انتظار ډله رښتیا څنګه له هغو دوو بنسټیزو شیانو جوړېږي چې مجازي ماشین یې باید ورکړي،
# ځکه چې باید نه‌وېشل‌کېدونکي وي: قلف او حالت (ټولګی کارونه).
#
#     کار              ستاسې د پروګرام یوه برخه چې د نورو تر څنګ ځي: کار(دنده() ...)
#     قلف / ساتونکی    یوازې یو کار دننه: «_قلف.قلف_کړه() سره» د بلاک په پای کې خلاصوي
#     حالت             د قلف دننه انتظار، ترڅو څه رښتیا شي (مانیټر)
#     سیمافور          شمېرل شوې اجازه: په یوه وخت کې تر ډېره n کاره دننه
#     خنډ              هیڅوک نه تېرېږي ترڅو ټول ګډونوال ورسېږي
#     کانال<ت>         له یوه کاره بل ته د ارزښتونو لېږل، د لیکې سره په منځ کې
#     ډله              د یوې ډلې کارونو د پای انتظار
#     دروازه           یوه دروازه چې یو ځل پرانیستل کېږي، کله چې شمېر صفر شي
#     لوست_لیک_قلف     ډېر لوستونکي یوځای، یا یو لیکونکی یوازې
#     ټایمر            ټایمر.وروسته(ملي_ثانیې، چار)، ټایمر.هر_ځل(...)، ټایمر.لغوه_کړه()
#
# کارونه هرڅه شریکوي: عام متغیرونه، او هر هغه متغیر چې د دوی یوه تړلې دنده یې نیسي. پر یوه
# مزي وار په وار ځي او هرو ۱۰۰ لارښوونو وروسته بدلېږي (thundervm --slice n)، نو دوه کاره
# هېڅکله په یوه شېبه کې نه ځي - خو بدلون د «شمېر += ۱» د درېیو لارښوونو *تر منځ* هم کېدای
# شي، او همدا لامل دی چې یو شریک شمېرګر لا هم قلف ته اړتیا لري. وارۍ په هر ځل کې یو شان
# دي، نو د پروګرام وتنه ازمویل کېږي؛ --schedule-seed n یې بدلوي، خو بیا هم په تکرارېدونکې
# توګه، چې د پروګرام ننګونې راوباسي.
#
# پروګرام هغه وخت پای ته رسېږي چې ټول کارونه پای ته ورسېږي. که ټول یو بل ته انتظار پاتې
# شي، مجازي ماشین وايي او دروي یې: «بند کرښه: ... (R037)».

# ------------------------------------------------- قلف (یوازې یو کار دننه)
#
# هغه ساتونکی چې قلف یې ورکوي. «سره» د بلاک په پای کې وتړه() بلي، په هر ډول چې بلاک پای
# ته ورسېږي - نو د یوې حساسې برخې په منځ کې راګرځه یا ودرېږه نور قلف نیولی نه پرېږدي.
جوړښت ساتونکی
    _قلف: عدد
    _نیولی: منطقي

    # د قلف.قلف_کړه() له خوا جوړېږي؛ کله چې ساتونکی راښکاره شي، قلف لا نیول شوی دی.
    ساتونکی(قلف_یې: عدد)
        _قلف = قلف_یې
        _نیولی = رښتیا

    # قلف بېرته ورکوي (یو ځل، که څو ځله هم وبلل شي).
    دنده وتړه()
        که _نیولی
            _نیولی = درواغ
            کارونه.خلاص کړه(_قلف)

# یو قلف په یوه وخت کې یوازې یو کار نیولای شي. هر بل کار چې یې غواړي انتظار باسي، او په
# هغه ترتیب خدمت کېږي چې غوښتی یې دی.
#
#     متغیر ق = قلف()
#     ق.قلف_کړه() سره
#         شمېر += ۱
جوړښت قلف
    _شمېره: عدد

    # یو نوی، خلاص قلف.
    قلف()
        _شمېره = کارونه.نوی قلف()

    # قلف نیسي (که بل کار یې لري انتظار یې باسي) او هغه ساتونکی راګرځوي چې بېرته یې ورکوي:
    # «ق.قلف_کړه() سره» ولیکئ.
    دنده قلف_کړه(): ساتونکی
        کارونه.قلف کړه(_شمېره)
        راګرځه ساتونکی(_شمېره)

    # قلف یوازې هغه وخت نیسي چې خلاص وي: رښتیا که ونیول شو، درواغ که نه.
    دنده هڅه_وکړه(): منطقي
        راګرځه کارونه.هڅه یې وکړه(_شمېره)

    # قلف په لاس بېرته ورکوي (یوازې هغه کار چې لري یې). «ق.قلف_کړه() سره» غوره ده.
    دنده خلاص_کړه()
        کارونه.خلاص کړه(_شمېره)

    # هغه شمېره چې مجازي ماشین دا قلف پرې پېژني (ټولګی کارونه له شمېرو سره کار کوي).
    دنده نښه(): عدد
        راګرځه _شمېره

# ------------------------------------------------- حالت (مانیټر)
#
# هغه څه چې یو کار یې د قلف دننه انتظار باسي: «لیکه تشه نه ده»، «ټول لوبغاړي چمتو دي».
# انتظار_وباسه() د انتظار پر مهال قلف بېرته ورکوي او تر تلو مخکې یې بیا نیسي، نو هغه حالت
# چې انتظار یې ایستلی لاندې نه بدلېږي. تل په یوه تکرار کې انتظار وباسئ - کېدای شي بل کار
# مخکې راویښ شوی او حالت یې بېرته بدل کړی وي:
#
#     ق.قلف_کړه() سره
#         ترڅو اوږدوالی(لیکه) == ۰
#             تشه_نه_ده.انتظار_وباسه()
#         متغیر توکی = له ځایه لیرې کړه(لیکه، ۰)
جوړښت حالت
    _شمېره: عدد
    _قلف: قلف

    # یو حالت یوه قلف پورې تړلی دی: هغه قلف چې کار یې باید ولري ترڅو انتظار وباسي.
    حالت(قلف_یې: قلف)
        _شمېره = کارونه.نوی حالت()
        _قلف = قلف_یې

    # قلف خلاصوي، د خبر انتظار باسي، بیا قلف بېرته نیسي.
    دنده انتظار_وباسه()
        کارونه.انتظار وباسه(_شمېره، _قلف.نښه())

    # هغه کار راویښوي چې تر ټولو ډېر یې انتظار ایستلی (که هیڅوک نه وي، څه نه کېږي).
    دنده خبر_ورکړه()
        کارونه.خبر ورکړه(_شمېره)

    # هر هغه کار راویښوي چې پر حالت انتظار باسي.
    دنده ټولو_ته_خبر_ورکړه()
        کارونه.ټولو ته خبر ورکړه(_شمېره)

# ------------------------------------------------- کار
#
# د پروګرام یوه برخه چې د نورو تر څنګ ځي. جوړول یې پیلول یې دي:
#
#     متغیر کارګر = کار(وییونه_وشمېره)
#     متغیر بل = کار(دنده() کرښه چاپ("سلام له "، کارونه.نوم(کارونه.اوسنی())))
#     کارګر.انتظار_یې_وکړه()
#
# چار هیڅ دلیل نه اخلي - یوه تړلې دنده هرڅه له ځانه سره وړي:
#
#     تکرار نوم په نومونه
#         متغیر زما = نوم                  # په هر ځل کې یو متغیر، د تړلې دندې لپاره
#         ورزیات کړه(کارګران، کار(دنده() سلام(زما)))
جوړښت کار
    _شمېره: عدد

    # چار د خپل کار په توګه پیلوي؛ هغه وخت ځي چې دا کار خپله وارۍ پرېږدي.
    کار(چار: دنده())
        _شمېره = کارونه.پیل کړه(چار)

    # انتظار باسي ترڅو دا کار پای ته ورسېږي؛ نور کارونه په دې منځ کې ځي.
    دنده انتظار_یې_وکړه()
        کارونه.انتظار یې وکړه(_شمېره)

    # رښتیا، کله چې پای ته ورسېږي.
    دنده پای_ته_رسېدلی(): منطقي
        راګرځه کارونه.پای ته رسېدلی(_شمېره)

    # نوم یې: «کار#۲»، «کار#۳» ... («اصلي» هغه کار دی چې پروګرام پکې پیلېږي).
    دنده نوم(): متن
        راګرځه کارونه.نوم(_شمېره)

    # هغه شمېره چې مجازي ماشین پرې پېژني یې.
    دنده نښه(): عدد
        راګرځه _شمېره

# ------------------------------------------------- سیمافور
#
# شمېرل شوې اجازه: په یوه وخت کې تر ډېره «اجازې» کاره دننه کېدای شي. د یوې اجازې سره قلف
# دی؛ د n سره دا محدودوي چې څو کاره یوه سرچینه یوځای کاروي.
جوړښت سیمافور
    _اجازې: عدد
    _قلف: قلف
    _خلاص: حالت

    # یو سیمافور چې دومره اجازې ویشلای شي.
    سیمافور(اجازې: عدد)
        _اجازې = اجازې
        _قلف = قلف()
        _خلاص = حالت(_قلف)

    # یوه اجازه اخلي، او ترڅو هیڅ یوه خلاصه نه وي انتظار باسي.
    دنده واخله()
        _قلف.قلف_کړه() سره
            ترڅو _اجازې == ۰
                _خلاص.انتظار_وباسه()
            _اجازې -= ۱

    # یوه اجازه بېرته ورکوي (هر کار یې کولای شي: همدا یې له قلفه ډېر کوي).
    دنده بېرته_ورکړه()
        _قلف.قلف_کړه() سره
            _اجازې += ۱
            _خلاص.خبر_ورکړه()

    # یوه اجازه اخلي که خلاصه وي؛ کنه سمدلاسه درواغ.
    دنده هڅه_وکړه(): منطقي
        متغیر واخیستل = درواغ
        _قلف.قلف_کړه() سره
            که _اجازې > ۰
                _اجازې -= ۱
                واخیستل = رښتیا
        راګرځه واخیستل

    # څومره اجازې خلاصې دي.
    دنده شته_شمېر(): عدد
        راګرځه _اجازې

# ------------------------------------------------- خنډ
#
# د کتنې ځای: هیڅوک نه تېرېږي ترڅو «ګډونوال» کاره ورسېږي، او بیا ټول یوځای مخته ځي. بیا هم
# کارېدای شي (د چکر شمېره د دې چکر انتظار باسونکي له راتلونکي بېلوي، نو چټک کار له ورو
# څخه مخته نشي تلای).
جوړښت خنډ
    _ګډونوال: عدد
    _انتظار: عدد
    _چکر: عدد
    _قلف: قلف
    _ټول_راغلل: حالت

    # یو خنډ چې د دومره کارونو انتظار باسي.
    خنډ(ګډونوال: عدد)
        _ګډونوال = ګډونوال
        _انتظار = ۰
        _چکر = ۰
        _قلف = قلف()
        _ټول_راغلل = حالت(_قلف)

    # انتظار باسي ترڅو هر ګډونوال دلته ورسېږي.
    دنده انتظار_وکړه()
        _قلف.قلف_کړه() سره
            متغیر زما_چکر = _چکر
            _انتظار += ۱
            که _انتظار == _ګډونوال
                _انتظار = ۰
                _چکر += ۱
                _ټول_راغلل.ټولو_ته_خبر_ورکړه()
            کنه
                ترڅو زما_چکر == _چکر
                    _ټول_راغلل.انتظار_وباسه()

    # د څومره کارونو انتظار باسي.
    دنده ګډونوال(): عدد
        راګرځه _ګډونوال

# ------------------------------------------------- کانال (اړیکه)
#
# د کارونو تر منځ یوه نلۍ چې د «ظرفیت» ارزښتونو ځای لري. ولېږه هغه وخت انتظار باسي چې ډکه
# وي، واخله هغه وخت چې تشه وي، نو چټک جوړوونکی له ورو کاروونکي مخته نشي تښتېدای. د ۰
# ظرفیت یو لاس په لاس دی: لېږونکی انتظار باسي ترڅو یو اخیستونکی ارزښت له لاسه واخلي.
#
#     متغیر چارې: کانال<متن> = کانال(۴)
#     ... چارې.ولېږه("یو") ...
#     ترڅو چارې.بل_شته()
#         پرې_کار_وکړه(چارې.واخله())
#
# وتړه() اخیستونکو ته وايي چې نور څه نه راځي: بل_شته() بیا درواغ وايي کله چې وروستی ارزښت
# واخیستل شو. له هغه کانال څخه اخیستل چې تړلی او تش وي، یا په تړلي کې لېږل، د پروګرام
# تېروتنه ده او پروګرام دروي.
جوړښت کانال<ت>
    _توکي: ت[]
    _ظرفیت: عدد
    _تړلی: منطقي
    _لېږل_شوي: عدد
    _اخیستل_شوي: عدد
    _ځانګړي: عدد
    _قلف: قلف
    _تشه_نه_ده: حالت
    _ډکه_نه_ده: حالت

    # یو کانال چې د «ظرفیت» ارزښتونو ځای لري (۰: لاس په لاس، هیڅ ځای نه).
    کانال(ظرفیت: عدد)
        _توکي = []
        _ظرفیت = ظرفیت
        _تړلی = درواغ
        _لېږل_شوي = ۰
        _اخیستل_شوي = ۰
        _ځانګړي = ۰
        _قلف = قلف()
        _تشه_نه_ده = حالت(_قلف)
        _ډکه_نه_ده = حالت(_قلف)

    # یو ارزښت لېږي، او ترڅو کانال ډک وي انتظار باسي.
    دنده ولېږه(ارزښت: ت)
        _قلف.قلف_کړه() سره
            که _تړلی
                ناکام شه("تړلی کانال نور ارزښتونه نه مني")
            ترڅو _ظرفیت > ۰ او اوږدوالی(_توکي) >= _ظرفیت
                _ډکه_نه_ده.انتظار_وباسه()
            متغیر نمره = _لېږل_شوي
            _لېږل_شوي += ۱
            ورزیات کړه(_توکي، ارزښت)
            _تشه_نه_ده.ټولو_ته_خبر_ورکړه()
            که _ظرفیت == ۰
                # لاس په لاس: انتظار ترڅو همدا ارزښت واخیستل شي.
                ترڅو _اخیستل_شوي <= نمره او نه _تړلی
                    _ډکه_نه_ده.انتظار_وباسه()

    # بل ارزښت اخلي، او ترڅو کانال تش وي انتظار باسي.
    دنده واخله(): ت
        _قلف.قلف_کړه() سره
            ترڅو اوږدوالی(_توکي) == ۰ او نه _تړلی
                _تشه_نه_ده.انتظار_وباسه()
            که اوږدوالی(_توکي) == ۰
                ناکام شه("تړلی او تش کانال نور څه نه لري")
            متغیر ارزښت = له ځایه لیرې کړه(_توکي، ۰)
            _اخیستل_شوي += ۱
            که _ځانګړي > ۰
                _ځانګړي -= ۱
            _ډکه_نه_ده.ټولو_ته_خبر_ورکړه()
            راګرځه ارزښت

    # انتظار باسي ترڅو د دې کار لپاره یو ارزښت وي، یا ترڅو کانال تړلی او تش شي: رښتیا که
    # واخله() سمدلاسه ځواب ورکړي. هغه ارزښت چې یې ولید د دې کار لپاره ساتل کېږي، نو دوه
    # اخیستونکي د «ترڅو بل_شته()» په تکرار کې د وروستي پر سر نه جنګېږي.
    دنده بل_شته(): منطقي
        _قلف.قلف_کړه() سره
            ترڅو اوږدوالی(_توکي) - _ځانګړي == ۰ او نه _تړلی
                _تشه_نه_ده.انتظار_وباسه()
            که اوږدوالی(_توکي) - _ځانګړي == ۰
                راګرځه درواغ
            _ځانګړي += ۱
            راګرځه رښتیا

    # وايي چې نور څه نه لېږل کېږي. انتظار باسونکي اخیستونکي راویښېږي.
    دنده وتړه()
        _قلف.قلف_کړه() سره
            _تړلی = رښتیا
            _تشه_نه_ده.ټولو_ته_خبر_ورکړه()
            _ډکه_نه_ده.ټولو_ته_خبر_ورکړه()

    # رښتیا، کله چې وتړه() وبلل شوه.
    دنده تړلی_دی(): منطقي
        راګرځه _تړلی

    # څومره ارزښتونه په کانال کې انتظار باسي.
    دنده شمېر(): عدد
        راګرځه اوږدوالی(_توکي)

    # د څومره ارزښتونو ځای لري (۰: لاس په لاس).
    دنده ظرفیت(): عدد
        راګرځه _ظرفیت

# ------------------------------------------------- ډله (د انتظار ډله)
#
# د یوې ډلې کارونو انتظار، پرته له دې چې یو یو ونومول شي: ورزیات_کړه(n) تر پیل مخکې،
# بشپړه_شوه() کله چې هر یو پای ته ورسېږي، انتظار_وکړه() ترڅو شمېر بېرته صفر شي.
جوړښت ډله
    _شمېر: عدد
    _قلف: قلف
    _صفر: حالت

    # یوه ډله چې لا هیڅ څوک پکې نه دی.
    ډله()
        _شمېر = ۰
        _قلف = قلف()
        _صفر = حالت(_قلف)

    # وايي چې نور n کاره په لار دي.
    دنده ورزیات_کړه(ن: عدد)
        _قلف.قلف_کړه() سره
            _شمېر += ن

    # وايي چې یو یې بشپړ شو.
    دنده بشپړه_شوه()
        _قلف.قلف_کړه() سره
            _شمېر -= ۱
            که _شمېر <= ۰
                _صفر.ټولو_ته_خبر_ورکړه()

    # انتظار باسي ترڅو هر کار بشپړه_شوه() ووايي.
    دنده انتظار_وکړه()
        _قلف.قلف_کړه() سره
            ترڅو _شمېر > ۰
                _صفر.انتظار_وباسه()

    # څومره یې لا پاتې دي.
    دنده شمېر(): عدد
        راګرځه _شمېر

# ------------------------------------------------- دروازه
#
# یوه دروازه چې یو ځل پرانیستل کېږي او پرانیستې پاتې کېږي: هر انتظار باسونکی کار مخته ځي
# کله چې شمېر صفر شي. خنډ بیا کارېدای شي؛ دروازه نه - او همدا یې د «چمتووالی بشپړ شو» یا
# «ځه!» لپاره سمه کوي.
جوړښت دروازه
    _شمېر: عدد
    _قلف: قلف
    _پرانیستل: حالت

    # یوه دروازه چې د «شمېر» ځله یو_کم_کړه() وروسته پرانیستل کېږي.
    دروازه(شمېر: عدد)
        _شمېر = شمېر
        _قلف = قلف()
        _پرانیستل = حالت(_قلف)

    # د پرانیستلو په لور یو ګام (کله چې پرانیستې وي، څه نه کېږي).
    دنده یو_کم_کړه()
        _قلف.قلف_کړه() سره
            که _شمېر > ۰
                _شمېر -= ۱
                که _شمېر == ۰
                    _پرانیستل.ټولو_ته_خبر_ورکړه()

    # انتظار باسي ترڅو دروازه پرانیستل شي.
    دنده انتظار_وکړه()
        _قلف.قلف_کړه() سره
            ترڅو _شمېر > ۰
                _پرانیستل.انتظار_وباسه()

    # څو ګامه پاتې دي.
    دنده شمېر(): عدد
        راګرځه _شمېر

    # رښتیا، کله چې دروازه پرانیستې وي.
    دنده پرانیستې_ده(): منطقي
        راګرځه _شمېر == ۰

# ------------------------------------------------- لوست_لیک_قلف
#
# یوځای لوستل بې خطره دي؛ لیکل نه دي. هر شمېر لوستونکي دا قلف په یوه وخت کې نیولای شي، خو
# لیکونکی یې یوازې نیسي. هلته یې وکاروئ چې یو ارزښت تر بدلولو ډېر لوستل کېږي.
جوړښت لوست_لیک_قلف
    _لوستونکي: عدد
    _لیکل_کېږي: منطقي
    _قلف: قلف
    _خلاص: حالت

    # یو نوی، خلاص د لوست او لیک قلف.
    لوست_لیک_قلف()
        _لوستونکي = ۰
        _لیکل_کېږي = درواغ
        _قلف = قلف()
        _خلاص = حالت(_قلف)

    # د لوستلو لپاره قلف نیسي، او ترڅو یو لیکونکی یې لري انتظار باسي.
    دنده د_لوست_قلف()
        _قلف.قلف_کړه() سره
            ترڅو _لیکل_کېږي
                _خلاص.انتظار_وباسه()
            _لوستونکي += ۱

    # د یوه لوستونکي نیول بېرته ورکوي.
    دنده د_لوست_خلاصول()
        _قلف.قلف_کړه() سره
            _لوستونکي -= ۱
            که _لوستونکي == ۰
                _خلاص.ټولو_ته_خبر_ورکړه()

    # د لیکلو لپاره قلف نیسي، او انتظار باسي ترڅو نه لوستونکی او نه بل لیکونکی یې لري.
    دنده د_لیک_قلف()
        _قلف.قلف_کړه() سره
            ترڅو _لیکل_کېږي یا _لوستونکي > ۰
                _خلاص.انتظار_وباسه()
            _لیکل_کېږي = رښتیا

    # د لیکونکي نیول بېرته ورکوي.
    دنده د_لیک_خلاصول()
        _قلف.قلف_کړه() سره
            _لیکل_کېږي = درواغ
            _خلاص.ټولو_ته_خبر_ورکړه()

    # څومره لوستونکي یې لري.
    دنده لوستونکي(): عدد
        راګرځه _لوستونکي

# ------------------------------------------------- ټایمر
#
# setTimeout او setInterval، په تندر کې: ټایمر یو کار دی چې ویده کېږي او بیا څه کوي. ځکه
# چې کار دی، د پروګرام پاتې برخه د انتظار پر مهال خپل کار کوي.
#
#     متغیر ټک = ټایمر.هر_ځل(۱۰۰، دنده() کرښه چاپ("ټک"))
#     کارونه.ویده شه(۳۵۰)
#     ټک.لغوه_کړه()
ټولګی ټایمر
    # هغه څه چې ټایمر.وروسته او ټایمر.هر_ځل یې راګرځوي. لغوه_کړه() یې دروي: هغه چار چې لا
    # نه دی چلېدلی هېڅکله نه چلېږي، او تکراري ټایمر د خپل راتلونکي انتظار وروسته درېږي.
    جوړښت ټایمر
        _لغوه_شوی: منطقي
        _کار: عدد

        # یو ټایمر چې لا څه نه کوي (ټایمر.وروسته او ټایمر.هر_ځل یې پیلوي).
        ټایمر()
            _لغوه_شوی = درواغ
            _کار = -۱

        # هغه کار پیلوي چې انتظار باسي او بیا چار کوي (ټایمر.وروسته او ټایمر.هر_ځل یې کاروي).
        دنده پیل_کړه(چار: دنده())
            _کار = کارونه.پیل کړه(چار)

        # چار به (بیا) ونه چلېږي.
        دنده لغوه_کړه()
            _لغوه_شوی = رښتیا

        # رښتیا، کله چې لغوه شوی وي.
        دنده لغوه_شوی(): منطقي
            راګرځه _لغوه_شوی

        # انتظار باسي ترڅو د ټایمر کار پای ته ورسېږي (لغوه شوی تکراري ټایمر د خپل راتلونکي
        # انتظار وروسته پای ته رسېږي؛ هغه چې تل تکرارېږي هېڅکله نه).
        دنده انتظار_یې_وکړه()
            که _کار >= ۰
                کارونه.انتظار یې وکړه(_کار)

    # چار یو ځل چلوي، د دومره ملي ثانیو وروسته.
    دنده وروسته(ملي_ثانیې: عدد، چار: دنده()): ټایمر
        متغیر ټ = ټایمر()
        متغیر چلول = دنده()
            کارونه.ویده شه(ملي_ثانیې)
            که نه ټ.لغوه_شوی()
                چار()
        ټ.پیل_کړه(چلول)
        راګرځه ټ

    # چار هرو دومره ملي ثانیو وروسته چلوي، ترڅو ټایمر لغوه شي.
    دنده هر_ځل(ملي_ثانیې: عدد، چار: دنده()): ټایمر
        متغیر ټ = ټایمر()
        متغیر چلول = دنده()
            ترڅو نه ټ.لغوه_شوی()
                کارونه.ویده شه(ملي_ثانیې)
                که نه ټ.لغوه_شوی()
                    چار()
        ټ.پیل_کړه(چلول)
        راګرځه ټ
