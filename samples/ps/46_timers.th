# ژبه: ps
# ۴۶ - وروسته یو څه کول، او بیا بیا یې کول
#
# ټایمر یو کار دی چې ویده کېږي او بیا څه کوي، نو د پروګرام پاتې برخه د انتظار پر مهال
# خپل کار کوي: ټایمر.وروسته setTimeout دی، ټایمر.هر_ځل setInterval، او لغوه_کړه()
# دواړه دروي. کله چې ټول کارونه یوازې د وخت انتظار باسي، مجازي ماشین رښتیا ویده کېږي -
# پروګرام تر راتلونکي ټایمره پورې هیڅ پروسېسر نه کاروي.
راوړه "concurrency"

متغیر وویل: متن[] = []
متغیر ټکونه = ۰

کرښه چاپ("۱. تکراري ټایمر، تر درېیم ټک وروسته درول شوی:")
# دروازه هغه وخت پرانیستل کېږي چې شمېر یې صفر شي. د درېیم ټک انتظار، نه د یوې
# اندازې وخت، د پروګرام وتنه په هر ځل کې یو شان ساتي.
متغیر درې_ټکونه = دروازه(۳)
متغیر شمېرل = دنده()
    ټکونه += ۱
    درې_ټکونه.یو_کم_کړه()
متغیر هر_لس = ټایمر.هر_ځل(۱۰، شمېرل)
درې_ټکونه.انتظار_وکړه()
هر_لس.لغوه_کړه()
کرښه چاپ("  ټکونه: "، ټکونه)

کرښه چاپ("۲. یو ځلی ټایمر وروسته چلېږي، او پاتې برخه خپل کار کوي:")
متغیر چمتو = دروازه(۱)
متغیر وروسته_به = دنده()
    ورزیات کړه(وویل، "ټایمر")
    چمتو.یو_کم_کړه()
متغیر یو_ځل = ټایمر.وروسته(۱۰، وروسته_به)
ورزیات کړه(وویل، "پروګرام")
چمتو.انتظار_وکړه()
کرښه چاپ("  "، متن.یو ځای کړه(وویل، "، او بیا "))

کرښه چاپ("۳. هغه ټایمر چې تر وخته مخکې لغوه شي هېڅکله نه چلېږي:")
متغیر وچلېد = درواغ
متغیر پښېماني = دنده()
    وچلېد = رښتیا
متغیر لغوه_شوی = ټایمر.وروسته(۲۰، پښېماني)
لغوه_شوی.لغوه_کړه()
لغوه_شوی.انتظار_یې_وکړه()
کرښه چاپ("  وچلېد؟ "، وچلېد، " (لغوه شوی: "، لغوه_شوی.لغوه_شوی()، ")")

# پروګرام هغه وخت پای ته رسېږي چې ټول کارونه پای ته ورسېږي، نو پورته ټایمرونو ته دلته
# انتظار ایستل کېږي؛ هغه تکراري ټایمر چې هېڅکله لغوه نه شي، پروګرام تل ژوندی ساتي.
یو_ځل.انتظار_یې_وکړه()
هر_لس.انتظار_یې_وکړه()
کرښه چاپ("هر ټایمر پای ته ورسېد.")
