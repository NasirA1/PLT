// ژبه: ps
// ۳۱ - جیب، تتمیم جیب او ظل (حرکت)
//
// د انځور کښلو دندې اعشاري شمېرې مني، نو یو ټکی کولای شي په
// جیب(زاویه) * ۸۰ کې کېني، پرته له دې چې مخکې بشپړ عدد شي. دا پروګرام درې
// مثلثاتي دندې کاږي او په هر چوکاټ کې یې یو ګام کیڼ خوا ته بیايي.
//
// زاویه په رادیانو ده: یوه بشپړه ګرځېدنه ۲ * پای ده، نیمه ګرځېدنه پای ده.
// جیب او تتمیم جیب تل له -۱ تر ۱ وي؛ ظل د څلورمې ګرځېدنې نږدې بې‌پایه ته ځي،
// نو په لنډو ټوټو کښل کېږي او پرې کېږي.
//
// هڅه وکړه: «چلول» کښېکښه. «چټکتیا» بدله کړه چې څپې ژر وګرځي، یا «څپې» چې
// په ټاټ کې ډېرې څپې ځای شي.

راوړه ګرافیک

ثابت پلنوالی = ۴۸۰
ثابت لوړوالی = ۳۲۰
ثابت منځ = لوړوالی / ۲٫۰        // ۱۶۰٫۰ - اعشاري وېش، نه ۱۶۰
ثابت لوړه = ۱۱۰٫۰
ثابت څپې = ۲٫۰                  // څو بشپړې ګرځېدنې په ټاټ کې ځای شي
ثابت چټکتیا = ۰٫۰۸              // په هر چوکاټ کې څومره رادیان ښوېږي

ټاټ(پلنوالی، لوړوالی)
د لیکنې اندازه(۱۳)

// هغه زاویه، په رادیانو، چې د پکسلونو ستن س یې ښيي.
دنده زاویه_په(س: اعشاري، پړاو: اعشاري): اعشاري
    راګرځه س / پلنوالی * څپې * ۲٫۰ * پای() + پړاو

// یوه کږه، چې په هره څلورمه ستن کې له یو ټکي څخه د لیکې په بڼه کښل کېږي.
دنده وکاږه(پړاو: اعشاري، پیمانه: اعشاري، رنګ: متن، ډول: عدد)
    متغیر پخوانی_ص = ۰٫۰
    متغیر تشه = رښتیا
    لپاره متغیر س = ۰، س <= پلنوالی، س = س + ۴
        متغیر زاویه = زاویه_په(س، پړاو)
        متغیر ارزښت = جیب(زاویه)
        که ډول == ۱
            ارزښت = تتمیم جیب(زاویه)
        که ډول == ۲
            ارزښت = ظل(زاویه)
        متغیر ص = منځ - ارزښت * پیمانه
        // ظل د څلورمې ګرځېدنې نږدې له ټاټه وځي: د څوکې پر ځای تشه پرېږده.
        که مطلق(ارزښت) > ۱٫۴
            تشه = رښتیا
        کنه
            که نه تشه
                لیکه(س - ۴، پخوانی_ص، س، ص، رنګ)
            پخوانی_ص = ص
            تشه = دروغ

متغیر پړاو = ۰٫۰
ترڅو رښتیا
    ټاټ پاک کړه("#101828")

    // محورونه او د -۱ / +۱ لارښود لیکې.
    د لیکې پلنوالی(۱٫۰)
    لیکه(۰، منځ، پلنوالی، منځ، "#55607a")
    لیکه(۰، منځ - لوړه، پلنوالی، منځ - لوړه، "#2b344a")
    لیکه(۰، منځ + لوړه، پلنوالی، منځ + لوړه، "#2b344a")

    د لیکې پلنوالی(۲٫۵)
    وکاږه(پړاو، لوړه، "#4cc9f0"، ۰)        // جیب
    وکاږه(پړاو، لوړه، "#f7b801"، ۱)        // تتمیم جیب
    د لیکې پلنوالی(۱٫۵)
    وکاږه(پړاو، لوړه، "#f55d3e"، ۲)        // ظل

    // یو ټکی چې د واحدې دایرې پر شاوخوا ګرځي، ښيي چې زاویه اوس چېرته ده.
    ثابت مس = ۶۰٫۰
    ثابت مص = ۶۰٫۰
    ثابت و = ۳۴٫۰
    د دایرې څنډه(مس، مص، و، "#55607a")
    لیکه(مس، مص، مس + تتمیم جیب(پړاو) * و، مص - جیب(پړاو) * و، "#f7b801")
    دایره(مس + تتمیم جیب(پړاو) * و، مص - جیب(پړاو) * و، ۴٫۵، "#4cc9f0")

    لیکنه(پلنوالی - ۱۵۰، ۱۰، "جیب"، "#4cc9f0")
    لیکنه(پلنوالی - ۱۱۰، ۱۰، "تتمیم جیب"، "#f7b801")
    لیکنه(پلنوالی - ۴۰، ۱۰، "ظل"، "#f55d3e")
    لیکنه(۱۰، لوړوالی - ۲۲، "زاویه " + متن کړه(نږدې کړه(پړاو / پای() * ۱۸۰٫۰) % ۳۶۰) + " درجې"، "#c9d1e4")
    چوکاټ()

    پړاو = پړاو + چټکتیا
