// ژبه: ps
// ۱۴ - ساحه او ژوند
//
// یو نوم له خپل اعلان څخه د هغه بلاک تر پایه لیدل کېږي چې په کې دی. یو
// دننی بلاک کولای شي داسې نوم اعلان کړي چې بهرنی نوم «پټ» کړي.
// د سر کچې متغیرونه عمومي دي: هره دنده یې کارولای شي.
//
// هڅه وکړئ: د «نښې» پاڼه پرانیزئ او ننوتې ساحې خلاصې کړئ. وګورئ کوم
// نومونه عمومي دي (په عمومي جدول کې) او کوم ځایي (د چوکاټ په ځایونو کې).

متغیر شمېرونکی = ۰           // عمومي متغیر

دنده بل_پېژند(): عدد
    شمېرونکی = شمېرونکی + ۱
    راګرځه شمېرونکی

متغیر پیغام = "بهرنی"
که رښتیا                      // د «که» (یا تکرار، یا دندې) برخه یو بلاک دی
    متغیر پیغام = "دننی"     // بهرنی «پیغام» پټوي
    کرښه چاپ("په بلاک کې: "، پیغام)
کرښه چاپ("له بلاک وروسته: "، پیغام)

کرښه چاپ("پېژندونه: "، بل_پېژند()، " "، بل_پېژند()، " "، بل_پېژند())
کرښه چاپ("شمېرونکی اوس "، شمېرونکی، " دی")
