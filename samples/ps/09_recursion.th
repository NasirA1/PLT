// ژبه: ps
// ۰۹ - دندې او تکراري دندې
//
// یوه دنده ډول لرونکي پارامټرونه او د راګرځېدو ډول لري. تکراري دنده ځان
// یو کوچني ستونزې لپاره بیا بولي، تر هغه چې بنسټیز حالت ته ورسېږي.
//
// هڅه وکړئ: دا پروګرام ډیبګ کړئ او د VM پاڼه کې د بلنو چوکاټونه وګورئ.

دنده فکتوریل(n: عدد): عدد
    که n <= ۱
        راګرځه ۱    // بنسټیز حالت
    راګرځه n * فکتوریل(n - ۱)

دنده فیبوناچي(n: عدد): عدد
    که n < ۲
        راګرځه n
    راګرځه فیبوناچي(n - ۱) + فیبوناچي(n - ۲)

کرښه چاپ("۵! = ", فکتوریل(۵))
کرښه چاپ("۲۰! = ", فکتوریل(۲۰))

متغیر کرښه = ""
لپاره متغیر i = ۰; i < ۱۲; i = i + ۱
    کرښه = کرښه + متن کړه(فیبوناچي(i)) + " "
کرښه چاپ("فیبوناچي: ", کرښه)
