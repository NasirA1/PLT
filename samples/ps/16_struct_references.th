// ژبه: ps
// ۱۶ - جوړښتونه ماخذونه دي؛ کاپي() جلا کاپي جوړوي
//
// لکه لړۍ، جوړښتونه هم شریکېږي: یو بل متغیر ته یې ورکول یا دندې ته
// لېږل همغه ارزښت ته بل نوم ورکوي. کاپي() خپلواکه کاپي جوړوي، چې دننه
// لړۍ یې هم کاپي کېږي.
//
// هڅه وکړئ: ډیبګ یې کړئ او د VM په پاڼه کې وګورئ چې «احمد» او «همغه» یو
// ارزښت ته اشاره کوي.

جوړښت زده_کوونکی
    نوم: متن
    نمرې: عدد[]

دنده اوسط(زده: زده_کوونکی): عدد
    متغیر ټول = ۰
    لپاره متغیر ش = ۰، ش < اوږدوالی(زده.نمرې)، ش = ش + ۱
        ټول = ټول + زده.نمرې[ش]
    راګرځه ټول / اوږدوالی(زده.نمرې)

دنده نمره_ورزیاته_کړه(زده: زده_کوونکی، نمره: عدد)
    متغیر نمرې = لړۍ(اوږدوالی(زده.نمرې) + ۱، ۰)
    لپاره متغیر ش = ۰، ش < اوږدوالی(زده.نمرې)، ش = ش + ۱
        نمرې[ش] = زده.نمرې[ش]
    نمرې[اوږدوالی(زده.نمرې)] = نمره
    زده.نمرې = نمرې               // د بلونکي جوړښت بدلوي: هغه شریک دی

متغیر احمد = زده_کوونکی("احمد"، [۹۰، ۸۰])
متغیر همغه = احمد                // همغه زده کوونکي ته بل نوم
نمره_ورزیاته_کړه(همغه، ۱۰۰)
کرښه چاپ("احمد:  "، احمد)

متغیر غبرګونی = کاپي(احمد)       // خپلواکه کاپي
غبرګونی.نوم = "د احمد غبرګونی"
غبرګونی.نمرې[۰] = ۰
کرښه چاپ("احمد:  "، احمد)
کرښه چاپ("غبرګونی: "، غبرګونی)

متغیر ټولګی = [احمد، زده_کوونکی("ملالۍ"، [۷۰، ۷۵، ۸۰])، زده_کوونکی("خوشال"، [۹۵])]
لپاره متغیر ش = ۰، ش < اوږدوالی(ټولګی)، ش = ش + ۱
    متغیر زده = ټولګی[ش]
    کرښه چاپ(زده.نوم، " اوسط "، اوسط(زده)، " لري")
