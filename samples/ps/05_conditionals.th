// ژبه: ps
// ۰۵ - شرطونه: که / کنه که / کنه
//
// شرط باید منطقي (رښتیا یا درواغ) وي. د پرتلې عملګر (== != < <= > >=)
// منطقي ارزښت جوړوي، او «او»، «یا» او «نه» یې سره یوځای کوي. «او» او «یا»
// لنډه لار نیسي: ښي خوا یوازې هغه وخت ارزول کېږي چې پایله بدلولای شي.
//
// هڅه وکړئ: د «بایټ کوډ» پاڼه پرانیزئ او JUMP_IF_FALSE لارښوونې ومومئ
// چې هره څانګه جوړوي.

دنده درجه(نمره: عدد): متن
    که نمره >= ۹۰
        راګرځه "الف"
    کنه که نمره >= ۷۵
        راګرځه "ب"
    کنه که نمره >= ۵۰
        راګرځه "ج"
    کنه
        راګرځه "ناکام"

کرښه چاپ("۹۵ ← "، درجه(۹۵))
کرښه چاپ("۸۰ ← "، درجه(۸۰))
کرښه چاپ("۵۰ ← "، درجه(۵۰))
کرښه چاپ("۱۲ ← "، درجه(۱۲))

متغیر کال = ۲۰۲۴
متغیر کبیسه = (کال % ۴ == ۰ او کال % ۱۰۰ != ۰) یا کال % ۴۰۰ == ۰
که کبیسه
    کرښه چاپ(کال، " کبیسه کال دی")
کنه
    کرښه چاپ(کال، " کبیسه کال نه دی")
که نه کبیسه
    کرښه چاپ("فبروري ۲۸ ورځې لري")
