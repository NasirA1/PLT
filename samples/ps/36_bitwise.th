// ژبه: ps
// ۳۶ - بیټونه: شپاړس‌بنسټیز، دوه‌بنسټیز او بیټي عملګر
//
// بشپړ عدد د ۶۴ بیټونو یوه کرښه ده. په دوه‌بنسټیز (0b...) یا شپاړس‌بنسټیز (0x...،
// هر رقم څلور بیټه) لیکل هغه بیټونه ښيي، او بیټي عملګر یو په یو پرې کار کوي:
//     &  AND   ۱ چېرې چې دواړه ۱ لري        |  OR    ۱ چېرې چې یو یې ۱ لري
//     ^  XOR   ۱ چېرې چې توپیر لري            ~  NOT   هر بیټ اړول شوی
//     << >>    بیټونه کیڼ یا ښي ته ښويوي (<< په ۲ ضربوي، >> وېشي)
// د پرتلو نه لوړ لومړیتوب لري، نو  بیرغونه & نقاب != ۰  یعنې  (بیرغونه & نقاب) != ۰.
//
// هڅه وکړئ: د «بیټونه» پاڼه (د پردې شاته) پرانیزئ، ۱۲ او ۱۰ ولیکئ او هر عملګر
// وګورئ. بیا د «بایټ کوډ» پاڼه: هر عملګر یوه لارښوونه ده.

کرښه چاپ(0b1100، " "، 0x0C، " "، ۱۲)          // د دولسو درې لیکنې
کرښه چاپ(۱۲ & ۱۰، " "، ۱۲ | ۱۰، " "، ۱۲ ^ ۱۰)  // ۸ ۱۴ ۶
کرښه چاپ(~۰، " "، ~۱۲)                         // -۱ -۱۳: ~الف د -الف - ۱ دی

// ښويېدنې: هر ګام کیڼ ته دوه‌چنده کوي، هر ګام ښي ته نیمايي (نښه ساتي).
کرښه چاپ(۱ << ۴، " "، 0b1000 >> ۳، " "، -۱۶ >> ۲)

// بیرغونه: هرې ترتیبونې ته یو بیټ، ټول په یوه عدد کې.
ثابت پنډ = 0b001
ثابت کږ = 0b010
ثابت کرښه_لاندې = 0b100
متغیر بڼه = پنډ | کرښه_لاندې                   // دوه بیرغونه روښانه کړه
کرښه چاپ("پنډ؟ "، بڼه & پنډ != ۰، "  کږ؟ "، بڼه & کږ != ۰)
بڼه = بڼه & ~پنډ                               // یو بېرته مړ کړه
کرښه چاپ("پنډ؟ "، بڼه & پنډ != ۰، "  د بیټونو په بڼه: "، بڼه)

// نقابونه د عدد یوه برخه راباسي: د رنګ ټیټ بایټ، د بېلګې په توګه.
متغیر رنګ_یې = 0x336699
کرښه چاپ("سور "، رنګ_یې >> ۱۶ & 0xFF، " شین "، رنګ_یې >> ۸ & 0xFF، " آبي "، رنګ_یې & 0xFF)

// د یوه عدد د ۱ بیټونو شمېرل، په لاس.
دنده بیټونه_وشمېره(ن: عدد): عدد
    متغیر شمېر = ۰
    ترڅو ن != ۰
        شمېر = شمېر + (ن & ۱)
        ن = ن >> ۱
    راګرځه شمېر
کرښه چاپ("0b101101 "، بیټونه_وشمېره(0b101101)، " روښانه بیټونه لري؛ 0xFF "، بیټونه_وشمېره(0xFF))
