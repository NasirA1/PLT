# ژبه: ps
# ۲۳ - عامل سیسټم (د سیسټم ماډیول)
#
# دننی ماډیول «سیسټم» (انګلیسي: os) پروګرامونو ته فایلونه، امرونه، ساعت او
# چاپېریال ورکوي. دندې یې یوازې له «راوړه سیسټم» وروسته شته، نو دا نومونه
# د هغو پروګرامونو لپاره خالي پاتې کېږي چې ورته اړتیا نلري.
#
# هڅه وکړئ: د قوماندې له کرښې: thundervm 23_os.thc یو دوه
# «یو» او «دوه» پروګرام ته ورکوي (لاندې دلیلونه وګورئ).

راوړه سیسټم

کرښه چاپ("پېژندل شوی سیسټم؟ "، شامل دی(["linux"، "windows"، "macos"]، عامل سیسټم()))
کرښه چاپ("دلیلونه: "، دلیلونه())
متغیر ښه_راغلاست = د چاپېریال ارزښت("THUNDER_GREETING")
که ښه_راغلاست == ""
    ښه_راغلاست = "(THUNDER_GREETING نه دی ټاکل شوی)"
کرښه چاپ("ښه راغلاست: "، ښه_راغلاست)

# فایلونه: نسبي نومونه د پروګرام په کاري پوښۍ کې دي.
متغیر فایل = "د_تندر_بېلګه.txt"
فایل ولیکه(فایل، "لومړۍ کرښه\n")
فایل ته ورزیات کړه(فایل، "دوهمه کرښه\n")
کرښه چاپ("فایل وايي: "، وېشه(پاک کړه(فایل ولوله(فایل))، "\n"))
فایل ړنګ کړه(فایل)
کرښه چاپ("لا شته؟ "، فایل شته(فایل))

# امرونه د سیسټم په شیل کې چلېږي؛ «وچلوه» یې وتنه پروګرام ته ورکوي.
متغیر حالت = وچلوه("echo 42")
کرښه چاپ("د وتلو حالت "، حالت)
متغیر (کوډ، متن_یې) = د چلولو پایله("echo 7")
کرښه چاپ("د چلولو پایله "، کوډ، " او ["، پاک کړه(متن_یې)، "] وه")

متغیر پیل = ساعت()
انتظار(۲۰)
کرښه چاپ("لږ تر لږه ۲۰ ملي ثانیې ویده و؟ "، ساعت() - پیل >= ۲۰)
کرښه چاپ("نېټه او وخت "، اوږدوالی(نېټه او وخت())، " توري لري، لکه 2026-11-06 14:30:00")
پای ته ورسوه(۰)
کرښه چاپ("«پای ته ورسوه» پروګرام ختموي، نو دا کرښه هېڅکله نه اجرا کېږي")
