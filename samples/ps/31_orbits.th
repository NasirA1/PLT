# ژبه: ps
# ۳۱ - دایروي حرکت: مدارونه او سپیروګراف (حرکت)
#
# هر څه چې په دایره کې ګرځي، تتمیم جیب او جیب دي: د (مس، مص) پر شاوخوا د و
# وړانګې په دایره کې، په زاویه ز کې یو ټکی دا دی:
#     س = مس + تتمیم جیب(ز) * و
#     ص = مص + جیب(ز) * و
# هغه سیاره چې یوه ګرځېدنه یې «دوره» ثانیې وخت نیسي، زاویه یې
# ۲ * پای() * وخت / دوره ده.
#
# ښي خوا سپیروګراف کاږي: یوه کوچنۍ څرخه چې د یوې لویې دننه ګرځي — همدا دوه
# فورمولونه سره جمع شوي.
#
# هڅه وکړه: «چلول» کښېکښه. د یوې سیارې دوره، یا د سپیروګراف «څرخه» او «قلم»
# بدل کړه چې بل نقش جوړ شي.

راوړه ګرافیک

ثابت پلنوالی = ۵۲۰
ثابت لوړوالی = ۳۲۰
ګرافیک.ټاټ(پلنوالی، لوړوالی)
ګرافیک.د چوکاټ چټکتیا(۳۰)
ګرافیک.د لیکنې اندازه(۱۲)

جوړښت سیاره
    نوم: متن
    واټن_یې: اعشاري
    دوره: اعشاري        # د یوې بشپړې ګرځېدنې ثانیې
    اندازه: اعشاري
    رنګ_یې: متن

متغیر سیارې = [
    سیاره("۱"، ۳۴٫۰، ۲٫۰، ۵٫۰، "#f7b801")،
    سیاره("۲"، ۵۸٫۰، ۳٫۶، ۷٫۵، "#4cc9f0")،
    سیاره("۳"، ۸۶٫۰، ۶٫۴، ۶٫۰، "#f55d3e")،
    سیاره("۴"، ۱۱۸٫۰، ۱۱٫۰، ۹٫۰، "#90be6d")]

ثابت لمر_س = ۱۴۰٫۰
ثابت لمر_ص = ۱۶۰٫۰

# سپیروګراف: یو قلم پر کوچنۍ څرخه چې د «کړۍ» په وړانګه دننه ګرځي.
ثابت کړۍ = ۱۱۰٫۰
ثابت څرخه = ۳۱٫۰
ثابت قلم = ۶۲٫۰
ثابت سپ_س = ۳۹۰٫۰
ثابت سپ_ص = ۱۶۰٫۰

دنده سپیرو(ز: اعشاري، محور: عدد): اعشاري
    ثابت ک = (کړۍ - څرخه) / څرخه
    که محور == ۰
        راګرځه سپ_س + (کړۍ - څرخه) * ریاضي.تتمیم جیب(ز) + قلم * ریاضي.تتمیم جیب(ک * ز)
    راګرځه سپ_ص + (کړۍ - څرخه) * ریاضي.جیب(ز) - قلم * ریاضي.جیب(ک * ز)

متغیر وخت_یې = ۰٫۰
ترڅو رښتیا
    ګرافیک.ټاټ پاک کړه("#0b1020")

    # ---- مدارونه
    ګرافیک.د لیکې پلنوالی(۱٫۰)
    تکرار س په سیارې
        ګرافیک.د دایرې څنډه(لمر_س، لمر_ص، س.واټن_یې، "#2b344a")
    ګرافیک.دایره(لمر_س، لمر_ص، ۱۴٫۰، "#ffd166")
    ګرافیک.د دایرې څنډه(لمر_س، لمر_ص، ۲۰٫۰، "#8a6d1f")

    تکرار س په سیارې
        متغیر ز = ۲٫۰ * ریاضي.پای() * وخت_یې / س.دوره
        متغیر ځ_س = لمر_س + ریاضي.تتمیم جیب(ز) * س.واټن_یې
        متغیر ځ_ص = لمر_ص + ریاضي.جیب(ز) * س.واټن_یې
        ګرافیک.دایره(ځ_س، ځ_ص، س.اندازه، س.رنګ_یې)
        ګرافیک.لیکنه(ځ_س + س.اندازه + ۳٫۰، ځ_ص - ۷٫۰، س.نوم، "#8894b0")
    ګرافیک.لیکنه(۲۰، ۲۰، "مدارونه: د ۲*پای*و/دوره جیب او تتمیم جیب"، "#c9d1e4")

    # ---- سپیروګراف، چې په هر چوکاټ کې یو څه نور کښل کېږي
    ګرافیک.د لیکې پلنوالی(۱٫۵)
    متغیر کښل_شوی = وخت_یې * ۲٫۶
    متغیر ګام = ۰٫۰۸
    متغیر ز = ۰٫۰
    ترڅو ز < کښل_شوی
        متغیر بل = ریاضي.کمینه(ز + ګام، کښل_شوی)
        ګرافیک.لیکه(سپیرو(ز، ۰)، سپیرو(ز، ۱)، سپیرو(بل، ۰)، سپیرو(بل، ۱)، "#c77dff")
        ز = ز + ګام
    ګرافیک.د دایرې څنډه(سپ_س، سپ_ص، کړۍ، "#2b344a")
    ګرافیک.دایره(سپیرو(کښل_شوی، ۰)، سپیرو(کښل_شوی، ۱)، ۳٫۵، "#ffffff")
    ګرافیک.لیکنه(۳۰۰، ۲۰، "سپیروګراف: دوې دایرې سره جمع"، "#c9d1e4")

    ګرافیک.چوکاټ()
    وخت_یې = وخت_یې + ۱٫۰ / ۳۰٫۰
    که وخت_یې > ۶۰٫۰
        وخت_یې = ۰٫۰
