# datastructures.th (lib/thunder/en) - the classic data structures, written in Thunder itself
# (docs/datastructures.md)
#
# import "datastructures" and every structure below is yours (thunderc finds this file in
# lib/thunder next to itself, or name a directory with --module-path). Unlike sockets or
# graphics nothing here is native: this is ordinary Thunder, written to be read - open this
# file to see how a stack, a queue, a linked list, a binary search tree and a heap really work.
#
# Every structure is a struct with a constructor and methods: make one with its name
# ("var s: Stack<int> = Stack()") and use it through its methods ("s.push(1)", "s.pop()").
# Most are generic: Stack<T> works for any element type T, named where the variable is
# declared. The tree and the heap compare their elements with <, so their elements are
# numbers or strings. A member whose name ends in '_' is private: only the structure's own
# methods may touch it - programs use the methods, never the insides.
#
# Taking from an empty structure is a mistake in the program and stops it, as a wrong
# built-in call would. Ask is_empty first.

# ---------------------------------------------------------------- Stack (last in, first out)
#
# A pile of plates: push puts a value on top, pop takes the top one back.
# Every operation is O(1).
struct Stack<T>
    items_: T[]

    # A new, empty stack ("var s: Stack<int> = Stack()" says what it will hold).
    Stack()
        items_ = []

    # Puts a value on top.
    func push(value: T)
        push(items_, value)

    # Takes the top value off and returns it.
    func pop(): T
        return pop(items_)

    # The top value, without taking it off.
    func peek(): T
        return items_[len(items_) - 1]

    # How many values the stack holds.
    func size(): int
        return len(items_)

    # true when the stack holds nothing.
    func is_empty(): bool
        return len(items_) == 0

# ---------------------------------------------------------------- Queue (first in, first out)
#
# A line at a counter: add joins at the back, take serves the front.
# The front index moves instead of shifting every element, so both are O(1) on average;
# the space of served elements is reclaimed whenever it outgrows the rest.
struct Queue<T>
    items_: T[]
    front_: int

    # A new, empty queue ("var q: Queue<string> = Queue()" says what it will hold).
    Queue()
        items_ = []
        front_ = 0

    # Joins the back of the queue.
    func add(value: T)
        push(items_, value)

    # Serves (removes and returns) the front of the queue.
    func take(): T
        var value = items_[front_]
        front_ = front_ + 1
        if front_ * 2 >= len(items_) and front_ > 8
            items_ = slice(items_, front_, len(items_))
            front_ = 0
        return value

    # The front of the queue, without serving it.
    func peek(): T
        return items_[front_]

    # How many values are waiting.
    func size(): int
        return len(items_) - front_

    # true when the queue holds nothing.
    func is_empty(): bool
        return size() == 0

# ---------------------------------------------------------------- Linked list (singly linked)
#
# A chain of nodes, each holding its value and the node that follows; `nothing` ends the
# chain. Adding at the front is O(1); adding at the end and searching walk the chain, O(n).
# This is the textbook picture, made of a recursive struct. The nodes themselves are plain
# data - the list is the object that owns and works the chain.
struct ListNode<T>
    value: T
    next: ListNode<T>

struct LinkedList<T>
    head_: ListNode<T>
    count_: int

    # A new, empty linked list ("var l: LinkedList<int> = LinkedList()").
    LinkedList()
        head_ = nothing
        count_ = 0

    # Adds a value at the front: the new node points at the old head.
    func add_first(value: T)
        head_ = ListNode(value: value, next: head_)
        count_ = count_ + 1

    # Adds a value at the end: walk to the last node, then hang the new one on it.
    func add_last(value: T)
        var node = ListNode(value: value, next: nothing)
        if head_ == nothing
            head_ = node
        else
            var last = head_
            while last.next != nothing
                last = last.next
            last.next = node
        count_ = count_ + 1

    # Removes the front value and returns it.
    func remove_first(): T
        var value = head_.value
        head_ = head_.next
        count_ = count_ - 1
        return value

    # Removes the first node holding this value. True if one was found.
    func remove_value(value: T): bool
        var node = head_
        var previous: ListNode<T> = nothing
        while node != nothing
            if node.value == value
                if previous == nothing
                    head_ = node.next
                else
                    previous.next = node.next
                count_ = count_ - 1
                return true
            previous = node
            node = node.next
        return false

    # True if some node holds this value.
    func has(value: T): bool
        var node = head_
        while node != nothing
            if node.value == value
                return true
            node = node.next
        return false

    # How many values the list holds.
    func size(): int
        return count_

    # The values in list order, as an ordinary array.
    func to_array(): T[]
        var out: T[] = []
        var node = head_
        while node != nothing
            push(out, node.value)
            node = node.next
        return out

# ---------------------------------------------------------------- Binary search tree
#
# Every node's left subtree holds smaller values, its right subtree larger ones, so one
# value is found in O(height) steps - O(log n) when the tree is reasonably balanced.
# The elements are compared with <, so they are numbers or strings. Duplicates are ignored.
struct TreeNode<T>
    value: T
    left: TreeNode<T>
    right: TreeNode<T>

struct BinaryTree<T>
    root_: TreeNode<T>
    count_: int

    # A new, empty tree ("var t: BinaryTree<int> = BinaryTree()").
    BinaryTree()
        root_ = nothing
        count_ = 0

    # Adds a value in its ordered place. A value already in the tree is left as it is.
    func insert(value: T)
        var node = TreeNode(value: value, left: nothing, right: nothing)
        if root_ == nothing
            root_ = node
            count_ = 1
            return
        var at = root_
        while true
            if value == at.value
                return
            if value < at.value
                if at.left == nothing
                    at.left = node
                    count_ = count_ + 1
                    return
                at = at.left
            else
                if at.right == nothing
                    at.right = node
                    count_ = count_ + 1
                    return
                at = at.right

    # True if the value is in the tree.
    func has(value: T): bool
        var at = root_
        while at != nothing
            if value == at.value
                return true
            if value < at.value
                at = at.left
            else
                at = at.right
        return false

    # How many values the tree holds.
    func size(): int
        return count_

    # How many nodes the longest path from the root downwards passes (0 for an empty tree).
    func height(): int
        return node_height_(root_)

    # (private) The height below one node; nothing is a tree of height 0.
    func node_height_(node: TreeNode<T>): int
        if node == nothing
            return 0
        return 1 + math.max(node_height_(node.left), node_height_(node.right))

    # The smallest value: keep walking left.
    func smallest(): T
        var at = root_
        while at.left != nothing
            at = at.left
        return at.value

    # The largest value: keep walking right.
    func largest(): T
        var at = root_
        while at.right != nothing
            at = at.right
        return at.value

    # Every value in ascending order (an in-order walk: left subtree, node, right subtree).
    func sorted(): T[]
        var out: T[] = []
        walk_(root_, out)
        return out

    # (private) The in-order walk itself.
    func walk_(node: TreeNode<T>, out: T[])
        if node == nothing
            return
        walk_(node.left, out)
        push(out, node.value)
        walk_(node.right, out)

    # Removes a value. True if it was in the tree. A node with two children swaps its value
    # with the smallest of its right subtree (the next value in order) and that node, which
    # has at most one child, is unlinked instead.
    func remove(value: T): bool
        var at = root_
        var parent: TreeNode<T> = nothing
        while at != nothing and at.value != value
            parent = at
            if value < at.value
                at = at.left
            else
                at = at.right
        if at == nothing
            return false
        if at.left != nothing and at.right != nothing
            var successor = at.right
            var successor_parent = at
            while successor.left != nothing
                successor_parent = successor
                successor = successor.left
            at.value = successor.value
            at = successor
            parent = successor_parent
        var child = at.left
        if child == nothing
            child = at.right
        if parent == nothing
            root_ = child
        else if parent.left == at
            parent.left = child
        else
            parent.right = child
        count_ = count_ - 1
        return true

# ---------------------------------------------------------------- Heap (priority queue)
#
# take always returns the smallest value first, however the values arrived. The heap
# is a binary tree flattened into one array: the children of the node at index i sit at
# 2*i + 1 and 2*i + 2, and every parent is <= its children. Adding and taking are O(log n).
# The elements are compared with <, so they are numbers or strings.
struct Heap<T>
    items_: T[]

    # A new, empty heap ("var h: Heap<int> = Heap()").
    Heap()
        items_ = []

    # Adds a value: append at the end, then let it rise while it is smaller than its parent.
    func add(value: T)
        push(items_, value)
        var at = len(items_) - 1
        while at > 0
            var parent = (at - 1) / 2
            if items_[parent] <= items_[at]
                break
            var held = items_[parent]
            items_[parent] = items_[at]
            items_[at] = held
            at = parent

    # Removes and returns the smallest value: the last element replaces the root, then sinks
    # below every child smaller than itself.
    func take(): T
        var smallest = items_[0]
        var last = pop(items_)
        if len(items_) == 0
            return smallest
        items_[0] = last
        var at = 0
        while true
            var child = at * 2 + 1
            if child >= len(items_)
                break
            if child + 1 < len(items_) and items_[child + 1] < items_[child]
                child = child + 1
            if items_[at] <= items_[child]
                break
            var held = items_[at]
            items_[at] = items_[child]
            items_[child] = held
            at = child
        return smallest

    # The smallest value, without removing it.
    func peek(): T
        return items_[0]

    # How many values the heap holds.
    func size(): int
        return len(items_)

    # true when the heap holds nothing.
    func is_empty(): bool
        return len(items_) == 0

# ---------------------------------------------------------------- Set (unique elements)
#
# A collection in which every value appears once. It is built on Thunder's own map - the
# value is the key, so adding, removing and membership are all O(1) - which also means the
# elements are map keys: int, bool or string. values() returns them in insertion order;
# for elements kept sorted, use OrderedSet below.
struct Set<T>
    entries_: {T: bool}

    # A new, empty set ("var s: Set<string> = Set()" says what it will hold).
    Set()
        entries_ = {}

    # Puts a value in; a value already there stays single.
    func add(value: T)
        entries_[value] = true

    # Takes a value out. True if it was there.
    func remove(value: T): bool
        if not has(entries_, value)
            return false
        remove(entries_, value)
        return true

    # True if the value is in the set.
    func has(value: T): bool
        return has(entries_, value)

    # How many values the set holds.
    func size(): int
        return len(entries_)

    # true when the set holds nothing.
    func is_empty(): bool
        return len(entries_) == 0

    # The values, in the order they were first added.
    func values(): T[]
        return keys(entries_)

    # Every value that is in either set. (Inside a method a bare "values()" would mean the
    # built-in values(map) - built-in names stay reserved - so the set reads its own map.)
    func union(other: Set<T>): Set<T>
        var out: Set<T> = Set()
        for value in keys(entries_)
            out.add(value)
        for value in other.values()
            out.add(value)
        return out

    # Every value that is in both sets.
    func intersection(other: Set<T>): Set<T>
        var out: Set<T> = Set()
        for value in keys(entries_)
            if other.has(value)
                out.add(value)
        return out

    # Every value of this set that is not in the other.
    func difference(other: Set<T>): Set<T>
        var out: Set<T> = Set()
        for value in keys(entries_)
            if not other.has(value)
                out.add(value)
        return out

# ---------------------------------------------------------------- OrderedSet (unique, sorted)
#
# A set that keeps its values in ascending order: it is a binary search tree underneath, so
# adding, removing and membership are O(log n) and the values come out sorted. The elements
# are compared with <, so they are numbers or strings. One object built on another: the
# ordered set owns a BinaryTree and turns every question into a tree question.
struct OrderedSet<T>
    tree_: BinaryTree<T>

    # A new, empty ordered set ("var s: OrderedSet<int> = OrderedSet()").
    OrderedSet()
        tree_ = BinaryTree()

    # Puts a value in its ordered place; a value already there stays single.
    func add(value: T)
        tree_.insert(value)

    # Takes a value out. True if it was there.
    func remove(value: T): bool
        return tree_.remove(value)

    # True if the value is in the set.
    func has(value: T): bool
        return tree_.has(value)

    # How many values the set holds.
    func size(): int
        return tree_.size()

    # true when the set holds nothing.
    func is_empty(): bool
        return tree_.size() == 0

    # The values, in ascending order.
    func values(): T[]
        return tree_.sorted()

    # The two ends of the order.
    func smallest(): T
        return tree_.smallest()

    # The largest element (the set must not be empty).
    func largest(): T
        return tree_.largest()

# ---------------------------------------------------------------- Deque (both ends)
#
# A queue that is open at both ends: values join and leave at the front and at the back.
# Two stacks, back to back: `front_` holds the front half reversed (its last element is the
# deque's first), `back_` holds the rest in order. Each end is O(1); when one side runs dry
# it is refilled from the other, which keeps every operation O(1) on average.
struct Deque<T>
    front_: T[]
    back_: T[]

    # A new, empty deque ("var d: Deque<int> = Deque()").
    Deque()
        front_ = []
        back_ = []

    # Puts a value at the front.
    func add_first(value: T)
        push(front_, value)

    # Puts a value at the back.
    func add_last(value: T)
        push(back_, value)

    # Takes the front value off and returns it.
    func take_first(): T
        if len(front_) == 0
            refill_(back_, front_)
        return pop(front_)

    # Takes the back value off and returns it.
    func take_last(): T
        if len(back_) == 0
            refill_(front_, back_)
        return pop(back_)

    # (private) Moves everything from one side to the other, reversing the order on the way.
    func refill_(source: T[], target: T[])
        while len(source) > 0
            push(target, pop(source))

    # The front value, without taking it off.
    func peek_first(): T
        if len(front_) == 0
            refill_(back_, front_)
        return front_[len(front_) - 1]

    # The back value, without taking it off.
    func peek_last(): T
        if len(back_) == 0
            refill_(front_, back_)
        return back_[len(back_) - 1]

    # How many values the deque holds.
    func size(): int
        return len(front_) + len(back_)

    # true when the deque holds nothing.
    func is_empty(): bool
        return size() == 0

    # The values from front to back, as an ordinary array.
    func to_array(): T[]
        var out: T[] = []
        for var i = len(front_) - 1, i >= 0, i = i - 1
            push(out, front_[i])
        for var i = 0, i < len(back_), i = i + 1
            push(out, back_[i])
        return out

# ---------------------------------------------------------------- Doubly linked list
#
# Like the linked list, but every node also knows the node before it, and the list keeps
# both ends - so adding and removing at either end is O(1), and it can be walked backwards.
struct DllNode<T>
    value: T
    previous: DllNode<T>
    next: DllNode<T>

struct DoublyLinkedList<T>
    head_: DllNode<T>
    tail_: DllNode<T>
    count_: int

    # A new, empty doubly linked list ("var l: DoublyLinkedList<int> = DoublyLinkedList()").
    DoublyLinkedList()
        head_ = nothing
        tail_ = nothing
        count_ = 0

    # Adds a value at the front.
    func add_first(value: T)
        var node = DllNode(value: value, previous: nothing, next: head_)
        if head_ == nothing
            tail_ = node
        else
            head_.previous = node
        head_ = node
        count_ = count_ + 1

    # Adds a value at the end.
    func add_last(value: T)
        var node = DllNode(value: value, previous: tail_, next: nothing)
        if tail_ == nothing
            head_ = node
        else
            tail_.next = node
        tail_ = node
        count_ = count_ + 1

    # Removes the front value and returns it.
    func take_first(): T
        var node = head_
        head_ = node.next
        if head_ == nothing
            tail_ = nothing
        else
            head_.previous = nothing
        count_ = count_ - 1
        return node.value

    # Removes the back value and returns it.
    func take_last(): T
        var node = tail_
        tail_ = node.previous
        if tail_ == nothing
            head_ = nothing
        else
            tail_.next = nothing
        count_ = count_ - 1
        return node.value

    # Removes the first node holding this value. True if one was found.
    func remove_value(value: T): bool
        var node = head_
        while node != nothing
            if node.value == value
                if node.previous == nothing
                    head_ = node.next
                else
                    node.previous.next = node.next
                if node.next == nothing
                    tail_ = node.previous
                else
                    node.next.previous = node.previous
                count_ = count_ - 1
                return true
            node = node.next
        return false

    # True if some node holds this value.
    func has(value: T): bool
        var node = head_
        while node != nothing
            if node.value == value
                return true
            node = node.next
        return false

    # How many values the list holds.
    func size(): int
        return count_

    # The values from front to back, and from back to front: the point of the extra pointer.
    func to_array(): T[]
        var out: T[] = []
        var node = head_
        while node != nothing
            push(out, node.value)
            node = node.next
        return out

    # The elements from the last to the first, as an array.
    func to_array_reversed(): T[]
        var out: T[] = []
        var node = tail_
        while node != nothing
            push(out, node.value)
            node = node.previous
        return out

# ---------------------------------------------------------------- Graph
#
# Vertices and the edges between them, as an adjacency map: each vertex maps to the
# vertices an edge leads to. Edges are directed; connect adds one each way for an
# undirected graph. The vertices are map keys: int, bool or string.
struct Graph<T>
    adjacency_: {T: T[]}

    # A new, empty graph ("var g: Graph<string> = Graph()").
    Graph()
        adjacency_ = {}

    # Adds a vertex with no edges yet (a vertex already there is left alone).
    func add_vertex(vertex: T)
        if not has(adjacency_, vertex)
            var none: T[] = []
            adjacency_[vertex] = none

    # Adds a directed edge; both vertices are added as needed. A repeated edge is kept single.
    func add_edge(from: T, to: T)
        add_vertex(from)
        add_vertex(to)
        if not contains(adjacency_[from], to)
            push(adjacency_[from], to)

    # Connects two vertices both ways: an undirected edge.
    func connect(a: T, b: T)
        add_edge(a, b)
        add_edge(b, a)

    # Every vertex, in the order first added.
    func vertices(): T[]
        return keys(adjacency_)

    # The vertices an edge leads to from here (empty for an unknown vertex).
    func neighbors(vertex: T): T[]
        if not has(adjacency_, vertex)
            var none: T[] = []
            return none
        return adjacency_[vertex]

    # Breadth-first search: every vertex reachable from the start, nearest rings first.
    # A queue holds the frontier; a set remembers what has been seen.
    func bfs(start: T): T[]
        var out: T[] = []
        if not has(adjacency_, start)
            return out
        var seen: Set<T> = Set()
        var frontier: Queue<T> = Queue()
        seen.add(start)
        frontier.add(start)
        while not frontier.is_empty()
            var vertex = frontier.take()
            push(out, vertex)
            for neighbor in neighbors(vertex)
                if not seen.has(neighbor)
                    seen.add(neighbor)
                    frontier.add(neighbor)
        return out

    # Depth-first search: follow each road to its end before trying the next one.
    func dfs(start: T): T[]
        var out: T[] = []
        if not has(adjacency_, start)
            return out
        var seen: Set<T> = Set()
        dfs_visit_(start, seen, out)
        return out

    # (private) One vertex of the depth-first walk and everything below it.
    func dfs_visit_(vertex: T, seen: Set<T>, out: T[])
        if seen.has(vertex)
            return
        seen.add(vertex)
        push(out, vertex)
        for neighbor in neighbors(vertex)
            dfs_visit_(neighbor, seen, out)

    # The shortest path (fewest edges) from one vertex to another, found by breadth-first
    # search; empty when there is none. Includes both ends: [from, ..., to].
    func shortest_path(from: T, to: T): T[]
        var path: T[] = []
        if not has(adjacency_, from) or not has(adjacency_, to)
            return path
        var came_from: {T: T} = {}
        var seen: Set<T> = Set()
        var frontier: Queue<T> = Queue()
        seen.add(from)
        frontier.add(from)
        var found = from == to
        while not frontier.is_empty() and not found
            var vertex = frontier.take()
            for neighbor in neighbors(vertex)
                if not seen.has(neighbor)
                    seen.add(neighbor)
                    came_from[neighbor] = vertex
                    if neighbor == to
                        found = true
                        break
                    frontier.add(neighbor)
        if not found
            return path
        # Walk home along the breadcrumbs, then turn the trail around.
        var step = to
        push(path, step)
        while step != from
            step = came_from[step]
            push(path, step)
        return reverse(path)

    # True if some chain of edges leads from one vertex to the other.
    func has_path(from: T, to: T): bool
        return len(shortest_path(from, to)) > 0

# ---------------------------------------------------------------- Trie (prefix tree)
#
# A tree of characters: every word shares its path with every word that starts the same
# way, so lookup and prefix questions cost O(length of the word), however many words are
# stored - the structure behind autocomplete.
struct TrieNode
    children: {string: TrieNode}
    ends_word: bool

    # A new node: no children yet, and no word ends here.
    TrieNode()
        children = {}
        ends_word = false

struct Trie
    root_: TrieNode
    count_: int

    # A new, empty trie.
    Trie()
        root_ = TrieNode()
        count_ = 0

    # Adds a word (adding it twice keeps it once).
    func add(word: string)
        var node = root_
        for var i = 0, i < len(word), i = i + 1
            var letter = string.substring(word, i, i + 1)
            if not has(node.children, letter)
                node.children[letter] = TrieNode()
            node = node.children[letter]
        if not node.ends_word
            node.ends_word = true
            count_ = count_ + 1

    # True if exactly this word was added.
    func has(word: string): bool
        var node = walk_(word)
        return node != nothing and node.ends_word

    # True if some added word starts with this prefix ("" is a prefix of everything).
    func has_prefix(prefix: string): bool
        return walk_(prefix) != nothing

    # (private) Follows the word letter by letter; nothing when the path is not there.
    func walk_(word: string): TrieNode
        var node = root_
        for var i = 0, i < len(word), i = i + 1
            var letter = string.substring(word, i, i + 1)
            if not has(node.children, letter)
                return nothing
            node = node.children[letter]
        return node

    # How many distinct words the trie holds.
    func size(): int
        return count_

    # Every word, in alphabetical order.
    func words(): string[]
        var out: string[] = []
        collect_(root_, "", out)
        return sort(out)

    # (private) Gathers every word below one node, letter by letter.
    func collect_(node: TrieNode, prefix: string, out: string[])
        if node.ends_word
            push(out, prefix)
        for letter in node.children
            collect_(node.children[letter], prefix + letter, out)
