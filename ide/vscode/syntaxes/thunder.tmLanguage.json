{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Thunder",
  "scopeName": "source.thunder",
  "information_for_contributors": [
    "Generated by ide/vscode/tools/generate_assets.py from thunderc --language-info.",
    "Do not edit by hand: edit the language pack (src/core/language_*.cpp) and run the generator."
  ],
  "patterns": [
    {
      "include": "#language-directive"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#annotation"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#import"
    },
    {
      "include": "#type-annotation"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#call"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "language-directive": {
      "match": "\\A\\s*(#)\\s*(lang|ژبه)\\s*(:)\\s*(\\w+)\\s*$",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.thunder"
        },
        "2": {
          "name": "keyword.control.directive.thunder"
        },
        "3": {
          "name": "punctuation.separator.key-value.thunder"
        },
        "4": {
          "name": "constant.language.thunder"
        }
      }
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.number-sign.thunder",
          "begin": "#",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.thunder"
            }
          }
        },
        {
          "name": "comment.block.thunder",
          "begin": "'''",
          "end": "'''",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.thunder"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.thunder"
            }
          }
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.thunder",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "name": "string.quoted.other.guillemet.thunder",
          "begin": "«",
          "end": "»|$",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "name": "string.quoted.other.curly.thunder",
          "begin": "[“„]",
          "end": "[”“]|$",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.thunder",
      "match": "\\\\."
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.thunder",
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])0[xX](?:[0-9a-fA-F]|[0123456789۰۱۲۳۴۵۶۷۸۹])+(?![[:word:]\\p{L}\\p{M}\\p{Nd}_])"
        },
        {
          "name": "constant.numeric.binary.thunder",
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])0[bB](?:[01]|[0123456789۰۱۲۳۴۵۶۷۸۹])+(?![[:word:]\\p{L}\\p{M}\\p{Nd}_])"
        },
        {
          "name": "constant.numeric.decimal.thunder",
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(?:[0-9]|[0123456789۰۱۲۳۴۵۶۷۸۹])+(?:[.٫](?:[0-9]|[0123456789۰۱۲۳۴۵۶۷۸۹])+)?(?![[:word:]\\p{L}\\p{M}\\p{Nd}_])"
        }
      ]
    },
    "annotation": {
      "name": "entity.name.function.decorator.thunder",
      "match": "@(?:آزموینه|ازموینه|پېښه\\s+ګر|پېښه_ګر|mock|test)(?![[:word:]\\p{L}\\p{M}\\p{Nd}_])|@[[:word:]\\p{L}\\p{M}\\p{Nd}_]+"
    },
    "declaration": {
      "patterns": [
        {
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(func|دنده)\\s+([[:word:]\\p{L}\\p{M}\\p{Nd}_]+)",
          "captures": {
            "1": {
              "name": "storage.type.function.thunder"
            },
            "2": {
              "name": "entity.name.function.thunder"
            }
          }
        },
        {
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(struct|mixin|جوړښت|ګډون)\\s+([[:word:]\\p{L}\\p{M}\\p{Nd}_]+)",
          "captures": {
            "1": {
              "name": "storage.type.struct.thunder"
            },
            "2": {
              "name": "entity.name.type.struct.thunder"
            }
          }
        },
        {
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(const|متغیر|ثابت|var)\\s+([[:word:]\\p{L}\\p{M}\\p{Nd}_]+)",
          "captures": {
            "1": {
              "name": "storage.type.thunder"
            },
            "2": {
              "name": "variable.other.declaration.thunder"
            }
          }
        }
      ]
    },
    "import": {
      "patterns": [
        {
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(import|راوړه)\\s+(native|بهرنی)?",
          "captures": {
            "1": {
              "name": "keyword.control.import.thunder"
            },
            "2": {
              "name": "keyword.control.import.thunder"
            }
          }
        }
      ]
    },
    "type-annotation": {
      "match": "(:)\\s*(string|اعشاری|float|منطقی|bool|byte|بایټ|int|عدد|متن|[[:alpha:]\\p{L}][[:word:]\\p{L}\\p{M}\\p{Nd}_]*)",
      "captures": {
        "1": {
          "name": "punctuation.separator.type.thunder"
        },
        "2": {
          "name": "storage.type.thunder"
        }
      }
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.operator.word.thunder",
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(?:and|not|or|او|نه|یا)(?![[:word:]\\p{L}\\p{M}\\p{Nd}_])"
        },
        {
          "name": "constant.language.thunder",
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(?:nothing|false|درواغ|رښتیا|true|دروغ|هېڅ)(?![[:word:]\\p{L}\\p{M}\\p{Nd}_])"
        },
        {
          "name": "storage.type.thunder",
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(?:string|اعشاری|float|منطقی|bool|byte|بایټ|int|عدد|متن)(?![[:word:]\\p{L}\\p{M}\\p{Nd}_])"
        },
        {
          "name": "keyword.control.thunder",
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(?:interface|continue|import|module|native|return|struct|راګرځه|ودریږه|ودرېږه|break|const|mixin|while|برسېر|بهرنی|تکرار|جوړښت|راوړه|متغیر|ټولګی|else|enum|func|pass|with|ترڅو|ثابت|دنده|دوام|ګډون|ګڼنه|for|var|تېر|سره|کنه|if|in|په|که)(?![[:word:]\\p{L}\\p{M}\\p{Nd}_])"
        },
        {
          "name": "support.function.builtin.thunder",
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(?:له\\s+ځایه\\s+لیرې\\s+کړه|end_of_input|وروستی\\s+واخله|دوه\\s+ییز\\s+کړه|شمېره\\s+ورکړه|شپاړسیز\\s+کړه|اعشاري\\s+کړه|ترلاسه\\s+کړه|د\\s+دندې\\s+نوم|د\\s+ننوت\\s+پای|ورزیات\\s+کړه|enumerate|remove_at|ترتیب\\s+کړه|راټول\\s+کړه|سره\\s+نښلوه|سرچپه\\s+کړه|ځای\\s+بدلول|contains|index_of|to_float|ارزښتونه|اوږدوالی|بایټ\\s+کړه|جوړې\\s+کړه|لیرې\\s+کړه|ناکام\\s+شه|پر\\s+هر\\s+یو|کرښه\\s+چاپ|inspect|name_of|println|reverse|to_byte|شامل\\s+دی|عدد\\s+کړه|متن\\s+کړه|چاڼ\\s+کړه|concat|filter|insert|reduce|remove|second|to_int|values|مجموعه|ننباسه|ځای\\s+یې|array|first|input|items|print|range|slice|لومړی|ولوله|وښایه|copy|dump|fail|keys|push|sort|swap|توکي|دوهم|واټن|ټوټه|کاپي|کتنه|کیلۍ|bin|get|has|hex|len|map|pop|str|sum|zip|لري|لړۍ|چاپ)(?![[:word:]\\p{L}\\p{M}\\p{Nd}_])"
        },
        {
          "name": "support.function.module.thunder",
          "match": "(?<![[:word:]\\p{L}\\p{M}\\p{Nd}_])(?:ګرافیک\\.تڼۍ\\s+کښېکښل\\s+شوې\\s+ده|graphics\\.circle_outline|فایل\\.بایټونه\\s+ورزیات\\s+کړه|سیسټم\\.د\\s+چاپېریال\\s+ارزښت|ګرافیک\\.موږک\\s+کښېکښل\\s+شوی|graphics\\.rect_outline|string\\.from_char_code|ګرافیک\\.د\\s+لیکنې\\s+اندازه|ګرافیک\\.د\\s+لیکې\\s+پلنوالی|ګرافیک\\.د\\s+چوکاټ\\s+چټکتیا|ګرافیک\\.کښېکښل\\s+شوې\\s+تڼۍ|graphics\\.key_pressed|کارونه\\.پای\\s+ته\\s+رسېدلی|ګرافیک\\.د\\s+مستطیل\\s+څنډه|graphics\\.frame_rate|graphics\\.line_width|graphics\\.mouse_down|سیسټم\\.د\\s+چلولو\\s+پایله|کارونه\\.انتظار\\s+وباسه|ګرافیک\\.د\\s+دایرې\\s+څنډه|graphics\\.text_size|string\\.starts_with|سیسټم\\.پای\\s+ته\\s+ورسوه|فایل\\.بایټونه\\s+ولوله|فایل\\.بایټونه\\s+ولیکه|متن\\.کوچنی\\s+توري\\s+کړه|کارونه\\.راته\\s+ودرېږه|کارونه\\.ټولو\\s+ته\\s+خبر|ګرافیک\\.ټاټ\\s+پاک\\s+کړه|bytes\\.from_string|file\\.append_bytes|graphics\\.key_down|سیسټم\\.د\\s+پوښۍ\\s+توکي|سیسټم\\.نېټه\\s+او\\s+وخت|ګرافیک\\.موږک\\s+عمودي|file\\.write_bytes|graphics\\.mouse_x|graphics\\.mouse_y|string\\.char_code|string\\.ends_with|string\\.is_number|string\\.substring|سیسټم\\.اوسنۍ\\s+پوښۍ|سیسټم\\.عامل\\s+سیسټم|متن\\.لوی\\s+توري\\s+کړه|کارونه\\.لار\\s+ورکړه|ګرافیک\\.موږک\\s+افقي|ګرافیک\\.ښکاره\\s+کړه|bytes\\.to_string|file\\.read_bytes|graphics\\.canvas|graphics\\.circle|string\\.contains|string\\.index_of|string\\.to_float|string\\.to_lower|string\\.to_upper|بایټونه\\.عدد\\s+کړه|بایټونه\\.له\\s+عدده|بایټونه\\.له\\s+متنه|بایټونه\\.متن\\s+کړه|ریاضي\\.تتمیم\\s+جیب|ریاضي\\.نیژدې\\s+کړه|ریاضي\\.پورته\\s+کړه|فایل\\.ورزیات\\s+کړه|کارونه\\.خلاص\\s+کړه|کارونه\\.نوی\\s+حالت|کارونه\\.هڅه\\s+وکړه|bytes\\.from_int|graphics\\.clear|graphics\\.frame|graphics\\.pixel|os\\.current_dir|string\\.replace|string\\.reverse|task\\.broadcast|task\\.condition|ریاضي\\.کښته\\s+کړه|متن\\.اعشاري\\s+کړه|متن\\.د\\s+توري\\s+کوډ|متن\\.د\\s+کوډ\\s+توری|متن\\.یو\\s+ځای\\s+کړه|کارونه\\.بیده\\s+شه|کارونه\\.قلف\\s+کړه|کارونه\\.نوی\\s+قلف|کارونه\\.پیل\\s+کړه|graphics\\.line|graphics\\.rec