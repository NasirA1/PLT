// 06 - While loops
//
// A while loop repeats its body as long as its condition is true.
// 'break' leaves the loop early; 'continue' skips to the next check.
//
// This program follows the Collatz sequence: halve even numbers, and turn
// odd numbers n into 3n + 1, until reaching 1.

var n = 27
var steps = 0
var highest = n

while n != 1
    if n % 2 == 0
        n = n / 2
    else
        n = 3 * n + 1
    if n > highest
        highest = n
    steps = steps + 1

println("27 reaches 1 after ", steps, " steps")
println("the highest value on the way was ", highest)

// Sum the odd numbers below 20, stopping early at 15.
var i = 0
var sum = 0
while true
    i = i + 1
    if i > 15
        break
    if i % 2 == 0
        continue
    sum = sum + i
println("1 + 3 + ... + 15 = ", sum)
