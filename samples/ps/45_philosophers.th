# ژبه: ps
# ۴۵ - ډوډۍ خوړونکي فیلسوفان، او هغه بند کرښه چې پرې مشهور دي
#
# پنځه فیلسوفان د یوې مېز پر شا ناست دي او د هرې دوو ترمنځ یو څانګی دی. د خوړلو
# لپاره فیلسوف کیڼ او ښي څانګي ته اړتیا لري. که هر یو لومړی کیڼ څانګی پورته کړي او
# بیا د ښي انتظار وباسي، هر څانګی نیول شوی دی او هیڅوک مخته نشي تلای: بند کرښه.
# تندر یې پېژني او پروګرام دروي:
#
#   تېروتنه R037: بند کرښه: ټول کارونه انتظار باسي او هیڅ یو یې مخته تلای نشي
#   (کار#۲ د هغه قلف انتظار باسي چې کار#۳ یې لري؛ ...)
#
# لاندې حل کلاسیک دی: څانګو ته ترتیب ورکړه او تل لومړی هغه واخله چې شمېره یې کمه ده.
# بیا د انتظار کومه کړۍ نشي جوړېدای، او ډوډۍ تل پای ته رسېږي.
راوړه "concurrency"

ثابت شمېر = ۵

متغیر څانګي: قلف[] = []
ترڅو اوږدوالی(څانګي) < شمېر
    ورزیات کړه(څانګي، قلف())

متغیر خواړه: عدد[] = لړۍ(شمېر، ۰)

# دواړه څانګي د خپلو شمېرو په ترتیب اخلي، هېڅکله برعکس.
دنده ډوډۍ(څوک: عدد): دنده()
    متغیر چلول = دنده()
        متغیر کیڼ = څوک
        متغیر ښي = (څوک + ۱) % شمېر
        متغیر ټیټ = ریاضي.کمینه(کیڼ، ښي)
        متغیر پورته = ریاضي.اعظمه(کیڼ، ښي)
        متغیر خوراکونه = ۳
        ترڅو خوراکونه > ۰
            خوراکونه -= ۱
            څانګي[ټیټ].قلف_کړه() سره
                څانګي[پورته].قلف_کړه() سره
                    خواړه[څوک] += ۱
                    کارونه.لار ورکړه()     # خوړل وخت نیسي، او نور یې هڅه کوي
    راګرځه چلول

متغیر مېز: کار[] = []
تکرار ځای په واټن(۰، شمېر)
    ورزیات کړه(مېز، کار(ډوډۍ(ځای)))
تکرار فیلسوف په مېز
    فیلسوف.انتظار_یې_وکړه()

کرښه چاپ("هر یو وخوړل: "، خواړه)
کرښه چاپ("ټول خواړه: "، مجموعه(خواړه))
کرښه چاپ("هر څانګی بیا خلاص دی: "، څانګي[۰].هڅه_وکړه() او څانګي[۳].هڅه_وکړه())
