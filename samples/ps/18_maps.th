// ژبه: ps
// ۱۸ - نقشې (اړیکیزې لړۍ)
//
// نقشه ارزښتونه د کیلیو لاندې ساتي: {"ناصر": ۴۰} د {متن: عدد} ډول لري.
// کیلۍ کېدای شي عدد، منطقي یا متن وي. م[کیلۍ] یو ارزښت لولي (که کیلۍ نه وي،
// د اجرا تېروتنه ده)، م[کیلۍ] = ارزښت یو ارزښت ورزیاتوي یا بدلوي، او لري،
// لرې کړه، کیلۍ او ارزښتونه دنننۍ دندې دي. نقشې د ورزیاتېدو ترتیب ساتي.
//
// هڅه وکړئ: له ډیبګ وروسته د VM پاڼه پرانیزئ او وګورئ چې نقشه ګام په ګام لوېږي.

متغیر عمرونه = {"ناصر": ۴۰, "ساره": ۷}
عمرونه["علي"] = ۱۲                 // یوه کیلۍ ورزیاتوي
عمرونه["ساره"] = ۸                 // یو ارزښت بدلوي
کرښه چاپ(عمرونه)
کرښه چاپ("ناصر ", عمرونه["ناصر"], " کلن دی")
کرښه چاپ(اوږدوالی(عمرونه), " کسان؛ ساره شته؟ ", لري(عمرونه, "ساره"), "؛ عمر شته؟ ", لري(عمرونه, "عمر"))

// وشمېرئ چې هره کلمه څو ځله راغلې ده.
متغیر کلمې = ["پیشو", "سپی", "او", "پیشو", "موږک", "او", "پیشو", "سپی"]
متغیر شمېرنې: {متن: عدد} = {}     // تشه نقشه د ډول ښودنې ته اړتیا لري
لپاره متغیر i = ۰; i < اوږدوالی(کلمې); i = i + ۱
    متغیر کلمه = کلمې[i]
    که لري(شمېرنې, کلمه)
        شمېرنې[کلمه] = شمېرنې[کلمه] + ۱
    کنه
        شمېرنې[کلمه] = ۱
کرښه چاپ(شمېرنې)

// کیلۍ() او ارزښتونه() لړۍ د ورزیاتېدو په ترتیب راکوي.
متغیر نومونه = کیلۍ(شمېرنې)
لپاره متغیر i = ۰; i < اوږدوالی(نومونه); i = i + ۱
    کرښه چاپ(نومونه[i], ": ", ارزښتونه(شمېرنې)[i])

لرې کړه(شمېرنې, "پیشو")
کرښه چاپ("پرته له «پیشو»: ", شمېرنې)

// لکه لړۍ، نقشې هم په ورکولو کې شریکېږي؛ کاپي() یوه خپلواکه نقشه جوړوي.
متغیر شریکه = عمرونه
شریکه["ناصر"] = ۴۱
متغیر جلا = کاپي(عمرونه)
جلا["ناصر"] = ۹۹
کرښه چاپ(عمرونه["ناصر"], " ", شریکه["ناصر"], " ", جلا["ناصر"])
