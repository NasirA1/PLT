// ژبه: ps
// ۱۰ - لړۍ
//
// لړۍ د یو ډول ډېر ارزښتونه ساتي. هغه په [۱، ۲، ۳] یا لړۍ(n، ارزښت) جوړېږي.
// اوږدوالی(a) یې د توکو شمېر دی او a[i] یې iم توکی دی (له ۰ پیلېږي).

متغیر لومړني = [۲، ۳، ۵، ۷، ۱۱]
چاپ_کرښه(«لومړني عددونه: »، لومړني، « (»، اوږدوالی(لومړني)، « توکي)»)

متغیر ټول = ۰
لپاره (متغیر i = ۰؛ i < اوږدوالی(لومړني)؛ i = i + ۱)
{
    ټول = ټول + لومړني[i]
}
چاپ_کرښه(«ټولټال: »، ټول)

متغیر مربع = لړۍ(۶، ۰)
لپاره (متغیر i = ۰؛ i < اوږدوالی(مربع)؛ i = i + ۱)
{
    مربع[i] = i × i
}
چاپ_کرښه(«مربعګانې: »، مربع)

متغیر نومونه = [«احمد»، «ملالۍ»، «خوشال»]
چاپ_کرښه(نومونه)
